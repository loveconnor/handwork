+// Resolve every replacement against the same preimage before allocating one
+// postimage. A rejected batch cannot partially write or multiply file buffers.
+fn deriveBatchPostimage(
+    alloc: Allocator,
+    edits: []const file_mutation_contract.EditReplacement,
+    preimage: file_mutation_contract.Preimage,
+) error{OutOfMemory}!PostimageResult {
+    if (edits.len == 0 or edits.len > file_mutation_contract.max_edit_replacements)
+        return .{ .semantic_failure = "edit_file edits must contain 1 to 32 replacements" };
+    const before = switch (preimage) {
+        .absent => return .{ .semantic_failure = identity_changed_message },
+        .present => |present| present.content,
+    };
+    const Span = struct { start: usize, end: usize, replacement: []const u8 };
+    var spans: [file_mutation_contract.max_edit_replacements]Span = undefined;
+    var after_len = before.len;
+    for (edits, 0..) |edit, i| {
+        if (std.mem.eql(u8, edit.old_string, edit.new_string))
+            return .{ .semantic_failure = "edit_file failed: old_string and new_string are identical" };
+        const count = countOccurrences(before, edit.old_string);
+        if (count == 0) return .{ .semantic_failure = "edit_file failed: old_string not found in file" };
+        if (count != 1) return .{ .semantic_failure = "edit_file failed: old_string is not unique, provide more context" };
+        const start = std.mem.find(u8, before, edit.old_string).?;
+        spans[i] = .{ .start = start, .end = start + edit.old_string.len, .replacement = edit.new_string };
+    }
+    std.mem.sort(Span, spans[0..edits.len], {}, struct {
+        fn less(_: void, a: Span, b: Span) bool {
+            return a.start < b.start;
+        }
+    }.less);
+    var previous_end: usize = 0;
+    for (spans[0..edits.len]) |span| {
+        if (span.start < previous_end) return .{ .semantic_failure = "edit_file failed: replacements overlap in the original file" };
+        previous_end = span.end;
+        after_len -= span.end - span.start;
+    }
+    for (spans[0..edits.len]) |span| {
+        after_len = std.math.add(usize, after_len, span.replacement.len) catch
+            return .{ .semantic_failure = "edit_file failed: postimage exceeds the 4 MiB preparation limit" };
+        if (after_len > max_content_bytes) return .{ .semantic_failure = "edit_file failed: postimage exceeds the 4 MiB preparation limit" };
+    }
+    const after = try alloc.alloc(u8, after_len);
+    var source: usize = 0;
+    var dest: usize = 0;
+    for (spans[0..edits.len]) |span| {
+        const n = span.start - source;
+        @memcpy(after[dest..][0..n], before[source..span.start]);
+        dest += n;
+        @memcpy(after[dest..][0..span.replacement.len], span.replacement);
+        dest += span.replacement.len;
+        source = span.end;
+    }
+    @memcpy(after[dest..], before[source..]);
+    return .{ .content = after };
 }
 
