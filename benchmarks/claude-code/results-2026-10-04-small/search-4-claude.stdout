d.get('a')!.rej(new Error('x')); await a;\n  assert.equal(c.getState().error, null); assert.equal(c.getState().loading, true);\n  d.get('ab')!.res(r('ab')); await b;\n  assert.equal(c.getState().loading, false);\n});\ntest('clear wins over late response', async () => {\n  const { c, d } = mk();\n  const a = c.search('a'); await c.search(' ');\n  assert.deepEqual(c.getState(), { query: '', results: [], loading: false, error: null });\n  d.get('a')!.res(r('a')); await a;\n  assert.deepEqual(c.getState(), { query: '', results: [], loading: false, error: null });\n});\nEOF\nnode --test /tmp/race-check.test.ts 2>&1 | tail -12; rm /tmp/race-check.test.ts; git status --short","description":"Apply request-token fix, run existing tests and a temporary race check"}},"wire_ingest_context":{"toolu_01Y8sjeqXShofEqYQhEvB3nF":{"cwd":"/private/tmp/handwork-claude-vucg11_s/search-4-claude/repo"}}}
