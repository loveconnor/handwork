{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GmWsEaNmHWwjNfamMwvwik","type":"tool_result","content":"      expect(isCompleted).toBe(false);\n      expect(isFailed).toBe(true);\n      expect(job.attemptsMade).toBe(1);\n      expect(job.finishedOn).toBeTypeOf('number');\n      expect(job.failedReason).toBe('job failed for some reason');\n\n      await worker.close();\n    });\n\n    describe('when there is a job in waiting', () => {\n      it('should emit active event when calling getNextJob', async () => {\n        const worker = new Worker(queueName, null, { connection, prefix });\n        const token = 'my-token';\n\n        await queue.add('test', { foo: 'bar' });\n\n        const activated = new Promise<Job>(resolve => {\n          worker.on('active', resolve);\n        });\n\n        const job = (await worker.getNextJob(token)) as Job;\n\n        const activatedJob = await activated;\n\n        expect(activatedJob.id).toBe(job.id);\n\n        const isActive = await job.isActive();\n        expect(isActive).toBe(true);\n\n        await job.moveToCompleted('done', token);\n        await worker.close();\n      });\n    });\n\n    describe('when a stalled job has exhausted its max stalled attempts', () => {\n      const markJobForDeferredFailure = async (worker: Worker, job: Job) => {\n        const client = await getRedisClient(worker);\n        await client.del(`${prefix}:${queueName}:${job.id}:lock`);\n\n        const stalled = new Promise<string>(resolve => {\n          worker.on('stalled', resolve);\n        });\n\n        await (worker as any).moveStalledJobsToWait();\n        await client.del(`${prefix}:${queueName}:stalled-check`);\n        await (worker as any).moveStalledJobsToWait();\n\n        expect(await stalled).toBe(job.id);\n      };\n\n      it(\n31-  describe('constructor', () => {\n32-    it('should create a lock manager with worker context', () => {\n33-      const mockWorkerContext: LockManagerWorkerContext = {\n34:        extendJobLocks: async () => [],\n35-        emit: () => true,\n36-        trace: async (_, __, ___, callback) => callback(),\n37-        name: 'test-queue',\n38-      };\n39-\n40-      const lockManager = new LockManager(mockWorkerContext, {\n--\n53-  describe('start and stop', () => {\n54-    it('should start and stop the lock manager', async () => {\n55-      const mockWorkerContext: LockManagerWorkerContext = {\n56:        extendJobLocks: async () => [],\n57-        emit: () => true,\n58-        trace: async (_, __, ___, callback) => callback(),\n59-        name: 'test-queue',\n60-      };\n61-\n62-      const lockManager = new LockManager(mockWorkerContext, {\n--\n76-\n77-    it('should not start if already closed', async () => {\n78-      const mockWorkerContext: LockManagerWorkerContext = {\n79:        extendJobLocks: async () => [],\n80-        emit: () => true,\n81-        trace: async (_, __, ___, callback) => callback(),\n82-        name: 'test-queue',\n83-      };\n84-\n85-      const lockManager = new LockManager(mockWorkerContext, {\n--\n96-\n97-    it('should not start timer if lockRenewTime is 0', () => {\n98-      const mockWorkerContext: LockManagerWorkerContext = {\n99:        extendJobLocks: async () => [],\n100-        emit: () => true,\n101-        trace: async (_, __, ___, callback) => callback(),\n102-        name: 'test-queue',","is_error":false}]},"parent_tool_use_id":null,"session_id":"1dbf0a0c-dc90-4fd8-bb5e-42123f53969d","uuid":"f5cf81c5-a30e-46da-8648-0c05f2b2a27d","timestamp":"2026-10-04T14:57:16.702Z","tool_use_result":{"stdout":"      expect(isCompleted).toBe(false);\n      expect(isFailed).toBe(true);\n      expect(job.attemptsMade).toBe(1);\n      expect(job.finishedOn).toBeTypeOf('number');\n      expect(job.failedReason).toBe('job failed for some reason');\n\n      await worker.close();\n    });\n\n    describe('when there is a job in waiting', () => {\n      it('should emit active event when calling getNextJob', async ()