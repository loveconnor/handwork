t })) });\nconst items = [{ id: '1', title: 'Latest', url: '/latest' }];\nconst old = c.search('old');\nconst stale = c.search('stale');\nconst latest = c.search('latest');\npending[0].resolve(items);\nawait old;\nassert.deepEqual(c.getState(), { query: 'latest', results: [], loading: true, error: null });\npending[1].reject(new Error('stale failure'));\nawait stale;\nassert.deepEqual(c.getState(), { query: 'latest', results: [], loading: true, error: null });\npending[2].resolve(items);\nawait latest;\nconst lateSuccess = c.search('late success');\nconst lateFailure = c.search('late failure');\nawait c.search('  ');\nconst cleared = { query: '', results: [], loading: false, error: null };\nassert.deepEqual(c.getState(), cleared);\npending[3].resolve(items);\npending[4].reject(new Error('late failure'));\nawait Promise.all([lateSuccess, lateFailure]);\nassert.deepEqual(c.getState(), cleared);\nconsole.log('Race and clearing probe passed');\nNODE\n git diff --check && git diff --stat && git diff -- src/search/controller.ts","cwd":"/private/tmp/handwork-efficiency-m_m99ddq/1-2-optimized/repo","exit_code":0,"signal":null,"timed_out":false,"duration_ms":362,"stdout_bytes":2241,"stderr_bytes":0,"truncated":false,"output_file":"handwork-command-replay-c9bec495d69fc94e72a2586362fc8afb.bin","stdout_file":null,"stderr_file":null}}],"usage":{"input_tokens":32914,"output_tokens":871},"usage_details":{"cached_input_tokens":4864,"cache_write_tokens":0,"reasoning_tokens":0}}
