{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CN7fiNFAMcYNxht99nj8mr","type":"tool_result","content":"      expect(isCompleted).toBe(false);\n      expect(isFailed).toBe(true);\n      expect(job.attemptsMade).toBe(1);\n      expect(job.finishedOn).toBeTypeOf('number');\n      expect(job.failedReason).toBe('job failed for some reason');\n\n      await worker.close();\n    });\n\n    describe('when there is a job in waiting', () => {\n      it('should emit active event when calling getNextJob', async () => {\n        const worker = new Worker(queueName, null, { connection, prefix });\n        const token = 'my-token';\n\n        await queue.add('test', { foo: 'bar' });\n\n        const activated = new Promise<Job>(resolve => {\n          worker.on('active', resolve);\n        });\n\n        const job = (await worker.getNextJob(token)) as Job;\n\n        const activatedJob = await activated;\n\n        expect(activatedJob.id).toBe(job.id);\n\n        const isActive = await job.isActive();\n        expect(isActive).toBe(true);\n\n        await job.moveToCompleted('done', token);\n        await worker.close();\n      });\n    });\n\n    describe('when a stalled job has exhausted its max stalled attempts', () => {\n      const markJobForDeferredFailure = async (worker: Worker, job: Job) => {\n        const client = await getRedisClient(worker);\n        await client.del(`${prefix}:${queueName}:${job.id}:lock`);\n\n        const stalled = new Promise<string>(resolve => {\n          worker.on('stalled', resolve);\n        });\n\n        await (worker as any).moveStalledJobsToWait();\n        await client.del(`${prefix}:${queueName}:stalled-check`);\n        await (worker as any).moveStalledJobsToWait();\n\n        expect(await stalled).toBe(job.id);\n      };\n\n      it(\n/**\n * Redis-only tests for `Worker`.\n *\n * These exercise Redis-specific internals (raw event-stream length via `xlen`,\n * etc.) that have no backend-agnostic equivalent. They live in a dedicated\n * `*.redis.test.ts` suite excluded from the cross-backend runs.\n */\nimport {\n  getRedisClient,\n  getRedisVersion,\n  getDatabaseType,\n  getBlockingRedisClient,\n} from './utils/get-redis-client';\nimport * as sinon from 'sinon';\nimport {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\n\nimport {\n  Queue,\n  QueueEvents,\n  Job,\n  Worker,\n  WaitingChildrenError,\n} from '../src/classes';\nimport { IRedisClient } from '../src/interfaces';\nimport {\n  delay,\n  isRedisVersionLowerThan,\n  randomUUID,\n  removeAllQueueData,\n} from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\n\nconst NoopProc = () => Promise.resolve();\n\ndescribe('workers (redis-only)', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n\n  let queue: Queue;\n  let queueEvents: QueueEvents;\n  let queueName: string;\n\n  let connection: IRedisClient;\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n    queueEvents = new QueueEvents(queueName, { connection, prefix });\n    await queueEvents.waitUntilReady();\n  });\nsrc/classes/queue-keys.ts:17:      'stalled-check',\nsrc/classes/redis-queue-backend.ts:2096:      this.queue.keys['stalled-check'],\nsrc/classes/worker.ts:216:  private stalledCheckerRunning = false;\nsrc/classes/worker.ts:217:  private stalledCheckStopper?: () => void;\nsrc/classes/worker.ts:1213:          this.stalledCheckStopper?.();","is_error":false}]},"parent_tool_use_id":null,"session_id":"4d958c2e-77db-4cd9-8dce-60022af6e0c7","uuid":"6c16b6e6-6c8a-4b25-a535-2b76ee1c8acf","timestamp":"2026-10-04T15:14:29.665Z","tool_use_result":{"stdout":"      expect(isCompleted).toBe(false);\n      expect(isFailed).toBe(true);\n      expect(job.attemptsMade).toBe(1);\n      expect(job.finishedOn).toBeTypeOf('number');\n      expect(job.failedReason).toBe('job failed for some reason');\n\n      await worker.close();\n    });\n\n    describe('when there is a job in waiting', () => {\n      it('should emit active event when calling getNextJob', async () => {\n        const worker = new Worker(queueName, null, { connection, prefix });\n        const token = 'my-token';\n\n        await queue.add('test', { foo: 'bar' });\n\n        const activated = new Promise<Job>(resolve => {\n          worker.on('active', resolve);\n        });\n\n        const job = (await worker.getNextJob(token)) as Job;\n\n        const activatedJob = await activated;\n\n        expect(activatedJob.id).toBe(job.id);\n\n        const isActive = await job.isActive();\n        expect(isActive).toBe(true);\n\n        await job.moveToCompleted('done', token);\n        await worker.close();\n      });\n    });\n\n    describe('when a stalled job has exhausted its max stalled attempts', () => {\n      const markJobForDeferredFailure = async (worker: Worker, job: Job) => {\n        const client = await getRedisClient(worker);\n        await client.del(`${prefix}:${queueName}:${job.id}:lock`);\n\n        const stalled = new Promise<string>(resolve => {\n          worker.on('stalled', resolve);\n        });\n\n        await (worker as any).moveStalledJobsToWait();\n        await client.del(`${prefix}:${queueName}:stalled-check`);\n        await (worker as any).moveStalledJobsToWait();\n\n        expect(await stalled).toBe(job.id);\n      };\n\n      it(\n/**\n * Redis-only tests for `Worker`.\n *\n * These exercise Redis-specific internals (raw event-stream length via `xlen`,\n * etc.) that have no backend-agnostic equivalent. They live in a dedicated\n * `*.redis.test.ts` suite excluded from the cross-backend runs.\n */\nimport {\n  getRedisClient,\n  getRedisVersion,\n  getDatabaseType,\n  getBlockingRedisClient,\n} from './utils/get-redis-client';\nimport * as sinon from 'sinon';\nimport {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\n\nimport {\n  Queue,\n  QueueEvents,\n  Job,\n  Worker,\n  WaitingChildrenError,\n} from '../src/classes';\nimport { IRedisClient } from '../src/interfaces';\nimport {\n  delay,\n  isRedisVersionLowerThan,\n  randomUUID,\n  removeAllQueueData,\n} from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\n\nconst NoopProc = () => Promise.resolve();\n\ndescribe('workers (redis-only)', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n\n  let queue: Queue;\n  let queueEvents: QueueEvents;\n  let queueName: string;\n\n  let connection: IRedisClient;\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n    queueEvents = new QueueEvents(queueName, { connection, prefix });\n    await queueEvents.waitUntilReady();\n  });\nsrc/classes/queue-keys.ts:17:      'stalled-check',\nsrc/classes/redis-queue-backend.ts:2096:      this.queue.keys['stalled-check'],\nsrc/classes/worker.ts:216:  private stalledCheckerRunning = false;\nsrc/classes/worker.ts:217:  private stalledCheckStopper?: () => void;\nsrc/classes/worker.ts:1213:          this.stalledCheckStopper?.();","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfhR3aE9LYfSo9auYQsYp","type":"message","role":"assistant","content":[{"type":"text","text":"Fix is applied and built; now adding a regression test that performs a real stall-recovery takeover, then running the full regression command."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1576,"cache_read_input_tokens":43922,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1576},"output_tokens":61,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4d958c2e-77db-4cd9-8dce-60022af6e0c7","uuid":"76f7bad7-8aad-4d4c-9149-dd4eb8abb80b","timestamp":"2026-10-04T15:14:31.571Z","request_id":"req_011CfhR3Zy1nFycGUx8RfjsS"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfhR3aE9LYfSo9auYQsYp","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019CpvH7Qm8jvJV3KYkaVxPj","name":"Write","input":{"file_path":"/private/tmp/handwork-claude-7lla1sj1/bullmq-4-claude/repo/tests/stale_worker_ownership.redis.test.ts","content":"/**\n * Redis-only tests for lock ownership after a job has been recovered by\n * another worker. They inspect raw `:lock` keys and the event stream.\n */\nimport { getRedisClient } from './utils/get-redis-client';\nimport {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\n\nimport { Queue, Job, Worker } from '../src/classes';\nimport { IRedisClient } from '../src/interfaces';\nimport { randomUUID, removeAllQueueData } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\n\ndescribe('stale worker ownership (redis-only)', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n  const staleToken = 'stale-token';\n  const ownerToken = 'owner-token';\n\n  let queue: Queue;\n  let queueName: string;\n  let staleWorker: Worker;\n  let ownerWorker: Worker;\n  let client: any;\n  let lockKey: string;\n\n  let connection: IRedisClient;\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n    staleWorker = new Worker(queueName, null, { connection, prefix });\n    ownerWorker = new Worker(queueName, null, { connection, prefix });\n    client = await getRedisClient(queue);\n  });\n\n  afterEach(async () => {\n    await staleWorker.close();\n    await ownerWorker.close();\n    await queue.close();\n    await removeAllQueueData(createTestConnection(), queueName);\n  });\n\n  afterAll(async function () {\n    await connection.quit();\n  });\n\n  // The stale worker gets the job, loses its lock, the job is recovered by\n  // the stalled checker and claimed by the owner worker.\n  const recoverJob = async (opts = {}) => {\n    await queue.add('test', { foo: 'bar' }, opts);\n\n    const staleJob = (await staleWorker.getNextJob(staleToken)) as Job;\n    lockKey = `${prefix}:${queueName}:${staleJob.id}:lock`;\n\n    await client.del(lockKey);\n    await (ownerWorker as any).moveStalledJobsToWait();\n    await client.del(`${prefix}:${queueName}:stalled-check`);\n    await (ownerWorker as any).moveStalledJobsToWait();\n\n    const ownerJob = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    expect(ownerJob.id).toBe(staleJob.id);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n\n    return { staleJob, ownerJob };\n  };\n\n  const snapshot = async (jobId: string) => ({\n    state: await queue.getJobState(jobId),\n    hash: await client.hgetall(`${prefix}:${queueName}:${jobId}`),\n    lock: await client.get(lockKey),\n    events: await client.xlen(`${prefix}:${queueName}:events`),\n    counts: await queue.getJobCounts(),\n  });\n\n  const expectRejected = async (\n    staleJob: Job,\n    operation: () => Promise<any>,\n  ) => {\n    const before = await snapshot(staleJob.id!);\n    expect(before.state).toBe('active');\n\n    await expect(operation()).rejects.toThrow(\n      `Lock mismatch for job ${staleJob.id}`,\n    );\n\n    expect(await snapshot(staleJob.id!)).toEqual(before);\n  };\n\n  it('rejects completing a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n\n    await expectRejected(staleJob, () =>\n      staleJob.moveToCompleted('stale', staleToken, false),\n    );\n\n    await ownerJob.moveToCompleted('owner', ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('completed');\n    expect(job.returnvalue).toBe('owner');\n    expect(job.attemptsMade).toBe(1);\n  });\n\n  it('rejects failing a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n\n    await expectRejected(staleJob, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('failed');\n    expect(job.failedReason).toBe('owner');\n  });\n\n  it('rejects an immediate retry of a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob({ attempts: 3 });\n\n    await expectRejected(staleJob, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('waiting');\n    expect(job.attemptsMade).toBe(1);\n  });\n\n  it('rejects a delayed retry of a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob({\n      attempts: 3,\n      backoff: { type: 'fixed', delay: 60000 },\n    });\n\n    await expectRejected(staleJob, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n    await expectRejected(staleJob, () =>\n      staleJob.moveToDelayed(Date.now() + 60000, staleToken),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('delayed');\n    expect(job.attemptsMade).toBe(1);\n    expect(job.delay).toBe(60000);\n  });\n\n  it('rejects moving a recovered job back to wait', async () => {\n    const { staleJob } = await recoverJob();\n\n    await expectRejected(staleJob, () => staleJob.moveToWait(staleToken));\n  });\n\n  it('does not renew the lock of a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n    const jobId = staleJob.id!;\n\n    expect(await staleJob.extendLock(staleToken, 60000)).toBe(0);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n\n    expect(\n      await (staleWorker as any).extendJobLocks([jobId], [staleToken], 60000),\n    ).toEqual([jobId]);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await client.pttl(lockKey)).toBeLessThanOrEqual(30000);\n\n    expect(await ownerJob.extendLock(ownerToken, 60000)).toBe(1);\n    expect(await client.pttl(lockKey)).toBeGreaterThan(30000);\n    expect(\n      await (ownerWorker as any).extendJobLocks([jobId], [ownerToken], 90000),\n    ).toEqual([]);\n    expect(await client.pttl(lockKey)).toBeGreaterThan(60000);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n  });\n\n  it('renews only the locks owned in a batch', async () => {\n    await queue.add('test', { idx: 1 });\n    await queue.add('test', { idx: 2 });\n    const owned = (await staleWorker.getNextJob(staleToken)) as Job;\n    const taken = (await staleWorker.getNextJob(staleToken)) as Job;\n    const takenLockKey = `${prefix}:${queueName}:${taken.id}:lock`;\n    await client.set(takenLockKey, ownerToken, 'PX', 30000);\n\n    expect(\n      await (staleWorker as any).extendJobLocks(\n        [owned.id, taken.id, 'missing'],\n        [staleToken, staleToken, staleToken],\n        60000,\n      ),\n    ).toEqual([taken.id, 'missing']);\n\n    expect(await client.get(takenLockKey)).toBe(ownerToken);\n    expect(await client.pttl(takenLockKey)).toBeLessThanOrEqual(30000);\n    expect(\n      await client.pttl(`${prefix}:${queueName}:${owned.id}:lock`),\n    ).toBeGreaterThan(30000);\n  });\n\n  it('keeps reporting missing locks', async () => {\n    await queue.add('test', { foo: 'bar' });\n    const job = (await staleWorker.getNextJob(staleToken)) as Job;\n    await client.del(`${prefix}:${queueName}:${job.id}:lock`);\n\n    expect(await job.extendLock(staleToken, 60000)).toBe(0);\n    await expect(job.moveToCompleted('done', staleToken, false)).rejects.toThrow(\n      `Missing lock for job ${job.id}`,\n    );\n    expect(await job.getState()).toBe('active');\n  });\n});\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1576,"cache_read_input_tokens":43922,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1576},"output_tokens":61,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4d958c2e-77db-4cd9-8dce-60022af6e0c7","uuid":"3f69f05c-1e8c-485c-95ec-cf82c719d5ca","timestamp":"2026-10-04T15:14:56.451Z","request_id":"req_011CfhR3Zy1nFycGUx8RfjsS","wire_tool_inputs":{"toolu_019CpvH7Qm8jvJV3KYkaVxPj":{"file_path":"/private/tmp/handwork-claude-7lla1sj1/bullmq-4-claude/repo/tests/stale_worker_ownership.redis.test.ts","content":"/**\n * Redis-only tests for lock ownership after a job has been recovered by\n * another worker. They inspect raw `:lock` keys and the event stream.\n */\nimport { getRedisClient } from './utils/get-redis-client';\nimport {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\n\nimport { Queue, Job, Worker } from '../src/classes';\nimport { IRedisClient } from '../src/interfaces';\nimport { randomUUID, removeAllQueueData } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\n\ndescribe('stale worker ownership (redis-only)', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n  const staleToken = 'stale-token';\n  const ownerToken = 'owner-token';\n\n  let queue: Queue;\n  let queueName: string;\n  let staleWorker: Worker;\n  let ownerWorker: Worker;\n  let client: any;\n  let lockKey: string;\n\n  let connection: IRedisClient;\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n    staleWorker = new Worker(queueName, null, { connection, prefix });\n    ownerWorker = new Worker(queueName, null, { connection, prefix });\n    client = await getRedisClient(queue);\n  });\n\n  afterEach(async () => {\n    await staleWorker.close();\n    await ownerWorker.close();\n    await queue.close();\n    await removeAllQueueData(createTestConnection(), queueName);\n  });\n\n  afterAll(async function () {\n    await connection.quit();\n  });\n\n  // The stale worker gets the job, loses its lock, the job is recovered by\n  // the stalled checker and claimed by the owner worker.\n  const recoverJob = async (opts = {}) => {\n    await queue.add('test', { foo: 'bar' }, opts);\n\n    const staleJob = (await staleWorker.getNextJob(staleToken)) as Job;\n    lockKey = `${prefix}:${queueName}:${staleJob.id}:lock`;\n\n    await client.del(lockKey);\n    await (ownerWorker as any).moveStalledJobsToWait();\n    await client.del(`${prefix}:${queueName}:stalled-check`);\n    await (ownerWorker as any).moveStalledJobsToWait();\n\n    const ownerJob = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    expect(ownerJob.id).toBe(staleJob.id);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n\n    return { staleJob, ownerJob };\n  };\n\n  const snapshot = async (jobId: string) => ({\n    state: await queue.getJobState(jobId),\n    hash: await client.hgetall(`${prefix}:${queueName}:${jobId}`),\n    lock: await client.get(lockKey),\n    events: await client.xlen(`${prefix}:${queueName}:events`),\n    counts: await queue.getJobCounts(),\n  });\n\n  const expectRejected = async (\n    staleJob: Job,\n    operation: () => Promise<any>,\n  ) => {\n    const before = await snapshot(staleJob.id!);\n    expect(before.state).toBe('active');\n\n    await expect(operation()).rejects.toThrow(\n      `Lock mismatch for job ${staleJob.id}`,\n    );\n\n    expect(await snapshot(staleJob.id!)).toEqual(before);\n  };\n\n  it('rejects completing a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n\n    await expectRejected(staleJob, () =>\n      staleJob.moveToCompleted('stale', staleToken, false),\n    );\n\n    await ownerJob.moveToCompleted('owner', ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('completed');\n    expect(job.returnvalue).toBe('owner');\n    expect(job.attemptsMade).toBe(1);\n  });\n\n  it('rejects failing a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n\n    await expectRejected(staleJob, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('failed');\n    expect(job.failedReason).toBe('owner');\n  });\n\n  it('rejects an immediate retry of a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob({ attempts: 3 });\n\n    await expectRejected(staleJob, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('waiting');\n    expect(job.attemptsMade).toBe(1);\n  });\n\n  it('rejects a delayed retry of a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob({\n      attempts: 3,\n      backoff: { type: 'fixed', delay: 60000 },\n    });\n\n    await expectRejected(staleJob, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n    await expectRejected(staleJob, () =>\n      staleJob.moveToDelayed(Date.now() + 60000, staleToken),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('delayed');\n    expect(job.attemptsMade).toBe(1);\n    expect(job.delay).toBe(60000);\n  });\n\n  it('rejects moving a recovered job back to wait', async () => {\n    const { staleJob } = await recoverJob();\n\n    await expectRejected(staleJob, () => staleJob.moveToWait(staleToken));\n  });\n\n  it('does not renew the lock of a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n    const jobId = staleJob.id!;\n\n    expect(await staleJob.extendLock(staleToken, 60000)).toBe(0);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n\n    expect(\n      await (staleWorker as any).extendJobLocks([jobId], [staleToken], 60000),\n    ).toEqual([jobId]);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await client.pttl(lockKey)).toBeLessThanOrEqual(30000);\n\n    expect(await ownerJob.extendLock(ownerToken, 60000)).toBe(1);\n    expect(await client.pttl(lockKey)).toBeGreaterThan(30000);\n    expect(\n      await (ownerWorker as any).extendJobLocks([jobId], [ownerToken], 90000),\n    ).toEqual([]);\n    expect(await client.pttl(lockKey)).toBeGreaterThan(60000);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n  });\n\n  it('renews only the locks owned in a batch', async () => {\n    await queue.add('test', { idx: 1 });\n    await queue.add('test', { idx: 2 });\n    const owned = (await staleWorker.getNextJob(staleToken)) as Job;\n    const taken = (await staleWorker.getNextJob(staleToken)) as Job;\n    const takenLockKey = `${prefix}:${queueName}:${taken.id}:lock`;\n    await client.set(takenLockKey, ownerToken, 'PX', 30000);\n\n    expect(\n      await (staleWorker as any).extendJobLocks(\n        [owned.id, taken.id, 'missing'],\n        [staleToken, staleToken, staleToken],\n        60000,\n      ),\n    ).toEqual([taken.id, 'missing']);\n\n    expect(await client.get(takenLockKey)).toBe(ownerToken);\n    expect(await client.pttl(takenLockKey)).toBeLessThanOrEqual(30000);\n    expect(\n      await client.pttl(`${prefix}:${queueName}:${owned.id}:lock`),\n    ).toBeGreaterThan(30000);\n  });\n\n  it('keeps reporting missing locks', async () => {\n    await queue.add('test', { foo: 'bar' });\n    const job = (await staleWorker.getNextJob(staleToken)) as Job;\n    await client.del(`${prefix}:${queueName}:${job.id}:lock`);\n\n    expect(await job.extendLock(staleToken, 60000)).toBe(0);\n    await expect(job.moveToCompleted('done', staleToken, false)).rejects.toThrow(\n      `Missing lock for job ${job.id}`,\n    );\n    expect(await job.getState()).toBe('active');\n  });\n});\n"}}}
