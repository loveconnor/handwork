, url: '/new' }];\nfor (const outcome of ['resolve', 'reject']) {\n  for (const phase of ['pending', 'finished', 'cleared']) {\n    const requests = [];\n    const c = createSearchController({ search: () => new Promise((resolve, reject) => requests.push({ resolve, reject })) });\n    const old = c.search('same');\n    const current = c.search('same');\n    if (phase === 'finished') { requests[1].resolve(newItems); await current; }\n    if (phase === 'cleared') {\n      await c.search('  ');\n      assert.deepEqual(c.getState(), { query: '', results: [], loading: false, error: null });\n    }\n    const expected = c.getState();\n    requests[0][outcome](outcome === 'resolve' ? oldItems : new Error('stale'));\n    await old;\n    assert.deepEqual(c.getState(), expected);\n    if (phase !== 'finished') {\n      requests[1].resolve(newItems);\n      await current;\n      if (phase === 'cleared') assert.deepEqual(c.getState(), expected);\n      else assert.deepEqual(c.getState(), { query: 'same', results: newItems, loading: false, error: null });\n    }\n  }\n}\nconsole.log('Race-condition probe passed');\nNODE\n git diff --check && git diff --stat && git diff -- src/search/controller.ts","cwd":"/private/tmp/handwork-fair-2tip6hsn/search-2-handwork/repo","exit_code":0,"signal":null,"timed_out":false,"duration_ms":374,"stdout_bytes":2228,"stderr_bytes":0,"truncated":false,"output_file":"handwork-command-replay-1c40c087d0e325a4f193c630656f986c.bin","stdout_file":null,"stderr_file":null}}],"usage":{"input_tokens":37045,"output_tokens":973},"usage_details":{"cached_input_tokens":12160,"cache_write_tokens":0,"reasoning_tokens":10}}
