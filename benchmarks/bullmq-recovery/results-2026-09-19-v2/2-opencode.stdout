{"type":"tool_use","timestamp":1789788825600,"sessionID":"ses_f48467e2bffejC2lfVdrXfzZn1","part":{"type":"tool","tool":"read","callID":"call_yUoCWJpkE8qGxYYIYdCGYLIy","state":{"status":"completed","input":{"filePath":"/private/tmp/handwork-bullmq-G7VJT5/2-opencode/repo/tests/lock_manager.test.ts","limit":160},"output":"<path>/private/tmp/handwork-bullmq-G7VJT5/2-opencode/repo/tests/lock_manager.test.ts</path>\n<type>file</type>\n<content>\n1: import {\n2:   describe,\n3:   beforeEach,\n4:   afterEach,\n5:   beforeAll,\n6:   afterAll,\n7:   it,\n8:   expect,\n9: } from 'vitest';\n10: \n11: import { randomUUID } from '../src/utils';\n12: import { LockManager, Queue, Worker } from '../src/classes';\n13: import { IRedisClient, LockManagerWorkerContext } from '../src/interfaces';\n14: import { delay } from '../src/utils';\n15: import { createTestConnection } from './utils/connection-factory';\n16: import { cleanupQueue } from './utils/cleanup-queue';\n17: \n18: describe('LockManager', () => {\n19:   const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n20: \n21:   let connection: IRedisClient;\n22: \n23:   beforeAll(async () => {\n24:     connection = createTestConnection();\n25:   });\n26: \n27:   afterAll(async function () {\n28:     await connection.quit();\n29:   });\n30: \n31:   describe('constructor', () => {\n32:     it('should create a lock manager with worker context', () => {\n33:       const mockWorkerContext: LockManagerWorkerContext = {\n34:         extendJobLocks: async () => [],\n35:         emit: () => true,\n36:         trace: async (_, __, ___, callback) => callback(),\n37:         name: 'test-queue',\n38:       };\n39: \n40:       const lockManager = new LockManager(mockWorkerContext, {\n41:         lockRenewTime: 5000,\n42:         lockDuration: 30000,\n43:         workerId: 'worker-1',\n44:         workerName: 'test-worker',\n45:       });\n46: \n47:       expect(lockManager).toBeInstanceOf(LockManager);\n48:       expect(lockManager.isRunning()).toBe(false);\n49:       expect(lockManager.getActiveJobCount()).toBe(0);\n50:     });\n51:   });\n52: \n53:   describe('start and stop', () => {\n54:     it('should start and stop the lock manager', async () => {\n55:       const mockWorkerContext: LockManagerWorkerContext = {\n56:         extendJobLocks: async () => [],\n57:         emit: () => true,\n58:         trace: async (_, __, ___, callback) => callback(),\n59:         name: 'test-queue',\n60:       };\n61: \n62:       const lockManager = new LockManager(mockWorkerContext, {\n63:         lockRenewTime: 5000,\n64:         lockDuration: 30000,\n65:         workerId: 'worker-1',\n66:       });\n67: \n68:       expect(lockManager.isRunning()).toBe(false);\n69: \n70:       lockManager.start();\n71:       expect(lockManager.isRunning()).toBe(true);\n72: \n73:       await lockManager.close();\n74:       expect(lockManager.isRunning()).toBe(false);\n75:     });\n76: \n77:     it('should not start if already closed', async () => {\n78:       const mockWorkerContext: LockManagerWorkerContext = {\n79:         extendJobLocks: async () => [],\n80:         emit: () => true,\n81:         trace: async (_, __, ___, callback) => callback(),\n82:         name: 'test-queue',\n83:       };\n84: \n85:       const lockManager = new LockManager(mockWorkerContext, {\n86:         lockRenewTime: 5000,\n87:         lockDuration: 30000,\n88:         workerId: 'worker-1',\n89:       });\n90: \n91:       await lockManager.close();\n92:       lockManager.start();\n93: \n94:       expect(lockManager.isRunning()).toBe(false);\n95:     });\n96: \n97:     it('should not start timer if lockRenewTime is 0', () => {\n98:       const mockWorkerContext: LockManagerWorkerContext = {\n99:         extendJobLocks: async () => [],\n100:         emit: () => true,\n101:         trace: async (_, __, ___, callback) => callback(),\n102:         name: 'test-queue',\n103:       };\n104: \n105:       const lockManager = new LockManager(mockWorkerContext, {\n10