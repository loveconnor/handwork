{"type":"tool_use","timestamp":1789792621137,"sessionID":"ses_f4810bfebffeApNO7X3dNhAmLI","part":{"type":"tool","tool":"bash","callID":"call_ZNghPxXiz11f4kSPkPSRE2k3","state":{"status":"completed","input":{"command":"node node_modules/prettier/bin/prettier.cjs tests/worker_ownership.redis.test.ts"},"output":"import { afterEach, beforeEach, describe, expect, it } from 'vitest';\nimport { Job, Queue, Worker } from '../src/classes';\nimport { IRedisClient } from '../src/interfaces';\nimport { randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { getRedisClient } from './utils/get-redis-client';\n\ndescribe('Worker ownership after stalled recovery (redis-only)', () => {\n  let connection: IRedisClient;\n  let queue: Queue;\n  let original: Worker;\n  let replacement: Worker;\n\n  beforeEach(() => {\n    connection = createTestConnection();\n    const name = `ownership-${randomUUID()}`;\n    const opts = {\n      connection,\n      prefix: process.env.BULLMQ_TEST_PREFIX || 'bull',\n      autorun: false,\n    };\n    queue = new Queue(name, opts);\n    original = new Worker(name, null, opts);\n    replacement = new Worker(name, null, opts);\n  });\n\n  afterEach(async () => {\n    await Promise.all([original.close(), replacement.close()]);\n    await queue.obliterate({ force: true });\n    await queue.close();\n    await connection.quit();\n  });\n\n  async function recover() {\n    const stale = (await original.getNextJob('old', { block: false })) as Job;\n    const client = await getRedisClient(queue);\n    // Simulate the original worker's lease expiring, then run real recovery.\n    await client.del(queue.toKey(`${stale.id}:lock`));\n    await replacement.getBackend().moveStalledJobsToWait();\n    await client.del(queue.toKey('stalled-check'));\n    await replacement.getBackend().moveStalledJobsToWait();\n    const current = (await replacement.getNextJob('new', {\n      block: false,\n    })) as Job;\n    expect(current.id).toBe(stale.id);\n    return { stale, current, client };\n  }\n\n  it.each(['complete', 'fail', 'retry', 'delayed retry'])(\n    'rejects stale %s without modifying recovered job or events',\n    async operation => {\n      await queue.add(\n        'job',\n        {},\n        {\n          attempts: operation.includes('retry') ? 3 : 1,\n          backoff:\n            operation === 'delayed retry'\n              ? { type: 'fixed', delay: 1000 }\n              : undefined,\n        },\n      );\n      const { stale, current, client } = await recover();\n      // A due delayed job must not be promoted by an unauthorized retry.\n      const delayed = await queue.add('delayed', {}, { delay: 60000 });\n      await client.zadd(queue.toKey('delayed'), 0, delayed.id);\n      const key = queue.toKey(stale.id);\n      const snapshot = async () => ({\n        job: await client.hgetall(key),\n        lock: await client.get(`${key}:lock`),\n        active: await client.lrange(queue.toKey('active'), 0, -1),\n        wait: await client.lrange(queue.toKey('wait'), 0, -1),\n        delayed: await client.zrange(\n          queue.toKey('delayed'),\n          0,\n          -1,\n          'WITHSCORES',\n        ),\n        events: await client.xrange(queue.toKey('events'), '-', '+'),\n      });\n      const before = await snapshot();\n      const attempt =\n        operation === 'complete'\n          ? stale.moveToCompleted('stale result', 'old', false)\n          : stale.moveToFailed(new Error('stale failure'), 'old', false);\n      await expect(attempt).rejects.toThrow(\n        `Lock mismatch for job ${stale.id}`,\n      );\n      expect(await snapshot()).toEqual(before);\n      expect(await current.getState()).toBe('active');\n      expect(await current.extendLock('new', 60000)).toBe(1);\n      await current.moveToCompleted('current result', 'new', false);\n      const finished = await queue.getJob(current.id);\n      expect(await finished.getState()).toBe('completed');\n      expect(finished.returnvalue).toBe('current result');\n      expect(finished.attemptsMade).toBe(1);\n    },\n  );\n\n  it('rejects stale and missing renewals while renewing matching batch entries', async () => {\n    await queue.add('job', {});\n    const { stale, current, client } = await recover();\n    await queue.add('other', {});\n    const other = (await replacement.getNextJob('other', {\n      block: false,\n    })) as Job;\n    const key = queue.toKey(`${current.id}:lock`);\n    await client.sadd(queue.toKey('stalled'), current.id, other.id);\n    const ttl = await client.pttl(key);\n    expect(await stale.extendLock('old', 120000)).toBe(0);\n    expect(\n      await original.extendJobLocks(\n        [current.id, other.id, 'missing'],\n        ['old', 'other', 'missing'],\n        120000,\n      ),\n    ).toEqual([current.id, 'missing']);\n    expect(await client.get(key)).toBe('new');\n    expect(await client.pttl(key)).toBeLessThanOrEqual(ttl);\n    expect(await client.sismember(queue.toKey('stalled'), current.id)).toBe(1);\n    expect(await client.sismember(queue.toKey('stalled'), other.id)).toBe(0);\n    expect(await client.pttl(queue.toKey(`${other.id}:lock`))).toBeGreaterThan(\n      60000,\n    );\n    expect(\n      await replacement.extendJobLocks([current.id], ['new'], 120000),\n    ).toEqual([]);\n    expect(await client.pttl(key)).toBeGreaterThan(60000);\n    expect(await client.sismember(queue.toKey('stalled'), current.id)).toBe(0);\n    await current.moveToCompleted('done', 'new', false);\n    expect(await current.extendLock('new', 120000)).toBe(0);\n    expect(await client.exists(key)).toBe(0);\n  });\n\n  it('keeps missing-lock errors and the administrative token-zero bypass', async () => {\n    await queue.add('job', {});\n    const job = (await original.getNextJob('old', { block: false })) as Job;\n    const client = await getRedisClient(queue);\n    await client.del(queue.toKey(`${job.id}:lock`));\n    await expect(job.moveToCompleted('done', 'old', false)).rejects.toThrow(\n      `Missing lock for job ${job.id}`,\n    );\n    await expect(\n      job.moveToFailed(new Error('failure'), 'old', false),\n    ).rejects.toThrow(`Missing lock for job ${job.id}`);\n    await job.moveToCompleted('admin result', '0', false);\n    expect(await job.getState()).toBe('completed');\n  });\n});\n","metadata":{"output":"import { afterEach, beforeEach, describe, expect, it } from 'vitest';\nimport { Job, Queue, Worker } from '../src/classes';\nimport { IRedisClient } from '../src/interfaces';\nimport { randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { getRedisClient } from './utils/get-redis-client';\n\ndescribe('Worker ownership after stalled recovery (redis-only)', () => {\n  let connection: IRedisClient;\n  let queue: Queue;\n  let original: Worker;\n  let replacement: Worker;\n\n  beforeEach(() => {\n    connection = createTestConnection();\n    const name = `ownership-${randomUUID()}`;\n    const opts = {\n      connection,\n      prefix: process.env.BULLMQ_TEST_PREFIX || 'bull',\n      autorun: false,\n    };\n    queue = new Queue(name, opts);\n    original = new Worker(name, null, opts);\n    replacement = new Worker(name, null, opts);\n  });\n\n  afterEach(async () => {\n    await Promise.all([original.close(), replacement.close()]);\n    await queue.obliterate({ force: true });\n    await queue.close();\n    await connection.quit();\n  });\n\n  async function recover() {\n    const stale = (await original.getNextJob('old', { block: false })) as Job;\n    const client = await getRedisClient(queue);\n    // Simulate the original worker's lease expiring, then run real recovery.\n    await client.del(queue.toKey(`${stale.id}:lock`));\n    await replacement.getBackend().moveStalledJobsToWait();\n    await client.del(queue.toKey('stalled-check'));\n    await replacement.getBackend().moveStalledJobsToWait();\n    const current = (await replacement.getNextJob('new', {\n      block: false,\n    })) as Job;\n    expect(current.id).toBe(stale.id);\n    return { stale, current, client };\n  }\n\n  it.each(['complete', 'fail', 'retry', 'delayed retry'])(\n    'rejects stale %s without modifying recovered job or events',\n    async operation => {\n      await queue.add(\n        'job',\n        {},\n        {\n          attempts: operation.includes('retry') ? 3 : 1,\n          backoff:\n            operation === 'delayed retry'\n              ? { type: 'fixed', delay: 1000 }\n              : undefined,\n        },\n      );\n      const { stale, current, client } = await recover();\n      // A due delayed job must not be promoted by an unauthorized retry.\n      const delayed = await queue.add('delayed', {}, { delay: 60000 });\n      await client.zadd(queue.toKey('delayed'), 0, delayed.id);\n      const key = queue.toKey(stale.id);\n      const snapshot = async () => ({\n        job: await client.hgetall(key),\n        lock: await client.get(`${key}:lock`),\n        active: await client.lrange(queue.toKey('active'), 0, -1),\n        wait: await client.lrange(queue.toKey('wait'), 0, -1),\n        delayed: await client.zrange(\n          queue.toKey('delayed'),\n          0,\n          -1,\n          'WITHSCORES',\n        ),\n        events: await client.xrange(queue.toKey('events'), '-', '+'),\n      });\n      const before = await snapshot();\n      const attempt =\n        operation === 'complete'\n          ? stale.moveToCompleted('stale result', 'old', false)\n          : stale.moveToFailed(new Error('stale failure'), 'old', false);\n      await expect(attempt).rejects.toThrow(\n        `Lock mismatch for job ${stale.id}`,\n      );\n      expect(await snapshot()).toEqual(before);\n      expect(await current.getState()).toBe('active');\n      expect(await current.extendLock('new', 60000)).toBe(1);\n      await current.moveToCompleted('current result', 'new', false);\n      const finished = await queue.getJob(current.id);\n      expect(await finished.getState()).toBe('completed');\n      expect(finished.returnvalue).toBe('current result');\n      expect(finished.attemptsMade).toBe(1);\n    },\n  );\n\n  it('rejects stale and missing renewals while renewing matching batch entries', async () => {\n    await queue.add('job', {});\n    const { stale, current, client } = await recover();\n    await queue.add('other', {});\n    const other = (await replacement.getNextJob('other', {\n      block: false,\n    })) as Job;\n    const key = queue.toKey(`${current.id}:lock`);\n    await client.sadd(queue.toKey('stalled'), current.id, other.id);\n    const ttl = await client.pttl(key);\n    expect(await stale.extendLock('old', 120000)).toBe(0);\n    expect(\n      await original.extendJobLocks(\n        [current.id, other.id, 'missing'],\n        ['old', 'other', 'missing'],\n        120000,\n      ),\n    ).toEqual([current.id, 'missing']);\n    expect(await client.get(key)).toBe('new');\n    expect(await client.pttl(key)).toBeLessThanOrEqual(ttl);\n    expect(await client.sismember(queue.toKey('stalled'), current.id)).toBe(1);\n    expect(await client.sismember(queue.toKey('stalled'), other.id)).toBe(0);\n    expect(await client.pttl(queue.toKey(`${other.id}:lock`))).toBeGreaterThan(\n      60000,\n    );\n    expect(\n      await replacement.extendJobLocks([current.id], ['new'], 120000),\n    ).toEqual([]);\n    expect(await client.pttl(key)).toBeGreaterThan(60000);\n    expect(await client.sismember(queue.toKey('stalled'), current.id)).toBe(0);\n    await current.moveToCompleted('done', 'new', false);\n    expect(await current.extendLock('new', 120000)).toBe(0);\n    expect(await client.exists(key)).toBe(0);\n  });\n\n  it('keeps missing-lock errors and the administrative token-zero bypass', async () => {\n    await queue.add('job', {});\n    const job = (await original.getNextJob('old', { block: false })) as Job;\n    const client = await getRedisClient(queue);\n    await client.del(queue.toKey(`${job.id}:lock`));\n    await expect(job.moveToCompleted('done', 'old', false)).rejects.toThrow(\n      `Missing lock for job ${job.id}`,\n    );\n    await expect(\n      job.moveToFailed(new Error('failure'), 'old', false),\n    ).rejects.toThrow(`Missing lock for job ${job.id}`);\n    await job.moveToCompleted('admin result', '0', false);\n    expect(await job.getState()).toBe('completed');\n  });\n});\n","exit":0,"truncated":false},"title":"node node_modules/prettier/bin/prettier.cjs tests/worker_ownership.redis.test.ts","time":{"start":1789792621030,"end":1789792621136}},"metadata":{"openai":{"itemId":"fc_03b1e0e92a443a04016aae116c228c87d18b8ccf5b49941c79"}},"id":"prt_0b7f40e6d00169sZikKzq4Vn7R","sessionID":"ses_f4810bfebffeApNO7X3dNhAmLI","messageID":"msg_0b7f40569001IZ94RSBPNwDLln"}}
