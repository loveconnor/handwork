t.rejects(mapLimit([], limit, () => {}), RangeError);\n}\nfor (const limit of [1, 2, 10]) {\n  let active = 0, peak = 0;\n  const seen = [];\n  const syncError = new Error('sync');\n  const asyncError = new Error('async');\n  const result = await mapLimit([0, 1, 2, 3, 4], limit, (item, index) => {\n    assert.equal(item, index);\n    seen.push(index);\n    if (item === 1) throw syncError;\n    active++;\n    peak = Math.max(peak, active);\n    return new Promise((resolve, reject) => setTimeout(() => {\n      active--;\n      if (item === 2) reject(asyncError);\n      else resolve(item * 2);\n    }, (5 - item) * 5));\n  });\n  assert.deepEqual(result, [\n    {status:'fulfilled', value:0}, {status:'rejected', reason:syncError},\n    {status:'rejected', reason:asyncError}, {status:'fulfilled', value:6},\n    {status:'fulfilled', value:8}\n  ]);\n  assert.deepEqual(seen, [0, 1, 2, 3, 4]);\n  assert.ok(peak <= limit);\n  assert.equal(active, 0);\n}\nconsole.log('Contract probe passed');\nNODE\n git diff --check && git diff --stat && git diff -- src/map.js src/worker.js","cwd":"/private/tmp/handwork-efficiency-apul1kbx/queue-2-optimized/repo","exit_code":0,"signal":null,"timed_out":false,"duration_ms":444,"stdout_bytes":1539,"stderr_bytes":0,"truncated":false,"output_file":"handwork-command-replay-f916defe20ca9447534e3c7a43e883c0.bin","stdout_file":null,"stderr_file":null}}],"usage":{"input_tokens":26518,"output_tokens":1017},"usage_details":{"cached_input_tokens":7296,"cache_write_tokens":0,"reasoning_tokens":0}}
