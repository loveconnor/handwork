{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/ownership.redis.test.ts <<'EOF'\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest';\nimport { Job, Queue, Worker } from '../src/classes';\nimport { randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { getRedisClient } from './utils/get-redis-client';\n\ndescribe('Recovered job ownership', () => {\n  let queue: Queue;\n  let worker: Worker;\n  let connection: ReturnType<typeof createTestConnection>;\n\n  beforeEach(() => {\n    connection = createTestConnection();\n    const name = \"'`ownership-${randomUUID()}`;\n    queue = new Queue(name, { connection });\n    worker = new Worker(name, null, { connection, skipLockRenewal: true });\n  });\n\n  afterEach(async () => {\n    await worker.close();\n    await queue.obliterate({ force: true });\n    await queue.close();\n    await connection.quit();\n  });\n\n  async function recover(opts = {}) {\n    await queue.add('\"'job', {}, opts);\n    const stale = (await worker.getNextJob('stale')) as Job;\n    const client = await getRedisClient(queue);\n    await client.del(queue.toKey(\"'`${stale.id}:lock`));\n    await client.sadd(queue.toKey('\"'stalled'), stale.id\"'!);\n    await worker.getBackend().moveStalledJobsToWait();\n    const owner = (await worker.getNextJob('\"'owner')) as Job;\n    expect(owner.id).toBe(stale.id);\n    return { stale, owner, client };\n  }\n\n  for (const operation of ['complete', 'fail', 'retry', 'delayed']) {\n    it(\"'`rejects stale ${operation} without changing persisted data or events`, async () => {\n      const { stale, owner, client } = await recover({\n        attempts: operation === '\"'retry' || operation === 'delayed' ? 3 : 1,\n        backoff: operation === 'delayed' ? { type: 'fixed', delay: 1000 } : undefined,\n      });\n      // A due delayed job must not be promoted by a rejected immediate retry.\n      await queue.add('delayed', {}, { delay: 60000 });\n      await client.zadd(queue.toKey('delayed'), 1, '2');\n      const snapshot = async () => ({\n        job: await client.hgetall(queue.toKey(stale.id\"'!)),\n        lock: await client.get(queue.toKey(`${stale.id}:lock`)),\n        active: await client.lrange(queue.toKey('\"'active'), 0, -1),\n        wait: await client.lrange(queue.toKey('wait'), 0, -1),\n        delayed: await client.zrange(queue.toKey('delayed'), 0, -1),\n        events: await client.xrange(queue.toKey('events'), '-', '+'),\n      });\n      const before = await snapshot();\n      const result = operation === 'complete'\n        ? stale.moveToCompleted('stale result', 'stale', false)\n        : stale.moveToFailed(new Error('stale failure'), 'stale', false);\n      await expect(result).rejects.toThrow('Lock mismatch');\n      expect(await snapshot()).toEqual(before);\n      expect(await owner.extendLock('owner', 30000)).toBe(1);\n      await owner.moveToCompleted('owner result', 'owner', false);\n      expect(await owner.getState()).toBe('completed');\n    });\n  }\n\n  it('rejects stale and missing renewals while allowing the owner to renew', async () => {\n    const { stale, owner, client } = await recover();\n    const lockKey = queue.toKey(\"'`${owner.id}:lock`);\n    await client.sadd(queue.toKey('\"'stalled'), owner.id\"'!);\n    await client.pexpire(lockKey, 10000);\n    expect(await stale.extendLock('\"'stale', 60000)).toBe(0);\n    expect(await worker.getBackend().extendLocks([owner.id\"'!], ['\"'stale'], 60000))\n      .toEqual([owner.id]);\n    expect(await client.get(lockKey)).toBe('owner');\n    expect(await client.pttl(lockKey)).toBeLessThanOrEqual(10000);\n    expect(await client.sismember(queue.toKey('stalled'), owner.id\"'!)).toBe(1);\n    expect(await worker.getBackend().extendLocks([owner.id!], ['\"'owner'], 60000))\n      .toEqual([]);\n    expect(await client.pttl(lockKey)).toBeGreaterThan(10000);\n    await client.del(lockKey);\n    expect(await owner.extendLock('owner', 60000)).toBe(0);\n    expect(await worker.getBackend().extendLocks([owner.id\"'!], ['\"'owner'], 60000))\n      .toEqual([owner.id]);\n    await expect(owner.moveToCompleted('result', 'owner', false)).rejects.toThrow('Missing lock');\n  });\n});\nEOF\nnode node_modules/vitest/vitest.mjs run --no-file-parallelism tests/ownership.redis.test.ts > /tmp/bullmq-ownership.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/ownership.redis.test.ts <<'EOF'\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest';\nimport { Job, Queue, Worker } from '../src/classes';\nimport { randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { getRedisClient } from './utils/get-redis-client';\n\ndescribe('Recovered job ownership', () => {\n  let queue: Queue;\n  let worker: Worker;\n  let connection: ReturnType<typeof createTestConnection>;\n\n  beforeEach(() => {\n    connection = createTestConnection();\n    const name = \"'`ownership-${randomUUID()}`;\n    queue = new Queue(name, { connection });\n    worker = new Worker(name, null, { connection, skipLockRenewal: true });\n  });\n\n  afterEach(async () => {\n    await worker.close();\n    await queue.obliterate({ force: true });\n    await queue.close();\n    await connection.quit();\n  });\n\n  async function recover(opts = {}) {\n    await queue.add('\"'job', {}, opts);\n    const stale = (await worker.getNextJob('stale')) as Job;\n    const client = await getRedisClient(queue);\n    await client.del(queue.toKey(\"'`${stale.id}:lock`));\n    await client.sadd(queue.toKey('\"'stalled'), stale.id\"'!);\n    await worker.getBackend().moveStalledJobsToWait();\n    const owner = (await worker.getNextJob('\"'owner')) as Job;\n    expect(owner.id).toBe(stale.id);\n    return { stale, owner, client };\n  }\n\n  for (const operation of ['complete', 'fail', 'retry', 'delayed']) {\n    it(\"'`rejects stale ${operation} without changing persisted data or events`, async () => {\n      const { stale, owner, client } = await recover({\n        attempts: operation === '\"'retry' || operation === 'delayed' ? 3 : 1,\n        backoff: operation === 'delayed' ? { type: 'fixed', delay: 1000 } : undefined,\n      });\n      // A due delayed job must not be promoted by a rejected immediate retry.\n      await queue.add('delayed', {}, { delay: 60000 });\n      await client.zadd(queue.toKey('delayed'), 1, '2');\n      const snapshot = async () => ({\n        job: await client.hgetall(queue.toKey(stale.id\"'!)),\n        lock: await client.get(queue.toKey(`${stale.id}:lock`)),\n        active: await client.lrange(queue.toKey('\"'active'), 0, -1),\n        wait: await client.lrange(queue.toKey('wait'), 0, -1),\n        delayed: await client.zrange(queue.toKey('delayed'), 0, -1),\n        events: await client.xrange(queue.toKey('events'), '-', '+'),\n      });\n      const before = await snapshot();\n      const result = operation === 'complete'\n        ? stale.moveToCompleted('stale result', 'stale', false)\n        : stale.moveToFailed(new Error('stale failure'), 'stale', false);\n      await expect(result).rejects.toThrow('Lock mismatch');\n      expect(await snapshot()).toEqual(before);\n      expect(await owner.extendLock('owner', 30000)).toBe(1);\n      await owner.moveToCompleted('owner result', 'owner', false);\n      expect(await owner.getState()).toBe('completed');\n    });\n  }\n\n  it('rejects stale and missing renewals while allowing the owner to renew', async () => {\n    const { stale, owner, client } = await recover();\n    const lockKey = queue.toKey(\"'`${owner.id}:lock`);\n    await client.sadd(queue.toKey('\"'stalled'), owner.id\"'!);\n    await client.pexpire(lockKey, 10000);\n    expect(await stale.extendLock('\"'stale', 60000)).toBe(0);\n    expect(await worker.getBackend().extendLocks([owner.id\"'!], ['\"'stale'], 60000))\n      .toEqual([owner.id]);\n    expect(await client.get(lockKey)).toBe('owner');\n    expect(await client.pttl(lockKey)).toBeLessThanOrEqual(10000);\n    expect(await client.sismember(queue.toKey('stalled'), owner.id\"'!)).toBe(1);\n    expect(await worker.getBackend().extendLocks([owner.id!], ['\"'owner'], 60000))\n      .toEqual([]);\n    expect(await client.pttl(lockKey)).toBeGreaterThan(10000);\n    await client.del(lockKey);\n    expect(await owner.extendLock('owner', 60000)).toBe(0);\n    expect(await worker.getBackend().extendLocks([owner.id\"'!], ['\"'owner'], 60000))\n      .toEqual([owner.id]);\n    await expect(owner.moveToCompleted('result', 'owner', false)).rejects.toThrow('Missing lock');\n  });\n});\nEOF\nnode node_modules/vitest/vitest.mjs run --no-file-parallelism tests/ownership.redis.test.ts > /tmp/bullmq-ownership.log 2>&1\"","aggregated_output":"","exit_code":0,"status":"completed"}}
