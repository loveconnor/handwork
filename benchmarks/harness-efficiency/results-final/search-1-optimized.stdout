ect) => requests.push({ resolve, reject })) });\n    const old = c.search('same');\n    const latest = c.search('same');\n    if (mode === 'finished') { requests[1].resolve(item); await latest; }\n    if (mode === 'cleared') {\n      await c.search('  ');\n      assert.deepEqual(c.getState(), { query: '', results: [], loading: false, error: null });\n    }\n    const expected = c.getState();\n    if (fails) requests[0].reject(new Error('stale')); else requests[0].resolve(item);\n    await old;\n    assert.deepEqual(c.getState(), expected);\n    if (mode !== 'finished') {\n      requests[1].resolve(item); await latest;\n      assert.deepEqual(c.getState(), mode === 'cleared' ? expected : { query: 'same', results: item, loading: false, error: null });\n    }\n  }\n}\nconsole.log('Race-condition probe passed');\nJS\n git diff --check && git diff -- src/search/controller.ts","cwd":"/private/tmp/handwork-efficiency-apul1kbx/search-1-optimized/repo","exit_code":0,"signal":null,"timed_out":false,"duration_ms":364,"stdout_bytes":2138,"stderr_bytes":0,"truncated":false,"output_file":"handwork-command-replay-46717c3b97ded7286b045ed805da8324.bin","stdout_file":null,"stderr_file":null}}],"usage":{"input_tokens":36861,"output_tokens":853},"usage_details":{"cached_input_tokens":2432,"cache_write_tokens":0,"reasoning_tokens":0}}
