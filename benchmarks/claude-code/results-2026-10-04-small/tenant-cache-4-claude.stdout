e:'Delta',updatedAt:1},{id:'a3',organizationId:'org-a',name:'Gamma',updatedAt:2},{id:'b1',organizationId:'org-b',name:'Beta',updatedAt:7},{id:'b2',organizationId:'org-b',name:'Echo',updatedAt:5},{id:'b3',organizationId:'org-b',name:'Foxtrot',updatedAt:6}],\n     8\t};}\n=== tests/account.test.ts\n     1\timport test from 'node:test';\n     2\timport assert from 'node:assert/strict';\n     3\timport { createApp } from '../src/app.ts';\n     4\timport { sampleSeed } from '../src/seed.ts';\n     5\ttest('health and profile',()=>{const a=createApp(sampleSeed());assert.deepEqual(a.request({method:'GET',path:'/health'}).body,{status:'ok'});assert.equal((a.request({method:'GET',path:'/me',token:'alice'}).body as any).id,'alice');});\n     6\ttest('organizations scoped to user',()=>{const a=createApp(sampleSeed());assert.deepEqual((a.request({method:'GET',path:'/organizations',token:'alice'}).body as any).items.map((o:any)=>o.id),['org-a']);});\n     7\ttest('logout revokes session',()=>{const a=createApp(sampleSeed());assert.equal(a.request({method:'DELETE',path:'/session',token:'alice'}).status,204);assert.equal(a.request({method:'GET',path:'/me',token:'alice'}).status,401);});\n=== tests/projects.test.ts\n     1\timport test from 'node:test';\n     2\timport assert from 'node:assert/strict';\n     3\timport { createApp } from '../src/app.ts';\n     4\timport { sampleSeed } from '../src/seed.ts';\n     5\ttest('authenticated detail',()=>{const a=createApp(sampleSeed());assert.equal(a.request({method:'GET',path:'/projects/a1',token:'alice'}).status,200);});\n     6\ttest('authenticated list',()=>{const a=createApp(sampleSeed());const r=a.request({method:'GET',path:'/organizations/org-a/projects',token:'alice'});assert.equal(r.status,200);assert.equal((r.body as any).items.length,3);});\n     7\ttest('update then read',()=>{const a=createApp(sampleSeed());assert.equal(a.request({method:'PATCH',path:'/projects/a1',token:'alice',body:{name:'New'}}).status,200);assert.equal((a.request({method:'GET',path:'/projects/a1',token:'alice'}).body as any).name,'New');});\n     8\ttest('anonymous request rejected',()=>{const a=createApp(sampleSeed());assert.deepEqual(a.request({method:'GET',path:'/projects/a1'}),{status:401,body:{error:'unauthorized'}});});\n     9\ttest('invalid update rejected',()=>{const a=createApp(sampleSeed());assert.equal(a.request({method:'PATCH',path:'/projects/a1',token:'alice',body:{name:''}}).status,400);});","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
