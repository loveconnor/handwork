, ...patch };\n@@ -29,21 +30,24 @@\n       listener(getState());\n       return () => { listeners.delete(listener); };\n     },\n     async search(query) {\n+      const requestId = ++latestRequestId;\n       const normalized = query.trim();\n       if (!normalized) {\n         update({ query: '', results: [], loading: false, error: null });\n         return;\n       }\n       update({ query: normalized, loading: true, error: null });\n       try {\n         const results = await api.search(normalized);\n-        update({ results });\n+        if (requestId === latestRequestId) update({ results });\n       } catch (error) {\n-        update({ error: error instanceof Error ? error.message : String(error) });\n+        if (requestId === latestRequestId) {\n+          update({ error: error instanceof Error ? error.message : String(error) });\n+        }\n       } finally {\n-        update({ loading: false });\n+        if (requestId === latestRequestId) update({ loading: false });\n       }\n     },\n   };\n }\n\n","files":[{"filePath":"/private/tmp/handwork-search-benchmark-d5rjswig/3-3-opencode/repo/src/search/controller.ts","relativePath":"src/search/controller.ts","type":"update","patch":"Index: /private/tmp/handwork-search-benchmark-d5rjswig/3-3-opencode/repo/src/search/controller.ts\n===================================================================\n--- /private/tmp/handwork-search-benchmark-d5rjswig/3-3-opencode/repo/src/search/controller.ts\n+++ /private/tmp/handwork-search-benchmark-d5rjswig/3-3-opencode/repo/src/search/controller.ts\n@@ -14,8 +14,9 @@\n }\n \n export function createSearchController(api: SearchApi): SearchController {\n   let state: SearchState = { query: '', results: [], loading: false, error: null };\n+  let latestRequestId = 0;\n   const listeners = new Set<(state: SearchState) => void>();\n   const getState = (): SearchState => ({ ...state, results: [...state.results] });\n   const update = (patch: Partial<SearchState>): void => {\n     state = { ...state, ...patch };\n@@ -29,21 +30,24 @@\n       listener(getState());\n       return () => { listeners.delete(listener); };\n     },\n     async search(query) {\n+      const requestId = ++latestRequestId;\n       const normalized = query.trim();\n       if (!normalized) {\n         update({ query: '', results: [], loading: false, error: null });\n         return;\n       }\n       update({ query: normalized, loading: true, error: null });\n       try {\n         const results = await api.search(normalized);\n-        update({ results });\n+        if (requestId === latestRequestId) update({ results });\n       } catch (error) {\n-        update({ error: error instanceof Error ? error.message : String(error) });\n+        if (requestId === latestRequestId) {\n+          update({ error: error instanceof Error ? error.message : String(error) });\n+        }\n       } finally {\n-        update({ loading: false });\n+        if (requestId === latestRequestId) update({ loading: false });\n       }\n     },\n   };\n }\n","additions":7,"deletions":3}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nM src/search/controller.ts","time":{"start":1789170549415,"end":1789170549421}},"metadata":{"openai":{"itemId":"fc_035c5d34bcdf3a4c016aa4936e103887d1bdda04f863936cca"}},"id":"prt_092dfe635001GsVfBvqcKii7la","sessionID":"ses_f6d20faf0ffeMlzoL19Zt487uW","messageID":"msg_092dfd701001ixASgkxqKSsGKE"}}
