{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/project-isolation.test.ts <<'EOF'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { createApp } from '../src/app.ts';\nimport { createCache } from '../src/cache/project-cache.ts';\nimport { sampleSeed } from '../src/seed.ts';\n\nconst forbidden={status:403,body:{error:'forbidden'}};\n\ntest('nonmembers cannot read or update projects, spoof ownership, or change caches',()=>{\n  const cache=createCache(),app=createApp(sampleSeed(),cache);\n  app.request({method:'GET',path:'/organizations/org-b/projects',token:'bob'});\n  const storage=structuredClone(app.db.projects);\n  const keys=cache.keys(),metrics={...cache.metrics};\n  assert.deepEqual(app.request({method:'GET',path:'/projects/b1',token:'alice',query:{organizationId:'org-a'}}),forbidden);\n  for(const body of [{name:'Stolen',organizationId:'org-a'},{name:''}]) {\n    assert.deepEqual(app.request({method:'PATCH',path:'/projects/b1',token:'alice',body}),forbidden);\n  }\n  assert.deepEqual(app.request({method:'GET',path:'/organizations/org-b/projects',token:'alice'}),forbidden);\n  assert.deepEqual(app.db.projects,storage);\n  assert.equal(app.db.counters.projectUpdates,0);\n  assert.deepEqual(cache.keys(),keys);\n  assert.deepEqual(cache.metrics,metrics);\n  assert.deepEqual(app.request({method:'GET',path:'/projects/missing',token:'alice'}),{status:404,body:{error:'not_found'}});\n});\n\ntest('membership revocation blocks warmed lists and project access immediately',()=>{\n  const cache=createCache(),app=createApp(sampleSeed(),cache);\n  const request={method:'GET',path:'/organizations/org-a/projects',token:'alice'};\n  assert.equal(app.request(request).status,200);\n  const metrics={...cache.metrics};\n  app.db.memberships.delete(JSON.stringify(['alice','org-a']));\n  assert.deepEqual(app.request(request),forbidden);\n  assert.deepEqual(app.request({method:'GET',path:'/projects/a1',token:'alice'}),forbidden);\n  assert.deepEqual(app.request({method:'PATCH',path:'/projects/a1',token:'alice',body:{name:'No'}}),forbidden);\n  assert.deepEqual(cache.metrics,metrics);\n  assert.equal(app.db.counters.projectUpdates,0);\n  assert.equal(app.db.counters.projectLists,1);\n});\n\ntest('organization switching preserves every list variant and updates invalidate only owning lists',()=>{\n  const seed=sampleSeed();\n  // Prefixes and delimiter-like punctuation must not merge cache groups.\n  const organizations=['org','org:child','org\\\":1:10:name:asc','org%3Achild'];\n  for(const id of organizations) {\n    seed.organizations.push({id,name:id});\n    seed.memberships.push({userId:'both',organizationId:id});\n    seed.projects.push({id:\"'`${id}-project`,organizationId:id,name:'\"'Extra',updatedAt:1});\n  }\n  const app=createApp(seed);\n  const requests=[];\n  for(const organizationId of ['org-a','org-b',...organizations]) {\n    for(const page of ['1','2']) for(const pageSize of ['1','2']) {\n      for(const sort of ['name','updatedAt']) for(const direction of ['asc','desc']) {\n        requests.push({method:'GET',path:\"'`/organizations/${organizationId}/projects`,token:'\"'both',query:{page,pageSize,sort,direction}});\n      }\n    }\n  }\n  const expected=(request:typeof requests[number])=>{\n    const reference=createApp({...seed,projects:[...app.db.projects.values()]});\n    return reference.request(request);\n  };\n  for(const request of requests) assert.deepEqual(app.request(request),expected(request));\n  assert.equal(app.db.counters.projectLists,requests.length);\n  for(const request of requests) assert.deepEqual(app.request(request),expected(request));\n  assert.equal(app.db.counters.projectLists,requests.length);\n\n  for(const [projectId,organizationId] of [['a1','org-a'],['org-project','org']]) {\n    assert.equal(app.request({method:'PATCH',path:\"'`/projects/${projectId}`,token:'\"'both',body:{name:' Zulu ',organizationId:'org-b'}}).status,200);\n    assert.equal(app.db.projects.get(projectId)\"'!.organizationId,organizationId);\n    assert.equal(app.db.projects.get(projectId)!.name,'\"'Zulu');\n    const before=app.db.counters.projectLists;\n    const affected=requests.filter(r=>r.path===\"'`/organizations/${organizationId}/projects`);\n    for(const request of requests.filter(r=>!affected.includes(r))) assert.deepEqual(app.request(request),expected(request));\n    assert.equal(app.db.counters.projectLists,before);\n    for(const request of affected) assert.deepEqual(app.request(request),expected(request));\n    assert.equal(app.db.counters.projectLists,before+affected.length);\n    for(const request of affected) assert.deepEqual(app.request(request),expected(request));\n    assert.equal(app.db.counters.projectLists,before+affected.length);\n  }\n});\nEOF\nnpm test'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/project-isolation.test.ts <<'EOF'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { createApp } from '../src/app.ts';\nimport { createCache } from '../src/cache/project-cache.ts';\nimport { sampleSeed } from '../src/seed.ts';\n\nconst forbidden={status:403,body:{error:'forbidden'}};\n\ntest('nonmembers cannot read or update projects, spoof ownership, or change caches',()=>{\n  const cache=createCache(),app=createApp(sampleSeed(),cache);\n  app.request({method:'GET',path:'/organizations/org-b/projects',token:'bob'});\n  const storage=structuredClone(app.db.projects);\n  const keys=cache.keys(),metrics={...cache.metrics};\n  assert.deepEqual(app.request({method:'GET',path:'/projects/b1',token:'alice',query:{organizationId:'org-a'}}),forbidden);\n  for(const body of [{name:'Stolen',organizationId:'org-a'},{name:''}]) {\n    assert.deepEqual(app.request({method:'PATCH',path:'/projects/b1',token:'alice',body}),forbidden);\n  }\n  assert.deepEqual(app.request({method:'GET',path:'/organizations/org-b/projects',token:'alice'}),forbidden);\n  assert.deepEqual(app.db.projects,storage);\n  assert.equal(app.db.counters.projectUpdates,0);\n  assert.deepEqual(cache.keys(),keys);\n  assert.deepEqual(cache.metrics,metrics);\n  assert.deepEqual(app.request({method:'GET',path:'/projects/missing',token:'alice'}),{status:404,body:{error:'not_found'}});\n});\n\ntest('membership revocation blocks warmed lists and project access immediately',()=>{\n  const cache=createCache(),app=createApp(sampleSeed(),cache);\n  const request={method:'GET',path:'/organizations/org-a/projects',token:'alice'};\n  assert.equal(app.request(request).status,200);\n  const metrics={...cache.metrics};\n  app.db.memberships.delete(JSON.stringify(['alice','org-a']));\n  assert.deepEqual(app.request(request),forbidden);\n  assert.deepEqual(app.request({method:'GET',path:'/projects/a1',token:'alice'}),forbidden);\n  assert.deepEqual(app.request({method:'PATCH',path:'/projects/a1',token:'alice',body:{name:'No'}}),forbidden);\n  assert.deepEqual(cache.metrics,metrics);\n  assert.equal(app.db.counters.projectUpdates,0);\n  assert.equal(app.db.counters.projectLists,1);\n});\n\ntest('organization switching preserves every list variant and updates invalidate only owning lists',()=>{\n  const seed=sampleSeed();\n  // Prefixes and delimiter-like punctuation must not merge cache groups.\n  const organizations=['org','org:child','org\\\":1:10:name:asc','org%3Achild'];\n  for(const id of organizations) {\n    seed.organizations.push({id,name:id});\n    seed.memberships.push({userId:'both',organizationId:id});\n    seed.projects.push({id:\"'`${id}-project`,organizationId:id,name:'\"'Extra',updatedAt:1});\n  }\n  const app=createApp(seed);\n  const requests=[];\n  for(const organizationId of ['org-a','org-b',...organizations]) {\n    for(const page of ['1','2']) for(const pageSize of ['1','2']) {\n      for(const sort of ['name','updatedAt']) for(const direction of ['asc','desc']) {\n        requests.push({method:'GET',path:\"'`/organizations/${organizationId}/projects`,token:'\"'both',query:{page,pageSize,sort,direction}});\n      }\n    }\n  }\n  const expected=(request:typeof requests[number])=>{\n    const reference=createApp({...seed,projects:[...app.db.projects.values()]});\n    return reference.request(request);\n  };\n  for(const request of requests) assert.deepEqual(app.request(request),expected(request));\n  assert.equal(app.db.counters.projectLists,requests.length);\n  for(const request of requests) assert.deepEqual(app.request(request),expected(request));\n  assert.equal(app.db.counters.projectLists,requests.length);\n\n  for(const [projectId,organizationId] of [['a1','org-a'],['org-project','org']]) {\n    assert.equal(app.request({method:'PATCH',path:\"'`/projects/${projectId}`,token:'\"'both',body:{name:' Zulu ',organizationId:'org-b'}}).status,200);\n    assert.equal(app.db.projects.get(projectId)\"'!.organizationId,organizationId);\n    assert.equal(app.db.projects.get(projectId)!.name,'\"'Zulu');\n    const before=app.db.counters.projectLists;\n    const affected=requests.filter(r=>r.path===\"'`/organizations/${organizationId}/projects`);\n    for(const request of requests.filter(r=>!affected.includes(r))) assert.deepEqual(app.request(request),expected(request));\n    assert.equal(app.db.counters.projectLists,before);\n    for(const request of affected) assert.deepEqual(app.request(request),expected(request));\n    assert.equal(app.db.counters.projectLists,before+affected.length);\n    for(const request of affected) assert.deepEqual(app.request(request),expected(request));\n    assert.equal(app.db.counters.projectLists,before+affected.length);\n  }\n});\nEOF\nnpm test'","aggregated_output":"✔ health and profile (0.835792ms)\n✔ organizations scoped to user (0.137625ms)\n✔ logout revokes session (0.10925ms)\n✔ nonmembers cannot read or update projects, spoof ownership, or change caches (5.94925ms)\n✔ membership revocation blocks warmed lists and project access immediately (0.145667ms)\n✖ organization switching preserves every list variant and updates invalidate only owning lists (3.11ms)\n✔ authenticated detail (0.597292ms)\n✔ authenticated list (6.133709ms)\n✔ update then read (0.234ms)\n✔ anonymous request rejected (0.507792ms)\n✔ invalid update rejected (0.099666ms)\nℹ tests 11\nℹ suites 0\nℹ pass 10\nℹ fail 1\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 91.083458\n\n✖ failing tests:\n\ntest at tests/project-isolation.test.ts:40:1\n✖ organization switching preserves every list variant and updates invalidate only owning lists (3.11ms)\n  AssertionError [ERR_ASSERTION]: Expected values to be strictly equal:\n  \n  80 !== 96\n  \n      at TestContext.<anonymous> (file:///private/tmp/handwork-fair-2tip6hsn/tenant-cache-3-codex/repo/tests/project-isolation.test.ts:63:10)\n      at Test.