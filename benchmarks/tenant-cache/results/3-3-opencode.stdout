tries(seed.sessions)),\n    counters: { projectReads: 0, projectLists: 0, projectUpdates: 0 },\n  };\n}\nexport type Database = ReturnType<typeof createDatabase>;","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/handwork-tenant-benchmark-4znq2rjy/3-3-opencode/repo/src/db/database.ts","text":"import type { Project, Organization, User } from '../types.ts';\nexport type Seed = { projects: Project[]; organizations: Organization[]; users: User[]; memberships: {userId:string; organizationId:string}[]; sessions: Record<string,string> };\nexport function createDatabase(seed: Seed) {\n  return {\n    projects: new Map(seed.projects.map(p => [p.id, structuredClone(p)])),\n    organizations: new Map(seed.organizations.map(o => [o.id, {...o}])),\n    users: new Map(seed.users.map(u => [u.id, {...u}])),\n    memberships: new Set(seed.memberships.map(m => JSON.stringify([m.userId,m.organizationId]))),\n    sessions: new Map(Object.entries(seed.sessions)),\n    counters: { projectReads: 0, projectLists: 0, projectUpdates: 0 },\n  };\n}\nexport type Database = ReturnType<typeof createDatabase>;","lineStart":1,"lineEnd":13,"totalLines":13,"truncated":false}},"title":"src/db/database.ts","time":{"start":1789175969482,"end":1789175969491}},"metadata":{"openai":{"itemId":"fc_0b3c7993f57b05a3016aa4a8a150b487d1b4d3080e2633822d"}},"id":"prt_09332b6c80016mQ3GD8XJq7biQ","sessionID":"ses_f6ccebb5dffej1yBvOjg8rAq7i","messageID":"msg_09332912b0011KXyRb2yKtF945"}}
