{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'moveStalledJobsToWait|extendLocks|extendJobLocks' src/classes/worker.ts src/scripts* src -g '*.ts' | head -35; head -65 tests/job.redis.test.ts; rg -n 'getNextJob|moveToFailed|moveToCompleted' tests/job.redis.test.ts | head; rg -n 'moveStalledJobsToWait' src\"","aggregated_output":"src/classes/worker.ts:414:  async extendJobLocks(\nsrc/classes/worker.ts:419:    return this.backend.extendLocks(jobIds, tokens, duration);\nsrc/classes/worker.ts:1379:      await this.checkConnectionError(() => this.moveStalledJobsToWait());\nsrc/classes/worker.ts:1454:  private async moveStalledJobsToWait() {\nsrc/classes/worker.ts:1457:      'moveStalledJobsToWait',\nsrc/classes/worker.ts:1460:        const stalled = await this.backend.moveStalledJobsToWait();\nsrc/scripts/moveStalledJobsToWait-9.ts:182:export const moveStalledJobsToWait = {\nsrc/scripts/moveStalledJobsToWait-9.ts:183:  name: 'moveStalledJobsToWait',\nsrc/interfaces/queue-backend.ts:368:  moveStalledJobsToWait(): Promise<string[]>;\nsrc/interfaces/queue-backend.ts:436:  extendLocks(\nsrc/scripts/index.ts:12:export * from './extendLocks-1';\nsrc/scripts/index.ts:28:export * from './moveStalledJobsToWait-9';\nsrc/classes/worker.ts:414:  async extendJobLocks(\nsrc/classes/worker.ts:419:    return this.backend.extendLocks(jobIds, tokens, duration);\nsrc/classes/worker.ts:1379:      await this.checkConnectionError(() => this.moveStalledJobsToWait());\nsrc/classes/worker.ts:1454:  private async moveStalledJobsToWait() {\nsrc/classes/worker.ts:1457:      'moveStalledJobsToWait',\nsrc/classes/worker.ts:1460:        const stalled = await this.backend.moveStalledJobsToWait();\nsrc/classes/lock-manager.ts:46:  protected async extendLocks(jobIds: string[]): Promise<void> {\nsrc/classes/lock-manager.ts:49:      'extendLocks',\nsrc/classes/lock-manager.ts:63:          const erroredJobIds = await this.worker.extendJobLocks(\nsrc/classes/lock-manager.ts:121:          await this.extendLocks(jobsToExtend);\nsrc/interfaces/lock-manager-worker-context.ts:12:  extendJobLocks(\nsrc/classes/redis-queue-backend.ts:1033:  async extendLocks(\nsrc/classes/redis-queue-backend.ts:1048:    return this.execCommand(client, 'extendLocks', args);\nsrc/classes/redis-queue-backend.ts:2090:  protected moveStalledJobsToWaitArgs(): (string | number)[] {\nsrc/classes/redis-queue-backend.ts:2122:  async moveStalledJobsToWait(): Promise<string[]> {\nsrc/classes/redis-queue-backend.ts:2125:    const args = this.moveStalledJobsToWaitArgs();\nsrc/classes/redis-queue-backend.ts:2127:    return this.execCommand(client, 'moveStalledJobsToWait', args);\nsrc/scripts/extendLocks-1.ts:42:export const extendLocks = {\nsrc/scripts/extendLocks-1.ts:43:  name: 'extendLocks',\nsrc/postgres/postgres-queue-backend.ts:1077:  async moveStalledJobsToWait(): Promise<string[]> {\nsrc/postgres/postgres-queue-backend.ts:1189:  async extendLocks(\n'use strict';\n\n/**\n * Redis-only tests for `Job`.\n *\n * These exercise Redis-specific internals (raw job/dependency hashes, the\n * `:processed` set, deleting the meta key, low-level `addJob` with a client)\n * that have no backend-agnostic equivalent. They live in a dedicated\n * `*.redis.test.ts` suite excluded from the cross-backend runs.\n */\nimport { getRedisClient } from './utils/get-redis-client';\nimport {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\n\nimport { Job, Queue, Worker } from '../src/classes';\nimport {\n  delay,\n  getParentKey,\n  randomUUID,\n  removeAllQueueData,\n} from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { IRedisClient } from '../src/interfaces';\n\ndescribe('Job (redis-only)', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n\n  let queue: Queue;\n  let queueName: string;\n  let connection: IRedisClient;\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n  });\n\n  afterEach(async () => {\n    await queue.close();\n    await removeAllQueueData(createTestConnection(), queueName);\n  });\n\n  afterAll(async function () {\n    await connection.quit();\n  });\n\n  describe('.remove', () => {\n    it('removes processed hash', async () => {\n      const client = await getRedisClient(queue);\n      const values = [{ idx: 0, bar: 'something' }];\n      const token = 'my-token';\n      const token2 = 'my-token2';\n      const parentQueueName = `parent-queue-${randomUUID()}`;\n\n      const parentQueue = new Queue(parentQueueName, { connection, prefix });\n      const parentWorker = new Worker(parentQueueName, null, {\n82:      const job = (await parentWorker.getNextJob(token)) as Job;\n83:      const child1 = (await childrenWorker.getNextJob(token2)) as Job;\n88:      await child1.moveToCompleted('return value', token2);\n91:      await job.moveToCompleted('return value', token);\n110:  describe('.moveToCompleted', () => {\n119:      const job = (await worker.getNextJob(token)) as Job;\n122:      await job.moveToCompleted('done', '0', false);\n169:      const job = (await parentWorker.getNextJob(token)) as Job;\n177:      await expect(job.moveToCompleted('return value', token)).rejects.toThrow(\n198:  describe('.moveToFailed', () => {\nsrc/interfaces/queue-backend.ts:368:  moveStalledJobsToWait(): Promise<string[]>;\nsrc/postgres/postgres-queue-backend.ts:1077:  async moveStalledJobsToWait(): Promise<string[]> {\nsrc/classes/worker.ts:1379:      await this.checkConnectionError(() => this.moveStalledJobsToWait());\nsrc/classes/worker.ts:1454:  private async moveStalledJobsToWait() {\nsrc/classes/worker.ts:1457:      'moveStalledJobsToWait',\nsrc/classes/worker.ts:1460:        const stalled = await this.backend.moveStalledJobsToWait();\nsrc/postgres/