{"type":"tool_use","timestamp":1789782733207,"sessionID":"ses_f48a39245ffey7PBbEFyhaW1Ud","part":{"type":"tool","tool":"bash","callID":"call_8IRjiL6CEr35zOvFSBoS3kDr","state":{"status":"completed","input":{"command":"git diff --check && git diff -- src/search/controller.ts"},"output":"diff --git a/src/search/controller.ts b/src/search/controller.ts\nindex d6ab5ca..42247e8 100644\n--- a/src/search/controller.ts\n+++ b/src/search/controller.ts\n@@ -15,6 +15,7 @@ export interface SearchController {\n \n export function createSearchController(api: SearchApi): SearchController {\n   let state: SearchState = { query: '', results: [], loading: false, error: null };\n+  let searchVersion = 0;\n   const listeners = new Set<(state: SearchState) => void>();\n   const getState = (): SearchState => ({ ...state, results: [...state.results] });\n   const update = (patch: Partial<SearchState>): void => {\n@@ -30,6 +31,7 @@ export function createSearchController(api: SearchApi): SearchController {\n       return () => { listeners.delete(listener); };\n     },\n     async search(query) {\n+      const version = ++searchVersion;\n       const normalized = query.trim();\n       if (!normalized) {\n         update({ query: '', results: [], loading: false, error: null });\n@@ -38,11 +40,13 @@ export function createSearchController(api: SearchApi): SearchController {\n       update({ query: normalized, loading: true, error: null });\n       try {\n         const results = await api.search(normalized);\n-        update({ results });\n+        if (version === searchVersion) update({ results });\n       } catch (error) {\n-        update({ error: error instanceof Error ? error.message : String(error) });\n+        if (version === searchVersion) {\n+          update({ error: error instanceof Error ? error.message : String(error) });\n+        }\n       } finally {\n-        update({ loading: false });\n+        if (version === searchVersion) update({ loading: false });\n       }\n     },\n   };\n","metadata":{"output":"diff --git a/src/search/controller.ts b/src/search/controller.ts\nindex d6ab5ca..42247e8 100644\n--- a/src/search/controller.ts\n+++ b/src/search/controller.ts\n@@ -15,6 +15,7 @@ export interface SearchController {\n \n export function createSearchController(api: SearchApi): SearchController {\n   let state: SearchState = { query: '', results: [], loading: false, error: null };\n+  let searchVersion = 0;\n   const listeners = new Set<(state: SearchState) => void>();\n   const getState = (): SearchState => ({ ...state, results: [...state.results] });\n   const update = (patch: Partial<SearchState>): void => {\n@@ -30,6 +31,7 @@ export function createSearchController(api: SearchApi): SearchController {\n       return () => { listeners.delete(listener); };\n     },\n     async search(query) {\n+      const version = ++searchVersion;\n       const normalized = query.trim();\n       if (!normalized) {\n         update({ query: '', results: [], loading: false, error: null });\n@@ -38,11 +40,13 @@ export function createSearchController(api: SearchApi): SearchController {\n       update({ query: normalized, loading: true, error: null });\n       try {\n         const results = await api.search(normalized);\n-        update({ results });\n+        if (version === searchVersion) update({ results });\n       } catch (error) {\n-        update({ error: error instanceof Error ? error.message : String(error) });\n+        if (version === searchVersion) {\n+          update({ error: error instanceof Error ? error.message : String(error) });\n+        }\n       } finally {\n-        update({ loading: false });\n+        if (version === searchVersion) update({ loading: false });\n       }\n     },\n   };\n","exit":0,"truncated":false},"title":"git diff --check && git diff -- src/search/controller.ts","time":{"start":1789782733183,"end":1789782733207}},"metadata":{"openai":{"itemId":"fc_05960ce3271e6525016aadeacd0e3c87d1a150364a98384855"}},"id":"prt_0b75d3