{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017WMuA37JW2sgsEFeqV34cQ","type":"tool_result","content":"          metaKey, KEYS[2], KEYS[1], KEYS[8], KEYS[14], KEYS[3], KEYS[10],\n          KEYS[7], timestamp)\n    end\n\n    -- If job has a parent we need to\n    -- 1) remove this job id from parents dependencies\n    -- 2) move the job Id to parent \"processed\" set\n    -- 3) push the results into parent \"results\" list\n    -- 4) if parent's dependencies is empty, then move parent to \"wait/paused\". Note it may be a different queue!.\n    if parentId == \"\" and parentKey ~= \"\" then\n        parentId = getJobIdFromKey(parentKey)\n        parentQueueKey = getJobKeyPrefix(parentKey, \":\" .. parentId)\n    end\n\n    if parentId ~= \"\" then\n        if ARGV[5] == \"completed\" then\n            local dependenciesSet = parentKey .. \":dependencies\"\n            if rcall(\"SREM\", dependenciesSet, jobIdKey) == 1 then\n                updateParentDepsIfNeeded(parentKey, parentQueueKey, dependenciesSet, parentId, jobIdKey, ARGV[4],\n                    timestamp)\n            end\n        else\n            moveChildFromDependenciesIfNeeded(jobAttributes[2], jobIdKey, ARGV[4], timestamp)\n        end\n    end\n\n    local attemptsMade = rcall(\"HINCRBY\", jobIdKey, \"atm\", 1)\n\n    -- Remove job?\n    if maxCount ~= 0 then\n        local targetSet = KEYS[11]\n        -- Add to complete/failed set\n        rcall(\"ZADD\", targetSet, timestamp, jobId)\n        rcall(\"HSET\", jobIdKey, ARGV[3], ARGV[4], \"finishedOn\", timestamp)\n        -- \"returnvalue\" / \"failedReason\" and \"finishedOn\"\n\n        if ARGV[5] == \"failed\" then\n            rcall(\"HDEL\", jobIdKey, \"defa\")\n        end\n\n        -- Remove old jobs?\n        if maxAge ~= nil then\n            removeJobsByMaxAge(timestamp, maxAge, targetSet, prefix, maxLimit)\n        end\n\n        if maxCount ~= nil and maxCount > 0 then\n            removeJobsByMaxCount(maxCount, targetSet, prefix)\n        end\n    else\n        removeJobKeys(jobIdKey)\n        if parentKey ~= \"\" then\n            -- TODO: when a child is removed when finished, result or failure in parent\n            -- must not be deleted, those value references should be deleted when the parent\n            -- is deleted\n            removeParentDependencyKey(jobIdKey, false, parentKey, jobAttributes[3])\n        end\n    end\n\n    rcall(\"XADD\", eventStreamKey, \"*\", \"event\", ARGV[5], \"jobId\", jobId, ARGV[3], ARGV[4], \"prev\", \"active\")\n\n    if ARGV[5] == \"failed\" then\n        if tonumber(attemptsMade) >= tonumber(attempts) then\n            rcall(\"XADD\", eventStreamKey, \"*\", \"event\", \"retries-exhausted\", \"jobId\", jobId, \"attemptsMade\",\n                attemptsMade)\n        end\n    end\n\n    -- Collect metrics\n    if maxMetricsSize ~= \"\" then\n        collectMetrics(KEYS[13], KEYS[13] .. ':data', maxMetricsSize, timestamp)\n    end\n\n    -- Try to get next job to avoid an extra roundtrip if the queue is not closing,\n    -- and not rate limited.\n    if (ARGV[6] == \"1\") then\n        local result = fetchNextJob(KEYS[1], KEYS[2], KEYS[3], eventStreamKey,\n            KEYS[6], KEYS[7], metaKey, KEYS[10], KEYS[14], prefix,\n            timestamp, opts)\n        if result then\n            return result\n        end\n    end\n\n    local waitLen = rcall(\"LLEN\", KEYS[1])\n    if waitLen == 0 then\n        local activeLen = rcall(\"LLEN\", KEYS[2])\n\n        if activeLen == 0 then\n            local prioritizedLen = rcall(\"ZCARD\", KEYS[3])\n\n            if prioritizedLen == 0 then\n                rcall(\"XADD\", eventStreamKey, \"*\", \"event\", \"drained\")\n            end\n        end\n    end\n\n    return 0\nelse\n    return -1\nend\n--[[\n  Function to move job from wait state to active.\n  Input:\n    opts - token - lock token\n    opts - lockDuration\n    opts - limiter\n]]\n\n-- Includes\n--- @include \"addBaseMarkerIfNeeded\"\n\nlocal function prepareJobForProcessing(keyPrefix, rateLimiterKey, eventStreamKey,\n    jobId, processedOn, maxJobs, limiterDuration, markerKey, opts)\n  local jobKey = keyPrefix .. jobId\n\n  -- Check if we need to perform rate limiting.\n  if maxJobs then\n    local isDeferredFailure = rcall(\"HEXISTS\", jobKey, \"defa\") == 1\n\n    if not isDeferredFailure then\n      local jobCounter = tonumber(rcall(\"INCR\", rateLimiterKey))\n      if jobCounter == 1 then\n        local integerDuration = math.floor(math.abs(limiterDuration))\n        rcall(\"PEXPIRE\", rateLimiterKey, integerDuration)\n      end\n    end\n  end\n\n  -- get a lock\n  if opts['token'] ~= \"0\" then\n    local lockKey = jobKey .. ':lock'\n    rcall(\"SET\", lockKey, opts['token'], \"PX\", opts['lockDuration'])\n  end\n\n  local optionalValues = {}\n\n  if opts['name'] then\n    -- Set \"processedBy\" field to the worker name\n    table.insert(optionalValues, \"pb\")\n    table.insert(optionalValues, opts['name'])\n  end\n\n  rcall(\"XADD\", eventStreamKey, \"*\", \"event\", \"active\", \"jobId\", jobId, \"prev\", \"waiting\")\n  rcall(\"HMSET\", jobKey, \"processedOn\", processedOn, unpack(optionalValues))\n  rcall(\"HINCRBY\", jobKey, \"ats\", 1)\n\n  addBaseMarkerIfNeeded(markerKey, false)\n\n  -- rate limit delay must be 0 in this case to prevent adding more delay\n  -- when job that is moved to active needs to be processed\n  return {rcall(\"HGETALL\", jobKey), jobId, 0, 0} -- get job data\nend\n--[[\n  Move stalled jobs to wait.\n\n    Input:\n      KEYS[1] 'stalled' (SET)\n      KEYS[2] 'wait',   (LIST)\n      KEYS[3] 'active', (LIST)\n      KEYS[4] 'stalled-check', (KEY)\n      KEYS[5] 'meta', (KEY)\n      KEYS[6] 'paused', (LIST)\n      KEYS[7] 'marker'\n      KEYS[8] 'event stream' (STREAM)\n      KEYS[9] 'repeat' key\n\n      ARGV[1]  Max stalled job count\n      ARGV[2]  queue.toKey('')\n      ARGV[3]  timestamp\n      ARGV[4]  max check time\n\n    Events:\n      'stalled' with stalled job id.\n]]\nlocal rcall = redis.call\n\n-- Includes\n--- @include \"includes/batches\"\n--- @include \"includes/moveJobToWait\"\n--- @include \"includes/trimEvents\"\n\nlocal stalledKey = KEYS[1]\nlocal waitKey = KEYS[2]\nlocal activeKey = KEYS[3]\nlocal stalledCheckKey = KEYS[4]\nlocal metaKey = KEYS[5]\nlocal pausedKey = KEYS[6]\nlocal markerKey = KEYS[7]\nlocal eventStreamKey = KEYS[8]\nlocal repeatKey = KEYS[9]\nlocal maxStalledJobCount = tonumber(ARGV[1])\nlocal queueKeyPrefix = ARGV[2]\nlocal timestamp = ARGV[3]\nlocal maxCheckTime = ARGV[4]\n\nif rcall(\"EXISTS\", stalledCheckKey) == 1 then\n    return {}\nend\n\nrcall(\"SET\", stalledCheckKey, timestamp, \"PX\", maxCheckTime)\n\n-- Trim events before emitting them to avoid trimming events emitted in this script\ntrimEvents(metaKey, eventStreamKey)\n\n-- Move all stalled jobs to wait\nlocal stalling = rcall('SMEMBERS', stalledKey)\nlocal stalled = {}\nif (#stalling > 0) then\n    rcall('DEL', stalledKey)\n\n    -- Remove from active list\n    for i, jobId in ipairs(stalling) do\n        -- Markers in waitlist DEPRECATED in v5: Remove in v6.\n        if string.sub(jobId, 1, 2) == \"0:\" then\n            -- If the jobId is a delay marker ID we just remove it.\n            rcall(\"LREM\", activeKey, 1, jobId)\n        else\n            local jobKey = queueKeyPrefix .. jobId\n\n            -- Check that the lock is also missing, then we can handle this job as really stalled.\n            if (rcall(\"EXISTS\", jobKey .. \":lock\") == 0) then\n                --  Remove from the active queue.\n                local removed = rcall(\"LREM\", activeKey, 1, jobId)\n\n                if (removed > 0) then\n                    -- If this job has been stalled too many times, such as if it crashes the worker, then fail it.\n                    local stalledCount = rcall(\"HINCRBY\", jobKey, \"stc\", 1)\n                    \n                    -- Check if this is a repeatable job by looking at job options\n                    local jobSchedulerId = rcall(\"HGET\", jobKey, \"rjk\")\n                    local isRepeatableJob = false\n                    if jobSchedulerId then\n                        local schedulerKey = repeatKey .. \":\" .. jobSchedulerId\n\n                        if rcall(\"EXISTS\", schedulerKey) == 1 then\n                            isRepeatableJob = true\n                        else\n                            -- TODO: remove this check in v6, as it is only needed for legacy repeatable jobs\n                            -- that stored the scheduler id in the job key but did not create the scheduler hash key\n                            local prevMillis = rcall(\"ZSCORE\", repeatKey, jobSchedulerId)\n                            if prevMillis then\n                                isRepeatableJob = true\n                            end\n                        end\n                    end\n                    \n                    -- Only fail job if it exceeds stall limit AND is not a repeatable job\n                    if stalledCount > maxStalledJobCount and not isRepeatableJob then\n                        local failedReason = \"job stalled more than allowable limit\"\n                        rcall(\"HSET\", jobKey, \"defa\", failedReason)\n                    end\n                    \n                    moveJobToWait(metaKey, activeKey, waitKey, pausedKey, markerKey, eventStreamKey, jobId,\n                        \"RPUSH\")\n\n                    -- Emit the stalled event\n                    rcall(\"XADD\", eventStreamKey, \"*\", \"event\", \"stalled\", \"jobId\", jobId)\n                    table.insert(stalled, jobId)\n                end\n            end\n        end\n    end\nend\n\n-- Mark potentially stalled jobs\nlocal active = rcall('LRANGE', activeKey, 0, -1)\n\nif (#active > 0) then\n    for from, to in batches(#active, 7000) do\n        rcall('SADD', stalledKey, unpack(active, from, to))\n    end\nend\n\nreturn stalled\n--[[\n  Function to update a bunch of fields in a job.\n]]\nlocal function updateJobFields(jobKey, msgpackedFields)\n  if msgpackedFields and #msgpackedFields > 0 then\n    local fieldsToUpdate = cmsgpack.unpack(msgpackedFields)\n    if fieldsToUpdate then\n      rcall(\"HMSET\", jobKey, unpack(fieldsToUpdate))\n    end\n  end\nend\n13:-- lock (held until commit), so parallel producers cannot make progress — by far\n15:-- `nextval`, which takes no transaction-scoped lock, so concurrent adds run in\n34:  -- Fast path once the sequence exists: a cached catalog lookup + a lock-free\n36:  -- advisory lock serializes those racing first-adds so exactly one issues the\n39:    PERFORM pg_advisory_xact_lock(hashtext('bullmq:jidseq:' || p_queue));\n79:  -- add and finish paths always take the locks in the same order (advisory then\n80:  -- the id-counter row), which rules out a deadlock with requeue's own INCR.\n83:    PERFORM pg_advisory_xact_lock(\n188:-- token when a job is claimed. Otherwise identical to the v23 definition.\n191:  p_token            text,\n192:  p_lock_ms          bigint,\n239:  -- advisory lock so concurrent workers cannot all pass the check and overshoot;\n244:    PERFORM pg_advisory_xact_lock(hashtext('bullmq:concurrency:' || p_queue));\n260:    -- worker's limiter check and its token consumption can never interleave with\n263:    -- counter < max, each claim a (distinct) job, and each consume a token —\n264:    -- overshooting the limit. A transaction-scoped advisory lock serializes the\n266:    -- effective check below then runs on a fresh snapshot that sees the token a\n267:    -- preceding worker just committed. The lock auto-releases at statement end\n270:    PERFORM pg_advisory_xact_lock(hashtext('bullmq:limiter:' || p_queue));\n280:   FOR UPDATE SKIP LOCKED\n287:  -- Consume a token now that a job is actually being claimed. Duration: the\n300:         lock_token = p_token,\n301:         locked_until_ms = p_now + p_lock_ms,\n316:-- next_delay: the timestamp of the next delayed job (for worker block timing),\n331:  p_token        text,\n343:  v_lock     text;\n351:  -- FKs — deletes this job's row and its dependency row while we lock those same\n352:  -- rows below (in the opposite order), deadlocking (SQLSTATE 40P01). Read the\n353:  -- parent first (unlocked, just for the key) and take the per-parent advisory\n354:  -- lock BEFORE any row lock, so a concurrent parent removal and this finish op\n360:    PERFORM pg_advisory_xact_lock(\n364:  SELECT state, lock_token, parent_queue, parent_id, dedup_id\n365:    INTO v_state, v_lock, v_pq, v_pid, v_dedup_id\n373:  IF p_token <> '0' AND v_lock IS DISTINCT FROM p_token THEN\n374:    RAISE EXCEPTION 'bullmq: job % lock mismatch', p_id USING ERRCODE = 'BM001', DETAIL = '-6';\n399:         lock_token = NULL,\n400:         locked_until_ms = NULL,\n410:  -- The per-parent advisory lock taken at the top of this function serializes\n412:  -- removal, so the decrement cannot deadlock on the parent row.\n438:    PERFORM pg_advisory_xact_lock(\n476:  p_token         text,\n489:  v_lock     text;\n495:  -- FK, its child-dependency rows. A child finishing concurrently locks that\n497:  -- deadlocks (SQLSTATE 40P01). Take the per-parent advisory lock (keyed on this\n499:  -- lock below, so the two serialize instead of racing. Mirrors Redis's\n501:  PERFORM pg_advisory_xact_lock(\n504:  SELECT state, lock_token, dedup_id INTO v_state, v_lock, v_dedup_id\n512:  IF p_token <> '0' AND v_lock IS DISTINCT FROM p_token THEN\n513:    RAISE EXCEPTION 'bullmq: job % lock mismatch', p_id USING ERRCODE = 'BM001', DETAIL = '-6';\n521:         lock_token = NULL,\n522:         locked_until_ms = NULL,\n546:    PERFORM pg_advisory_xact_lock(\n576:-- extend_lock: refresh an active job's lock if the token still holds it.\n577:-- Returns 1 on success, 0 if the lock was lost.\n579:CREATE FUNCTION extend_lock(\n582:  p_token    text,\n583:  p_lock_ms  bigint,\n593:     SET locked_until_ms = p_now + p_lock_ms\n597:     AND lock_token = p_token;\n607:  p_token         text,\n619:  v_lock  text;\n621:  SELECT state, lock_token INTO v_state, v_lock\n629:  IF p_token <> '0' AND v_lock IS DISTINCT FROM p_token THEN\n630:    RAISE EXCEPTION 'bullmq: job % lock mismatch', p_id USING ERRCODE = 'BM001', DETAIL = '-6';\n639:         lock_token = NULL,\n640:         locked_until_ms = NULL,\n661:  p_token         text,\n671:  v_lock  text;\n674:  SELECT state, lock_token INTO v_state, v_lock\n682:  IF p_token <> '0' AND v_lock IS DISTINCT FROM p_token THEN\n683:    RAISE EXCEPTION 'bullmq: job % lock mismatch', p_id USING ERRCODE = 'BM001', DETAIL = '-6';\n697:         lock_token = NULL,\n698:         locked_until_ms = NULL,\n785:-- stream read with a blocking XREAD; here events live in `event` (a\n786:-- globally-ordered id per insert) and blocking reads use LISTEN/NOTIFY on the\n810:    (extract(epoch FROM clock_timestamp()) * 1000)::bigint\n816:  -- lock at commit (to deliver notifications in commit order), so a NOTIFY on\n818:  -- lock — the dominant processing bottleneck under load (and it caps throughput\n819:  -- across *all* queues and processes, since the lock is global).\n821:  -- A per-queue, transaction-scoped try-lock collapses that: only one committer\n827:  -- fires. Under low concurrency (e.g. tests) the lock is always free, so every\n829:  IF pg_try_advisory_xact_lock(hashtext('bullmq:evnotify:' || p_queue)) THEN\n847:  -- into a stream of DELETEs that contend (and previously deadlocked) with the\n850:  -- non-blocking, per-queue advisory lock further ensures at most one trimmer\n854:    IF pg_try_advisory_xact_lock(hashtext('bullmq:evtrim:' || p_queue)) THEN\n911:    -- Wake any worker blocked in waitForJob (LISTEN bullmq_jobs): jobs that were\n914:    -- until its drainDelay times out. The Redis backend wakes the blocking\n1008:--     its still-pending descendants — is locked by a worker; the caller turns\n1009:--     this into the \"locked by another worker\" error;\n1025:  v_locked    boolean;\n1028:  v_now       bigint := (extract(epoch from clock_timestamp()) * 1000)::bigint;\n1044:  -- Lock check. A job cannot be removed while it is locked; with removeChildren\n1045:  -- the check recurses through still-pending descendants (mirrors isLocked()).\n1059:      WHERE j.lock_token IS NOT NULL AND j.locked_until_ms > v_now\n1060:    ) INTO v_locked;\n1062:    SELECT lock_token IS NOT NULL AND locked_until_ms > v_now INTO v_locked\n1066:  IF v_locked THEN\n1148:         lock_token = NULL,\n1149:         locked_until_ms = NULL\n1325:    -- paths: advisory lock taken before the id-counter INCR below).\n1327:      PERFORM pg_advisory_xact_lock(\n1462:    SELECT q, ev, dat, (extract(epoch FROM clock_timestamp()) * 1000)::bigint\n1468:    -- stream once (not per publish). A non-blocking advisory lock keeps at most\n1481:         AND pg_try_advisory_xact_lock(hashtext('bullmq:evtrim:' || v_queue))\n1563:  -- Wake any worker blocked on an older (longer) delay so it recomputes.\n1619:  p_queue text, p_id text, p_token text, p_now bigint\n1626:  v_lock     text;\n1631:  SELECT state, lock_token, priority INTO v_state, v_lock, v_priority\n1638:     AND (p_token = '0' OR v_lock IS NOT DISTINCT FROM p_token) THEN\n1648:           lock_token = NULL,\n1649:           locked_until_ms = NULL\n1748:  p_queue text, p_id text, p_token text\n1755:  v_lock    text;\n1758:  SELECT state, lock_token, pending_deps INTO v_state, v_lock, v_pending\n1773:  -- Lock check (mirrors removeLock, taken before the active-state check): a\n1774:  -- missing lock is -2, a mismatched one is -6; token '0' skips the check.\n1775:  IF p_token <> '0' THEN\n1776:    IF v_lock IS NULL THEN\n1777:      RAISE EXCEPTION 'bullmq: job % missing lock', p_id\n1779:    ELSIF v_lock <> p_token THEN","is_error":false}]},"parent_tool_use_id":null,"session_id":"d1897958-d059-4bf2-a643-0cfa35d14c6d","uuid":"ed9e0e1c-ba36-494f-b614-766dc9a435fd","timestamp":"2026-10-04T15:20:56.535Z","tool_use_result":{"stdout":"          metaKey, KEYS[2], KEYS[1], KEYS[8], KEYS[14], KEYS[3], KEYS[10],\n          KEYS[7], timestamp)\n    end\n\n    -- If job has a parent we need to\n    -- 1) remove this job id from parents dependencies\n    -- 2) move the job Id to parent \"processed\" set\n    -- 3) push the results into parent \"results\" list\n    -- 4) if parent's dependencies is empty, then move parent to \"wait/paused\". Note it may be a different queue!.\n    if parentId == \"\" and parentKey ~= \"\" then\n        parentId = getJobIdFromKey(parentKey)\n        parentQueueKey = getJobKeyPrefix(parentKey, \":\" .. parentId)\n    end\n\n    if parentId ~= \"\" then\n        if ARGV[5] == \"completed\" then\n            local dependenciesSet = parentKey .. \":dependencies\"\n            if rcall(\"SREM\", dependenciesSet, jobIdKey) == 1 then\n                updateParentDepsIfNeeded(parentKey, parentQueueKey, dependenciesSet, parentId, jobIdKey, ARGV[4],\n                    timestamp)\n            end\n        else\n            moveChildFromDependenciesIfNeeded(jobAttributes[2], jobIdKey, ARGV[4], timestamp)\n        end\n    end\n\n    local attemptsMade = rcall(\"HINCRBY\", jobIdKey, \"atm\", 1)\n\n    -- Remove job?\n    if maxCount ~= 0 then\n        local targetSet = KEYS[11]\n        -- Add to complete/failed set\n        rcall(\"ZADD\", targetSet, timestamp, jobId)\n        rcall(\"HSET\", jobIdKey, ARGV[3], ARGV[4], \"finishedOn\", timestamp)\n        -- \"returnvalue\" / \"failedReason\" and \"finishedOn\"\n\n        if ARGV[5] == \"failed\" then\n            rcall(\"HDEL\", jobIdKey, \"defa\")\n        end\n\n        -- Remove old jobs?\n        if maxAge ~= nil then\n            removeJobsByMaxAge(timestamp, maxAge, targetSet, prefix, maxLimit)\n        end\n\n        if maxCount ~= nil and maxCount > 0 then\n            removeJobsByMaxCount(maxCount, targetSet, prefix)\n        end\n    else\n        removeJobKeys(jobIdKey)\n        if parentKey ~= \"\" then\n            -- TODO: when a child is removed when finished, result or failure in parent\n            -- must not be deleted, those value references should be deleted when the parent\n            -- is deleted\n            removeParentDependencyKey(jobIdKey, false, parentKey, jobAttributes[3])\n        end\n    end\n\n    rcall(\"XADD\", eventStreamKey, \"*\", \"event\", ARGV[5], \"jobId\", jobId, ARGV[3], ARGV[4], \"prev\", \"active\")\n\n    if ARGV[5] == \"failed\" then\n        if tonumber(attemptsMade) >= tonumber(attempts) then\n            rcall(\"XADD\", eventStreamKey, \"*\", \"event\", \"retries-exhausted\", \"jobId\", jobId, \"attemptsMade\",\n                attemptsMade)\n        end\n    end\n\n    -- Collect metrics\n    if maxMetricsSize ~= \"\" then\n        collectMetrics(KEYS[13], KEYS[13] .. ':data', maxMetricsSize, timestamp)\n    end\n\n    -- Try to get next job to avoid an extra roundtrip if the queue is not closing,\n    -- and not rate limited.\n    if (ARGV[6] == \"1\") then\n        local result = fetchNextJob(KEYS[1], KEYS[2], KEYS[3], eventStreamKey,\n            KEYS[6], KEYS[7], metaKey, KEYS[10], KEYS[14], prefix,\n            timestamp, opts)\n        if result then\n            return result\n        end\n    end\n\n    local waitLen = rcall(\"LLEN\", KEYS[1])\n    if waitLen == 0 then\n        local activeLen = rcall(\"LLEN\", KEYS[2])\n\n        if activeLen == 0 then\n            local prioritizedLen = rcall(\"ZCARD\", KEYS[3])\n\n            if prioritizedLen == 0 then\n                rcall(\"XADD\", eventStreamKey, \"*\", \"event\", \"drained\")\n            end\n        end\n    end\n\n    return 0\nelse\n    return -1\nend\n--[[\n  Function to move job from wait state to active.\n  Input:\n    opts - token - lock token\n    opts - lockDuration\n    opts - limiter\n]]\n\n-- Includes\n--- @include \"addBaseMarkerIfNeeded\"\n\nlocal function prepareJobForProcessing(keyPrefix, rateLimiterKey, eventStreamKey,\n    jobId, processedOn, maxJobs, limiterDuration, markerKey, opts)\n  local jobKey = keyPrefix .. jobId\n\n  -- Check if we need to perform rate limiting.\n  if maxJobs then\n    local isDeferredFailure = rcall(\"HEXISTS\", jobKey, \"defa\") == 1\n\n    if not isDeferredFailure then\n      local jobCounter = tonumber(rcall(\"INCR\", rateLimiterKey))\n      if jobCounter == 1 then\n        local integerDuration = math.floor(math.abs(limiterDuration))\n        rcall(\"PEXPIRE\", rateLimiterKey, integerDuration)\n      end\n    end\n  end\n\n  -- get a lock\n  if opts['token'] ~= \"0\" then\n    local lockKey = jobKey .. ':lock'\n    rcall(\"SET\", lockKey, opts['token'], \"PX\", opts['lockDuration'])\n  end\n\n  local optionalValues = {}\n\n  if opts['name'] then\n    -- Set \"processedBy\" field to the worker name\n    table.insert(optionalValues, \"pb\")\n    table.insert(optionalValues, opts['name'])\n  end\n\n  rcall(\"XADD\", eventStreamKey, \"*\", \"event\", \"active\", \"jobId\", jobId, \"prev\", \"waiting\")\n  rcall(\"HMSET\", jobKey, \"processedOn\", processedOn, unpack(optionalValues))\n  rcall(\"HINCRBY\", jobKey, \"ats\", 1)\n\n  addBaseMarkerIfNeeded(markerKey, false)\n\n  -- rate limit delay must be 0 in this case to prevent adding more delay\n  -- when job that is moved to active needs to be processed\n  return {rcall(\"HGETALL\", jobKey), jobId, 0, 0} -- get job data\nend\n--[[\n  Move stalled jobs to wait.\n\n    Input:\n      KEYS[1] 'stalled' (SET)\n      KEYS[2] 'wait',   (LIST)\n      KEYS[3] 'active', (LIST)\n      KEYS[4] 'stalled-check', (KEY)\n      KEYS[5] 'meta', (KEY)\n      KEYS[6] 'paused', (LIST)\n      KEYS[7] 'marker'\n      KEYS[8] 'event stream' (STREAM)\n      KEYS[9] 'repeat' key\n\n      ARGV[1]  Max stalled job count\n      ARGV[2]  queue.toKey('')\n      ARGV[3]  timestamp\n      ARGV[4]  max check time\n\n    Events:\n      'stalled' with stalled job id.\n]]\nlocal rcall = redis.call\n\n-- Includes\n--- @include \"includes/batches\"\n--- @include \"includes/moveJobToWait\"\n--- @include \"includes/trimEvents\"\n\nlocal stalledKey = KEYS[1]\nlocal waitKey = KEYS[2]\nlocal activeKey = KEYS[3]\nlocal stalledCheckKey = KEYS[4]\nlocal metaKey = KEYS[5]\nlocal pausedKey = KEYS[6]\nlocal markerKey = KEYS[7]\nlocal eventStreamKey = KEYS[8]\nlocal repeatKey = KEYS[9]\nlocal maxStalledJobCount = tonumber(ARGV[1])\nlocal queueKeyPrefix = ARGV[2]\nlocal timestamp = ARGV[3]\nlocal maxCheckTime = ARGV[4]\n\nif rcall(\"EXISTS\", stalledCheckKey) == 1 then\n    return {}\nend\n\nrcall(\"SET\", stalledCheckKey, timestamp, \"PX\", maxCheckTime)\n\n-- Trim events before emitting them to avoid trimming events emitted in this script\ntrimEvents(metaKey, eventStreamKey)\n\n-- Move all stalled jobs to wait\nlocal stalling = rcall('SMEMBERS', stalledKey)\nlocal stalled = {}\nif (#stalling > 0) then\n    rcall('DEL', stalledKey)\n\n    -- Remove from active list\n    for i, jobId in ipairs(stalling) do\n        -- Markers in waitlist DEPRECATED in v5: Remove in v6.\n        if string.sub(jobId, 1, 2) == \"0:\" then\n            -- If the jobId is a delay marker ID we just remove it.\n            rcall(\"LREM\", activeKey, 1, jobId)\n        else\n            local jobKey = queueKeyPrefix .. jobId\n\n            -- Check that the lock is also missing, then we can handle this job as really stalled.\n            if (rcall(\"EXISTS\", jobKey .. \":lock\") == 0) then\n                --  Remove from the active queue.\n                local removed = rcall(\"LREM\", activeKey, 1, jobId)\n\n                if (removed > 0) then\n                    -- If this job has been stalled too many times, such as if it crashes the worker, then fail it.\n                    local stalledCount = rcall(\"HINCRBY\", jobKey, \"stc\", 1)\n                    \n                    -- Check if this is a repeatable job by looking at job options\n                    local jobSchedulerId = rcall(\"HGET\", jobKey, \"rjk\")\n                    local isRepeatableJob = false\n                    if jobSchedulerId then\n                        local schedulerKey = repeatKey .. \":\" .. jobSchedulerId\n\n                        if rcall(\"EXISTS\", schedulerKey) == 1 then\n                            isRepeatableJob = true\n                        else\n                            -- TODO: remove this check in v6, as it is only needed for legacy repeatable jobs\n                            -- that stored the scheduler id in the job key but did not create the scheduler hash key\n                            local prevMillis = rcall(\"ZSCORE\", repeatKey, jobSchedulerId)\n                            if prevMillis then\n                                isRepeatableJob = true\n                            end\n                        end\n                    end\n                    \n                    -- Only fail job if it exceeds stall limit AND is not a repeatable job\n                    if stalledCount > maxStalledJobCount and not isRepeatableJob then\n                        local failedReason = \"job stalled more than allowable limit\"\n                        rcall(\"HSET\", jobKey, \"defa\", failedReason)\n                    end\n                    \n                    moveJobToWait(metaKey, activeKey, waitKey, pausedKey, markerKey, eventStreamKey, jobId,\n                        \"RPUSH\")\n\n                    -- Emit the stalled event\n                    rcall(\"XADD\", eventStreamKey, \"*\", \"event\", \"stalled\", \"jobId\", jobId)\n                    table.insert(stalled, jobId)\n                end\n            end\n        end\n    end\nend\n\n-- Mark potentially stalled jobs\nlocal active = rcall('LRANGE', activeKey, 0, -1)\n\nif (#active > 0) then\n    for from, to in batches(#active, 7000) do\n        rcall('SADD', stalledKey, unpack(active, from, to))\n    end\nend\n\nreturn stalled\n--[[\n  Function to update a bunch of fields in a job.\n]]\nlocal function updateJobFields(jobKey, msgpackedFields)\n  if msgpackedFields and #msgpackedFields > 0 then\n    local fieldsToUpdate = cmsgpack.unpack(msgpackedFields)\n    if fieldsToUpdate then\n      rcall(\"HMSET\", jobKey, unpack(fieldsToUpdate))\n    end\n  end\nend\n13:-- lock (held until commit), so parallel producers cannot make progress — by far\n15:-- `nextval`, which takes no transaction-scoped lock, so concurrent adds run in\n34:  -- Fast path once the sequence exists: a cached catalog lookup + a lock-free\n36:  -- advisory lock serializes those racing first-adds so exactly one issues the\n39:    PERFORM pg_advisory_xact_lock(hashtext('bullmq:jidseq:' || p_queue));\n79:  -- add and finish paths always take the locks in the same order (advisory then\n80:  -- the id-counter row), which rules out a deadlock with requeue's own INCR.\n83:    PERFORM pg_advisory_xact_lock(\n188:-- token when a job is claimed. Otherwise identical to the v23 definition.\n191:  p_token            text,\n192:  p_lock_ms          bigint,\n239:  -- advisory lock so concurrent workers cannot all pass the check and overshoot;\n244:    PERFORM pg_advisory_xact_lock(hashtext('bullmq:concurrency:' || p_queue));\n260:    -- worker's limiter check and its token consumption can never interleave with\n263:    -- counter < max, each claim a (distinct) job, and each consume a token —\n264:    -- overshooting the limit. A transaction-scoped advisory lock serializes the\n266:    -- effective check below then runs on a fresh snapshot that sees the token a\n267:    -- preceding worker just committed. The lock auto-releases at statement end\n270:    PERFORM pg_advisory_xact_lock(hashtext('bullmq:limiter:' || p_queue));\n280:   FOR UPDATE SKIP LOCKED\n287:  -- Consume a token now that a job is actually being claimed. Duration: the\n300:         lock_token = p_token,\n301:         locked_until_ms = p_now + p_lock_ms,\n316:-- next_delay: the timestamp of the next delayed job (for worker block timing),\n331:  p_token        text,\n343:  v_lock     text;\n351:  -- FKs — deletes this job's row and its dependency row while we lock those same\n352:  -- rows below (in the opposite order), deadlocking (SQLSTATE 40P01). Read the\n353:  -- parent first (unlocked, just for the key) and take the per-parent advisory\n354:  -- lock BEFORE any row lock, so a concurrent parent removal and this finish op\n360:    PERFORM pg_advisory_xact_lock(\n364:  SELECT state, lock_token, parent_queue, parent_id, dedup_id\n365:    INTO v_state, v_lock, v_pq, v_pid, v_dedup_id\n373:  IF p_token <> '0' AND v_lock IS DISTINCT FROM p_token THEN\n374:    RAISE EXCEPTION 'bullmq: job % lock mismatch', p_id USING ERRCODE = 'BM001', DETAIL = '-6';\n399:         lock_token = NULL,\n400:         locked_until_ms = NULL,\n410:  -- The per-parent advisory lock taken at the top of this function serializes\n412:  -- removal, so the decrement cannot deadlock on the parent row.\n438:    PERFORM pg_advisory_xact_lock(\n476:  p_token         text,\n489:  v_lock     text;\n495:  -- FK, its child-dependency rows. A child finishing concurrently locks that\n497:  -- deadlocks (SQLSTATE 40P01). Take the per-parent advisory lock (keyed on this\n499:  -- lock below, so the two serialize instead of racing. Mirrors Redis's\n501:  PERFORM pg_advisory_xact_lock(\n504:  SELECT state, lock_token, dedup_id INTO v_state, v_lock, v_dedup_id\n512:  IF p_token <> '0' AND v_lock IS DISTINCT FROM p_token THEN\n513:    RAISE EXCEPTION 'bullmq: job % lock mismatch', p_id USING ERRCODE = 'BM001', DETAIL = '-6';\n521:         lock_token = NULL,\n522:         locked_until_ms = NULL,\n546:    PERFORM pg_advisory_xact_lock(\n576:-- extend_lock: refresh an active job's lock if the token still holds it.\n577:-- Returns 1 on success, 0 if the lock was lost.\n579:CREATE FUNCTION extend_lock(\n582:  p_token    text,\n583:  p_lock_ms  bigint,\n593:     SET locked_until_ms = p_now + p_lock_ms\n597:     AND lock_token = p_token;\n607:  p_token         text,\n619:  v_lock  text;\n621:  SELECT state, lock_token INTO v_state, v_lock\n629:  IF p_token <> '0' AND v_lock IS DISTINCT FROM p_token THEN\n630:    RAISE EXCEPTION 'bullmq: job % lock mismatch', p_id USING ERRCODE = 'BM001', DETAIL = '-6';\n639:         lock_token = NULL,\n640:         locked_until_ms = NULL,\n661:  p_token         text,\n671:  v_lock  text;\n674:  SELECT state, lock_token INTO v_state, v_lock\n682:  IF p_token <> '0' AND v_lock IS DISTINCT FROM p_token THEN\n683:    RAISE EXCEPTION 'bullmq: job % lock mismatch', p_id USING ERRCODE = 'BM001', DETAIL = '-6';\n697:         lock_token = NULL,\n698:         locked_until_ms = NULL,\n785:-- stream read with a blocking XREAD; here events live in `event` (a\n786:-- globally-ordered id per insert) and blocking reads use LISTEN/NOTIFY on the\n810:    (extract(epoch FROM clock_timestamp()) * 1000)::bigint\n816:  -- lock at commit (to deliver notifications in commit order), so a NOTIFY on\n818:  -- lock — the dominant processing bottleneck under load (and it caps throughput\n819:  -- across *all* queues and processes, since the lock is global).\n821:  -- A per-queue, transaction-scoped try-lock collapses that: only one committer\n827:  -- fires. Under low concurrency (e.g. tests) the lock is always free, so every\n829:  IF pg_try_advisory_xact_lock(hashtext('bullmq:evnotify:' || p_queue)) THEN\n847:  -- into a stream of DELETEs that contend (and previously deadlocked) with the\n850:  -- non-blocking, per-queue advisory lock further ensures at most one trimmer\n854:    IF pg_try_advisory_xact_lock(hashtext('bullmq:evtrim:' || p_queue)) THEN\n911:    -- Wake any worker blocked in waitForJob (LISTEN bullmq_jobs): jobs that were\n914:    -- until its drainDelay times out. The Redis backend wakes the blocking\n1008:--     its still-pending descendants — is locked by a worker; the caller turns\n1009:--     this into the \"locked by another worker\" error;\n1025:  v_locked    boolean;\n1028:  v_now       bigint := (extract(epoch from clock_timestamp()) * 1000)::bigint;\n1044:  -- Lock check. A job cannot be removed while it is locked; with removeChildren\n1045:  -- the check recurses through still-pending descendants (mirrors isLocked()).\n1059:      WHERE j.lock_token IS NOT NULL AND j.locked_until_ms > v_now\n1060:    ) INTO v_locked;\n1062:    SELECT lock_token IS NOT NULL AND locked_until_ms > v_now INTO v_locked\n1066:  IF v_locked THEN\n1148:         lock_token = NULL,\n1149:         locked_until_ms = NULL\n1325:    -- paths: advisory lock taken before the id-counter INCR below).\n1327:      PERFORM pg_advisory_xact_lock(\n1462:    SELECT q, ev, dat, (extract(epoch FROM clock_timestamp()) * 1000)::bigint\n1468:    -- stream once (not per publish). A non-blocking advisory lock keeps at most\n1481:         AND pg_try_advisory_xact_lock(hashtext('bullmq:evtrim:' || v_queue))\n1563:  -- Wake any worker blocked on an older (longer) delay so it recomputes.\n1619:  p_queue text, p_id text, p_token text, p_now bigint\n1626:  v_lock     text;\n1631:  SELECT state, lock_token, priority INTO v_state, v_lock, v_priority\n1638:     AND (p_token = '0' OR v_lock IS NOT DISTINCT FROM p_token) THEN\n1648:           lock_token = NULL,\n1649:           locked_until_ms = NULL\n1748:  p_queue text, p_id text, p_token text\n1755:  v_lock    text;\n1758:  SELECT state, lock_token, pending_deps INTO v_state, v_lock, v_pending\n1773:  -- Lock check (mirrors removeLock, taken before the active-state check): a\n1774:  -- missing lock is -2, a mismatched one is -6; token '0' skips the check.\n1775:  IF p_token <> '0' THEN\n1776:    IF v_lock IS NULL THEN\n1777:      RAISE EXCEPTION 'bullmq: job % missing lock', p_id\n1779:    ELSIF v_lock <> p_token THEN","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
