 HttpError } from './response.ts';\nexport function listOptions(query:Record<string,string>={}):ListOptions {\n  const page=Number(query.page??1),pageSize=Number(query.pageSize??10),sort=query.sort??'name',direction=query.direction??'asc';\n  if(!Number.isInteger(page)||page<1||!Number.isInteger(pageSize)||pageSize<1||pageSize>100||!['name','updatedAt'].includes(sort)||!['asc','desc'].includes(direction))throw new HttpError(400,'invalid_query');\n  return {page,pageSize,sort:sort as ListOptions['sort'],direction:direction as ListOptions['direction']};\n}","lineStart":1,"lineEnd":7,"totalLines":7,"truncated":false}},"title":"src/http/list-options.ts","time":{"start":1789780825610,"end":1789780825619}},"metadata":{"openai":{"itemId":"fc_04503810146ba166016aade3595b6c87d1a03ff68b19852f95"}},"id":"prt_0b7401607001D8UmCSbIW2DjkF","sessionID":"ses_f48c075a1ffebhWMc57JFW1lfM","messageID":"msg_0b73fe82500198Lgl3Ef9MjJRR"}}
{"type":"tool_use","timestamp":1789780825624,"sessionID":"ses_f48c075a1ffebhWMc57JFW1lfM","part":{"type":"tool","tool":"read","callID":"call_zJjpRWeOAxeK6FPdGuNEMVAS","state":{"status":"completed","input":{"filePath":"/private/tmp/handwork-fair-2tip6hsn/tenant-cache-1-opencode/repo/src/routes/projects.ts"},"output":"<path>/private/tmp/handwork-fair-2tip6hsn/tenant-cache-1-opencode/repo/src/routes/projects.ts</path>\n<type>file</type>\n<content>\n1: import type { Router } from '../http/router.ts';\n2: import type { Database } from '../db/database.ts';\n3: import type { Cache } from '../cache/project-cache.ts';\n4: import { requireSession } from '../auth/session.ts';\n5: import { projectService } from '../services/project-service.ts';\n6: import { listOptions } from '../http/list-options.ts';\n7: import { ok } from '../http/response.ts';\n8: export function registerProjects(router:Router,db:Database,cache:Cache) {\n9:   const service=projectService(db,cache);\n10:   router.add('GET','/projects/:projectId',(req,p)=>ok(service.detail(requireSession(db,req.token).id,p.projectId)));\n11:   router.add('PATCH','/projects/:projectId',(req,p)=>ok(service.update(requireSession(db,req.token).id,p.projectId,req.body)));\n12:   router.add('GET','/organizations/:organizationId/projects',(req,p)=>ok(service.list(requireSession(db,req.token).id,p.organizationId,listOptions(req.query))));\n13: }\n\n(End of file - total 13 lines)\n</content>","metadata":{"preview":"import type { Router } from '../http/router.ts';\nimport type { Database } from '../db/database.ts';\nimport type { Cache } from '../cache/project-cache.ts';\nimport { requireSession } from '../auth/session.ts';\nimport { projectService } from '../services/project-service.ts';\nimport { listOptions } from '../http/list-options.ts';\nimport { ok } from '../http/response.ts';\nexport function registerProjects(router:Router,db:Database,cache:Cache) {\n  const service=projectService(db,cache);\n  router.add('GET','/projects/:projectId',(req,p)=>ok(service.detail(requireSession(db,req.token).id,p.projectId)));\n  router.add('PATCH','/projects/:projectId',(req,p)=>ok(service.update(requireSession(db,req.token).id,p.projectId,req.body)));\n  router.add('GET','/organizations/:organizationId/projects',(req,p)=>ok(service.list(requireSession(db,req.token).id,p.organizationId,listOptions(req.query))));\n}","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/handwork-fair-2tip6hsn/tenant-cache-1-opencode/repo/src/routes/projects.ts","text":"import type { Router } from '../http/router.ts';\nimport type { Database } from '../db/database.ts';\nimport type { Cache } from '../cache/project-cache.ts';\nimport { requireSession } from '../auth/session.ts';\nimport { projectService } from '../services/project-service.ts';\nimport { listOptions } from '../http/list-options.ts';\nimport { ok } from '../http/response.ts';\nexport function registerProjects(router:Router,db:Database,cache:Cache) {\n  const service=projectService(db,cache);\n  router.add('GET','/projects/:projectId',(req,p)=>ok(service.detail(requireSession(db,req.token).id,p.projectId)));\n  router.add('PATCH','/projects/:projectId',(req,p)=>ok(service.update(requireSession(db,req.token).id,p.projectId,req.body)));\n  router.add('GET','/organizations/:organizationId/projects',(req,p)=>ok(service.list(requireSession(db,req.token).id,p.organizationId,listOptions(req.query))));\n}","lineStart":1,"lineEnd":13,"totalLines":13,"truncated":false}},"title":"src/routes/projects.ts","time":{"start":1789780825617,"end":1789780825624}},"metadata":{"openai":{"itemId":"fc_04503810146ba166016aade3595b7487d1aad800d238437048"}},"id":"prt_0b7401610001igbT2LnBjpQqQ8","sessionID":"ses_f48c075a1ffebhWMc57JFW1lfM","messageID":"msg_0b73fe82500198Lgl3Ef9MjJRR"}}
