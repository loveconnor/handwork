 import { execute } from './worker.js';
 export async function mapLimit(items, limit, fn) {
-  if (limit < 1) throw new RangeError('limit');
-  const results = [];
-  await Promise.all(items.map(async (item, index) => {
-    results.push(await execute(fn, item, index));
