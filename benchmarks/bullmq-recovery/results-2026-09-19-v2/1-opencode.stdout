ue.close();\n50:     await cleanupQueue(queueName);\n51:   });\n52: \n53:   afterAll(async function () {\n54:     await connection.quit();\n55:   });\n56: \n57:   it('process stalled jobs when starting a queue', async () => {\n58:     // TODO: Move timeout to test options: { timeout: 5000 }\n59: \n60:     const queueEvents = new QueueEvents(queueName, { connection, prefix });\n61:     await queueEvents.waitUntilReady();\n62: \n63:     const concurrency = 4;\n64: \n65:     const worker = new Worker(\n66:       queueName,\n67:       async () => {\n68:         return delay(10000);\n69:       },\n70:       {\n71:         connection,\n72:         prefix,\n73:         lockDuration: 1000,\n74:         stalledInterval: 100,\n75:         concurrency,\n76:       },\n77:     );\n78: \n79:     const allActive = new Promise(resolve => {\n80:       worker.on('active', after(concurrency, resolve));\n81:     });\n82: \n83:     await worker.waitUntilReady();\n84: \n85:     await Promise.all([\n86:       queue.add('test', { bar: 'baz' }),\n87:       queue.add('test', { bar1: 'baz1' }),\n88:       queue.add('test', { bar2: 'baz2' }),\n89:       queue.add('test', { bar3: 'baz3' }),\n90:     ]);\n91: \n92:     await allActive;\n93:     await worker.close(true);\n94: \n95:     const worker2 = new Worker(queueName, NoopProc, {\n96:       connection,\n97:       prefix,\n98:       stalledInterval: 100,\n99:       concurrency,\n100:     });\n101: \n102:     const allStalledGlobalEvent = new Promise(resolve => {\n103:       queueEvents.on('stalled', after(concurrency, resolve));\n104:     });\n105: \n106:     const allStalled = new Promise<void>(resolve => {\n107:       worker2.on(\n108:         'stalled',\n109:         after(concurrency, (jobId, prev) => {\n110:           expect(prev).toBe('active');\n111:           resolve();\n112:         }),\n113:       );\n114:     });\n115: \n116:     await allStalled;\n117:     await allStalledGlobalEvent;\n118: \n119:     const allCompleted = new Prom