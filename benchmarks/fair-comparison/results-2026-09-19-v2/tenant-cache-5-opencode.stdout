;\n+    }\n+  }\n+  assert.equal(a.db.counters.projectLists,variants);\n+  assert.equal(a.cache.keys().length,variants);\n+});\n+\n+test('cached lists still require current membership',()=>{\n+  const cache=createCache(),a=createApp(sampleSeed(),cache);\n+  const request={method:'GET',path:'/organizations/org-a/projects',token:'alice'};\n+  assert.equal(a.request(request).status,200);\n+  const metrics={...cache.metrics};\n+  assert.deepEqual(a.request({...request,token:'bob'}),{status:403,body:{error:'forbidden'}});\n+  a.db.memberships.delete(JSON.stringify(['alice','org-a']));\n+  assert.deepEqual(a.request(request),{status:403,body:{error:'forbidden'}});\n+  assert.deepEqual(cache.metrics,metrics);\n+  assert.equal(a.request({...request,token:'both'}).status,200);\n+  assert.equal(a.db.counters.projectLists,1);\n+});\n+\n+test('updates invalidate all owning-organization variants and retain other cached lists',()=>{\n+  const seed=sampleSeed();\n+  // Similar IDs and delimiters must not cause over-broad invalidation.\n+  const other='org-a:child\"';\n+  seed.organizations.push({id:other,name:'Other'});\n+  seed.memberships.push({userId:'both',organizationId:other});\n+  seed.projects.push({id:'c1',organizationId:other,name:'Other',updatedAt:1});\n+  const a=createApp(seed);\n+  const queries=[];\n+  for(const page of ['1','2'])for(const pageSize of ['1','2'])for(const sort of ['name','updatedAt'])for(const direction of ['asc','desc'])queries.push({page,pageSize,sort,direction});\n+  const list=(org:string,query:Record<string,string>)=>a.request({method:'GET',path:`/organizations/${org}/projects`,token:'both',query});\n+  const retained=[];\n+  for(const query of queries) {\n+    assert.equal(list('org-a',query).status,200);\n+    for(const org of ['org-b',other])retained.push({org,query,response:list(org,query)});\n+  }\n+  const before=a.db.counters.projectLists;\n+  assert.equal(a.request({method:'PATCH',path:'/projects/a1',token:'both',body:{name:' Zulu '}}).s