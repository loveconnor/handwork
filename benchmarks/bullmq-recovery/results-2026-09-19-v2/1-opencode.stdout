{"type":"tool_use","timestamp":1789787905500,"sessionID":"ses_f4855cf73ffe37M114ntFFYqdE","part":{"type":"tool","tool":"apply_patch","callID":"call_8KBUVZfZ4lrD6Fduu05GiH6i","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Add File: /private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/worker_ownership.redis.test.ts\n+import { afterEach, beforeEach, describe, expect, it } from 'vitest';\n+import { Job, Queue, Worker } from '../src/classes';\n+import { IRedisClient } from '../src/interfaces';\n+import { randomUUID } from '../src/utils';\n+import { createTestConnection } from './utils/connection-factory';\n+import { getRedisClient } from './utils/get-redis-client';\n+\n+describe('worker ownership after stalled recovery', () => {\n+  let connection: IRedisClient;\n+  let queue: Queue;\n+  let original: Worker;\n+  let replacement: Worker;\n+\n+  beforeEach(async () => {\n+    connection = createTestConnection();\n+    const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n+    const name = `test-${randomUUID()}`;\n+    queue = new Queue(name, { connection, prefix });\n+    original = new Worker(name, null, { connection, prefix });\n+    replacement = new Worker(name, null, { connection, prefix });\n+    await Promise.all([\n+      original.waitUntilReady(),\n+      replacement.waitUntilReady(),\n+    ]);\n+  });\n+\n+  afterEach(async () => {\n+    await Promise.all([original.close(), replacement.close()]);\n+    await queue.obliterate({ force: true });\n+    await queue.close();\n+    await connection.quit();\n+  });\n+\n+  it.each(['complete', 'fail', 'retry', 'delayed retry'])(\n+    'rejects stale %s without changing the recovered job or events',\n+    async operation => {\n+      await queue.add('job', {}, {\n+        attempts: operation.includes('retry') ? 3 : 1,\n+        backoff: operation === 'delayed retry'\n+          ? { type: 'fixed', delay: 1000 }\n+          : undefined,\n+      });\n+      const stale = (await original.getNextJob('original')) as Job;\n+      const client = await getRedisClient(queue);\n+      const jobKey = queue.toKey(stale.id);\n+      const lockKey = `${jobKey}:lock`;\n+\n+      // Simulate lock expiry, then use the real stalled recovery path.\n+      await client.del(lockKey);\n+      await replacement.getBackend().moveStalledJobsToWait();\n+      await client.del(queue.toKey('stalled-check'));\n+      await replacement.getBackend().moveStalledJobsToWait();\n+      const owner = (await replacement.getNextJob('replacement')) as Job;\n+      expect(owner.id).toBe(stale.id);\n+      expect(owner.stalledCounter).toBe(1);\n+\n+      // A due delayed job must not be promoted by a rejected immediate retry.\n+      const delayed = await queue.add('delayed', {}, { delay: 60000 });\n+      await client.zadd(queue.toKey('delayed'), 0, delayed.id);\n+      await client.sadd(queue.toKey('stalled'), stale.id);\n+      const snapshot = async () => ({\n+        job: await client.hgetall(jobKey),\n+        lock: await client.get(lockKey),\n+        active: await client.lrange(queue.toKey('active'), 0, -1),\n+        waiting: await client.lrange(queue.toKey('wait'), 0, -1),\n+        delayed: await client.zrange(queue.toKey('delayed'), 0, -1, 'WITHSCORES'),\n+        stalled: await client.smembers(queue.toKey('stalled')),\n+        events: await client.xrange(queue.toKey('events'), '-', '+'),\n+      });\n+      const before = await snapshot();\n+      const ttl = await client.pttl(lockKey);\n+\n+      expect(await stale.extendLock('original', 120000)).toBe(0);\n+      expect(await original.extendJobLocks([stale.id], ['original'], 120000))\n+        .toEqual([stale.id]);\n+      expect(await client.pttl(lockKey)).toBeLessThanOrEqual(ttl);\n+      await expect(operation === 'complete'\n+        ? stale.moveToCompleted('stale result', 'original', false)\n+        : stale.moveToFailed(new Error('stale failure'), 'original', false),\n+      ).rejects.toThrow(`Lock mismatch for job ${stale.id}`);\n+      expect(await snapshot()).toEqual(before);\n+      expect(await owner.getState()).toBe('active');\n+\n+      expect(await owner.extendLock('replacement', 120000)).toBe(1);\n+      expect(await replacement.extendJobLocks([owner.id], ['replacement'], 120000))\n+        .toEqual([]);\n+      expect(await client.pttl(lockKey)).toBeGreaterThan(ttl);\n+      await owner.moveToCompleted('owner result', 'replacement', false);\n+      const finished = await queue.getJob(owner.id);\n+      expect(await finished.getState()).toBe('completed');\n+      expect(finished.returnvalue).toBe('owner result');\n+      expect(finished.attemptsMade).toBe(1);\n+      expect(finished.attemptsStarted).toBe(2);\n+    },\n+  );\n+\n+  it('rejects missing locks while preserving administrative completion', async () => {\n+    await queue.add('job', {});\n+    const job = (await original.getNextJob('original')) as Job;\n+    const client = await getRedisClient(queue);\n+    const lockKey = `${queue.toKey(job.id)}:lock`;\n+    await client.del(lockKey);\n+    expect(await job.extendLock('original', 120000)).toBe(0);\n+    expect(await original.extendJobLocks([job.id], ['original'], 120000))\n+      .toEqual([job.id]);\n+    expect(await client.exists(lockKey)).toBe(0);\n+    await expect(job.moveToCompleted('result', 'original', false))\n+      .rejects.toThrow(`Missing lock for job ${job.id}`);\n+    await expect(job.moveToFailed(new Error('failure'), 'original', false))\n+      .rejects.toThrow(`Missing lock for job ${job.id}`);\n+    expect(await job.getState()).toBe('active');\n+    await job.moveToCompleted('administrative result', '0', false);\n+    expect(await job.getState()).toBe('completed');\n+  });\n+});\n*** End Patch"},"output":"Success. Updated the following files:\nA tests/worker_ownership.redis.test.ts","metadata":{"diff":"Index: /private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/worker_ownership.redis.test.ts\n===================================================================\n--- /private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/worker_ownership.redis.test.ts\n+++ /private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/worker_ownership.redis.test.ts\n@@ -0,0 +1,115 @@\n+import { afterEach, beforeEach, describe, expect, it } from 'vitest';\n+import { Job, Queue, Worker } from '../src/classes';\n+import { IRedisClient } from '../src/interfaces';\n+import { randomUUID } from '../src/utils';\n+import { createTestConnection } from './utils/connection-factory';\n+import { getRedisClient } from './utils/get-redis-client';\n+\n+describe('worker ownership after stalled recovery', () => {\n+  let connection: IRedisClient;\n+  let queue: Queue;\n+  let original: Worker;\n+  let replacement: Worker;\n+\n+  beforeEach(async () => {\n+    connection = createTestConnection();\n+    const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n+    const name = `test-${randomUUID()}`;\n+    queue = new Queue(name, { connection, prefix });\n+    original = new Worker(name, null, { connection, prefix });\n+    replacement = new Worker(name, null, { connection, prefix });\n+    await Promise.all([\n+      original.waitUntilReady(),\n+      replacement.waitUntilReady(),\n+    ]);\n+  });\n+\n+  afterEach(async () => {\n+    await Promise.all([original.close(), replacement.close()]);\n+    await queue.obliterate({ force: true });\n+    await queue.close();\n+    await connection.quit();\n+  });\n+\n+  it.each(['complete', 'fail', 'retry', 'delayed retry'])(\n+    'rejects stale %s without changing the recovered job or events',\n+    async operation => {\n+      await queue.add('job', {}, {\n+        attempts: operation.includes('retry') ? 3 : 1,\n+        backoff: operation === 'delayed retry'\n+          ? { type: 'fixed', delay: 1000 }\n+          : undefined,\n+      });\n+      const stale = (await original.getNextJob('original')) as Job;\n+      const client = await getRedisClient(queue);\n+      const jobKey = queue.toKey(stale.id);\n+      const lockKey = `${jobKey}:lock`;\n+\n+      // Simulate lock expiry, then use the real stalled recovery path.\n+      await client.del(lockKey);\n+      await replacement.getBackend().moveStalledJobsToWait();\n+      await client.del(queue.toKey('stalled-check'));\n+      await replacement.getBackend().moveStalledJobsToWait();\n+      const owner = (await replacement.getNextJob('replacement')) as Job;\n+      expect(owner.id).toBe(stale.id);\n+      expect(owner.stalledCounter).toBe(1);\n+\n+      // A due delayed job must not be promoted by a rejected immediate retry.\n+      const delayed = await queue.add('delayed', {}, { delay: 60000 });\n+      await client.zadd(queue.toKey('delayed'), 0, delayed.id);\n+      await client.sadd(queue.toKey('stalled'), stale.id);\n+      const snapshot = async () => ({\n+        job: await client.hgetall(jobKey),\n+        lock: await client.get(lockKey),\n+        active: await client.lrange(queue.toKey('active'), 0, -1),\n+        waiting: await client.lrange(queue.toKey('wait'), 0, -1),\n+        delayed: await client.zrange(queue.toKey('delayed'), 0, -1, 'WITHSCORES'),\n+        stalled: await client.smembers(queue.toKey('stalled')),\n+        events: await client.xrange(queue.toKey('events'), '-', '+'),\n+      });\n+      const before = await snapshot();\n+      const ttl = await client.pttl(lockKey);\n+\n+      expect(await stale.extendLock('original', 120000)).toBe(0);\n+      expect(await original.extendJobLocks([stale.id], ['original'], 120000))\n+        .toEqual([stale.id]);\n+      expect(await client.pttl(lockKey)).toBeLessThanOrEqual(ttl);\n+      await expect(operation === 'complete'\n+        ? stale.moveToCompleted('stale result', 'original', false)\n+        : stale.moveToFailed(new Error('stale failure'), 'original', false),\n+      ).rejects.toThrow(`Lock mismatch for job ${stale.id}`);\n+      expect(await snapshot()).toEqual(before);\n+      expect(await owner.getState()).toBe('active');\n+\n+      expect(await owner.extendLock('replacement', 120000)).toBe(1);\n+      expect(await replacement.extendJobLocks([owner.id], ['replacement'], 120000))\n+        .toEqual([]);\n+      expect(await client.pttl(lockKey)).toBeGreaterThan(ttl);\n+      await owner.moveToCompleted('owner result', 'replacement', false);\n+      const finished = await queue.getJob(owner.id);\n+      expect(await finished.getState()).toBe('completed');\n+      expect(finished.returnvalue).toBe('owner result');\n+      expect(finished.attemptsMade).toBe(1);\n+      expect(finished.attemptsStarted).toBe(2);\n+    },\n+  );\n+\n+  it('rejects missing locks while preserving administrative completion', async () => {\n+    await queue.add('job', {});\n+    const job = (await original.getNextJob('original')) as Job;\n+    const client = await getRedisClient(queue);\n+    const lockKey = `${queue.toKey(job.id)}:lock`;\n+    await client.del(lockKey);\n+    expect(await job.extendLock('original', 120000)).toBe(0);\n+    expect(await original.extendJobLocks([job.id], ['original'], 120000))\n+      .toEqual([job.id]);\n+    expect(await client.exists(lockKey)).toBe(0);\n+    await expect(job.moveToCompleted('result', 'original', false))\n+      .rejects.toThrow(`Missing lock for job ${job.id}`);\n+    await expect(job.moveToFailed(new Error('failure'), 'original', false))\n+      .rejects.toThrow(`Missing lock for job ${job.id}`);\n+    expect(await job.getState()).toBe('active');\n+    await job.moveToCompleted('administrative result', '0', false);\n+    expect(await job.getState()).toBe('completed');\n+  });\n+});\n\n","files":[{"filePath":"/private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/worker_ownership.redis.test.ts","relativePath":"tests/worker_ownership.redis.test.ts","type":"add","patch":"Index: /private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/worker_ownership.redis.test.ts\n===================================================================\n--- /private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/worker_ownership.redis.test.ts\n+++ /private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/worker_ownership.redis.test.ts\n@@ -0,0 +1,115 @@\n+import { afterEach, beforeEach, describe, expect, it } from 'vitest';\n+import { Job, Queue, Worker } from '../src/classes';\n+import { IRedisClient } from '../src/interfaces';\n+import { randomUUID } from '../src/utils';\n+import { createTestConnection } from './utils/connection-factory';\n+import { getRedisClient } from './utils/get-redis-client';\n+\n+describe('worker ownership after stalled recovery', () => {\n+  let connection: IRedisClient;\n+  let queue: Queue;\n+  let original: Worker;\n+  let replacement: Worker;\n+\n+  beforeEach(async () => {\n+    connection = createTestConnection();\n+    const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n+    const name = `test-${randomUUID()}`;\n+    queue = new Queue(name, { connection, prefix });\n+    original = new Worker(name, null, { connection, prefix });\n+    replacement = new Worker(name, null, { connection, prefix });\n+    await Promise.all([\n+      original.waitUntilReady(),\n+      replacement.waitUntilReady(),\n+    ]);\n+  });\n+\n+  afterEach(async () => {\n+    await Promise.all([original.close(), replacement.close()]);\n+    await queue.obliterate({ force: true });\n+    await queue.close();\n+    await connection.quit();\n+  });\n+\n+  it.each(['complete', 'fail', 'retry', 'delayed retry'])(\n+    'rejects stale %s without changing the recovered job or events',\n+    async operation => {\n+      await queue.add('job', {}, {\n+        attempts: operation.includes('retry') ? 3 : 1,\n+        backoff: operation === 'delayed retry'\n+          ? { type: 'fixed', delay: 1000 }\n+          : undefined,\n+      });\n+      const stale = (await original.getNextJob('original')) as Job;\n+      const client = await getRedisClient(queue);\n+      const jobKey = queue.toKey(stale.id);\n+      const lockKey = `${jobKey}:lock`;\n+\n+      // Simulate lock expiry, then use the real stalled recovery path.\n+      await client.del(lockKey);\n+      await replacement.getBackend().moveStalledJobsToWait();\n+      await client.del(queue.toKey('stalled-check'));\n+      await replacement.getBackend().moveStalledJobsToWait();\n+      const owner = (await replacement.getNextJob('replacement')) as Job;\n+      expect(owner.id).toBe(stale.id);\n+      expect(owner.stalledCounter).toBe(1);\n+\n+      // A due delayed job must not be promoted by a rejected immediate retry.\n+      const delayed = await queue.add('delayed', {}, { delay: 60000 });\n+      await client.zadd(queue.toKey('delayed'), 0, delayed.id);\n+      await client.sadd(queue.toKey('stalled'), stale.id);\n+      const snapshot = async () => ({\n+        job: await client.hgetall(jobKey),\n+        lock: await client.get(lockKey),\n+        active: await client.lrange(queue.toKey('active'), 0, -1),\n+        waiting: await client.lrange(queue.toKey('wait'), 0, -1),\n+        delayed: await client.zrange(queue.toKey('delayed'), 0, -1, 'WITHSCORES'),\n+        stalled: await client.smembers(queue.toKey('stalled')),\n+        events: await client.xrange(queue.toKey('events'), '-', '+'),\n+      });\n+      const before = await snapshot();\n+      const ttl = await client.pttl(lockKey);\n+\n+      expect(await stale.extendLock('original', 120000)).toBe(0);\n+      expect(await original.extendJobLocks([stale.id], ['original'], 120000))\n+        .toEqual([stale.id]);\n+      expect(await client.pttl(lockKey)).toBeLessThanOrEqual(ttl);\n+      await expect(operation === 'complete'\n+        ? stale.moveToCompleted('stale result', 'original', false)\n+        : stale.moveToFailed(new Error('stale failure'), 'original', false),\n+      ).rejects.toThrow(`Lock mismatch for job ${stale.id}`);\n+      expect(await snapshot()).toEqual(before);\n+      expect(await owner.getState()).toBe('active');\n+\n+      expect(await owner.extendLock('replacement', 120000)).toBe(1);\n+      expect(await replacement.extendJobLocks([owner.id], ['replacement'], 120000))\n+        .toEqual([]);\n+      expect(await client.pttl(lockKey)).toBeGreaterThan(ttl);\n+      await owner.moveToCompleted('owner result', 'replacement', false);\n+      const finished = await queue.getJob(owner.id);\n+      expect(await finished.getState()).toBe('completed');\n+      expect(finished.returnvalue).toBe('owner result');\n+      expect(finished.attemptsMade).toBe(1);\n+      expect(finished.attemptsStarted).toBe(2);\n+    },\n+  );\n+\n+  it('rejects missing locks while preserving administrative completion', async () => {\n+    await queue.add('job', {});\n+    const job = (await original.getNextJob('original')) as Job;\n+    const client = await getRedisClient(queue);\n+    const lockKey = `${queue.toKey(job.id)}:lock`;\n+    await client.del(lockKey);\n+    expect(await job.extendLock('original', 120000)).toBe(0);\n+    expect(await original.extendJobLocks([job.id], ['original'], 120000))\n+      .toEqual([job.id]);\n+    expect(await client.exists(lockKey)).toBe(0);\n+    await expect(job.moveToCompleted('result', 'original', false))\n+      .rejects.toThrow(`Missing lock for job ${job.id}`);\n+    await expect(job.moveToFailed(new Error('failure'), 'original', false))\n+      .rejects.toThrow(`Missing lock for job ${job.id}`);\n+    expect(await job.getState()).toBe('active');\n+    await job.moveToCompleted('administrative result', '0', false);\n+    expect(await job.getState()).toBe('completed');\n+  });\n+});\n","additions":115,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nA tests/worker_ownership.redis.test.ts","time":{"start":1789787905494,"end":1789787905498}},"metadata":{"openai":{"itemId":"fc_09ef0f0c2aa017b2016aadfed2552887d1be047404502d4bd9"}},"id":"prt_0b7ab65c3001AVfzEbvWv56DUa","sessionID":"ses_f4855cf73ffe37M114ntFFYqdE","messageID":"msg_0b7ab5f89001zxfQy98n0FcWij"}}
