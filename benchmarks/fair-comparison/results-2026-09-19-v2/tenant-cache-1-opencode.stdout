ies(seed.sessions)),\n    counters: { projectReads: 0, projectLists: 0, projectUpdates: 0 },\n  };\n}\nexport type Database = ReturnType<typeof createDatabase>;","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/handwork-fair-2tip6hsn/tenant-cache-1-opencode/repo/src/db/database.ts","text":"import type { Project, Organization, User } from '../types.ts';\nexport type Seed = { projects: Project[]; organizations: Organization[]; users: User[]; memberships: {userId:string; organizationId:string}[]; sessions: Record<string,string> };\nexport function createDatabase(seed: Seed) {\n  return {\n    projects: new Map(seed.projects.map(p => [p.id, structuredClone(p)])),\n    organizations: new Map(seed.organizations.map(o => [o.id, {...o}])),\n    users: new Map(seed.users.map(u => [u.id, {...u}])),\n    memberships: new Set(seed.memberships.map(m => JSON.stringify([m.userId,m.organizationId]))),\n    sessions: new Map(Object.entries(seed.sessions)),\n    counters: { projectReads: 0, projectLists: 0, projectUpdates: 0 },\n  };\n}\nexport type Database = ReturnType<typeof createDatabase>;","lineStart":1,"lineEnd":13,"totalLines":13,"truncated":false}},"title":"src/db/database.ts","time":{"start":1789780825597,"end":1789780825600}},"metadata":{"openai":{"itemId":"fc_04503810146ba166016aade3595b5087d19a71ead7b59cfd5b"}},"id":"prt_0b74015e6001H3PCoStpJGCVQ2","sessionID":"ses_f48c075a1ffebhWMc57JFW1lfM","messageID":"msg_0b73fe82500198Lgl3Ef9MjJRR"}}
