     },\n   };\n M src/search/controller.ts\n","metadata":{"output":"diff --git a/src/search/controller.ts b/src/search/controller.ts\nindex d6ab5ca..5089cd6 100644\n--- a/src/search/controller.ts\n+++ b/src/search/controller.ts\n@@ -15,6 +15,7 @@ export interface SearchController {\n \n export function createSearchController(api: SearchApi): SearchController {\n   let state: SearchState = { query: '', results: [], loading: false, error: null };\n+  let latestRequestId = 0;\n   const listeners = new Set<(state: SearchState) => void>();\n   const getState = (): SearchState => ({ ...state, results: [...state.results] });\n   const update = (patch: Partial<SearchState>): void => {\n@@ -30,6 +31,7 @@ export function createSearchController(api: SearchApi): SearchController {\n       return () => { listeners.delete(listener); };\n     },\n     async search(query) {\n+      const requestId = ++latestRequestId;\n       const normalized = query.trim();\n       if (!normalized) {\n         update({ query: '', results: [], loading: false, error: null });\n@@ -38,11 +40,13 @@ export function createSearchController(api: SearchApi): SearchController {\n       update({ query: normalized, loading: true, error: null });\n       try {\n         const results = await api.search(normalized);\n-        update({ results });\n+        if (requestId === latestRequestId) update({ results });\n       } catch (error) {\n-        update({ error: error instanceof Error ? error.message : String(error) });\n+        if (requestId === latestRequestId) {\n+          update({ error: error instanceof Error ? error.message : String(error) });\n+        }\n       } finally {\n-        update({ loading: false });\n+        if (requestId === latestRequestId) update({ loading: false });\n       }\n     },\n   };\n M src/search/controller.ts\n","exit":0,"truncated":false},"title":"git diff --check && git diff && git status --short","time":{"start":1789780526608,"end":1789780526648}},"metadata":{"openai":{"