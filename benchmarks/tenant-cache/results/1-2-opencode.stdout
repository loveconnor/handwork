nId:string)=>JSON.stringify([userId,organizationId]);\n  return {\n    has(userId:string,organizationId:string){return db.memberships.has(key(userId,organizationId));},\n    revoke(userId:string,organizationId:string){db.memberships.delete(key(userId,organizationId));},\n    organizationsFor(userId:string){return [...db.organizations.values()].filter(o=>db.memberships.has(key(userId,o.id))).map(o=>({...o}));},\n  };\n}","lineStart":1,"lineEnd":9,"totalLines":9,"truncated":false}},"title":"src/db/membership-repository.ts","time":{"start":1789175154842,"end":1789175154845}},"metadata":{"openai":{"itemId":"fc_097f36c4dacc1bb9016aa4a572a03487d1aa6d6fe4209cedf7"}},"id":"prt_093264874001fBGU5vrM169nex","sessionID":"ses_f6cdbab5bffeiOcNlp5LNJFmDc","messageID":"msg_09326260e0017jqSxoSBnwvC2t"}}
