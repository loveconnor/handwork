{"type":"tool_use","timestamp":1789782747980,"sessionID":"ses_f48a39245ffey7PBbEFyhaW1Ud","part":{"type":"tool","tool":"bash","callID":"call_fjvaZVmBvsdvCGVkj6nKEEWA","state":{"status":"completed","input":{"command":"node --input-type=module -e 'import assert from \"node:assert/strict\"; import { createSearchController } from \"./src/search/controller.ts\"; const item = title => [{ id: title, title, url: \"/\" + title }]; for (const staleFails of [false, true]) { for (const latestFirst of [false, true]) { const pending = []; const c = createSearchController({ search: () => new Promise((resolve, reject) => pending.push({ resolve, reject })) }); const old = c.search(\"old\"); const latest = c.search(\"latest\"); if (latestFirst) { pending[1].resolve(item(\"latest\")); await latest; } const before = c.getState(); if (staleFails) pending[0].reject(new Error(\"stale error\")); else pending[0].resolve(item(\"old\")); await old; assert.deepEqual(c.getState(), before); if (!latestFirst) { pending[1].resolve(item(\"latest\")); await latest; } assert.deepEqual(c.getState(), { query: \"latest\", results: item(\"latest\"), loading: false, error: null }); } const pending = []; const c = createSearchController({ search: () => new Promise((resolve, reject) => pending.push({ resolve, reject })) }); const old = c.search(\"old\"); const clear = c.search(\"  \"); const empty = { query: \"\", results: [], loading: false, error: null }; assert.deepEqual(c.getState(), empty); if (staleFails) pending[0].reject(new Error(\"stale error\")); else pending[0].resolve(item(\"old\")); await Promise.all([old, clear]); assert.deepEqual(c.getState(), empty); } console.log(\"Race checks passed: stale success/failure, both completion orders, and clearing pending searches.\");'"},"output":"Race checks passed: stale success/failure, both completion orders, and clearing pending searches.\n","metadata":{"output":"Race checks passed: stale success/failure, both completion orders, and clearing pending searches.\n","exit":0,"truncated":false},"title":"node --input-type=module -e 'import assert from \"node:assert/strict\"; import { createSearchController } from \"./src/search/controller.ts\"; const item = title => [{ id: title, title, url: \"/\" + title }]; for (const staleFails of [false, true]) { for (const latestFirst of [false, true]) { const pending = []; const c = createSearchController({ search: () => new Promise((resolve, reject) => pending.push({ resolve, reject })) }); const old = c.search(\"old\"); const latest = c.search(\"latest\"); if (latestFirst) { pending[1].resolve(item(\"latest\")); await latest; } const before = c.getState(); if (staleFails) pending[0].reject(new Error(\"stale error\")); else pending[0].resolve(item(\"old\")); await old; assert.deepEqual(c.getState(), before); if (!latestFirst) { pending[1].resolve(item(\"latest\")); await latest; } assert.deepEqual(c.getState(), { query: \"latest\", results: item(\"latest\"), loading: false, error: null }); } const pending = []; const c = createSearchController({ search: () => new Promise((resolve, reject) => pending.push({ resolve, reject })) }); const old = c.search(\"old\"); const clear = c.search(\"  \"); const empty = { query: \"\", results: [], loading: false, error: null }; assert.deepEqual(c.getState(), empty); if (staleFails) pending[0].reject(new Error(\"stale error\")); else pending[0].resolve(item(\"old\")); await Promise.all([old, clear]); assert.deepEqual(c.getState(), empty); } console.log(\"Race checks passed: stale success/failure, both completion orders, and clearing pending searches.\");'","time":{"start":1789782747909,"end":1789782747979}},"metadata":{"openai":{"itemId":"fc_0216f92e8718f883016aadead0d78487d1a4ff74ddf95358d0"}},"id":"prt_0b75d4032001eTQHl0ATjI3yeu","sessionID":"ses_f48a39245ffey7PBbEFyhaW1Ud","messageID":"msg_0b75d32d9001lpwESAvey9PSRq"}}
