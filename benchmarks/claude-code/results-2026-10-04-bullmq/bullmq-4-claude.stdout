ob();\n\n    await expectRejected(staleJob, () => staleJob.moveToWait(staleToken));\n  });\n\n  it('does not renew the lock of a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n    const jobId = staleJob.id!;\n\n    expect(await staleJob.extendLock(staleToken, 60000)).toBe(0);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n\n    expect(\n      await (staleWorker as any).extendJobLocks([jobId], [staleToken], 60000),\n    ).toEqual([jobId]);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await client.pttl(lockKey)).toBeLessThanOrEqual(30000);\n\n    expect(await ownerJob.extendLock(ownerToken, 60000)).toBe(1);\n    expect(await client.pttl(lockKey)).toBeGreaterThan(30000);\n    expect(\n      await (ownerWorker as any).extendJobLocks([jobId], [ownerToken], 90000),\n    ).toEqual([]);\n    expect(await client.pttl(lockKey)).toBeGreaterThan(60000);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n  });\n\n  it('renews only the locks owned in a batch', async () => {\n    await queue.add('test', { idx: 1 });\n    await queue.add('test', { idx: 2 });\n    const owned = (await staleWorker.getNextJob(staleToken)) as Job;\n    const taken = (await staleWorker.getNextJob(staleToken)) as Job;\n    const takenLockKey = `${prefix}:${queueName}:${taken.id}:lock`;\n    await client.set(takenLockKey, ownerToken, 'PX', 30000);\n\n    expect(\n      await (staleWorker as any).extendJobLocks(\n        [owned.id, taken.id, 'missing'],\n        [staleToken, staleToken, staleToken],\n        60000,\n      ),\n    ).toEqual([taken.id, 'missing']);\n\n    expect(await client.get(takenLockKey)).toBe(ownerToken);\n    expect(await client.pttl(takenLockKey)).toBeLessThanOrEqual(30000);\n    expect(\n      await client.pttl(`${prefix}:${queueName}:${owned.id}:lock`),\n    ).toBeGreaterThan(30000);\n  });\n\n  it('keeps reporting missing locks', async () => {\n    await queue.add('test', { foo: 'bar' });\n    const job = (await staleWorker.getNextJob(staleToken)) as Job;\n    await client.del(`${prefix}:${queueName}:${job.id}:lock`);\n\n    expect(await job.extendLock(staleToken, 60000)).toBe(0);\n    await expect(job.moveToCompleted('done', staleToken, false)).rejects.toThrow(\n      `Missing lock for job ${job.id}`,\n    );\n    expect(await job.getState()).toBe('active');\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
