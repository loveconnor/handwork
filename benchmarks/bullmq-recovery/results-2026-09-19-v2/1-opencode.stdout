{"type":"tool_use","timestamp":1789787844596,"sessionID":"ses_f4855cf73ffe37M114ntFFYqdE","part":{"type":"tool","tool":"read","callID":"call_jCnSNQmAreXvWMMOXSe6Kxrt","state":{"status":"completed","input":{"filePath":"/private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/utils/get-redis-client.ts"},"output":"<path>/private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/utils/get-redis-client.ts</path>\n<type>file</type>\n<content>\n1: import { RedisQueueBackend } from '../../src/classes/redis-queue-backend';\n2: import { RedisConnection } from '../../src/classes/redis-connection';\n3: import { RedisClient } from '../../src/interfaces';\n4: \n5: /**\n6:  * A queue-like object backed by the Redis adapter. The built-in classes\n7:  * (`Queue`, `Worker`, `FlowProducer`) are parameterized on\n8:  * {@link RedisQueueBackend} by default, so `getBackend()` returns the concrete\n9:  * adapter and these helpers need no casting.\n10:  */\n11: interface RedisBackedTarget {\n12:   getBackend(): RedisQueueBackend;\n13: }\n14: \n15: /**\n16:  * Test-only helper to reach the raw Redis client behind a queue-like object.\n17:  *\n18:  * The high-level classes (`Queue`, `Worker`, `FlowProducer`, …) no longer\n19:  * expose a `client` getter: they are datastore-agnostic and only know about\n20:  * their backend. The raw Redis client is a Redis-specific escape hatch that\n21:  * lives on the concrete {@link RedisQueueBackend} implementation.\n22:  *\n23:  * This helper is a drop-in replacement for the old `await queue.client`: the\n24:  * backend's `client` getter resolves once the underlying connection is ready.\n25:  */\n26: export function getRedisClient(\n27:   target: RedisBackedTarget,\n28: ): Promise<RedisClient> {\n29:   return target.getBackend().client;\n30: }\n31: \n32: /**\n33:  * Test-only helper to reach the raw blocking Redis client behind a worker-like\n34:  * object (Redis-specific escape hatch on {@link RedisQueueBackend}). This is\n35:  * the connection that registers as a worker (`:w:` suffix).\n36:  *\n37:  * Throws if the target's backend has no blocking client so call sites can\n38:  * safely treat the result as a non-optional `Promise<RedisClient>`.\n39:  */\n40: export function getBlockingRedisClient(\n41:   target: RedisBackedTarget,\n42: ): Promise<RedisClient> {\n43:   const blockingClient = target.getBackend().blockingClient;\n44:   if (!blockingClient) {\n45:     throw new Error(\n46:       'Target backend has no blocking Redis client (it was not created with a blocking connection)',\n47:     );\n48:   }\n49:   return blockingClient;\n50: }\n51: \n52: /**\n53:  * Test-only helper to reach the underlying {@link RedisConnection} of a\n54:  * queue-like object (Redis-specific escape hatch on {@link RedisQueueBackend}).\n55:  */\n56: export function getRedisConnection(target: RedisBackedTarget): RedisConnection {\n57:   return target.getBackend().connection;\n58: }\n59: \n60: /**\n61:  * Test-only helper to reach the dedicated blocking {@link RedisConnection} of a\n62:  * worker-like object (Redis-specific escape hatch on {@link RedisQueueBackend}).\n63:  *\n64:  * Throws if the target's backend has no blocking connection so call sites can\n65:  * safely treat the result as a non-optional `RedisConnection`.\n66:  */\n67: export function getBlockingRedisConnection(\n68:   target: RedisBackedTarget,\n69: ): RedisConnection {\n70:   const blockingConnection = target.getBackend().blockingConnection;\n71:   if (!blockingConnection) {\n72:     throw new Error(\n73:       'Target backend has no blocking connection (it was not created with a blocking connection)',\n74:     );\n75:   }\n76:   return blockingConnection;\n77: }\n78: \n79: /**\n80:  * Test-only helper to read the detected Redis server version behind a\n81:  * queue-like object (Redis-specific escape hatch on {@link RedisQueueBackend}).\n82:  */\n83: export function getRedisVersion(target: RedisBackedTarget): string {\n84:   return target.getBackend().redisVersion;\n85: }\n86: \n87: /**\n88:  * Test-only helper to read the detected datastore flavour behind a queue-like\n89:  * object (Redis-specific escape hatch on {@link RedisQueueBackend}).\n90:  */\n91: export function getDatabaseType(target: RedisBackedTarget): string {\n92:   return target.getBackend().databaseType;\n93: }\n\n(End of file - total 93 lines)\n</content>","metadata":{"preview":"import { RedisQueueBackend } from '../../src/classes/redis-queue-backend';\nimport { RedisConnection } from '../../src/classes/redis-connection';\nimport { RedisClient } from '../../src/interfaces';\n\n/**\n * A queue-like object backed by the Redis adapter. The built-in classes\n * (`Queue`, `Worker`, `FlowProducer`) are parameterized on\n * {@link RedisQueueBackend} by default, so `getBackend()` returns the concrete\n * adapter and these helpers need no casting.\n */\ninterface RedisBackedTarget {\n  getBackend(): RedisQueueBackend;\n}\n\n/**\n * Test-only helper to reach the raw Redis client behind a queue-like object.\n *\n * The high-level classes (`Queue`, `Worker`, `FlowProducer`, …) no longer\n * expose a `client` getter: they are datastore-agnostic and only know about\n * their backend. The raw Redis client is a Redis-specific escape hatch that","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/utils/get-redis-client.ts","text":"import { RedisQueueBackend } from '../../src/classes/redis-queue-backend';\nimport { RedisConnection } from '../../src/classes/redis-connection';\nimport { RedisClient } from '../../src/interfaces';\n\n/**\n * A queue-like object backed by the Redis adapter. The built-in classes\n * (`Queue`, `Worker`, `FlowProducer`) are parameterized on\n * {@link RedisQueueBackend} by default, so `getBackend()` returns the concrete\n * adapter and these helpers need no casting.\n */\ninterface RedisBackedTarget {\n  getBackend(): RedisQueueBackend;\n}\n\n/**\n * Test-only helper to reach the raw Redis client behind a queue-like object.\n *\n * The high-level classes (`Queue`, `Worker`, `FlowProducer`, …) no longer\n * expose a `client` getter: they are datastore-agnostic and only know about\n * their backend. The raw Redis client is a Redis-specific escape hatch that\n * lives on the concrete {@link RedisQueueBackend} implementation.\n *\n * This helper is a drop-in replacement for the old `await queue.client`: the\n * backend's `client` getter resolves once the underlying connection is ready.\n */\nexport function getRedisClient(\n  target: RedisBackedTarget,\n): Promise<RedisClient> {\n  return target.getBackend().client;\n}\n\n/**\n * Test-only helper to reach the raw blocking Redis client behind a worker-like\n * object (Redis-specific escape hatch on {@link RedisQueueBackend}). This is\n * the connection that registers as a worker (`:w:` suffix).\n *\n * Throws if the target's backend has no blocking client so call sites can\n * safely treat the result as a non-optional `Promise<RedisClient>`.\n */\nexport function getBlockingRedisClient(\n  target: RedisBackedTarget,\n): Promise<RedisClient> {\n  const blockingClient = target.getBackend().blockingClient;\n  if (!blockingClient) {\n    throw new Error(\n      'Target backend has no blocking Redis client (it was not created with a blocking connection)',\n    );\n  }\n  return blockingClient;\n}\n\n/**\n * Test-only helper to reach the underlying {@link RedisConnection} of a\n * queue-like object (Redis-specific escape hatch on {@link RedisQueueBackend}).\n */\nexport function getRedisConnection(target: RedisBackedTarget): RedisConnection {\n  return target.getBackend().connection;\n}\n\n/**\n * Test-only helper to reach the dedicated blocking {@link RedisConnection} of a\n * worker-like object (Redis-specific escape hatch on {@link RedisQueueBackend}).\n *\n * Throws if the target's backend has no blocking connection so call sites can\n * safely treat the result as a non-optional `RedisConnection`.\n */\nexport function getBlockingRedisConnection(\n  target: RedisBackedTarget,\n): RedisConnection {\n  const blockingConnection = target.getBackend().blockingConnection;\n  if (!blockingConnection) {\n    throw new Error(\n      'Target backend has no blocking connection (it was not created with a blocking connection)',\n    );\n  }\n  return blockingConnection;\n}\n\n/**\n * Test-only helper to read the detected Redis server version behind a\n * queue-like object (Redis-specific escape hatch on {@link RedisQueueBackend}).\n */\nexport function getRedisVersion(target: RedisBackedTarget): string {\n  return target.getBackend().redisVersion;\n}\n\n/**\n * Test-only helper to read the detected datastore flavour behind a queue-like\n * object (Redis-specific escape hatch on {@link RedisQueueBackend}).\n */\nexport function getDatabaseType(target: RedisBackedTarget): string {\n  return target.getBackend().databaseType;\n}","lineStart":1,"lineEnd":93,"totalLines":93,"truncated":false}},"title":"tests/utils/get-redis-client.ts","time":{"start":1789787844580,"end":1789787844595}},"metadata":{"openai":{"itemId":"fc_019901d092a7a0e3016aadfec4889887d1acf84898704f9dff"}},"id":"prt_0b7ab2fe30018f51bOS4daZYYX","sessionID":"ses_f4855cf73ffe37M114ntFFYqdE","messageID":"msg_0b7ab0eff001C8QL5TTZzeBTPE"}}
