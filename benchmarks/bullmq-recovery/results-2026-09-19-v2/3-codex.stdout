{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'moveStalledJobsToWait|extendLocks|extendJobLocks' src/classes/redis* src/classes/worker.ts; sed -n '725,810p' src/classes/job.ts; rg -n 'stalledCheck|moveStalled' tests/stalled_jobs.test.ts | head -20; git diff\"","aggregated_output":"src/classes/worker.ts:414:  async extendJobLocks(\nsrc/classes/worker.ts:419:    return this.backend.extendLocks(jobIds, tokens, duration);\nsrc/classes/worker.ts:1379:      await this.checkConnectionError(() => this.moveStalledJobsToWait());\nsrc/classes/worker.ts:1454:  private async moveStalledJobsToWait() {\nsrc/classes/worker.ts:1457:      'moveStalledJobsToWait',\nsrc/classes/worker.ts:1460:        const stalled = await this.backend.moveStalledJobsToWait();\nsrc/classes/redis-queue-backend.ts:1033:  async extendLocks(\nsrc/classes/redis-queue-backend.ts:1048:    return this.execCommand(client, 'extendLocks', args);\nsrc/classes/redis-queue-backend.ts:2090:  protected moveStalledJobsToWaitArgs(): (string | number)[] {\nsrc/classes/redis-queue-backend.ts:2122:  async moveStalledJobsToWait(): Promise<string[]> {\nsrc/classes/redis-queue-backend.ts:2125:    const args = this.moveStalledJobsToWaitArgs();\nsrc/classes/redis-queue-backend.ts:2127:    return this.execCommand(client, 'moveStalledJobsToWait', args);\n  async moveToFailed<E extends Error>(\n    err: E,\n    token: string,\n    fetchNext = false,\n  ): Promise<void | any[]> {\n    this.failedReason = err?.message;\n\n    // Check if an automatic retry should be performed\n    const [shouldRetry, retryDelay] = await this.shouldRetryJob(err);\n\n    return this.queue.trace<Promise<void | any[]>>(\n      SpanKind.INTERNAL,\n      this.getSpanOperation(shouldRetry, retryDelay),\n      this.queue.name,\n      async (span, dstPropagationMetadata) => {\n        this.setSpanJobAttributes(span);\n\n        let tm;\n        if (!this.opts?.telemetry?.omitContext && dstPropagationMetadata) {\n          tm = dstPropagationMetadata;\n        }\n        let result;\n\n        this.updateStacktrace(err);\n\n        const fieldsToUpdate = {\n          failedReason: this.failedReason,\n          stacktrace: JSON.stringify(this.stacktrace),\n          tm,\n        };\n\n        let finishedOn: number;\n        if (shouldRetry) {\n          if (retryDelay) {\n            // Retry with delay\n            result = await this.backend.moveToDelayed(\n              this.id,\n              Date.now(),\n              retryDelay,\n              token,\n              { fieldsToUpdate, fetchNext },\n            );\n\n            this.recordJobMetrics('delayed');\n          } else {\n            // Retry immediately\n            result = await this.backend.retryJob(\n              this.id,\n              this.opts.lifo,\n              token,\n              {\n                fieldsToUpdate,\n              },\n            );\n\n            this.recordJobMetrics('retried');\n          }\n        } else {\n          const moved = await this.backend.moveToFailed(\n            this,\n            this.failedReason,\n            this.opts.removeOnFail,\n            token,\n            fetchNext,\n            fieldsToUpdate,\n          );\n          result = moved.result;\n          finishedOn = moved.finishedOn;\n\n          // Only record failed metrics when job is not retrying\n          this.recordJobMetrics('failed');\n        }\n\n        if (finishedOn && typeof finishedOn === 'number') {\n          this.finishedOn = finishedOn;\n        }\n\n        if (retryDelay && typeof retryDelay === 'number') {\n          this.delay = retryDelay;\n        }\n\n        this.attemptsMade += 1;\n\n        return result;\n      },\n    );\ndiff --git a/src/commands/extendLock-2.lua b/src/commands/extendLock-2.lua\nindex 2d5ffe3..b84c686 100644\n--- a/src/commands/extendLock-2.lua\n+++ b/src/commands/extendLock-2.lua\n@@ -13,8 +13,7 @@\n     \"1\" if lock extended successfully.\n ]]\n local rcall = redis.call\n-if rcall(\"EXISTS\", KEYS[1]) == 1 then\n-  --   if rcall(\"SET\", KEYS[1], ARGV[1], \"PX\", ARGV[2], \"XX\") then\n+if rcall(\"GET\", KEYS[1]) == ARGV[1] then\n   if rcall(\"SET\", KEYS[1], ARGV[1], \"PX\", ARGV[2]) then\n     rcall(\"SREM\", KEYS[2], ARGV[3])\n     return 1\ndiff --git a/src/commands/extendLocks-1.lua b/src/commands/extendLocks-1.lua\nindex cce23e6..bbd5548 100644\n--- a/src/commands/extendLocks-1.lua\n+++ b/src/commands/extendLocks-1.lua\n@@ -30,7 +30,7 @@ for i = 1, jobCount, 1 do\n \n     local currentToken = rcall(\"GET\", lockKey)\n     if currentToken then\n-        if currentToken then\n+        if currentToken == token then\n             local setResult = rcall(\"SET\", lockKey, token, \"PX\", lockDuration)\n             if setResult then\n                 rcall(\"SREM\", stalledKey, jobId)\ndiff --git a/src/commands/includes/removeLock.lua b/src/commands/includes/removeLock.lua\nindex b8025cc..d7335f6 100644\n--- a/src/commands/includes/removeLock.lua\n+++ b/src/commands/includes/removeLock.lua\n@@ -2,7 +2,7 @@ local function removeLock(jobKey, stalledKey, token, jobId)\n   if token ~= \"0\" then\n     local lockKey = jobKey .. ':lock'\n     local lockToken = rcall(\"GET\", lockKey)\n-    if lockToken then\n+    if lockToken == token then\n       rcall(\"DEL\", lockKey)\n       rcall(\"SREM\", stalledKey, jobId)\n     else\ndiff --git a/src/commands/retryJob-11.lua b/src/commands/retryJob-11.lua\nindex 1beca80..e4b7dc2 100644\n--- a/src/commands/retryJob-11.lua\n+++ b/src/commands/retryJob-11.lua\n@@ -44,10 +44,6 @@ local rcall = redis.call\n local isPausedOrMaxed = isQueuePausedOrMaxed(KEYS[5], KEYS[1])\n local markerKey = KEYS[10]\n \n--- Check if there are delayed jobs that we can move to wait.\n--- test example: when there are delayed jobs between retries\n-promoteDelayedJobs(KEYS[7], markerKey, KEYS[2], KEYS[8], KEYS[6], ARGV[1], ARGV[2], KEYS[9], isPausedOrMaxed)\n-\n local jobKey = KEYS[4]\n \n if rcall(\"EXISTS\", jobKey) == 1 then\n@@ -56,6 +52,10 @@ if rcall(\"EXISTS\", jobKey) == 1 then\n     return errorCode\n   end\n \n+  -- Check if there are delayed jobs that we can move to wait.\n+  -- test example: when there are delayed jobs between retries\n+  promoteDelayedJobs(KEYS[7], markerKey, KEYS[2], KEYS[8], KEYS[6], ARGV[1], ARGV[2], KEYS[9], isPausedOrMaxed)\n+\n   updateJobFields(jobKey, ARGV[6])\n \n   local numRemovedElements = rcall(\"LREM\", KEYS[1], -1, ARGV[4])\n","exit_code":0,"status":"completed"}}
