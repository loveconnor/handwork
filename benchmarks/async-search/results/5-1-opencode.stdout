{"type":"tool_use","timestamp":1789170812383,"sessionID":"ses_f6d1d087bffessTYLtb0bYfogx","part":{"type":"tool","tool":"bash","callID":"call_cANz6mmUCo7oGV4YZ2WyVmP4","state":{"status":"completed","input":{"command":"node --input-type=module -e 'import assert from \"node:assert/strict\"; import { createSearchController } from \"./src/search/controller.ts\"; for (const fail of [false, true]) { for (const clear of [false, true]) { for (const newerFirst of [false, true]) { const pending = []; const c = createSearchController({ search: () => new Promise((resolve, reject) => pending.push({ resolve, reject })) }); const old = c.search(\"old\"); const current = c.search(clear ? \" \" : \"new\"); const items = [{ id: \"new\", title: \"New\", url: \"/new\" }]; if (!clear && newerFirst) { pending[1].resolve(items); await current; } const expected = c.getState(); if (fail) pending[0].reject(new Error(\"stale\")); else pending[0].resolve([{ id: \"old\", title: \"Old\", url: \"/old\" }]); await old; assert.deepEqual(c.getState(), expected); if (clear) assert.deepEqual(c.getState(), { query: \"\", results: [], loading: false, error: null }); else { if (!newerFirst) { assert.equal(c.getState().loading, true); pending[1].resolve(items); await current; } assert.deepEqual(c.getState(), { query: \"new\", results: items, loading: false, error: null }); } } } } console.log(\"Passed 8 stale success/failure, completion-order, and query-clear scenarios\");'"},"output":"Passed 8 stale success/failure, completion-order, and query-clear scenarios\n","metadata":{"output":"Passed 8 stale success/failure, completion-order, and query-clear scenarios\n","exit":0,"truncated":false},"title":"node --input-type=module -e 'import assert from \"node:assert/strict\"; import { createSearchController } from \"./src/search/controller.ts\"; for (const fail of [false, true]) { for (const clear of [false, true]) { for (const newerFirst of [false, true]) { const pending = []; const c = createSearchController({ search: () => new Promise((resolve, reject) => pending.push({ resolve, reject })) }); const old = c.search(\"old\"); const current = c.search(clear ? \" \" : \"new\"); const items = [{ id: \"new\", title: \"New\", url: \"/new\" }]; if (!clear && newerFirst) { pending[1].resolve(items); await current; } const expected = c.getState(); if (fail) pending[0].reject(new Error(\"stale\")); else pending[0].resolve([{ id: \"old\", title: \"Old\", url: \"/old\" }]); await old; assert.deepEqual(c.getState(), expected); if (clear) assert.deepEqual(c.getState(), { query: \"\", results: [], loading: false, error: null }); else { if (!newerFirst) { assert.equal(c.getState().loading, true); pending[1].resolve(items); await current; } assert.deepEqual(c.getState(), { query: \"new\", results: items, loading: false, error: null }); } } } } console.log(\"Passed 8 stale success/failure, completion-order, and query-clear scenarios\");'","time":{"start":1789170812379,"end":1789170812382}},"metadata":{"openai":{"itemId":"fc_00b226b22eb22a0f016aa4947c18e487d1b02002061343613f"}},"id":"prt_092e40593001im3iMJxRt6q8XU","sessionID":"ses_f6d1d087bffessTYLtb0bYfogx","messageID":"msg_092e3d14f001YdXKTJE6skKPSx"}}
