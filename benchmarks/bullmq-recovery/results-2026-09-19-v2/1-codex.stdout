{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"cat src/commands/moveStalledJobsToWait-8.lua | head -110; sed -n '2090,2132p' src/classes/redis-queue-backend.ts; rg -n 'extendLock\\\\(' src/classes/job.ts; rg -n 'getNextJob\\\\(' tests/stalled_jobs.test.ts | head\"","aggregated_output":"cat: src/commands/moveStalledJobsToWait-8.lua: No such file or directory\n  protected moveStalledJobsToWaitArgs(): (string | number)[] {\n    const opts = this.queue.opts as WorkerOptions;\n    const keys: (string | number)[] = [\n      this.queue.keys.stalled,\n      this.queue.keys.wait,\n      this.queue.keys.active,\n      this.queue.keys['stalled-check'],\n      this.queue.keys.meta,\n      this.queue.keys.paused,\n      this.queue.keys.marker,\n      this.queue.keys.events,\n      this.queue.keys.repeat,\n    ];\n    const args = [\n      opts.maxStalledCount,\n      this.queue.toKey(''),\n      Date.now(),\n      opts.stalledInterval,\n    ];\n\n    return keys.concat(args);\n  }\n\n  /**\n   * Looks for unlocked jobs in the active queue.\n   *\n   * The job was being worked on, but the worker process died and it failed to renew the lock.\n   * We call these jobs 'stalled'. This is the most common case. We resolve these by moving them\n   * back to wait to be re-processed. To prevent jobs from cycling endlessly between active and wait,\n   * (e.g. if the job handler keeps crashing),\n   * we limit the number stalled job recoveries to settings.maxStalledCount.\n   */\n  async moveStalledJobsToWait(): Promise<string[]> {\n    const client = await this.queue.client;\n\n    const args = this.moveStalledJobsToWaitArgs();\n\n    return this.execCommand(client, 'moveStalledJobsToWait', args);\n  }\n\n  /**\n   * Moves a job back from Active to Wait.\n   * This script is used when a job has been manually rate limited and needs\n629:  extendLock(token: string, duration: number): Promise<number> {\n630:    return this.backend.extendLock(this.id, token, duration);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/worker_ownership.redis.test.ts <<'EOF'\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest';\nimport { Queue, Worker } from '../src/classes';\nimport { randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { getRedisClient } from './utils/get-redis-client';\n\ndescribe('recovered job ownership (redis-only)', () => {\n  let queue: Queue;\n  let original: Worker;\n  let replacement: Worker;\n  let connection: ReturnType<typeof createTestConnection>;\n\n  beforeEach(async () => {\n    connection = createTestConnection();\n    const name = \"'`ownership-${randomUUID()}`;\n    const opts = {\n      connection,\n      prefix: process.env.BULLMQ_TEST_PREFIX || '\"'bull',\n      autorun: false,\n      skipLockRenewal: true,\n    };\n    queue = new Queue(name, opts);\n    original = new Worker(name, undefined, opts);\n    replacement = new Worker(name, undefined, opts);\n  });\n\n  afterEach(async () => {\n    await original.close();\n    await replacement.close();\n    await queue.obliterate({ force: true });\n    await queue.close();\n    await connection.quit();\n  });\n\n  async function recover(attempts = 1, backoff = 0) {\n    await queue.add('job', {}, { attempts, backoff });\n    const stale = (await original.getNextJob('original', { block: false }))\"'!;\n    const client = await getRedisClient(queue);\n    await client.del(queue.toKey(`${stale.id}:lock`));\n    await client.sadd(queue.keys.stalled, stale.id!);\n    expect(await replacement.getBackend().moveStalledJobsToWait()).toEqual([\n      stale.id,\n    ]);\n    const current = (await replacement.getNextJob('\"'replacement', {\n      block: false,\n    }))\"'!;\n    expect(current.id).toBe(stale.id);\n    return { stale, current, client };\n  }\n\n  for (const operation of ['\"'complete', 'fail', 'retry', 'delay']) {\n    it(\"'`rejects stale ${operation} without changing persisted data or events`, async () => {\n      const { stale, current, client } = await recover(\n        operation === '\"'retry' || operation === 'delay' ? 3 : 1,\n        operation === 'delay' ? 1000 : 0,\n      );\n      // A due delayed job must not be promoted by a rejected immediate retry.\n      const delayed = await queue.add('delayed', {}, { delay: 60000 });\n      await client.zadd(queue.keys.delayed, 0, delayed.id\"'!);\n      const snapshot = async () => ({\n        job: await client.hgetall(queue.toKey(stale.id!)),\n        lock: await client.get(queue.toKey(`${stale.id}:lock`)),\n        active: await client.lrange(queue.keys.active, 0, -1),\n        wait: await client.lrange(queue.keys.wait, 0, -1),\n        delayed: await client.zrange(queue.keys.delayed, 0, -1, '\"'WITHSCORES'),\n        events: await client.xrange(queue.keys.events, '-', '+'),\n      });\n      const before = await snapshot();\n      await expect(\n        operation === 'complete'\n          ? stale.moveToCompleted('stale result', 'original', false)\n          : stale.moveToFailed(new Error('stale failure'), 'original', false),\n      ).rejects.toThrow('Lock mismatch');\n      expect(await snapshot()).toEqual(before);\n      expect(await current.extendLock('replacement', 30000)).toBe(1);\n      await current.moveToCompleted('current result', 'replacement', false);\n      expect(await current.getState()).toBe('completed');\n    });\n  }\n\n  it('rejects stale single and batch renewals while preserving the current lock', async () => {\n    const { stale, current, client } = await recover();\n    const lockKey = queue.toKey(\"'`${stale.id}:lock`);\n    await client.sadd(queue.keys.stalled, stale.id!);\n    await client.pexpire(lockKey, 10000);\n    expect(await stale.extendLock('\"'original', 60000)).toBe(0);\n    expect(\n      await original.getBackend().extendLocks([stale.id\"'!], ['\"'original'], 60000),\n    ).toEqual([stale.id]);\n    expect(await client.get(lockKey)).toBe('replacement');\n    expect(await client.pttl(lockKey)).toBeLessThanOrEqual(10000);\n    expect(await client.smembers(queue.keys.stalled)).toContain(stale.id);\n    expect(\n      await replacement.getBackend().extendLocks([current.id\"'!], ['\"'replacement'], 30000),\n    ).toEqual([]);\n    expect(await client.pttl(lockKey)).toBeGreaterThan(10000);\n    expect(await client.smembers(queue.keys.stalled)).not.toContain(stale.id);\n    await current.moveToCompleted('ok', 'replacement', false);\n  });\n\n  it('keeps missing locks as errors and does not recreate them during renewal', async () => {\n    const { current, client } = await recover();\n    const lockKey = queue.toKey(\"'`${current.id}:lock`);\n    await client.del(lockKey);\n    expect(await current.extendLock('\"'replacement', 30000)).toBe(0);\n    expect(\n      await replacement.getBackend().extendLocks([current.id\"'!], ['\"'replacement'], 30000),\n    ).toEqual([current.id]);\n    await expect(current.moveToCompleted('ok', 'replacement', false)).rejects.toThrow('Missing lock');\n    expect(await client.get(lockKey)).toBeNull();\n    expect(await current.getState()).toBe('active');\n  });\n});\nEOF\nnpm run build > /tmp/bullmq-build.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
