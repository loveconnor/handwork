shared prefixes and punctuation stay isolated in both caching and invalidation.","ttft_ms":1826,"type":"result","duration_ms":51638,"uuid":"abc8b144-899b-4bc5-9fe7-440cd9ed2825","ttft_stream_ms":770,"time_to_request_ms":23,"first_content_frame_ms":770,"queued_turn_count":0,"result_index":0}
