tup.ts'],\n45: \n46:     // Run tests sequentially by default (can be overridden with --parallel)\n47:     // This is important for Redis-based tests to avoid conflicts\n48:     sequence: {\n49:       concurrent: false,\n50:     },\n51: \n52:     // Reporter\n53:     reporters: ['verbose'],\n54: \n55:     // Coverage configuration.\n56:     //\n57:     // NOTE: `yarn coverage` uses `vitest.coverage.config.ts`, which runs the\n58:     // union of the default and ioredis-only suites so adapter-agnostic and\n59:     // ioredis-specific code paths (sandboxed_process, cluster, connection)\n60:     // are both included. The settings here only apply to ad-hoc invocations\n61:     // of `vitest --coverage` against this default config and intentionally\n62:     // exclude modules that have no coverage in this suite.\n63:     coverage: {\n64:       provider: 'v8',\n65:       include: ['src/**/*.ts'],\n66:       exclude: ['src/enums/*.ts', 'src/interfaces/*.ts'],\n67:       reporter: ['text', 'lcov'],\n68:       // Coverage thresholds (migrated from c8 config)\n69:       thresholds: {\n70:         lines: 80,\n71:         functions: 80,\n72:         branches: 70,\n73:         statements: 80,\n74:       },\n75:     },\n76: \n77:     // Globals (describe, it, expect, etc.) - we'll use explicit imports instead\n78:     globals: false,\n79:   },\n80: });\n\n(End of file - total 80 lines)\n</content>","metadata":{"preview":"import { defineConfig } from 'vitest/config';\n\nexport default defineConfig({\n  test: {\n    // Test files follow the pattern *.test.ts (new Vitest tests)\n    include: ['tests/**/*.test.ts'],\n\n    // Exclude adapter-specific smoke tests, ioredis-specific tests, and legacy files.\n    // The adapter-agnostic suite must be identical for ioredis, node-redis, and bun.\n    // ioredis-specific tests (cluster, connection, sandboxed_process) run separately\n    // via test:ioredis.\n    exclude: [\n      // ioredis-specific tests (direct ioredis imports / cluster /