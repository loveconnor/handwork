domUUID()}`;\n\n      const parentQueue = new Queue(parentQueueName, { connection, prefix });\n      const parentWorker = new Worker(parentQueueName, null, {\n        connection,\n        prefix,\n      });\n      const childrenWorker = new Worker(queueName, null, {\n        connection,\n","exit_code":0,"status":"completed"}}
