, results: [], loading: false, error: null });\n  d.res([{ id: 'a', title: 'A', url: '' }]); await p;\n  assert.deepEqual(c.getState(), { query: '', results: [], loading: false, error: null });\n});\nEOF\nnode --test /tmp/race-check.test.ts 2>&1 | tail -10; rm /tmp/race-check.test.ts","description":"Apply request-token guard, run tests and a temporary race check"}}}
