{"type":"tool_use","timestamp":1789791116584,"sessionID":"ses_f4824f550ffeaBmxcEcK2h5aW9","part":{"type":"tool","tool":"apply_patch","callID":"call_aQVvE3uV8vBdXKp5hq95EW2n","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Add File: /private/tmp/handwork-bullmq-G7VJT5/3-opencode/repo/tests/worker-ownership.redis.test.ts\n+import { afterEach, beforeEach, describe, expect, it } from 'vitest';\n+import { Job, Queue, Worker } from '../src/classes';\n+import { IRedisClient } from '../src/interfaces';\n+import { randomUUID, removeAllQueueData } from '../src/utils';\n+import { createTestConnection } from './utils/connection-factory';\n+import { getRedisClient } from './utils/get-redis-client';\n+\n+describe('Recovered job ownership (redis-only)', () => {\n+  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n+  let connection: IRedisClient;\n+  let queue: Queue;\n+  let original: Worker;\n+  let replacement: Worker;\n+\n+  beforeEach(() => {\n+    connection = createTestConnection();\n+    const name = `test-${randomUUID()}`;\n+    queue = new Queue(name, { connection, prefix });\n+    original = new Worker(name, null, { connection, prefix });\n+    replacement = new Worker(name, null, { connection, prefix });\n+  });\n+\n+  afterEach(async () => {\n+    await original.close();\n+    await replacement.close();\n+    await queue.close();\n+    await removeAllQueueData(createTestConnection(), queue.name);\n+    await connection.quit();\n+  });\n+\n+  async function recover(attempts = 1, backoff = 0) {\n+    await queue.add('job', {}, { attempts, backoff: { type: 'fixed', delay: backoff } });\n+    const stale = (await original.getNextJob('original')) as Job;\n+    const client = await getRedisClient(queue);\n+    // Deterministically simulate a crashed worker's expired lock, then use\n+    // normal stalled recovery and acquisition by a different worker.\n+    await client.del(queue.toKey(`${stale.id}:lock`));\n+    await client.sadd(queue.keys.stalled, stale.id!);\n+    expect(await replacement.getBackend().moveStalledJobsToWait()).toEqual([stale.id]);\n+    const current = (await replacement.getNextJob('replacement')) as Job;\n+    expect(current.id).toBe(stale.id);\n+    return { stale, current, client };\n+  }\n+\n+  for (const operation of ['complete', 'fail', 'retry', 'delayed retry']) {\n+    it(`rejects stale ${operation} without mutating the recovered job or events`, async () => {\n+      const { stale, current, client } = await recover(\n+        operation.includes('retry') ? 3 : 1,\n+        operation === 'delayed retry' ? 5000 : 0,\n+      );\n+      // A due delayed job must not be promoted by a rejected immediate retry.\n+      const delayed = await queue.add('delayed', {}, { delay: 60000 });\n+      await client.zadd(queue.keys.delayed, 0, delayed.id!);\n+      const snapshot = async () => ({\n+        job: await client.hgetall(queue.toKey(stale.id!)),\n+        lock: await client.get(queue.toKey(`${stale.id}:lock`)),\n+        active: await client.lrange(queue.keys.active, 0, -1),\n+        wait: await client.lrange(queue.keys.wait, 0, -1),\n+        delayed: await client.zrange(queue.keys.delayed, 0, -1, 'WITHSCORES'),\n+        events: await client.xrange(queue.keys.events, '-', '+'),\n+      });\n+      const before = await snapshot();\n+      const action = operation === 'complete'\n+        ? stale.moveToCompleted('stale result', 'original', false)\n+        : stale.moveToFailed(new Error('stale failure'), 'original', false);\n+      await expect(action).rejects.toThrow('Lock mismatch');\n+      expect(await snapshot()).toEqual(before);\n+      expect(await current.getState()).toBe('active');\n+      expect(await current.extendLock('replacement', 60000)).toBe(1);\n+      await current.moveToCompleted('current result', 'replacement', false);\n+      const finished = await queue.getJob(current.id!);\n+      expect(finished!.returnvalue).toBe('current result');\n+      expect(finished!.attemptsMade).toBe(1);\n+      expect(await finished!.getState()).toBe('completed');\n+    });\n+  }\n+\n+  it('rejects stale single and batch renewals while allowing current owners', async () => {\n+    const { stale, current, client } = await recover();\n+    const lockKey = queue.toKey(`${stale.id}:lock`);\n+    await client.sadd(queue.keys.stalled, stale.id!);\n+    const ttl = await client.pttl(lockKey);\n+    expect(await stale.extendLock('original', 120000)).toBe(0);\n+    expect(await original.extendJobLocks([stale.id!], ['original'], 120000)).toEqual([stale.id]);\n+    expect(await client.get(lockKey)).toBe('replacement');\n+    expect(await client.pttl(lockKey)).toBeLessThanOrEqual(ttl);\n+    expect(await client.sismember(queue.keys.stalled, stale.id!)).toBe(1);\n+\n+    expect(await current.extendLock('replacement', 60000)).toBe(1);\n+    expect(await replacement.extendJobLocks([current.id!], ['replacement'], 120000)).toEqual([]);\n+    expect(await client.pttl(lockKey)).toBeGreaterThan(60000);\n+    expect(await client.sismember(queue.keys.stalled, current.id!)).toBe(0);\n+    await current.moveToCompleted('done', 'replacement', false);\n+  });\n+\n+  it('does not recreate missing locks and retains the administrative token', async () => {\n+    const { current, client } = await recover();\n+    const lockKey = queue.toKey(`${current.id}:lock`);\n+    await client.del(lockKey);\n+    expect(await current.extendLock('replacement', 60000)).toBe(0);\n+    expect(await replacement.extendJobLocks([current.id!], ['replacement'], 60000)).toEqual([current.id]);\n+    await expect(current.moveToCompleted('done', 'replacement', false)).rejects.toThrow('Missing lock');\n+    expect(await client.exists(lockKey)).toBe(0);\n+    await current.moveToCompleted('admin result', '0', false);\n+    expect(await current.getState()).toBe('completed');\n+  });\n+});\n*** End Patch"},"output":"Success. Updated the following files:\nA tests/worker-ownership.redis.test.ts","metada