{"type":"tool_use","timestamp":1789787835976,"sessionID":"ses_f4855cf73ffe37M114ntFFYqdE","part":{"type":"tool","tool":"read","callID":"call_HeuIdaQTbGwT57HAqZAd0NAT","state":{"status":"completed","input":{"filePath":"/private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/job.redis.test.ts","limit":160},"output":"<path>/private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/job.redis.test.ts</path>\n<type>file</type>\n<content>\n1: 'use strict';\n2: \n3: /**\n4:  * Redis-only tests for `Job`.\n5:  *\n6:  * These exercise Redis-specific internals (raw job/dependency hashes, the\n7:  * `:processed` set, deleting the meta key, low-level `addJob` with a client)\n8:  * that have no backend-agnostic equivalent. They live in a dedicated\n9:  * `*.redis.test.ts` suite excluded from the cross-backend runs.\n10:  */\n11: import { getRedisClient } from './utils/get-redis-client';\n12: import {\n13:   describe,\n14:   beforeEach,\n15:   afterEach,\n16:   beforeAll,\n17:   afterAll,\n18:   it,\n19:   expect,\n20: } from 'vitest';\n21: \n22: import { Job, Queue, Worker } from '../src/classes';\n23: import {\n24:   delay,\n25:   getParentKey,\n26:   randomUUID,\n27:   removeAllQueueData,\n28: } from '../src/utils';\n29: import { createTestConnection } from './utils/connection-factory';\n30: import { IRedisClient } from '../src/interfaces';\n31: \n32: describe('Job (redis-only)', () => {\n33:   const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n34: \n35:   let queue: Queue;\n36:   let queueName: string;\n37:   let connection: IRedisClient;\n38:   beforeAll(async () => {\n39:     connection = createTestConnection();\n40:   });\n41: \n42:   beforeEach(async () => {\n43:     queueName = `test-${randomUUID()}`;\n44:     queue = new Queue(queueName, { connection, prefix });\n45:   });\n46: \n47:   afterEach(async () => {\n48:     await queue.close();\n49:     await removeAllQueueData(createTestConnection(), queueName);\n50:   });\n51: \n52:   afterAll(async function () {\n53:     await connection.quit();\n54:   });\n55: \n56:   describe('.remove', () => {\n57:     it('removes processed hash', async () => {\n58:       const client = await getRedisClient(queue);\n59:       const values = [{ idx: 0, bar: 'something' }];\n60:       const token = 'my-token';\n61:       const token2 = 'my-token2';\n62:       const parentQueueName = `parent-queue-${randomUUID()}`;\n63: \n64:       const parentQueue = new Queue(parentQueueName, { connection, prefix });\n65:       const parentWorker = new Worker(parentQueueName, null, {\n66:         connection,\n67:         prefix,\n68:       });\n69:       const childrenWorker = new Worker(queueName, null, {\n70:         connection,\n71:         prefix,\n72:       });\n73:       await parentWorker.waitUntilReady();\n74:       await childrenWorker.waitUntilReady();\n75: \n76:       const data = { foo: 'bar' };\n77:       const parent = await Job.create(parentQueue, 'testParent', data);\n78:       await Job.create(queue, 'testJob1', values[0], {\n79:         parent: { id: parent.id, queue: `${prefix}:${parentQueueName}` },\n80:       });\n81: \n82:       const job = (await parentWorker.getNextJob(token)) as Job;\n83:       const child1 = (await childrenWorker.getNextJob(token2)) as Job;\n84: \n85:       const isActive = await job.isActive();\n86:       expect(isActive).toBe(true);\n87: \n88:       await child1.moveToCompleted('return value', token2);\n89: \n90:       const parentId = job.id;\n91:       await job.moveToCompleted('return value', token);\n92:       await job.remove();\n93: \n94:       const storedJob = await Job.fromId(parentQueue, job.id);\n95:       expect(storedJob).toBe(undefined);\n96: \n97:       const processed = await client.hgetall(\n98:         `${prefix}:${parentQueueName}:${parentId}:processed`,\n99:       );\n100: \n101:       expect(processed).toEqual({});\n102: \n103:       await childrenWorker.close();\n104:       await parentWorker.close();\n105:       await parentQueue.close();\n106:       await removeAllQueueData(createTestConnection(), parentQueueName);\n107:     });\n108:   });\n109: \n110:   describe('.moveToCompleted', () => {\n111:     /**\n112:      * Verify moveToFinished use default value for opts.maxLenEvents\n113:      * if it does not exist in meta key (or entire meta key is missing).\n114:      */\n115:     it('should not fail if queue meta key is missing', async () => {\n116:       const worker = new Worker(queueName, null, { connection, prefix });\n117:       const token = 'my-token';\n118:       await Job.create(queue, 'test', { color: 'red' });\n119:       const job = (await worker.getNextJob(token)) as Job;\n120:       const client = await getRedisClient(queue);\n121:       await client.del(queue.toKey('meta'));\n122:       await job.moveToCompleted('done', '0', false);\n123:       const state = await job.getState();\n124:       expect(state).toBe('completed');\n125:       await worker.close();\n126:     });\n127: \n128:     it('should not complete a parent job before its children', async () => {\n129:       const values = [\n130:         { idx: 0, bar: 'something' },\n131:         { idx: 1, baz: 'something' },\n132:       ];\n133:       const token = 'my-token';\n134: \n135:       const parentQueueName = `parent-queue-${randomUUID()}`;\n136: \n137:       const parentQueue = new Queue(parentQueueName, { connection, prefix });\n138: \n139:       const parentWorker = new Worker(parentQueueName, null, {\n140:         connection,\n141:         prefix,\n142:       });\n143:       const childrenWorker = new Worker(queueName, null, {\n144:         connection,\n145:         prefix,\n146:       });\n147:       await parentWorker.waitUntilReady();\n148:       await childrenWorker.waitUntilReady();\n149: \n150:       const data = { foo: 'bar' };\n151:       const parent = await Job.create(parentQueue, 'testParent', data);\n152:       const parentKey = getParentKey({\n153:         id: parent.id!,\n154:         queue: `${prefix}:${parentQueueName}`,\n155:       });\n156:       const client = await getRedisClient(queue);\n157:       const child1 = new Job(queue, 'testJob1', values[0]);\n158:       await child1.addJob(client, {\n159:         parentKey,\n160:         parentDependenciesKey: `${parentKey}:dependencies`,\n\n(Showing lines 1-160 of 228. Use offset=161 to continue.)\n</content>","metadata":{"preview":"'use strict';\n\n/**\n * Redis-only tests for `Job`.\n *\n * These exercise Redis-specific internals (raw job/dependency hashes, the\n * `:processed` set, deleting the meta key, low-level `addJob` with a client)\n * that have no backend-agnostic equivalent. They live in a dedicated\n * `*.redis.test.ts` suite excluded from the cross-backend runs.\n */\nimport { getRedisClient } from './utils/get-redis-client';\nimport {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';","truncated":true,"loaded":[],"display":{"type":"file","path":"/private/tmp/handwork-bullmq-G7VJT5/1-opencode/repo/tests/job.redis.test.ts","text":"'use strict';\n\n/**\n * Redis-only tests for `Job`.\n *\n * These exercise Redis-specific internals (raw job/dependency hashes, the\n * `:processed` set, deleting the meta key, low-level `addJob` with a client)\n * that have no backend-agnostic equivalent. They live in a dedicated\n * `*.redis.test.ts` suite excluded from the cross-backend runs.\n */\nimport { getRedisClient } from './utils/get-redis-client';\nimport {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\n\nimport { Job, Queue, Worker } from '../src/classes';\nimport {\n  delay,\n  getParentKey,\n  randomUUID,\n  removeAllQueueData,\n} from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { IRedisClient } from '../src/interfaces';\n\ndescribe('Job (redis-only)', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n\n  let queue: Queue;\n  let queueName: string;\n  let connection: IRedisClient;\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n  });\n\n  afterEach(async () => {\n    await queue.close();\n    await removeAllQueueData(createTestConnection(), queueName);\n  });\n\n  afterAll(async function () {\n    await connection.quit();\n  });\n\n  describe('.remove', () => {\n    it('removes processed hash', async () => {\n      const client = await getRedisClient(queue);\n      const values = [{ idx: 0, bar: 'something' }];\n      const token = 'my-token';\n      const token2 = 'my-token2';\n      const parentQueueName = `parent-queue-${randomUUID()}`;\n\n      const parentQueue = new Queue(parentQueueName, { connection, prefix });\n      const parentWorker = new Worker(parentQueueName, null, {\n        connection,\n        prefix,\n      });\n      const childrenWorker = new Worker(queueName, null, {\n        connection,\n        prefix,\n      });\n      await parentWorker.waitUntilReady();\n      await childrenWorker.waitUntilReady();\n\n      const data = { foo: 'bar' };\n      const parent = await Job.create(parentQueue, 'testParent', data);\n      await Job.create(queue, 'testJob1', values[0], {\n        parent: { id: parent.id, queue: `${prefix}:${parentQueueName}` },\n      });\n\n      const job = (await parentWorker.getNextJob(token)) as Job;\n      const child1 = (await childrenWorker.getNextJob(token2)) as Job;\n\n      const isActive = await job.isActive();\n      expect(isActive).toBe(true);\n\n      await child1.moveToCompleted('return value', token2);\n\n      const parentId = job.id;\n      await job.moveToCompleted('return value', token);\n      await job.remove();\n\n      const storedJob = await Job.fromId(parentQueue, job.id);\n      expect(storedJob).toBe(undefined);\n\n      const processed = await client.hgetall(\n        `${prefix}:${parentQueueName}:${parentId}:processed`,\n      );\n\n      expect(processed).toEqual({});\n\n      await childrenWorker.close();\n      await parentWorker.close();\n      await parentQueue.close();\n      await removeAllQueueData(createTestConnection(), parentQueueName);\n    });\n  });\n\n  describe('.moveToCompleted', () => {\n    /**\n     * Verify moveToFinished use default value for opts.maxLenEvents\n     * if it does not exist in meta key (or entire meta key is missing).\n     */\n    it('should not fail if queue meta key is missing', async () => {\n      const worker = new Worker(queueName, null, { connection, prefix });\n      const token = 'my-token';\n      await Job.create(queue, 'test', { color: 'red' });\n      const job = (await worker.getNextJob(token)) as Job;\n      const client = await getRedisClient(queue);\n      await client.del(queue.toKey('meta'));\n      await job.moveToCompleted('done', '0', false);\n      const state = await job.getState();\n      expect(state).toBe('completed');\n      await worker.close();\n    });\n\n    it('should not complete a parent job before its children', async () => {\n      const values = [\n        { idx: 0, bar: 'something' },\n        { idx: 1, baz: 'something' },\n      ];\n      const token = 'my-token';\n\n      const parentQueueName = `parent-queue-${randomUUID()}`;\n\n      const parentQueue = new Queue(parentQueueName, { connection, prefix });\n\n      const parentWorker = new Worker(parentQueueName, null, {\n        connection,\n        prefix,\n      });\n      const childrenWorker = new Worker(queueName, null, {\n        connection,\n        prefix,\n      });\n      await parentWorker.waitUntilReady();\n      await childrenWorker.waitUntilReady();\n\n      const data = { foo: 'bar' };\n      const parent = await Job.create(parentQueue, 'testParent', data);\n      const parentKey = getParentKey({\n        id: parent.id!,\n        queue: `${prefix}:${parentQueueName}`,\n      });\n      const client = await getRedisClient(queue);\n      const child1 = new Job(queue, 'testJob1', values[0]);\n      await child1.addJob(client, {\n        parentKey,\n        parentDependenciesKey: `${parentKey}:dependencies`,","lineStart":1,"lineEnd":160,"totalLines":228,"truncated":true}},"title":"tests/job.redis.test.ts","time":{"start":1789787835961,"end":1789787835975}},"metadata":{"openai":{"itemId":"fc_0c6b1b0bdde25505016aadfebbe44887d1ad80d002a23d0142"}},"id":"prt_0b7ab0e06001eIrdMkHFnGigrx","sessionID":"ses_f4855cf73ffe37M114ntFFYqdE","messageID":"msg_0b7aaf1ed001SIDDvD8So6zTmQ"}}
