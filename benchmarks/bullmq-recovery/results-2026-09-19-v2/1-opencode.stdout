  jobid\n\n  Output:\n    \"1\" if lock extended successfully.\n]]\nlocal rcall = redis.call\nif rcall(\"EXISTS\", KEYS[1]) == 1 then\n  --   if rcall(\"SET\", KEYS[1], ARGV[1], \"PX\", ARGV[2], \"XX\") then\n  if rcall(\"SET\", KEYS[1], ARGV[1], \"PX\", ARGV[2]) then\n    rcall(\"SREM\", KEYS[2], ARGV[3])\n    return 1\n  end\nend\nreturn 0","lineStart":1,"lineEnd":23,"totalLines":23,"truncated":false}},"title":"src/commands/extendLock-2.lua","time":{"start":1789787799940,"end":1789787799943}},"metadata":{"openai":{"itemId":"fc_0c91e3c6b0042ce8016aadfe961b7487d18c44dafc54390c29"}},"id":"prt_0b7aa7a58001oRP437ACunUYSj","sessionID":"ses_f4855cf73ffe37M114ntFFYqdE","messageID":"msg_0b7aa72af001Yn2yqddlXhY81N"}}
