{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"cat src/commands/includes/isQueuePausedOrMaxed.lua; tail -8 /tmp/bullmq-regression.log; tail -7 /tmp/bullmq-build.log; rg -n 'token.*0|Missing lock|Lock mismatch' tests/job.test.ts tests/worker.test.ts tests/lock_manager.test.ts | head -25\"","aggregated_output":"--[[\n  Function to check if queue is paused or maxed\n  (since an empty list and !EXISTS are not really the same).\n]]\n\nlocal function isQueuePausedOrMaxed(queueMetaKey, activeKey)\n  local queueAttributes = rcall(\"HMGET\", queueMetaKey, \"paused\", \"concurrency\")\n\n  if queueAttributes[1] then\n    return true\n  else\n    if queueAttributes[2] then\n      local activeCount = rcall(\"LLEN\", activeKey)\n      return activeCount >= tonumber(queueAttributes[2])\n    end\n  end\n  return false\nend\n ✓ tests/worker.test.ts > workers > max started attempts cannot be less than zero 3ms\n ✓ tests/worker.test.ts > workers > stalled interval cannot be zero 3ms\n ✓ tests/worker.test.ts > workers > drain delay cannot be zero 3ms\n ✓ tests/worker.test.ts > workers > lock extender continues to run until all active jobs are completed when closing a worker 2007ms\n ✓ tests/worker.test.ts > workers > Concurrency process > should thrown an exception if I specify a concurrency of 0 4ms\n ✓ tests/worker.test.ts > workers > Concurrency process > should thrown an exception if I specify a NaN concurrency 3ms\n ✓ tests/worker.test.ts > workers > Concurrency process > should run job in sequence if I specify a concurrency of 1 112ms\n ✓ tests/worker.test.ts > workers > Concurrency process > should process job respecting the concurrency set 1233ms\n> bullmq@6.3.8 copy:includes:lua\n> cpx \"./src/commands/includes/*.lua\" ./dist/cjs/commands/includes && cpx \"./src/commands/includes/*.lua\" ./dist/esm/commands/includes\n\n\n> bullmq@6.3.8 copy:sql\n> cpx \"./src/postgres/migrations/*.sql\" ./dist/cjs/postgres/migrations && cpx \"./src/postgres/migrations/*.sql\" ./dist/esm/postgres/migrations && cpx \"./src/postgres/commands/*.sql\" ./dist/cjs/postgres/commands && cpx \"./src/postgres/commands/*.sql\" ./dist/esm/postgres/commands\n\ntests/lock_manager.test.ts:398:      lockManager.trackJob('job-1', 'token-1', 0);\ntests/worker.test.ts:4956:            `Missing lock for job ${parent.id}. moveToWaitingChildren`,\n","exit_code":0,"status":"completed"}}
