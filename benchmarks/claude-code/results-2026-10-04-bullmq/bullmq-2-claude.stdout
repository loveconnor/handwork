{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfhPjRhoiitF5BQ3YPW9d","type":"message","role":"assistant","content":[{"type":"text","text":"Source fix is in; now adding a regression test for the stale-worker scenarios, then rebuilding and running the suite."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1408,"cache_read_input_tokens":52075,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1408},"output_tokens":60,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1dbf0a0c-dc90-4fd8-bb5e-42123f53969d","uuid":"f6e998fa-4bbb-4259-9386-4d68efad403c","timestamp":"2026-10-04T14:57:18.612Z","request_id":"req_011CfhPjRQh6N1LJf1DKk5vu"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfhPjRhoiitF5BQ3YPW9d","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Y7P9gPp8FGbkpy32xsLJUU","name":"Write","input":{"file_path":"/private/tmp/handwork-claude-7lla1sj1/bullmq-2-claude/repo/tests/stale_worker_lock.redis.test.ts","content":"import { getRedisClient } from './utils/get-redis-client';\nimport { Job, Queue, Worker } from '../src/classes';\nimport { ErrorCode } from '../src/enums';\nimport { randomUUID } from '../src/utils';\nimport {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\nimport { createTestConnection } from './utils/connection-factory';\nimport { cleanupQueue } from './utils/cleanup-queue';\nimport { IRedisClient } from '../src/interfaces';\n\ndescribe('stale worker lock ownership', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n  const staleToken = 'stale-token';\n  const ownerToken = 'owner-token';\n\n  let queue: Queue;\n  let queueName: string;\n  let staleWorker: Worker;\n  let ownerWorker: Worker;\n\n  let connection: IRedisClient;\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n    staleWorker = new Worker(queueName, null, { connection, prefix });\n    ownerWorker = new Worker(queueName, null, { connection, prefix });\n  });\n\n  afterEach(async () => {\n    await staleWorker.close();\n    await ownerWorker.close();\n    await queue.close();\n    await cleanupQueue(queueName);\n  });\n\n  afterAll(async function () {\n    await connection.quit();\n  });\n\n  const lockKey = (jobId: string) => `${prefix}:${queueName}:${jobId}:lock`;\n\n  /**\n   * The stale worker picks the job, loses its lock, the job is recovered by\n   * the stalled checker and claimed by the owner worker.\n   */\n  const recoverJob = async (opts = {}) => {\n    await queue.add('test', { foo: 'bar' }, opts);\n\n    const staleJob = (await staleWorker.getNextJob(staleToken)) as Job;\n\n    const client = await getRedisClient(queue);\n    await client.del(lockKey(staleJob.id!));\n\n    await (ownerWorker as any).moveStalledJobsToWait();\n    await client.del(`${prefix}:${queueName}:stalled-check`);\n    await (ownerWorker as any).moveStalledJobsToWait();\n\n    const ownerJob = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    expect(ownerJob.id).toBe(staleJob.id);\n\n    return { staleJob, ownerJob, client };\n  };\n\n  const snapshot = async (client: any, jobId: string) => {\n    const events = await client.xlen(`${prefix}:${queueName}:events`);\n    const job = await queue.getJob(jobId);\n    return {\n      events,\n      state: await job!.getState(),\n      attemptsMade: job!.attemptsMade,\n      attemptsStarted: job!.attemptsStarted,\n      stalledCounter: job!.stalledCounter,\n      returnvalue: job!.returnvalue,\n      failedReason: job!.failedReason,\n      stacktrace: job!.stacktrace,\n      finishedOn: job!.finishedOn,\n      delay: job!.delay,\n      lock: await client.get(lockKey(jobId)),\n    };\n  };\n\n  const expectRejected = async (\n    opts: any,\n    operation: (job: Job) => Promise<any>,\n  ) => {\n    const { staleJob, ownerJob, client } = await recoverJob(opts);\n    const before = await snapshot(client, staleJob.id!);\n    expect(before.state).toBe('active');\n    expect(before.lock).toBe(ownerToken);\n\n    await expect(operation(staleJob)).rejects.toMatchObject({\n      code: ErrorCode.JobLockMismatch,\n    });\n\n    expect(await snapshot(client, staleJob.id!)).toEqual(before);\n\n    // The current owner is still able to renew and finish the job.\n    expect(await ownerJob.extendLock(ownerToken, 30000)).toBe(1);\n    await ownerJob.moveToCompleted('owner', ownerToken, false);\n    expect(await ownerJob.getState()).toBe('completed');\n    expect((await queue.getJob(ownerJob.id!))!.returnvalue).toBe('owner');\n  };\n\n  it('does not let a stale worker complete a recovered job', async () => {\n    await expectRejected({}, job =>\n      job.moveToCompleted('stale', staleToken, false),\n    );\n  });\n\n  it('does not let a stale worker fail a recovered job', async () => {\n    await expectRejected({}, job =>\n      job.moveToFailed(new Error('stale'), staleToken, false),\n    );\n  });\n\n  it('does not let a stale worker retry a recovered job', async () => {\n    await expectRejected({ attempts: 3 }, job =>\n      job.moveToFailed(new Error('stale'), staleToken, false),\n    );\n  });\n\n  it('does not let a stale worker schedule a delayed retry', async () => {\n    await expectRejected(\n      { attempts: 3, backoff: { type: 'fixed', delay: 1000 } },\n      job => job.moveToFailed(new Error('stale'), staleToken, false),\n    );\n  });\n\n  it('does not let a stale worker move a recovered job back to wait or delayed', async () => {\n    await expectRejected({}, job => job.moveToWait(staleToken));\n    await queue.drain();\n    await expectRejected({}, job =>\n      job.moveToDelayed(Date.now() + 1000, staleToken),\n    );\n  });\n\n  it('does not let a stale worker renew the lock of the current owner', async () => {\n    const { staleJob, ownerJob, client } = await recoverJob();\n    const key = lockKey(staleJob.id!);\n    await client.pexpire(key, 5000);\n\n    expect(await staleJob.extendLock(staleToken, 60000)).toBe(0);\n    expect(await client.get(key)).toBe(ownerToken);\n    expect(await client.pttl(key)).toBeLessThanOrEqual(5000);\n\n    const failed = await (staleWorker as any).extendJobLocks(\n      [staleJob.id],\n      [staleToken],\n      60000,\n    );\n    expect(failed).toEqual([staleJob.id]);\n    expect(await client.get(key)).toBe(ownerToken);\n    expect(await client.pttl(key)).toBeLessThanOrEqual(5000);\n\n    const renewed = await (ownerWorker as any).extendJobLocks(\n      [ownerJob.id],\n      [ownerToken],\n      60000,\n    );\n    expect(renewed).toEqual([]);\n    expect(await client.pttl(key)).toBeGreaterThan(5000);\n\n    await ownerJob.moveToCompleted('owner', ownerToken, false);\n  });\n\n  it('only renews the locks owned by the caller in a batch', async () => {\n    await queue.add('test', { idx: 1 });\n    await queue.add('test', { idx: 2 });\n    const first = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    const second = (await staleWorker.getNextJob(staleToken)) as Job;\n    const client = await getRedisClient(queue);\n    await client.pexpire(lockKey(second.id!), 5000);\n\n    const failed = await (ownerWorker as any).extendJobLocks(\n      [first.id, second.id, 'missing'],\n      [ownerToken, ownerToken, ownerToken],\n      60000,\n    );\n\n    expect(failed).toEqual([second.id, 'missing']);\n    expect(await client.get(lockKey(second.id!))).toBe(staleToken);\n    expect(await client.pttl(lockKey(second.id!))).toBeLessThanOrEqual(5000);\n    expect(await client.exists(lockKey('missing'))).toBe(0);\n  });\n\n  it('keeps reporting a missing lock as an error', async () => {\n    await queue.add('test', { foo: 'bar' });\n    const job = (await staleWorker.getNextJob(staleToken)) as Job;\n    const client = await getRedisClient(queue);\n    await client.del(lockKey(job.id!));\n\n    expect(await job.extendLock(staleToken, 30000)).toBe(0);\n    await expect(\n      job.moveToCompleted('stale', staleToken, false),\n    ).rejects.toMatchObject({ code: ErrorCode.JobLockNotExist });\n    expect(await job.getState()).toBe('active');\n  });\n});\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1408,"cache_read_input_tokens":52075,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1408},"output_tokens":60,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"1dbf0a0c-dc90-4fd8-bb5e-42123f53969d","uuid":"13a35551-4225-48cd-9caa-4a17fc079550","timestamp":"2026-10-04T14:57:42.007Z","request_id":"req_011CfhPjRQh6N1LJf1DKk5vu","wire_tool_inputs":{"toolu_01Y7P9gPp8FGbkpy32xsLJUU":{"file_path":"/private/tmp/handwork-claude-7lla1sj1/bullmq-2-claude/repo/tests/stale_worker_lock.redis.test.ts","content":"import { getRedisClient } from './utils/get-redis-client';\nimport { Job, Queue, Worker } from '../src/classes';\nimport { ErrorCode } from '../src/enums';\nimport { randomUUID } from '../src/utils';\nimport {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\nimport { createTestConnection } from './utils/connection-factory';\nimport { cleanupQueue } from './utils/cleanup-queue';\nimport { IRedisClient } from '../src/interfaces';\n\ndescribe('stale worker lock ownership', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n  const staleToken = 'stale-token';\n  const ownerToken = 'owner-token';\n\n  let queue: Queue;\n  let queueName: string;\n  let staleWorker: Worker;\n  let ownerWorker: Worker;\n\n  let connection: IRedisClient;\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n    staleWorker = new Worker(queueName, null, { connection, prefix });\n    ownerWorker = new Worker(queueName, null, { connection, prefix });\n  });\n\n  afterEach(async () => {\n    await staleWorker.close();\n    await ownerWorker.close();\n    await queue.close();\n    await cleanupQueue(queueName);\n  });\n\n  afterAll(async function () {\n    await connection.quit();\n  });\n\n  const lockKey = (jobId: string) => `${prefix}:${queueName}:${jobId}:lock`;\n\n  /**\n   * The stale worker picks the job, loses its lock, the job is recovered by\n   * the stalled checker and claimed by the owner worker.\n   */\n  const recoverJob = async (opts = {}) => {\n    await queue.add('test', { foo: 'bar' }, opts);\n\n    const staleJob = (await staleWorker.getNextJob(staleToken)) as Job;\n\n    const client = await getRedisClient(queue);\n    await client.del(lockKey(staleJob.id!));\n\n    await (ownerWorker as any).moveStalledJobsToWait();\n    await client.del(`${prefix}:${queueName}:stalled-check`);\n    await (ownerWorker as any).moveStalledJobsToWait();\n\n    const ownerJob = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    expect(ownerJob.id).toBe(staleJob.id);\n\n    return { staleJob, ownerJob, client };\n  };\n\n  const snapshot = async (client: any, jobId: string) => {\n    const events = await client.xlen(`${prefix}:${queueName}:events`);\n    const job = await queue.getJob(jobId);\n    return {\n      events,\n      state: await job!.getState(),\n      attemptsMade: job!.attemptsMade,\n      attemptsStarted: job!.attemptsStarted,\n      stalledCounter: job!.stalledCounter,\n      returnvalue: job!.returnvalue,\n      failedReason: job!.failedReason,\n      stacktrace: job!.stacktrace,\n      finishedOn: job!.finishedOn,\n      delay: job!.delay,\n      lock: await client.get(lockKey(jobId)),\n    };\n  };\n\n  const expectRejected = async (\n    opts: any,\n    operation: (job: Job) => Promise<any>,\n  ) => {\n    const { staleJob, ownerJob, client } = await recoverJob(opts);\n    const before = await snapshot(client, staleJob.id!);\n    expect(before.state).toBe('active');\n    expect(before.lock).toBe(ownerToken);\n\n    await expect(operation(staleJob)).rejects.toMatchObject({\n      code: ErrorCode.JobLockMismatch,\n    });\n\n    expect(await snapshot(client, staleJob.id!)).toEqual(before);\n\n    // The current owner is still able to renew and finish the job.\n    expect(await ownerJob.extendLock(ownerToken, 30000)).toBe(1);\n    await ownerJob.moveToCompleted('owner', ownerToken, false);\n    expect(await ownerJob.getState()).toBe('completed');\n    expect((await queue.getJob(ownerJob.id!))!.returnvalue).toBe('owner');\n  };\n\n  it('does not let a stale worker complete a recovered job', async () => {\n    await expectRejected({}, job =>\n      job.moveToCompleted('stale', staleToken, false),\n    );\n  });\n\n  it('does not let a stale worker fail a recovered job', async () => {\n    await expectRejected({}, job =>\n      job.moveToFailed(new Error('stale'), staleToken, false),\n    );\n  });\n\n  it('does not let a stale worker retry a recovered job', async () => {\n    await expectRejected({ attempts: 3 }, job =>\n      job.moveToFailed(new Error('stale'), staleToken, false),\n    );\n  });\n\n  it('does not let a stale worker schedule a delayed retry', async () => {\n    await expectRejected(\n      { attempts: 3, backoff: { type: 'fixed', delay: 1000 } },\n      job => job.moveToFailed(new Error('stale'), staleToken, false),\n    );\n  });\n\n  it('does not let a stale worker move a recovered job back to wait or delayed', async () => {\n    await expectRejected({}, job => job.moveToWait(staleToken));\n    await queue.drain();\n    await expectRejected({}, job =>\n      job.moveToDelayed(Date.now() + 1000, staleToken),\n    );\n  });\n\n  it('does not let a stale worker renew the lock of the current owner', async () => {\n    const { staleJob, ownerJob, client } = await recoverJob();\n    const key = lockKey(staleJob.id!);\n    await client.pexpire(key, 5000);\n\n    expect(await staleJob.extendLock(staleToken, 60000)).toBe(0);\n    expect(await client.get(key)).toBe(ownerToken);\n    expect(await client.pttl(key)).toBeLessThanOrEqual(5000);\n\n    const failed = await (staleWorker as any).extendJobLocks(\n      [staleJob.id],\n      [staleToken],\n      60000,\n    );\n    expect(failed).toEqual([staleJob.id]);\n    expect(await client.get(key)).toBe(ownerToken);\n    expect(await client.pttl(key)).toBeLessThanOrEqual(5000);\n\n    const renewed = await (ownerWorker as any).extendJobLocks(\n      [ownerJob.id],\n      [ownerToken],\n      60000,\n    );\n    expect(renewed).toEqual([]);\n    expect(await client.pttl(key)).toBeGreaterThan(5000);\n\n    await ownerJob.moveToCompleted('owner', ownerToken, false);\n  });\n\n  it('only renews the locks owned by the caller in a batch', async () => {\n    await queue.add('test', { idx: 1 });\n    await queue.add('test', { idx: 2 });\n    const first = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    const second = (await staleWorker.getNextJob(staleToken)) as Job;\n    const client = await getRedisClient(queue);\n    await client.pexpire(lockKey(second.id!), 5000);\n\n    const failed = await (ownerWorker as any).extendJobLocks(\n      [first.id, second.id, 'missing'],\n      [ownerToken, ownerToken, ownerToken],\n      60000,\n    );\n\n    expect(failed).toEqual([second.id, 'missing']);\n    expect(await client.get(lockKey(second.id!))).toBe(staleToken);\n    expect(await client.pttl(lockKey(second.id!))).toBeLessThanOrEqual(5000);\n    expect(await client.exists(lockKey('missing'))).toBe(0);\n  });\n\n  it('keeps reporting a missing lock as an error', async () => {\n    await queue.add('test', { foo: 'bar' });\n    const job = (await staleWorker.getNextJob(staleToken)) as Job;\n    const client = await getRedisClient(queue);\n    await client.del(lockKey(job.id!));\n\n    expect(await job.extendLock(staleToken, 30000)).toBe(0);\n    await expect(\n      job.moveToCompleted('stale', staleToken, false),\n    ).rejects.toMatchObject({ code: ErrorCode.JobLockNotExist });\n    expect(await job.getState()).toBe('active');\n  });\n});\n"}}}
