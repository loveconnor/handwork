{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/project-isolation.test.ts <<'EOF'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { createApp } from '../src/app.ts';\nimport { createCache } from '../src/cache/project-cache.ts';\nimport { sampleSeed } from '../src/seed.ts';\n\nconst forbidden = { status: 403, body: { error: 'forbidden' } };\n\ntest('nonmembers cannot read or update projects, including with spoofed ownership', () => {\n  const cache = createCache();\n  const app = createApp(sampleSeed(), cache);\n  app.request({ method: 'GET', path: '/organizations/org-b/projects', token: 'bob' });\n  const storage = structuredClone([...app.db.projects]);\n  const entries = cache.keys().map(key => [key, cache.get(key)]);\n  const metrics = { ...cache.metrics };\n  for (const method of ['GET', 'PATCH']) {\n    assert.deepEqual(app.request({ method, path: '/projects/b1', token: 'alice',\n      query: { organizationId: 'org-a' }, body: { name: 'Stolen', organizationId: 'org-a' } }), forbidden);\n  }\n  assert.deepEqual(app.request({ method: 'GET', path: '/organizations/org-b/projects', token: 'alice' }), forbidden);\n  assert.deepEqual([...app.db.projects], storage);\n  assert.equal(app.db.counters.projectUpdates, 0);\n  assert.deepEqual(cache.metrics, metrics);\n  assert.deepEqual(cache.keys().map(key => [key, cache.get(key)]), entries);\n  assert.deepEqual(app.request({ method: 'PATCH', path: '/projects/missing', token: 'alice', body: { name: 'New' } }),\n    { status: 404, body: { error: 'not_found' } });\n});\n\ntest('all organization, pagination and sorting variants cache separately and invalidate precisely', () => {\n  const seed = sampleSeed();\n  const organizations = ['org-a', 'org-a:child', 'org-a\\\":1:10:name:asc', 'org-a\\\\\\\\', 'org-b'];\n  for (const id of organizations.slice(1, -1)) {\n    seed.organizations.push({ id, name: id });\n    seed.memberships.push({ userId: 'both', organizationId: id });\n    seed.projects.push({ id: \"'`project-${id}`, organizationId: id, name: '\"'Other', updatedAt: 1 });\n  }\n  const app = createApp(seed);\n  const fresh = createApp(seed);\n  const requests = organizations.flatMap(organizationId =>\n    [1, 2].flatMap(page => [1, 2].flatMap(pageSize =>\n      ['name', 'updatedAt'].flatMap(sort => ['asc', 'desc'].map(direction => ({\n        method: 'GET', path: \"'`/organizations/${organizationId}/projects`, token: '\"'both',\n        query: { page: String(page), pageSize: String(pageSize), sort, direction },\n      }))))));\n  for (const request of requests) {\n    const expected = fresh.request(request);\n    assert.equal(expected.status, 200);\n    assert.deepEqual(app.request(request), expected);\n  }\n  assert.equal(app.db.counters.projectLists, requests.length);\n  for (const request of requests) app.request(request);\n  assert.equal(app.db.counters.projectLists, requests.length);\n\n  const update = { method: 'PATCH', path: '/projects/a1', token: 'both', body: { name: 'Zulu', organizationId: 'org-b' } };\n  assert.equal(app.request(update).status, 200);\n  fresh.request(update);\n  assert.equal(app.db.projects.get('a1')\"'!.organizationId, '\"'org-a');\n  for (const request of requests) assert.deepEqual(app.request(request), fresh.request(request));\n  assert.equal(app.db.counters.projectLists, requests.length + 16);\n  for (const request of requests) app.request(request);\n  assert.equal(app.db.counters.projectLists, requests.length + 16);\n});\n\ntest('membership revocation is enforced before cached lists and project access', () => {\n  const cache = createCache();\n  const app = createApp(sampleSeed(), cache);\n  const request = { method: 'GET', path: '/organizations/org-a/projects', token: 'alice' };\n  assert.equal(app.request(request).status, 200);\n  assert.equal(app.request(request).status, 200);\n  assert.equal(cache.metrics.hits, 1);\n  app.db.memberships.delete(JSON.stringify(['alice', 'org-a']));\n  const metrics = { ...cache.metrics };\n  assert.deepEqual(app.request(request), forbidden);\n  assert.deepEqual(app.request({ method: 'GET', path: '/projects/a1', token: 'alice' }), forbidden);\n  assert.deepEqual(app.request({ method: 'PATCH', path: '/projects/a1', token: 'alice', body: { name: 'Denied' } }), forbidden);\n  assert.deepEqual(cache.metrics, metrics);\n  assert.equal(app.db.counters.projectUpdates, 0);\n  assert.equal(app.request({ ...request, token: 'both' }).status, 200);\n  assert.equal(app.db.counters.projectLists, 1);\n});\nEOF\nnpm test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/project-isolation.test.ts <<'EOF'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { createApp } from '../src/app.ts';\nimport { createCache } from '../src/cache/project-cache.ts';\nimport { sampleSeed } from '../src/seed.ts';\n\nconst forbidden = { status: 403, body: { error: 'forbidden' } };\n\ntest('nonmembers cannot read or update projects, including with spoofed ownership', () => {\n  const cache = createCache();\n  const app = createApp(sampleSeed(), cache);\n  app.request({ method: 'GET', path: '/organizations/org-b/projects', token: 'bob' });\n  const storage = structuredClone([...app.db.projects]);\n  const entries = cache.keys().map(key => [key, cache.get(key)]);\n  const metrics = { ...cache.metrics };\n  for (const method of ['GET', 'PATCH']) {\n    assert.deepEqual(app.request({ method, path: '/projects/b1', token: 'alice',\n      query: { organizationId: 'org-a' }, body: { name: 'Stolen', organizationId: 'org-a' } }), forbidden);\n  }\n  assert.deepEqual(app.request({ method: 'GET', path: '/organizations/org-b/projects', token: 'alice' }), forbidden);\n  assert.deepEqual([...app.db.projects], storage);\n  assert.equal(app.db.counters.projectUpdates, 0);\n  assert.deepEqual(cache.metrics, metrics);\n  assert.deepEqual(cache.keys().map(key => [key, cache.get(key)]), entries);\n  assert.deepEqual(app.request({ method: 'PATCH', path: '/projects/missing', token: 'alice', body: { name: 'New' } }),\n    { status: 404, body: { error: 'not_found' } });\n});\n\ntest('all organization, pagination and sorting variants cache separately and invalidate precisely', () => {\n  const seed = sampleSeed();\n  const organizations = ['org-a', 'org-a:child', 'org-a\\\":1:10:name:asc', 'org-a\\\\\\\\', 'org-b'];\n  for (const id of organizations.slice(1, -1)) {\n    seed.organizations.push({ id, name: id });\n    seed.memberships.push({ userId: 'both', organizationId: id });\n    seed.projects.push({ id: \"'`project-${id}`, organizationId: id, name: '\"'Other', updatedAt: 1 });\n  }\n  const app = createApp(seed);\n  const fresh = createApp(seed);\n  const requests = organizations.flatMap(organizationId =>\n    [1, 2].flatMap(page => [1, 2].flatMap(pageSize =>\n      ['name', 'updatedAt'].flatMap(sort => ['asc', 'desc'].map(direction => ({\n        method: 'GET', path: \"'`/organizations/${organizationId}/projects`, token: '\"'both',\n        query: { page: String(page), pageSize: String(pageSize), sort, direction },\n      }))))));\n  for (const request of requests) {\n    const expected = fresh.request(request);\n    assert.equal(expected.status, 200);\n    assert.deepEqual(app.request(request), expected);\n  }\n  assert.equal(app.db.counters.projectLists, requests.length);\n  for (const request of requests) app.request(request);\n  assert.equal(app.db.counters.projectLists, requests.length);\n\n  const update = { method: 'PATCH', path: '/projects/a1', token: 'both', body: { name: 'Zulu', organizationId: 'org-b' } };\n  assert.equal(app.request(update).status, 200);\n  fresh.request(update);\n  assert.equal(app.db.projects.get('a1')\"'!.organizationId, '\"'org-a');\n  for (const request of requests) assert.deepEqual(app.request(request), fresh.request(request));\n  assert.equal(app.db.counters.projectLists, requests.length + 16);\n  for (const request of requests) app.request(request);\n  assert.equal(app.db.counters.projectLists, requests.length + 16);\n});\n\ntest('membership revocation is enforced before cached lists and project access', () => {\n  const cache = createCache();\n  const app = createApp(sampleSeed(), cache);\n  const request = { method: 'GET', path: '/organizations/org-a/projects', token: 'alice' };\n  assert.equal(app.request(request).status, 200);\n  assert.equal(app.request(request).status, 200);\n  assert.equal(cache.metrics.hits, 1);\n  app.db.memberships.delete(JSON.stringify(['alice', 'org-a']));\n  const metrics = { ...cache.metrics };\n  assert.deepEqual(app.request(request), forbidden);\n  assert.deepEqual(app.request({ method: 'GET', path: '/projects/a1', token: 'alice' }), forbidden);\n  assert.deepEqual(app.request({ method: 'PATCH', path: '/projects/a1', token: 'alice', body: { name: 'Denied' } }), forbidden);\n  assert.deepEqual(cache.metrics, metrics);\n  assert.equal(app.db.counters.projectUpdates, 0);\n  assert.equal(app.request({ ...request, token: 'both' }).status, 200);\n  assert.equal(app.db.counters.projectLists, 1);\n});\nEOF\nnpm test\"","aggregated_output":"✔ health and profile (0.823166ms)\n✔ organizations scoped to user (0.130542ms)\n✔ logout revokes session (0.106375ms)\n✔ nonmembers cannot read or update projects, including with spoofed ownership (6.173459ms)\n✔ all organization, pagination and sorting variants cache separately and invalidate precisely (2.58ms)\n✔ membership revocation is enforced before cached lists and project access (0.201958ms)\n✔ authenticated detail (0.544042ms)\n✔ authenticated list (5.124458ms)\n✔ update then read (0.124584ms)\n✔ anonymous request rejected (0.324292ms)\n✔ invalid update rejected (0.0685ms)\nℹ tests 11\nℹ suites 0\nℹ pass 11\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 87.49025\n","exit_code":0,"status":"completed"}}
