{"type":"tool_use","timestamp":1789170734844,"sessionID":"ses_f6d1e4bfaffePKuDeJBVEyIMD6","part":{"type":"tool","tool":"bash","callID":"call_sNHZ59ATW7oIXBoh8IGUSqei","state":{"status":"completed","input":{"command":"node --input-type=module -e 'import assert from \"node:assert/strict\"; import { createSearchController } from \"./src/search/controller.ts\"; const items = [{ id: \"new\", title: \"New result\", url: \"/new\" }]; for (const staleFails of [false, true]) { for (const finishLatestFirst of [false, true]) { const requests = []; const c = createSearchController({ search: () => new Promise((resolve, reject) => requests.push({ resolve, reject })) }); const old = c.search(\"old\"); const current = c.search(\"new\"); if (finishLatestFirst) { requests[1].resolve(items); await current; } const before = c.getState(); if (staleFails) requests[0].reject(new Error(\"stale failure\")); else requests[0].resolve([]); await old; assert.deepEqual(c.getState(), before); if (!finishLatestFirst) { requests[1].resolve(items); await current; } assert.deepEqual(c.getState(), { query: \"new\", results: items, loading: false, error: null }); } const requests = []; const c = createSearchController({ search: () => new Promise((resolve, reject) => requests.push({ resolve, reject })) }); const pending = c.search(\"old\"); await c.search(\"  \"); const cleared = { query: \"\", results: [], loading: false, error: null }; assert.deepEqual(c.getState(), cleared); if (staleFails) requests[0].reject(new Error(\"stale failure\")); else requests[0].resolve(items); await pending; assert.deepEqual(c.getState(), cleared); } console.log(\"Passed 6 in-memory race checks: stale success/failure before and after latest completion, and after clearing.\");'"},"output":"Passed 6 in-memory race checks: stale success/failure before and after latest completion, and after clearing.\n","metadata":{"output":"Passed 6 in-memory race checks: stale success/failure before and after latest completion, and after clearing.\n","exit":0,"truncated":false},"title":"node --input-type=module -e 'import assert from \"node:assert/strict\"; import { createSearchController } from \"./src/search/controller.ts\"; const items = [{ id: \"new\", title: \"New result\", url: \"/new\" }]; for (const staleFails of [false, true]) { for (const finishLatestFirst of [false, true]) { const requests = []; const c = createSearchController({ search: () => new Promise((resolve, reject) => requests.push({ resolve, reject })) }); const old = c.search(\"old\"); const current = c.search(\"new\"); if (finishLatestFirst) { requests[1].resolve(items); await current; } const before = c.getState(); if (staleFails) requests[0].reject(new Error(\"stale failure\")); else requests[0].resolve([]); await old; assert.deepEqual(c.getState(), before); if (!finishLatestFirst) { requests[1].resolve(items); await current; } assert.deepEqual(c.getState(), { query: \"new\", results: items, loading: false, error: null }); } const requests = []; const c = createSearchController({ search: () => new Promise((resolve, reject) => requests.push({ resolve, reject })) }); const pending = c.search(\"old\"); await c.search(\"  \"); const cleared = { query: \"\", results: [], loading: false, error: null }; assert.deepEqual(c.getState(), cleared); if (staleFails) requests[0].reject(new Error(\"stale failure\")); else requests[0].resolve(items); await pending; assert.deepEqual(c.getState(), cleared); } console.log(\"Passed 6 in-memory race checks: stale success/failure before and after latest completion, and after clearing.\");'","time":{"start":1789170734840,"end":1789170734843}},"metadata":{"openai":{"itemId":"fc_0e96cfffb9a4effe016aa4942e71ec87d1bf33ad267996c072"}},"id":"prt_092e2d6a9001C0VXlKJoRrRboF","sessionID":"ses_f6d1e4bfaffePKuDeJBVEyIMD6","messageID":"msg_092e29a8b0014t9iYVnaG9S6sx"}}
