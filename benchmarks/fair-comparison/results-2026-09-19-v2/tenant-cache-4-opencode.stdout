ix(organizationId)}${options.page}:${options.pageSize}:${options.sort}:${options.direction}`;\n }\n export function projectDetailKey(projectId:string):string { return `projects:detail:${projectId}`; }\n","additions":4,"deletions":1},{"filePath":"/private/tmp/handwork-fair-2tip6hsn/tenant-cache-4-opencode/repo/src/services/project-service.ts","relativePath":"src/services/project-service.ts","type":"update","patch":"Index: /private/tmp/handwork-fair-2tip6hsn/tenant-cache-4-opencode/repo/src/services/project-service.ts\n===================================================================\n--- /private/tmp/handwork-fair-2tip6hsn/tenant-cache-4-opencode/repo/src/services/project-service.ts\n+++ /private/tmp/handwork-fair-2tip6hsn/tenant-cache-4-opencode/repo/src/services/project-service.ts\n@@ -2,15 +2,16 @@\n import type { Cache } from '../cache/project-cache.ts';\n import type { ListOptions } from '../types.ts';\n import { projectRepository } from '../db/project-repository.ts';\n import { requireMembership } from '../auth/membership.ts';\n-import { projectListKey, projectDetailKey } from '../cache/keys.ts';\n+import { projectListKey, projectListPrefix, projectDetailKey } from '../cache/keys.ts';\n import { HttpError } from '../http/response.ts';\n export function projectService(db:Database,cache:Cache) {\n   const projects=projectRepository(db);\n   function detail(userId:string,projectId:string) {\n     const project=projects.find(projectId);\n     if(!project)throw new HttpError(404,'not_found');\n+    requireMembership(db,userId,project.organizationId);\n     return project;\n   }\n   return {\n     detail,\n@@ -25,8 +26,10 @@\n       detail(userId,projectId);\n       if(!body||typeof body!=='object'||typeof (body as any).name!=='string'||!(body as any).name.trim())throw new HttpError(400,'invalid_body');\n       const updated=projects.update(projectId,(body as any).name.trim())!;\n       cache.delete(projectDetailKey(projectId));\n+      const prefix=projectListPrefix(updated.organizationId);\n+      for(const key of cache.keys())if(key.startsWith(prefix))cache.delete(key);\n       return updated;\n     },\n   };\n }\n","additions":4,"deletions":1},{"filePath":"/private/tmp/handwork-fair-2tip6hsn/tenant-cache-4-opencode/repo/tests/project-isolation.test.ts","relativePath":"tests/project-isolation.test.ts","type":"add","patch":"Index: /private/tmp/handwork-fair-2tip6hsn/tenant-cache-4-opencode/repo/tests/project-isolation.test.ts\n===================================================================\n--- /private/tmp/handwork-fair-2tip6hsn/tenant-cache-4-opencode/repo/tests/project-isolation.test.ts\n+++ /private/tmp/handwork-fair-2tip6hsn/tenant-cache-4-opencode/repo/tests/project-isolation.test.ts\n@@ -0,0 +1,104 @@\n+import test from 'node:test';\n+import assert from 'node:assert/strict';\n+import { createApp } from '../src/app.ts';\n+import { sampleSeed } from '../src/seed.ts';\n+import { createCache } from '../src/cache/project-cache.ts';\n+import type { ListOptions, Project } from '../src/types.ts';\n+\n+const forbidden={status:403,body:{error:'forbidden'}};\n+const variants:ListOptions[]=[];\n+for(const page of [1,2])for(const pageSize of [1,2])for(const sort of ['name','updatedAt'] as const)for(const direction of ['asc','desc'] as const){\n+  variants.push({page,pageSize,sort,direction});\n+}\n+function list(app:ReturnType<typeof createApp>,organizationId:string,options:ListOptions=variants[0],token='both') {\n+  return app.request({method:'GET',path:`/organizations/${encodeURIComponent(organizationId)}/projects`,token,\n+    query:Object.fromEntries(Object.entries(options).map(([key,value])=>[key,String(value)]))});\n+}\n+function expected(projects:Project[],organizationId:string,options:ListOptions) {\n+  const rows=projects.filter(p=>p.organizationId===organizationId).sort((a,b)=>{\n+    const primary=options.sort==='name'?a.name.localeCompare(b.name):a.updatedAt-b.updatedAt;\n+    return (primary||a.id.localeCompare(b.id))*(options.direction==='asc'?1:-1);\n+  });\n+  return {status:200,body:{items:rows.slice((options.page-1)*options.pageSize,options.page*options.pageSize),total:rows.length,...options}};\n+}\n+\n+test('nonmembers cannot read or update projects or read cold or warm lists',()=>{\n+  const cache=createCache(),app=createApp(sampleSeed(),cache);\n+  const before=structuredClone([...app.db.projects]);\n+  for(const [token,organizationId,projectId] of [['alice','org-b','b1'],['bob','org-a','a1']]){\n+    assert.deepEqual(list(app,organizationId,variants[0],token),forbidden);\n+    assert.equal(list(app,organizationId).status,200);\n+    const metrics={...cache.metrics};\n+    assert.deepEqual(list(app,organizationId,variants[0],token),forbidden);\n+    assert.deepEqual(app.request({method:'GET',path:`/projects/${projectId}`,token}),forbidden);\n+    for(const body of [{name:'Unauthorized'}, {name:''}]){\n+      assert.deepEqual(app.request({method:'PATCH',path:`/projects/${projectId}`,token,body}),forbidden);\n+    }\n+    assert.deepEqual(cache.metrics,metrics);\n+  }\n+  assert.deepEqual([...app.db.projects],before);\n+  assert.equal(app.db.counters.projectUpdates,0);\n+});\n+\n+test('switching organizations keeps all pagination and sorting variants isolated and cached',()=>{\n+  const seed=sampleSeed(),cache=createCache(),app=createApp(seed,cache);\n+  for(const options of variants)for(const organizationId of ['org-a','org-b']){\n+    assert.deepEqual(list(app,organizationId,options),expected(seed.projects,organizationId,options));\n+  }\n+  assert.equal(app.db.counters.projectLists,variants.length*2);\n+  for(const options of variants)for(const organizationId of ['org-b','org-a']){\n+    assert.deepEqual(list(app,organizationId,options),expected(seed.projects,organizationId,options));\n+  }\n+  assert.equal(app.db.counters.projectLists,variants.length*2);\n+  assert.equal(cache.metrics.hits,variants.length*2);\n+});\n+\n+test('updates invalidate every owning-organization variant while preserving other organizations',()=>{\n+  const seed=sampleSeed();\n+  // A related-looking ID must not be included in prefix invalidation.\n+  seed.organizations.push({id:'org-a:child',name:'Child'});\n+  seed.memberships.push({userId:'both',organizationId:'org-a:child'});\n+  seed.projects.push({id:'c1',organizationId:'org-a:child',name:'Child',updatedAt:1});\n+  const cache=createCache(),app=createApp(seed,cache);\n+  for(const options of variants)for(const id of ['org-a','org-b','org-a:child'])list(app,id,options);\n+  const lists=app.db.counters.projectLists;\n+  assert.equal(app.request({method:'PATCH',path:'/projects/a2',token:'alice',body:{name:' Zulu '}}).status,200);\n+  const hits=cache.metrics.hits;\n+  for(const options of variants)for(const id of ['org-b','org-a:child']){\n+    assert.deepEqual(list(app,id,options),expected(seed.projects,id,options));\n+  }\n+  assert.equal(app.db.counters.projectLists,lists);\n+  assert.equal(cache.metrics.hits,hits+variants.length*2);\n+  for(const options of variants){\n+    assert.deepEqual(list(app,'org-a',options),expected([...app.db.projects.values()],'org-a',options));\n+  }\n+  assert.equal(app.db.counters.projectLists,lists+variants.length);\n+  for(const options of variants)list(app,'org-a',options);\n+  assert.equal(app.db.counters.projectLists,lists+variants.length);\n+});\n+\n+test('revoking membership denies cached lists and project reads and updates',()=>{\n+  const cache=createCache(),app=createApp(sampleSeed(),cache);\n+  list(app,'org-a',variants[0],'alice');\n+  app.db.memberships.delete(JSON.stringify(['alice','org-a']));\n+  const metrics={...cache.metrics},before=structuredClone([...app.db.projects]);\n+  assert.deepEqual(list(app,'org-a',variants[0],'alice'),forbidden);\n+  assert.deepEqual(app.request({method:'GET',path:'/projects/a1',token:'alice'}),forbidden);\n+  assert.deepEqual(app.request({method:'PATCH',path:'/projects/a1',token:'alice',body:{name:'Denied'}}),forbidden);\n+  assert.deepEqual([...app.db.projects],before);\n+  assert.deepEqual(cache.metrics,metrics);\n+  assert.equal(list(app,'org-a').status,200);\n+  assert.equal(cache.metrics.hits,metrics.hits+1);\n+});\n+\n+test('missing projects and invalid authorized updates preserve conventions and cached lists',()=>{\n+  const cache=createCache(),app=createApp(sampleSeed(),cache);\n+  const before=list(app,'org-a');\n+  for(const method of ['GET','PATCH']){\n+    assert.deepEqual(app.request({method,path:'/projects/missing',token:'alice',body:{name:'New'}}),{status:404,body:{error:'not_found'}});\n+  }\n+  assert.deepEqual(app.request({method:'PATCH',path:'/projects/a1',token:'alice',body:{name:''}}),{status:400,body:{error:'invalid_body'}});\n+  assert.deepEqual(list(app,'org-a'),before);\n+  assert.equal(cache.metrics.hits,1);\n+  assert.equal(app.db.counters.projectUpdates,0);\n+});\n","additions":104,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nM src/cache/keys.ts\nM src/services/project-service.ts\nA tests/project-isolation.test.ts","time":{"start":1789782328700,"end":1789782328709}},"metadata":{"openai":{"itemId":"fc_0a9db9be1f53931a016aade8fb119887d189578aeaebf08042"}},"id":"prt_0b75614c9001fhFQcedrlwkqZb","sessionID":"ses_f48aaa6a5ffe5n0V4QRqmAEfOf","messageID":"msg_0b7560d3f001nc4iy3EUXZJsM5"}}
