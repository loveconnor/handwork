{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/project-isolation.test.ts <<'EOF'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { createApp } from '../src/app.ts';\nimport { createCache } from '../src/cache/project-cache.ts';\nimport { sampleSeed } from '../src/seed.ts';\nimport type { ListOptions } from '../src/types.ts';\n\nconst forbidden = { status: 403, body: { error: 'forbidden' } };\nconst variants: ListOptions[] = [];\nfor (const page of [1, 2]) for (const pageSize of [1, 2])\n  for (const sort of ['name', 'updatedAt'] as const)\n    for (const direction of ['asc', 'desc'] as const)\n      variants.push({ page, pageSize, sort, direction });\n\nfunction list(app: ReturnType<typeof createApp>, organizationId: string, token = 'both', options?: ListOptions) {\n  return app.request({ method: 'GET', path: \"'`/organizations/${organizationId}/projects`, token,\n    query: options && Object.fromEntries(Object.entries(options).map(([key, value]) => [key, String(value)])) });\n}\n\ntest('\"'nonmembers cannot read or update projects, including with spoofed ownership', () => {\n  const cache = createCache(), app = createApp(sampleSeed(), cache);\n  list(app, 'org-b', 'bob');\n  const storage = structuredClone(app.db.projects), keys = cache.keys(), metrics = { ...cache.metrics };\n  assert.deepEqual(app.request({ method: 'GET', path: '/projects/b1', token: 'alice', query: { organizationId: 'org-a' } }), forbidden);\n  for (const name of ['Changed', '']) {\n    assert.deepEqual(app.request({ method: 'PATCH', path: '/projects/b1', token: 'alice', body: { name, organizationId: 'org-a' } }), forbidden);\n  }\n  assert.deepEqual(list(app, 'org-b', 'alice'), forbidden);\n  assert.deepEqual(app.db.projects, storage);\n  assert.equal(app.db.counters.projectUpdates, 0);\n  assert.deepEqual(cache.keys(), keys);\n  assert.deepEqual(cache.metrics, metrics);\n  for (const method of ['GET', 'PATCH']) {\n    assert.deepEqual(app.request({ method, path: '/projects/missing', token: 'alice', body: { name: 'New' } }), { status: 404, body: { error: 'not_found' } });\n  }\n});\n\ntest('organization switching and every pagination/sorting variant remain isolated and cached', () => {\n  const app = createApp(sampleSeed());\n  for (const options of variants) for (const organizationId of ['org-a', 'org-b']) {\n    const result = list(app, organizationId, 'both', options);\n    const fresh = list(createApp(sampleSeed()), organizationId, 'both', options);\n    assert.equal(result.status, 200);\n    assert.deepEqual(result, fresh);\n    const queries = app.db.counters.projectLists;\n    assert.deepEqual(list(app, organizationId, 'both', options), result);\n    assert.equal(app.db.counters.projectLists, queries);\n  }\n  assert.equal(app.db.counters.projectLists, variants.length * 2);\n});\n\ntest('updates invalidate all owning organization variants while retaining unrelated cache entries', () => {\n  const seed = sampleSeed();\n  // Include IDs that share prefixes and contain cache delimiters and JSON punctuation.\n  for (const id of ['org-a:child', 'org-a\\\"', 'org-a\\\\\\\\']) {\n    seed.organizations.push({ id, name: id });\n    seed.memberships.push({ userId: 'both', organizationId: id });\n    seed.projects.push({ id, organizationId: id, name: id, updatedAt: 1 });\n  }\n  const app = createApp(seed);\n  const otherIds = seed.organizations.map(o => o.id).filter(id => id \"'!== '\"'org-a');\n  for (const options of variants) for (const id of ['org-a', ...otherIds]) list(app, id, 'both', options);\n  const updated = app.request({ method: 'PATCH', path: '/projects/a1', token: 'alice', body: { name: '  Zeta  ', organizationId: 'org-b' } });\n  assert.deepEqual(updated, { status: 200, body: { id: 'a1', organizationId: 'org-a', name: 'Zeta', updatedAt: 4 } });\n  assert.equal(app.cache.keys().length, variants.length * otherIds.length);\n  const queries = app.db.counters.projectLists;\n  for (const options of variants) for (const id of otherIds) list(app, id, 'both', options);\n  assert.equal(app.db.counters.projectLists, queries);\n  const fresh = createApp(seed);\n  fresh.request({ method: 'PATCH', path: '/projects/a1', token: 'alice', body: { name: 'Zeta' } });\n  for (const options of variants) {\n    assert.deepEqual(list(app, 'org-a', 'alice', options), list(fresh, 'org-a', 'alice', options));\n  }\n  assert.equal(app.db.counters.projectLists, queries + variants.length);\n  for (const options of variants) list(app, 'org-a', 'alice', options);\n  assert.equal(app.db.counters.projectLists, queries + variants.length);\n});\n\ntest('revoked membership is checked before cached lists and project access', () => {\n  const cache = createCache(), app = createApp(sampleSeed(), cache);\n  const result = list(app, 'org-a', 'alice');\n  app.db.memberships.delete(JSON.stringify(['alice', 'org-a']));\n  const metrics = { ...cache.metrics };\n  assert.deepEqual(list(app, 'org-a', 'alice'), forbidden);\n  assert.deepEqual(app.request({ method: 'GET', path: '/projects/a1', token: 'alice' }), forbidden);\n  assert.deepEqual(app.request({ method: 'PATCH', path: '/projects/a1', token: 'alice', body: { name: 'Changed' } }), forbidden);\n  assert.deepEqual(cache.metrics, metrics);\n  assert.equal(app.db.counters.projectUpdates, 0);\n  assert.deepEqual(list(app, 'org-a', 'both'), result);\n  assert.equal(app.db.counters.projectLists, 1);\n});\nEOF\nnpm test\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/project-isolation.test.ts <<'EOF'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { createApp } from '../src/app.ts';\nimport { createCache } from '../src/cache/project-cache.ts';\nimport { sampleSeed } from '../src/seed.ts';\nimport type { ListOptions } from '../src/types.ts';\n\nconst forbidden = { status: 403, body: { error: 'forbidden' } };\nconst variants: ListOptions[] = [];\nfor (const page of [1, 2]) for (const pageSize of [1, 2])\n  for (const sort of ['name', 'updatedAt'] as const)\n    for (const direction of ['asc', 'desc'] as const)\n      variants.push({ page, pageSize, sort, direction });\n\nfunction list(app: ReturnType<typeof createApp>, organizationId: string, token = 'both', options?: ListOptions) {\n  return app.request({ method: 'GET', path: \"'`/organizations/${organizationId}/projects`, token,\n    query: options && Object.fromEntries(Object.entries(options).map(([key, value]) => [key, String(value)])) });\n}\n\ntest('\"'nonmembers cannot read or update projects, including with spoofed ownership', () => {\n  const cache = createCache(), app = createApp(sampleSeed(), cache);\n  list(app, 'org-b', 'bob');\n  const storage = structuredClone(app.db.projects), keys = cache.keys(), metrics = { ...cache.metrics };\n  assert.deepEqual(app.request({ method: 'GET', path: '/projects/b1', token: 'alice', query: { organizationId: 'org-a' } }), forbidden);\n  for (const name of ['Changed', '']) {\n    assert.deepEqual(app.request({ method: 'PATCH', path: '/projects/b1', token: 'alice', body: { name, organizationId: 'org-a' } }), forbidden);\n  }\n  assert.deepEqual(list(app, 'org-b', 'alice'), forbidden);\n  assert.deepEqual(app.db.projects, storage);\n  assert.equal(app.db.counters.projectUpdates, 0);\n  assert.deepEqual(cache.keys(), keys);\n  assert.deepEqual(cache.metrics, metrics);\n  for (const method of ['GET', 'PATCH']) {\n    assert.deepEqual(app.request({ method, path: '/projects/missing', token: 'alice', body: { name: 'New' } }), { status: 404, body: { error: 'not_found' } });\n  }\n});\n\ntest('organization switching and every pagination/sorting variant remain isolated and cached', () => {\n  const app = createApp(sampleSeed());\n  for (const options of variants) for (const organizationId of ['org-a', 'org-b']) {\n    const result = list(app, organizationId, 'both', options);\n    const fresh = list(createApp(sampleSeed()), organizationId, 'both', options);\n    assert.equal(result.status, 200);\n    assert.deepEqual(result, fresh);\n    const queries = app.db.counters.projectLists;\n    assert.deepEqual(list(app, organizationId, 'both', options), result);\n    assert.equal(app.db.counters.projectLists, queries);\n  }\n  assert.equal(app.db.counters.projectLists, variants.length * 2);\n});\n\ntest('updates invalidate all owning organization variants while retaining unrelated cache entries', () => {\n  const seed = sampleSeed();\n  // Include IDs that share prefixes and contain cache delimiters and JSON punctuation.\n  for (const id of ['org-a:child', 'org-a\\\"', 'org-a\\\\\\\\']) {\n    seed.organizations.push({ id, name: id });\n    seed.memberships.push({ userId: 'both', organizationId: id });\n    seed.projects.push({ id, organizationId: id, name: id, updatedAt: 1 });\n  }\n  const app = createApp(seed);\n  const otherIds = seed.organizations.map(o => o.id).filter(id => id \"'!== '\"'org-a');\n  for (const options of variants) for (const id of ['org-a', ...otherIds]) list(app, id, 'both', options);\n  const updated = app.request({ method: 'PATCH', path: '/projects/a1', token: 'alice', body: { name: '  Zeta  ', organizationId: 'org-b' } });\n  assert.deepEqual(updated, { status: 200, body: { id: 'a1', organizationId: 'org-a', name: 'Zeta', updatedAt: 4 } });\n  assert.equal(app.cache.keys().length, variants.length * otherIds.length);\n  const queries = app.db.counters.projectLists;\n  for (const options of variants) for (const id of otherIds) list(app, id, 'both', options);\n  assert.equal(app.db.counters.projectLists, queries);\n  const fresh = createApp(seed);\n  fresh.request({ method: 'PATCH', path: '/projects/a1', token: 'alice', body: { name: 'Zeta' } });\n  for (const options of variants) {\n    assert.deepEqual(list(app, 'org-a', 'alice', options), list(fresh, 'org-a', 'alice', options));\n  }\n  assert.equal(app.db.counters.projectLists, queries + variants.length);\n  for (const options of variants) list(app, 'org-a', 'alice', options);\n  assert.equal(app.db.counters.projectLists, queries + variants.length);\n});\n\ntest('revoked membership is checked before cached lists and project access', () => {\n  const cache = createCache(), app = createApp(sampleSeed(), cache);\n  const result = list(app, 'org-a', 'alice');\n  app.db.memberships.delete(JSON.stringify(['alice', 'org-a']));\n  const metrics = { ...cache.metrics };\n  assert.deepEqual(list(app, 'org-a', 'alice'), forbidden);\n  assert.deepEqual(app.request({ method: 'GET', path: '/projects/a1', token: 'alice' }), forbidden);\n  assert.deepEqual(app.request({ method: 'PATCH', path: '/projects/a1', token: 'alice', body: { name: 'Changed' } }), forbidden);\n  assert.deepEqual(cache.metrics, metrics);\n  assert.equal(app.db.counters.projectUpdates, 0);\n  assert.deepEqual(list(app, 'org-a', 'both'), result);\n  assert.equal(app.db.counters.projectLists, 1);\n});\nEOF\nnpm test\n\"","aggregated_output":"✔ health and profile (0.757958ms)\n✔ organizations scoped to user (0.121167ms)\n✔ logout revokes session (0.100833ms)\n✔ nonmembers cannot read or update projects, including with spoofed ownership (6.379833ms)\n✔ organization switching and every pagination/sorting variant remain isolated and cached (1.125625ms)\n✔ updates invalidate all owning organization variants while retaining unrelated cache entries (1.375125ms)\n✔ revoked membership is checked before cached 