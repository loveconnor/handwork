ose();\ntests/worker.test.ts:2566:  it('emits error and continues running when _getNextJob fails', async () => {\ntests/worker.test.ts:2605:    // Stub the _getNextJob method to throw an error on first call, then restore\ntests/worker.test.ts:2607:    const originalGetNextJob = (worker as any)._getNextJob;\ntests/worker.test.ts:2609:      .stub(worker as any, '_getNextJob')\ntests/worker.test.ts:2614:          throw new Error('Simulated _getNextJob failure');","is_error":false}]},"parent_tool_use_id":null,"session_id":"43ca26b3-baa3-428a-8353-3ab78a1aaa81","uuid":"68c0f70e-d223-41d7-af09-2586a3ec1237","timestamp":"2026-10-04T15:07:16.987Z","tool_use_result":{"stdout":"src/classes/worker.ts:581:      await this.startStalledCheckTimer();\nsrc/classes/worker.ts:1246:              await this.startStalledCheckTimer();\nsrc/classes/worker.ts:1350:  async startStalledCheckTimer(): Promise<void> {\nsrc/classes/worker.ts:1351:    if (!this.opts.skipStalledCheck) {\nsrc/classes/worker.ts:1355:          'startStalledCheckTimer',\nsrc/classes/worker.ts:1379:      await this.checkConnectionError(() => this.moveStalledJobsToWait());\nsrc/classes/worker.ts:1454:  private async moveStalledJobsToWait() {\nsrc/classes/worker.ts:1457:      'moveStalledJobsToWait',\nsrc/classes/worker.ts:1460:        const stalled = await this.backend.moveStalledJobsToWait();\nsrc/classes/queue-base.ts:31:  backend: B;\nimport { Queue } from '../../src/classes';\nimport { createTestConnection } from './connection-factory';\n\nconst DEFAULT_PREFIX = process.env.BULLMQ_TEST_PREFIX || 'bull';\n\n/**\n * Backend-agnostic per-test cleanup.\n *\n * Removes all data for a queue through the backend's own `obliterate`, so it\n * behaves identically on Redis and PostgreSQL. This is the uniform replacement\n * for the shared suite's historic `removeAllQueueData(client, name)`, which was\n * defined over a raw Redis client (`scanStream`/`pipeline.del`) and therefore\n * could not work against a non-Redis backend —