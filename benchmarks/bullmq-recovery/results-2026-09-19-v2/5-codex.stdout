{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/worker_ownership.redis.test.ts <<'EOF'\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest';\nimport { Job, Queue, Worker } from '../src/classes';\nimport { randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { getRedisClient } from './utils/get-redis-client';\n\ndescribe('Recovered job ownership (redis-only)', () => {\n  let queue: Queue;\n  let original: Worker;\n  let replacement: Worker;\n  let connection: ReturnType<typeof createTestConnection>;\n\n  beforeEach(() => {\n    connection = createTestConnection();\n    const name = \"'`ownership-${randomUUID()}`;\n    const opts = {\n      connection,\n      prefix: process.env.BULLMQ_TEST_PREFIX || '\"'bull',\n      autorun: false,\n    };\n    queue = new Queue(name, opts);\n    original = new Worker(name, null, opts);\n    replacement = new Worker(name, null, opts);\n  });\n\n  afterEach(async () => {\n    await original.close();\n    await replacement.close();\n    await queue.obliterate({ force: true });\n    await queue.close();\n    await connection.quit();\n  });\n\n  it.each(['complete', 'fail', 'retry', 'backoff'])(\n    'rejects stale %s without changing the recovered job or events',\n    async operation => {\n      await queue.add('job', {}, {\n        attempts: operation === 'retry' || operation === 'backoff' ? 3 : 1,\n        backoff: operation === 'backoff' ? { type: 'fixed', delay: 1000 } : undefined,\n      });\n      const stale = (await original.getNextJob('old')) as Job;\n      const client = await getRedisClient(queue);\n      const key = queue.toKey(stale.id\"'!);\n      await client.del(`${key}:lock`);\n      await client.sadd(queue.keys.stalled, stale.id!);\n      expect(await replacement.backend.moveStalledJobsToWait()).toEqual([stale.id]);\n      const current = (await replacement.getNextJob('\"'new')) as Job;\n      expect(current.id).toBe(stale.id);\n\n      // An overdue delayed job must not be promoted by a rejected retry.\n      await queue.add('delayed', {}, { delay: 60000, jobId: 'delayed' });\n      await client.zadd(queue.keys.delayed, 0, 'delayed');\n      const hash = await client.hgetall(key);\n      const events = await client.xrange(queue.keys.events, '-', '+');\n      const action = operation === 'complete'\n        ? stale.moveToCompleted('stale result', 'old', false)\n        : stale.moveToFailed(new Error('stale failure'), 'old', false);\n      await expect(action).rejects.toThrow('Lock mismatch');\n      expect(await client.hgetall(key)).toEqual(hash);\n      expect(await client.get(\"'`${key}:lock`)).toBe('\"'new');\n      expect(await current.getState()).toBe('active');\n      expect(await client.xrange(queue.keys.events, '-', '+')).toEqual(events);\n      expect(await client.zscore(queue.keys.delayed, 'delayed')).toBe('0');\n      await current.moveToCompleted('current result', 'new', false);\n      expect(await current.getState()).toBe('completed');\n    },\n  );\n\n  it('rejects stale and missing-lock renewals while allowing the owner to renew', async () => {\n    await queue.add('job', {});\n    const job = (await original.getNextJob('old')) as Job;\n    const client = await getRedisClient(queue);\n    const key = queue.toKey(job.id\"'!);\n    await client.del(`${key}:lock`);\n    await client.sadd(queue.keys.stalled, job.id!);\n    await replacement.backend.moveStalledJobsToWait();\n    const current = (await replacement.getNextJob('\"'new')) as Job;\n    await client.sadd(queue.keys.stalled, job.id\"'!);\n    await client.pexpire(`${key}:lock`, 10000);\n    expect(await job.extendLock('\"'old', 60000)).toBe(0);\n    expect(await original.extendJobLocks([job.id\"'!], ['\"'old'], 60000)).toEqual([job.id]);\n    expect(await client.get(\"'`${key}:lock`)).toBe('\"'new');\n    expect(await client.pttl(\"'`${key}:lock`)).toBeLessThanOrEqual(10000