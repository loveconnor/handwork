function () {\n    await connection.quit();\n  });\n\n  const lockKey = (jobId: string) => `${prefix}:${queueName}:${jobId}:lock`;\n\n  /**\n   * The stale worker picks the job, loses its lock, the job is recovered by\n   * the stalled checker and claimed by the owner worker.\n   */\n  const recoverJob = async (opts = {}) => {\n    await queue.add('test', { foo: 'bar' }, opts);\n\n    const staleJob = (await staleWorker.getNextJob(staleToken)) as Job;\n\n    const client = await getRedisClient(queue);\n    await client.del(lockKey(staleJob.id!));\n\n    await (ownerWorker as any).moveStalledJobsToWait();\n    await client.del(`${prefix}:${queueName}:stalled-check`);\n    await (ownerWorker as any).moveStalledJobsToWait();\n\n    const ownerJob = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    expect(ownerJob.id).toBe(staleJob.id);\n\n    return { staleJob, ownerJob, client };\n  };\n\n  const snapshot = async (client: any, jobId: string) => {\n    const events = await client.xlen(`${prefix}:${queueName}:events`);\n    const job = await queue.getJob(jobId);\n    return {\n      events,\n      state: await job!.getState(),\n      attemptsMade: job!.attemptsMade,\n      attemptsStarted: job!.attemptsStarted,\n      stalledCounter: job!.stalledCounter,\n      returnvalue: job!.returnvalue,\n      failedReason: job!.failedReason,\n      stacktrace: job!.stacktrace,\n      finishedOn: job!.finishedOn,\n      delay: job!.delay,\n      lock: await client.get(lockKey(jobId)),\n    };\n  };\n\n  const expectRejected = async (\n    opts: any,\n    operation: (job: Job) => Promise<any>,\n  ) => {\n    const { staleJob, ownerJob, client } = await recoverJob(opts);\n    const before = await snapshot(client, staleJob.id!);\n    expect(before.state).toBe('active');\n    expect(before.lock).toBe(ownerToken);\n\n    await expect(operation(staleJob)).rejects.toMatchObject({\n      code: ErrorCode.JobLockMismatch,\n    });\n\n    expect(await snapshot(client, staleJob.id!)).toE