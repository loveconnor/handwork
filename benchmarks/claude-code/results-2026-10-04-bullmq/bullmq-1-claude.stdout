nd lock and removes the job from the stalled set.\n\n  Input:\n    KEYS[1] 'lock',\n    KEYS[2] 'stalled'\n\n    ARGV[1]  token\n    ARGV[2]  lock duration in milliseconds\n    ARGV[3]  jobid\n\n  Output:\n    \"1\" if lock extended successfully.\n]]\nlocal rcall = redis.call\nif rcall(\"EXISTS\", KEYS[1]) == 1 then\n  --   if rcall(\"SET\", KEYS[1], ARGV[1], \"PX\", ARGV[2], \"XX\") then\n  if rcall(\"SET\", KEYS[1], ARGV[1], \"PX\", ARGV[2]) then\n    rcall(\"SREM\", KEYS[2], ARGV[3])\n    return 1\n  end\nend\nreturn 0\n--[[\n  Extend locks for multiple jobs and remove them from the stalled set if successful.\n  Return the list of job IDs for which the operation failed.\n\n  KEYS[1] = stalled key\n  \n  ARGV[1] = baseKey\n  ARGV[2] = tokens\n  ARGV[3] = jobIds\n  ARGV[4] = lockDuration (ms)\n\n  Output:\n    An array of failed job IDs. If empty, all succeeded.\n]]\nlocal rcall = redis.call\n\nlocal stalledKey = KEYS[1]\nlocal baseKey = ARGV[1]\nlocal tokens = cmsgpack.unpack(ARGV[2])\nlocal jobIds = cmsgpack.unpack(ARGV[3])\nlocal lockDuration = ARGV[4]\n\nlocal jobCount = #jobIds\nlocal failedJobs = {}\n\nfor i = 1, jobCount, 1 do\n    local lockKey = baseKey .. jobIds[i] .. ':lock'\n    local jobId = jobIds[i]\n    local token = tokens[i]\n\n    local currentToken = rcall(\"GET\", lockKey)\n    if currentToken then\n        if currentToken then\n            local setResult = rcall(\"SET\", lockKey, token, \"PX\", lockDuration)\n            if setResult then\n                rcall(\"SREM\", stalledKey, jobId)\n            else\n                table.insert(failedJobs, jobId)\n            end\n        else\n            table.insert(failedJobs, jobId)\n        end\n    else\n        table.insert(failedJobs, jobId)\n    end\nend\n\nreturn failedJobs\nlocal function removeLock(jobKey, stalledKey, token, jobId)\n  if token ~= \"0\" then\n    local lockKey = jobKey .. ':lock'\n    local lockToken = rcall(\"GET\", lockKey)\n    if lockToken then\n      rcall(\"DEL\", lockKey)\n      rcall(\"SREM\", stalledKey, jobId)\n    else\n      if lockToken then\n        -- Lock exists but token does not match\n        return -6\n      else\n        -- Lock is missing completely\n        return -2\n      end\n    end\n  end\n  return 0\nend\nv24.21.0\n62474","is_error":false}]},"parent_tool_use_id":null,"session_id":"191f61a1-f245-4c3a-b208-195b7f55d82c","uuid":"c7c9f765-5dd3-4955-b993-1b2210671f63","timestamp":"2026-10-04T14:49:07.014Z","tool_use_result":{"stdout":"commit 2da5186d087e0dcb9ff396ff5327abf17f1e3f37\nAuthor: Benchmark <benchmark@localhost>\nDate:   Sun Oct 4 10:43:49 2026 -0400\n\n    Recorded broken seed\n\n .github/ISSUE_TEMPLATE/bug.yaml                    |    58 +\n .github/ISSUE_TEMPLATE/feature_request.md          |    20 +\n .github/pull_request_template.md                   |    71 +\n .github/workflows/codeql-analysis.yml              |    70 +\n .github/workflows/codeql.yml                       |   102 +\n .github/workflows/docs.yml                         |    48 +\n .github/workflows/dotnet-test.yml                  |   127 +\n .github/workflows/elixir-test.yml                  |   180 +\n .github/workflows/osv-scanner-scheduled.yml        |    23 +\n .github/workflows/osv-scanner.yml                  |   148 +\n .github/workflows/python-test.yml                  |   178 +\n .github/workflows/release.yml                      |   568 +\n .github/workflows/rust-test.yml                    |   106 +\n .github/workflows/test.yml                         |   567 +\n .github/workflows/valkey-glide-test.yml            |    65 +\n .gitignore                                         |    35 +\n .husky/commit-msg                                  |     1 +\n .husky/pre-commit                                  |    10 +\n .madgerc                                           |     7 +\n .mocharc.js                                        |     7 +\n .npmignore                                         |    29 +\n .nvmrc              