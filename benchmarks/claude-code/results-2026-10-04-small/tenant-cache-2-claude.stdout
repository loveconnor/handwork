che.delete(projectDetailKey(projectId));\n\"\"\",\"\"\"      cache.delete(projectDetailKey(projectId));\n      const prefix=projectListPrefix(project.organizationId);\n      for(const key of cache.keys())if(key.startsWith(prefix))cache.delete(key);\n\"\"\")\nopen(p,'w').write(s)\nEOF\ncat > tests/isolation.test.ts <<'EOF'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { createApp } from '../src/app.ts';\nimport { sampleSeed } from '../src/seed.ts';\nimport { membershipRepository } from '../src/db/membership-repository.ts';\nconst forbidden={status:403,body:{error:'forbidden'}};\nconst list=(a:any,org:string,token:string,query?:Record<string,string>)=>a.request({method:'GET',path:`/organizations/${encodeURIComponent(org)}/projects`,token,query});\nconst names=(r:any)=>r.body.items.map((p:any)=>p.name);\ntest('nonmember cannot read a project',()=>{const a=createApp(sampleSeed());assert.deepEqual(a.request({method:'GET',path:'/projects/b1',token:'alice'}),forbidden);});\ntest('nonmember cannot update a project',()=>{\n  const a=createApp(sampleSeed());list(a,'org-b','bob');\n  const keys=a.cache.keys();\n  assert.deepEqual(a.request({method:'PATCH',path:'/projects/b1',token:'alice',body:{name:'Hacked',organizationId:'org-a'}}),forbidden);\n  assert.deepEqual(a.request({method:'PATCH',path:'/projects/b1',token:'alice',body:{name:''}}),forbidden);\n  assert.equal(a.db.projects.get('b1')!.name,'Beta');assert.equal(a.db.counters.projectUpdates,0);assert.deepEqual(a.cache.keys(),keys);\n});\ntest('missing project is 404, nonmember list is 403',()=>{\n  const a=createApp(sampleSeed());\n  assert.equal(a.request({method:'GET',path:'/projects/nope',token:'alice'}).status,404);\n  assert.equal(a.request({method:'PATCH',path:'/projects/nope',token:'alice',body:{name:'x'}}).status,404);\n  assert.deepEqual(list(a,'org-b','alice'),forbidden);\n});\ntest('lists are cached per organization',()=>{\n  const a=createApp(sampleSeed());\n  assert.deepEqual(names(list(a,'org-a','both')),['Alpha','Delta','Gamma']);\n  assert.deepEqual(names(list(a,'org-b','both')),['Beta','Echo','Foxtrot']);\n  assert.equal(a.db.counters.projectLists,2);\n  assert.deepEqual(names(list(a,'org-a','both')),['Alpha','Delta','Gamma']);\n  assert.equal(a.db.counters.projectLists,2);\n});\ntest('cache keeps pagination and sorting variants distinct',()=>{\n  const a=createApp(sampleSeed());\n  assert.deepEqual(names(list(a,'org-a','alice',{pageSize:'2'})),['Alpha','Delta']);\n  assert.deepEqual(names(list(a,'org-a','alice',{pageSize:'2',page:'2'})),['Gamma']);\n  assert.deepEqual(names(list(a,'org-a','alice',{direction:'desc'})),['Gamma','Delta','Alpha']);\n  assert.deepEqual(names(list(a,'org-a','alice',{sort:'updatedAt'})),['Delta','Gamma','Alpha']);\n  assert.equal(a.db.counters.projectLists,4);\n});\ntest('cached list still requires membership, including after revocation',()=>{\n  const a=createApp(sampleSeed());list(a,'org-b','bob');\n  assert.deepEqual(list(a,'org-b','alice'),forbidden);\n  membershipRepository(a.db).revoke('bob','org-b');\n  assert.deepEqual(list(a,'org-b','bob'),forbidden);\n  assert.deepEqual(a.request({method:'GET',path:'/projects/b1',token:'bob'}),forbidden);\n  assert.equal(a.db.counters.projectLists,1);\n});\ntest('update invalidates every list variant of the owning organization only',()=>{\n  const a=createApp(sampleSeed());\n  const variants=[undefined,{direction:'desc'},{sort:'updatedAt'},{pageSize:'1',page:'2'}];\n  for(const q of variants)list(a,'org-a','both',q as any);\n  list(a,'org-b','both');\n  assert.equal(a.db.counters.projectLists,5);\n  assert.equal(a.request({method:'PATCH',path:'/projects/a1',token:'both',body:{name:'Zulu'}}).status,200);\n  assert.deepEqual(names(list(a,'org-a','both')),['Delta','Gamma','Zulu']);\n  assert.deepEqual(names(list(a,'org-a','both',{direction:'desc'})),['Zulu','Gamma','Delta']);\n  assert.deepEqual(names(list(a,'org-a','both',{sort:'updatedAt'})),['Delta','Gamma','Zulu']);\n  assert.deepEqual(names(list(a,'org-a','both',{pageSize:'1',page:'2'})),['Gamma']);\n  assert.equal(a.db.counters.projectLists,9);\n  list(a,'org-b','both');assert.equal(a.db.counters.projectLists,9);\n});\ntest('organization IDs sharing prefixes or punctuation stay isolated',()=>{\n  const seed=sampleSeed();const ids=['org','org:1','org:1:10','org-a:1'];\n  for(const id of ids){seed.organizations.push({id,name:id});seed.memberships.push({userId:'both',organizationId:id});seed.projects.push({id:`p-${id}`,organizationId:id,name:`N ${id}`,updatedAt:1});}\n  const a=createApp(seed);\n  for(const id of ids)assert.deepEqual(names(list(a,id,'both')),[`N ${id}`]);\n  assert.deepEqual(names(list(a,'org:1','both',{pageSize:'10'})),['N org:1']);\n  const before=a.db.counters.projectLists;\n  assert.equal(a.request({method:'PATCH',path:'/projects/p-org:1',token:'both',body:{name:'Changed'}}).status,200);\n  assert.deepEqual(names(list(a,'org:1','both')),['Changed']);\n  assert.equal(a.db.counters.projectLists,before+1);\n  for(const id of ids.filter(i=>i!=='org:1'))assert.deepEqual(names(list(a,id,'both')),[`N ${id}`]);\n  assert.deepEqual(names(list(a,'org-a','both')),['Alpha','Delta','Gamma']);\n  assert.equal(a.db.counters.projectLists,before+2);\n});\ntest('cached lists are snapshots even with a non-cloning cache',()=>{\n  const m=new Map<string,unknown>();\n  const a=createApp(sampleSeed(),{get:k=>m.get(k),set:(k,v)=>{m.set(k,v);},delete:k=>{m.delete(k);},keys:()=>[...m.keys()]});\n  (list(a,'org-a','alice').body as any).items[0].name='Mutated';\n  (list(a,'org-a','alice').body as any).items[0].name='Mutated';\n  assert.deepEqual(names(list(a,'org-a','alice')),['Alpha','Delta','Gamma']);\n});\nEOF\nnpm test 2>&1 | tail -30; git status --short","description":"Apply fix, add isolation tests, run test suite"}},"wire_ingest_context":{"toolu_01MKPKgsLoXLzXzV3A6Wf5RT":{"cwd":"/private/tmp/handwork-claude-vucg11_s/tenant-cache-2-claude/repo"}}}
