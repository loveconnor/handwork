{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfhRb8bBMho2K6RVoJgjN","type":"message","role":"assistant","content":[{"type":"text","text":"Fix is in and the build passes; now writing a regression test file for the stale-worker scenarios, then running the full prevalidated command."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1522,"cache_read_input_tokens":58511,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1522},"output_tokens":60,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d1897958-d059-4bf2-a643-0cfa35d14c6d","uuid":"d4a07c10-c3cc-4402-ac6f-dae5c7f7efd2","timestamp":"2026-10-04T15:21:39.927Z","request_id":"req_011CfhRb8FaXF4DqwKwpCu8i"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfhRb8bBMho2K6RVoJgjN","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01B88XJVwY8KrQTY7U8n1aRr","name":"Write","input":{"file_path":"/private/tmp/handwork-claude-7lla1sj1/bullmq-5-claude/repo/tests/stale_worker_ownership.test.ts","content":"import {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\n\nimport { Job, Queue, Worker } from '../src/classes';\nimport { ErrorCode } from '../src/enums';\nimport { IRedisClient } from '../src/interfaces';\nimport { delay, randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { cleanupQueue } from './utils/cleanup-queue';\n\ndescribe('stale worker ownership', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n  const staleToken = 'stale-token';\n  const ownerToken = 'owner-token';\n\n  let connection: IRedisClient;\n  let queue: Queue;\n  let queueName: string;\n  let staleWorker: Worker;\n  let ownerWorker: Worker;\n\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n    staleWorker = new Worker(queueName, void 0, {\n      connection,\n      prefix,\n      lockDuration: 100,\n      stalledInterval: 10,\n    });\n    ownerWorker = new Worker(queueName, void 0, {\n      connection,\n      prefix,\n      lockDuration: 30000,\n    });\n    await staleWorker.waitUntilReady();\n    await ownerWorker.waitUntilReady();\n  });\n\n  afterEach(async () => {\n    await staleWorker.close();\n    await ownerWorker.close();\n    await queue.close();\n    await cleanupQueue(queueName, prefix);\n  });\n\n  afterAll(async function () {\n    await connection.quit();\n  });\n\n  // The stale worker takes the job, loses its lock, the job is recovered by\n  // the stalled checker and claimed by the owner worker.\n  async function recoverJob(opts = {}) {\n    await queue.add('test', { foo: 'bar' }, opts);\n\n    const staleJob = (await staleWorker.getNextJob(staleToken)) as Job;\n    expect(staleJob).toBeDefined();\n\n    await delay(150);\n\n    const backend = (staleWorker as any).backend;\n    await backend.moveStalledJobsToWait();\n    await delay(50);\n    const stalled = await backend.moveStalledJobsToWait();\n    expect(stalled).toEqual([staleJob.id]);\n\n    const ownerJob = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    expect(ownerJob.id).toBe(staleJob.id);\n\n    return { staleJob, ownerJob };\n  }\n\n  async function snapshot(jobId: string) {\n    const client = await queue.client;\n    const job = await queue.getJob(jobId);\n    return {\n      state: await job!.getState(),\n      attemptsMade: job!.attemptsMade,\n      attemptsStarted: job!.attemptsStarted,\n      returnvalue: job!.returnvalue,\n      failedReason: job!.failedReason,\n      stacktrace: job!.stacktrace,\n      delay: job!.delay,\n      finishedOn: job!.finishedOn,\n      lock: await client.get(`${prefix}:${queueName}:${jobId}:lock`),\n      events: await (client as any).xlen(`${prefix}:${queueName}:events`),\n    };\n  }\n\n  async function expectLockMismatch(\n    jobId: string,\n    operation: () => Promise<unknown>,\n  ) {\n    const before = await snapshot(jobId);\n    expect(before.state).toBe('active');\n    expect(before.lock).toBe(ownerToken);\n\n    await expect(operation()).rejects.toMatchObject({\n      code: ErrorCode.JobLockMismatch,\n    });\n\n    expect(await snapshot(jobId)).toEqual(before);\n  }\n\n  it('should not complete a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToCompleted('stale', staleToken, false),\n    );\n\n    await ownerJob.moveToCompleted('owner', ownerToken, false);\n    const job = await queue.getJob(ownerJob.id!);\n    expect(await job!.getState()).toBe('completed');\n    expect(job!.returnvalue).toBe('owner');\n  });\n\n  it('should not fail a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = await queue.getJob(ownerJob.id!);\n    expect(await job!.getState()).toBe('failed');\n    expect(job!.failedReason).toBe('owner');\n  });\n\n  it('should not immediately retry a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob({ attempts: 3 });\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = await queue.getJob(ownerJob.id!);\n    expect(await job!.getState()).toBe('waiting');\n    expect(job!.attemptsMade).toBe(1);\n  });\n\n  it('should not schedule a delayed retry for a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob({\n      attempts: 3,\n      backoff: { type: 'fixed', delay: 5000 },\n    });\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = await queue.getJob(ownerJob.id!);\n    expect(await job!.getState()).toBe('delayed');\n    expect(job!.attemptsMade).toBe(1);\n    expect(job!.delay).toBe(5000);\n  });\n\n  it('should not move a recovered job to delayed or wait', async () => {\n    const { staleJob } = await recoverJob();\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToDelayed(Date.now() + 5000, staleToken),\n    );\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToWait(staleToken),\n    );\n  });\n\n  it('should not renew the lock of a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n    const client = await queue.client;\n    const lockKey = `${prefix}:${queueName}:${staleJob.id}:lock`;\n\n    expect(await staleJob.extendLock(staleToken, 60000)).toBe(0);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await (client as any).pttl(lockKey)).toBeLessThanOrEqual(30000);\n\n    expect(await ownerJob.extendLock(ownerToken, 60000)).toBe(1);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await (client as any).pttl(lockKey)).toBeGreaterThan(30000);\n  });\n\n  it('should not renew the lock of a recovered job in batch', async () => {\n    const { staleJob } = await recoverJob();\n    const client = await queue.client;\n    const lockKey = `${prefix}:${queueName}:${staleJob.id}:lock`;\n\n    await queue.add('other', {});\n    const otherJob = (await staleWorker.getNextJob(staleToken)) as Job;\n\n    expect(\n      await (staleWorker as any).extendJobLocks(\n        [staleJob.id, otherJob.id, 'missing'],\n        [staleToken, staleToken, staleToken],\n        60000,\n      ),\n    ).toEqual([staleJob.id, 'missing']);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await (client as any).pttl(lockKey)).toBeLessThanOrEqual(30000);\n\n    expect(\n      await (ownerWorker as any).extendJobLocks(\n        [staleJob.id],\n        [ownerToken],\n        60000,\n      ),\n    ).toEqual([]);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await (client as any).pttl(lockKey)).toBeGreaterThan(30000);\n  });\n\n  it('should still report a missing lock', async () => {\n    await queue.add('test', { foo: 'bar' });\n    const job = (await staleWorker.getNextJob(staleToken)) as Job;\n\n    await delay(150);\n\n    expect(await job.extendLock(staleToken, 60000)).toBe(0);\n    await expect(\n      job.moveToCompleted('stale', staleToken, false),\n    ).rejects.toMatchObject({ code: ErrorCode.JobLockNotExist });\n    expect(await job.getState()).toBe('active');\n  });\n});\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1522,"cache_read_input_tokens":58511,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1522},"output_tokens":60,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d1897958-d059-4bf2-a643-0cfa35d14c6d","uuid":"3bbb9dd6-be60-479c-bad4-e3c17625f3f7","timestamp":"2026-10-04T15:22:04.808Z","request_id":"req_011CfhRb8FaXF4DqwKwpCu8i","wire_tool_inputs":{"toolu_01B88XJVwY8KrQTY7U8n1aRr":{"file_path":"/private/tmp/handwork-claude-7lla1sj1/bullmq-5-claude/repo/tests/stale_worker_ownership.test.ts","content":"import {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\n\nimport { Job, Queue, Worker } from '../src/classes';\nimport { ErrorCode } from '../src/enums';\nimport { IRedisClient } from '../src/interfaces';\nimport { delay, randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { cleanupQueue } from './utils/cleanup-queue';\n\ndescribe('stale worker ownership', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n  const staleToken = 'stale-token';\n  const ownerToken = 'owner-token';\n\n  let connection: IRedisClient;\n  let queue: Queue;\n  let queueName: string;\n  let staleWorker: Worker;\n  let ownerWorker: Worker;\n\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n    staleWorker = new Worker(queueName, void 0, {\n      connection,\n      prefix,\n      lockDuration: 100,\n      stalledInterval: 10,\n    });\n    ownerWorker = new Worker(queueName, void 0, {\n      connection,\n      prefix,\n      lockDuration: 30000,\n    });\n    await staleWorker.waitUntilReady();\n    await ownerWorker.waitUntilReady();\n  });\n\n  afterEach(async () => {\n    await staleWorker.close();\n    await ownerWorker.close();\n    await queue.close();\n    await cleanupQueue(queueName, prefix);\n  });\n\n  afterAll(async function () {\n    await connection.quit();\n  });\n\n  // The stale worker takes the job, loses its lock, the job is recovered by\n  // the stalled checker and claimed by the owner worker.\n  async function recoverJob(opts = {}) {\n    await queue.add('test', { foo: 'bar' }, opts);\n\n    const staleJob = (await staleWorker.getNextJob(staleToken)) as Job;\n    expect(staleJob).toBeDefined();\n\n    await delay(150);\n\n    const backend = (staleWorker as any).backend;\n    await backend.moveStalledJobsToWait();\n    await delay(50);\n    const stalled = await backend.moveStalledJobsToWait();\n    expect(stalled).toEqual([staleJob.id]);\n\n    const ownerJob = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    expect(ownerJob.id).toBe(staleJob.id);\n\n    return { staleJob, ownerJob };\n  }\n\n  async function snapshot(jobId: string) {\n    const client = await queue.client;\n    const job = await queue.getJob(jobId);\n    return {\n      state: await job!.getState(),\n      attemptsMade: job!.attemptsMade,\n      attemptsStarted: job!.attemptsStarted,\n      returnvalue: job!.returnvalue,\n      failedReason: job!.failedReason,\n      stacktrace: job!.stacktrace,\n      delay: job!.delay,\n      finishedOn: job!.finishedOn,\n      lock: await client.get(`${prefix}:${queueName}:${jobId}:lock`),\n      events: await (client as any).xlen(`${prefix}:${queueName}:events`),\n    };\n  }\n\n  async function expectLockMismatch(\n    jobId: string,\n    operation: () => Promise<unknown>,\n  ) {\n    const before = await snapshot(jobId);\n    expect(before.state).toBe('active');\n    expect(before.lock).toBe(ownerToken);\n\n    await expect(operation()).rejects.toMatchObject({\n      code: ErrorCode.JobLockMismatch,\n    });\n\n    expect(await snapshot(jobId)).toEqual(before);\n  }\n\n  it('should not complete a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToCompleted('stale', staleToken, false),\n    );\n\n    await ownerJob.moveToCompleted('owner', ownerToken, false);\n    const job = await queue.getJob(ownerJob.id!);\n    expect(await job!.getState()).toBe('completed');\n    expect(job!.returnvalue).toBe('owner');\n  });\n\n  it('should not fail a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = await queue.getJob(ownerJob.id!);\n    expect(await job!.getState()).toBe('failed');\n    expect(job!.failedReason).toBe('owner');\n  });\n\n  it('should not immediately retry a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob({ attempts: 3 });\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = await queue.getJob(ownerJob.id!);\n    expect(await job!.getState()).toBe('waiting');\n    expect(job!.attemptsMade).toBe(1);\n  });\n\n  it('should not schedule a delayed retry for a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob({\n      attempts: 3,\n      backoff: { type: 'fixed', delay: 5000 },\n    });\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = await queue.getJob(ownerJob.id!);\n    expect(await job!.getState()).toBe('delayed');\n    expect(job!.attemptsMade).toBe(1);\n    expect(job!.delay).toBe(5000);\n  });\n\n  it('should not move a recovered job to delayed or wait', async () => {\n    const { staleJob } = await recoverJob();\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToDelayed(Date.now() + 5000, staleToken),\n    );\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToWait(staleToken),\n    );\n  });\n\n  it('should not renew the lock of a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n    const client = await queue.client;\n    const lockKey = `${prefix}:${queueName}:${staleJob.id}:lock`;\n\n    expect(await staleJob.extendLock(staleToken, 60000)).toBe(0);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await (client as any).pttl(lockKey)).toBeLessThanOrEqual(30000);\n\n    expect(await ownerJob.extendLock(ownerToken, 60000)).toBe(1);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await (client as any).pttl(lockKey)).toBeGreaterThan(30000);\n  });\n\n  it('should not renew the lock of a recovered job in batch', async () => {\n    const { staleJob } = await recoverJob();\n    const client = await queue.client;\n    const lockKey = `${prefix}:${queueName}:${staleJob.id}:lock`;\n\n    await queue.add('other', {});\n    const otherJob = (await staleWorker.getNextJob(staleToken)) as Job;\n\n    expect(\n      await (staleWorker as any).extendJobLocks(\n        [staleJob.id, otherJob.id, 'missing'],\n        [staleToken, staleToken, staleToken],\n        60000,\n      ),\n    ).toEqual([staleJob.id, 'missing']);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await (client as any).pttl(lockKey)).toBeLessThanOrEqual(30000);\n\n    expect(\n      await (ownerWorker as any).extendJobLocks(\n        [staleJob.id],\n        [ownerToken],\n        60000,\n      ),\n    ).toEqual([]);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await (client as any).pttl(lockKey)).toBeGreaterThan(30000);\n  });\n\n  it('should still report a missing lock', async () => {\n    await queue.add('test', { foo: 'bar' });\n    const job = (await staleWorker.getNextJob(staleToken)) as Job;\n\n    await delay(150);\n\n    expect(await job.extendLock(staleToken, 60000)).toBe(0);\n    await expect(\n      job.moveToCompleted('stale', staleToken, false),\n    ).rejects.toMatchObject({ code: ErrorCode.JobLockNotExist });\n    expect(await job.getState()).toBe('active');\n  });\n});\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B88XJVwY8KrQTY7U8n1aRr","type":"tool_result","content":"File created successfully at: /private/tmp/handwork-claude-7lla1sj1/bullmq-5-claude/repo/tests/stale_worker_ownership.test.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"d1897958-d059-4bf2-a643-0cfa35d14c6d","uuid":"abdb7217-db5a-4f9c-a1b8-2e77488b51a0","timestamp":"2026-10-04T15:22:04.815Z","tool_use_result":{"type":"create","filePath":"/private/tmp/handwork-claude-7lla1sj1/bullmq-5-claude/repo/tests/stale_worker_ownership.test.ts","content":"import {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\n\nimport { Job, Queue, Worker } from '../src/classes';\nimport { ErrorCode } from '../src/enums';\nimport { IRedisClient } from '../src/interfaces';\nimport { delay, randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { cleanupQueue } from './utils/cleanup-queue';\n\ndescribe('stale worker ownership', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n  const staleToken = 'stale-token';\n  const ownerToken = 'owner-token';\n\n  let connection: IRedisClient;\n  let queue: Queue;\n  let queueName: string;\n  let staleWorker: Worker;\n  let ownerWorker: Worker;\n\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n    staleWorker = new Worker(queueName, void 0, {\n      connection,\n      prefix,\n      lockDuration: 100,\n      stalledInterval: 10,\n    });\n    ownerWorker = new Worker(queueName, void 0, {\n      connection,\n      prefix,\n      lockDuration: 30000,\n    });\n    await staleWorker.waitUntilReady();\n    await ownerWorker.waitUntilReady();\n  });\n\n  afterEach(async () => {\n    await staleWorker.close();\n    await ownerWorker.close();\n    await queue.close();\n    await cleanupQueue(queueName, prefix);\n  });\n\n  afterAll(async function () {\n    await connection.quit();\n  });\n\n  // The stale worker takes the job, loses its lock, the job is recovered by\n  // the stalled checker and claimed by the owner worker.\n  async function recoverJob(opts = {}) {\n    await queue.add('test', { foo: 'bar' }, opts);\n\n    const staleJob = (await staleWorker.getNextJob(staleToken)) as Job;\n    expect(staleJob).toBeDefined();\n\n    await delay(150);\n\n    const backend = (staleWorker as any).backend;\n    await backend.moveStalledJobsToWait();\n    await delay(50);\n    const stalled = await backend.moveStalledJobsToWait();\n    expect(stalled).toEqual([staleJob.id]);\n\n    const ownerJob = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    expect(ownerJob.id).toBe(staleJob.id);\n\n    return { staleJob, ownerJob };\n  }\n\n  async function snapshot(jobId: string) {\n    const client = await queue.client;\n    const job = await queue.getJob(jobId);\n    return {\n      state: await job!.getState(),\n      attemptsMade: job!.attemptsMade,\n      attemptsStarted: job!.attemptsStarted,\n      returnvalue: job!.returnvalue,\n      failedReason: job!.failedReason,\n      stacktrace: job!.stacktrace,\n      delay: job!.delay,\n      finishedOn: job!.finishedOn,\n      lock: await client.get(`${prefix}:${queueName}:${jobId}:lock`),\n      events: await (client as any).xlen(`${prefix}:${queueName}:events`),\n    };\n  }\n\n  async function expectLockMismatch(\n    jobId: string,\n    operation: () => Promise<unknown>,\n  ) {\n    const before = await snapshot(jobId);\n    expect(before.state).toBe('active');\n    expect(before.lock).toBe(ownerToken);\n\n    await expect(operation()).rejects.toMatchObject({\n      code: ErrorCode.JobLockMismatch,\n    });\n\n    expect(await snapshot(jobId)).toEqual(before);\n  }\n\n  it('should not complete a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToCompleted('stale', staleToken, false),\n    );\n\n    await ownerJob.moveToCompleted('owner', ownerToken, false);\n    const job = await queue.getJob(ownerJob.id!);\n    expect(await job!.getState()).toBe('completed');\n    expect(job!.returnvalue).toBe('owner');\n  });\n\n  it('should not fail a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = await queue.getJob(ownerJob.id!);\n    expect(await job!.getState()).toBe('failed');\n    expect(job!.failedReason).toBe('owner');\n  });\n\n  it('should not immediately retry a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob({ attempts: 3 });\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = await queue.getJob(ownerJob.id!);\n    expect(await job!.getState()).toBe('waiting');\n    expect(job!.attemptsMade).toBe(1);\n  });\n\n  it('should not schedule a delayed retry for a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob({\n      attempts: 3,\n      backoff: { type: 'fixed', delay: 5000 },\n    });\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = await queue.getJob(ownerJob.id!);\n    expect(await job!.getState()).toBe('delayed');\n    expect(job!.attemptsMade).toBe(1);\n    expect(job!.delay).toBe(5000);\n  });\n\n  it('should not move a recovered job to delayed or wait', async () => {\n    const { staleJob } = await recoverJob();\n\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToDelayed(Date.now() + 5000, staleToken),\n    );\n    await expectLockMismatch(staleJob.id!, () =>\n      staleJob.moveToWait(staleToken),\n    );\n  });\n\n  it('should not renew the lock of a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n    const client = await queue.client;\n    const lockKey = `${prefix}:${queueName}:${staleJob.id}:lock`;\n\n    expect(await staleJob.extendLock(staleToken, 60000)).toBe(0);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await (client as any).pttl(lockKey)).toBeLessThanOrEqual(30000);\n\n    expect(await ownerJob.extendLock(ownerToken, 60000)).toBe(1);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await (client as any).pttl(lockKey)).toBeGreaterThan(30000);\n  });\n\n  it('should not renew the lock of a recovered job in batch', async () => {\n    const { staleJob } = await recoverJob();\n    const client = await queue.client;\n    const lockKey = `${prefix}:${queueName}:${staleJob.id}:lock`;\n\n    await queue.add('other', {});\n    const otherJob = (await staleWorker.getNextJob(staleToken)) as Job;\n\n    expect(\n      await (staleWorker as any).extendJobLocks(\n        [staleJob.id, otherJob.id, 'missing'],\n        [staleToken, staleToken, staleToken],\n        60000,\n      ),\n    ).toEqual([staleJob.id, 'missing']);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await (client as any).pttl(lockKey)).toBeLessThanOrEqual(30000);\n\n    expect(\n      await (ownerWorker as any).extendJobLocks(\n        [staleJob.id],\n        [ownerToken],\n        60000,\n      ),\n    ).toEqual([]);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await (client as any).pttl(lockKey)).toBeGreaterThan(30000);\n  });\n\n  it('should still report a missing lock', async () => {\n    await queue.add('test', { foo: 'bar' });\n    const job = (await staleWorker.getNextJob(staleToken)) as Job;\n\n    await delay(150);\n\n    expect(await job.extendLock(staleToken, 60000)).toBe(0);\n    await expect(\n      job.moveToCompleted('stale', staleToken, false),\n    ).rejects.toMatchObject({ code: ErrorCode.JobLockNotExist });\n    expect(await job.getState()).toBe('active');\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
