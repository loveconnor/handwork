ies(seed.sessions)),\n    counters: { projectReads: 0, projectLists: 0, projectUpdates: 0 },\n  };\n}\nexport type Database = ReturnType<typeof createDatabase>;","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/handwork-fair-2tip6hsn/tenant-cache-3-opencode/repo/src/db/database.ts","text":"import type { Project, Organization, User } from '../types.ts';\nexport type Seed = { projects: Project[]; organizations: Organization[]; users: User[]; memberships: {userId:string; organizationId:string}[]; sessions: Record<string,string> };\nexport function createDatabase(seed: Seed) {\n  return {\n    projects: new Map(seed.projects.map(p => [p.id, structuredClone(p)])),\n    organizations: new Map(seed.organizations.map(o => [o.id, {...o}])),\n    users: new Map(seed.users.map(u => [u.id, {...u}])),\n    memberships: new Set(seed.memberships.map(m => JSON.stringify([m.userId,m.organizationId]))),\n    sessions: new Map(Object.entries(seed.sessions)),\n    counters: { projectReads: 0, projectLists: 0, projectUpdates: 0 },\n  };\n}\nexport type Database = ReturnType<typeof createDatabase>;","lineStart":1,"lineEnd":13,"totalLines":13,"truncated":false}},"title":"src/db/database.ts","time":{"start":1789781713634,"end":1789781713637}},"metadata":{"openai":{"itemId":"fc_0c09ed1540194e9d016aade6d1546487d1b66434e3fb4e3740"}},"id":"prt_0b74da2e0001YYVWvYbB0o3eSP","sessionID":"ses_f48b2fab2ffeptjxVIL440JMjh","messageID":"msg_0b74d763f001q62wHJMZb1Jqdc"}}
