er({ search: () => new Promise((resolve, reject) => pending.push({ resolve, reject })) }); const old = c.search(\"old\"); const latest = c.search(\"latest\"); const items = [{ id: \"latest\", title: \"Latest\", url: \"/latest\" }]; if (latestFirst) { pending[1].resolve(items); await latest; } if (clear) { const cleared = c.search(\"  \"); assert.deepEqual(c.getState(), { query: \"\", results: [], loading: false, error: null }); await cleared; } const before = c.getState(); if (rejectOld) pending[0].reject(new Error(\"stale error\")); else pending[0].resolve([{ id: \"old\", title: \"Old\", url: \"/old\" }]); await old; assert.deepEqual(c.getState(), before); if (!latestFirst) { pending[1].resolve(items); await latest; } assert.deepEqual(c.getState(), clear ? { query: \"\", results: [], loading: false, error: null } : { query: \"latest\", results: items, loading: false, error: null }); } } } console.log(\"Passed 8 stale-completion and query-clear scenarios\");'","time":{"start":1789170190409,"end":1789170190412}},"metadata":{"openai":{"itemId":"fc_0829185ef83c14c1016aa49203bc8487d196442c775e46d93c"}},"id":"prt_092da5ec9001Jfl12pwT5Ylwl0","sessionID":"ses_f6d2696d1ffeO4XxGsndKxjFOF","messageID":"msg_092da564e001H2UtOFQW2qH5Um"}}
