\n846:       [TelemetryAttributes.JobName]: this.name,\n847:       [TelemetryAttributes.JobState]: state,\n848:     };\n849: \n850:     // Record counter metric based on state\n851:     const stateToCounterName: Record<\n852:       | 'completed'\n853:       | 'failed'\n854:       | 'delayed'\n855:       | 'retried'\n856:       | 'waiting'\n857:       | 'waiting-children',\n858:       MetricNames\n859:     > = {\n860:       completed: MetricNames.JobsCompleted,\n861:       failed: MetricNames.JobsFailed,\n862:       delayed: MetricNames.JobsDelayed,\n863:       retried: MetricNames.JobsRetried,\n864:       waiting: MetricNames.JobsWaiting,\n865:       'waiting-children': MetricNames.JobsWaitingChildren,\n866:     };\n867: \n868:     const counterName = stateToCounterName[state];\n869:     const counter = meter.createCounter(counterName, {\n870:       description: `Number of jobs ${state}`,\n871:       unit: '1',\n872:     });\n873:     counter.add(1, attributes);\n874: \n875:     // Record duration histogram if processedOn is available\n876:     if (this.processedOn) {\n877:       const duration = Date.now() - this.processedOn;\n878:       const histogram = meter.createHistogram(MetricNames.JobDuration, {\n879:         description: 'Job processing duration',\n880:         unit: 'ms',\n881:       });\n882:       histogram.record(duration, attributes);\n883:     }\n884:   }\n885: \n886:   /**\n887:    * @returns true if the job has completed.\n888:    */\n889:   isCompleted(): Promise<boolean> {\n\n(Showing lines 730-889 of 1444. Use offset=890 to continue.)\n</content>","metadata":{"preview":"    this.failedReason = err?.message;\n\n    // Check if an automatic retry should be performed\n    const [shouldRetry, retryDelay] = await this.shouldRetryJob(err);\n\n    return this.queue.trace<Promise<void | any[]>>(\n      SpanKind.INTERNAL,\n      this.getSpanOperation(shouldRetry, retryDelay),\n      this.queue.name,\n      async (span, dstPropagationMetadata) => {\n        this.setSpanJobAttributes(span);\n\n        let tm;\n        if (!this.opts?.telemetry?.omitContext && dstPropagationMetadata) {\n          tm = dstPropagationMetadata;\n        }\n        let result;\n\n        this.updateStacktrace(err);\n","truncated":true,"loaded":[],"display":{"type":"file","path":"/private/tmp/handwork-bullmq-G7VJT5/4-opencode/repo/src/classes/job.ts","text":"    this.failedReason = err?.message;\n\n    // Check if an automatic retry should be performed\n    const [shouldRetry, retryDelay] = await this.shouldRetryJob(err);\n\n    return this.queue.trace<Promise<void | any[]>>(\n      SpanKind.INTERNAL,\n      this.getSpanOperation(shouldRetry, retryDelay),\n      this.queue.name,\n      async (span, dstPropagationMetadata) => {\n        this.setSpanJobAttributes(span);\n\n        let tm;\n        if (!this.opts?.telemetry?.omitContext && dstPropagationMetadata) {\n          tm = dstPropagationMetadata;\n        }\n        let result;\n\n        this.updateStacktrace(err);\n\n        const fieldsToUpdate = {\n          failedReason: this.failedReason,\n          stacktrace: JSON.stringify(this.stacktrace),\n          tm,\n        };\n\n        let finishedOn: number;\n        if (shouldRetry) {\n          if (retryDelay) {\n            // Retry with delay\n            result = await this.backend.moveToDelayed(\n              this.id,\n              Date.now(),\n              retryDelay,\n              token,\n              { fieldsToUpdate, fetchNext },\n            );\n\n            this.recordJobMetrics('delayed');\n          } else {\n            // Retry immediately\n            result = await this.backend.retryJob(\n              this.id,\n              this.opts.lifo,\n              token,\n              {\n                fieldsToUpdate,\n              },\n            );\n\n            this.recordJobMetrics('retried');\n          }\n        } else {\n          const moved = await this.backend.moveToFailed(\n            this,\n            this.failedReason,\n            this.opts.removeOnFail,\n            token,\n            fetchNext,\n            fieldsToUpdate,\n          );\n          result = moved.result;\n          finishedOn = moved.finishedOn;\n\n          // Only record failed metrics when job is not retrying\n          this.recordJobMetrics('failed');\n        }\n\n        if (finishedOn && typeof finishedOn === 'number') {\n          this.finishedOn = finishedOn;\n        }\n\n        if (retryDelay && typeof retryDelay === 'number') {\n          this.delay = retryDelay;\n        }\n\n        this.attemptsMade += 1;\n\n        return result;\n      },\n    );\n  }\n\n  private getSpanOperation(shouldRetry: boolean, retryDelay: number): string {\n    if (shouldRetry) {\n      if (retryDelay) {\n        return 'delay';\n      }\n\n      return 'retry';\n    }\n\n    return 'fail';\n  }\n\n  /**\n   * Records job metrics if a meter is configured in telemetry options.\n   *\n   * @param state - The job state\n   */\n  private recordJobMetrics(\n    state:\n      | 'completed'\n      | 'failed'\n      | 'delayed'\n      | 'retried'\n      | 'waiting'\n      | 'waiting-children',\n  ): void {\n    const meter = this.queue.opts?.telemetry?.meter;\n    if (!meter) {\n      return;\n    }\n\n    const attributes = {\n      [TelemetryAttributes.QueueName]: this.queue.name,\n      [TelemetryAttributes.JobName]: this.name,\n      [TelemetryAttributes.JobState]: state,\n    };\n\n    // Record counter metric based on state\n    const stateToCounterName: Record<\n      | 'completed'\n      | 'failed'\n      | 'delayed'\n      | 'retried'\n      | 'waiting'\n      | 'waiting-children',\n      MetricNames\n    > = {\n      completed: MetricNames.JobsCompleted,\n      failed: MetricNames.JobsFailed,\n      delayed: MetricNames.JobsDelayed,\n      retried: MetricNames.JobsRetried,\n      waiting: MetricNames.JobsWaiting,\n      'waiting-children': MetricNames.JobsWaitingChildren,\n    };\n\n    const counterName = stateToCounterName[state];\n    const counter = meter.createCounter(counterName, {\n      description: `Number of jobs ${state}`,\n      unit: '1',\n    });\n    counter.add(1, attributes);\n\n    // Record duration histogram if processedOn is available\n    if (this.processedOn) {\n      const duration = Date.now() - this.processedOn;\n      const histogram = meter.createHistogram(MetricNames.JobDuration, {\n        description: 'Job processing duration',\n        unit: 'ms',\n      });\n      histogram.record(duration, attributes);\n    }\n  }\n\n  /**\n   * @returns true if the job has completed.\n   */\n  isCompleted(): Promise<boolean> {","lineStart":730,"lineEnd":889,"totalLines":1444,"truncated":true}},"title":"src/classes/job.ts","time":{"start":1789792371042,"end":1789792371054}},"metadata":{"openai":{"itemId":"fc_06fb57fc49291d5d016aae1072f2c487d192603e450f1bde2d"}},"id":"prt_0b7f04161001WRKaUtrDxRmIJ6","sessionID":"ses_f4810bfebffeApNO7X3dNhAmLI","messageID":"msg_0b7f022bf001F0FJKbPX2cSy79"}}
