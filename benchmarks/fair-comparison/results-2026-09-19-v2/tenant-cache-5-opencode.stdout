ies(seed.sessions)),\n    counters: { projectReads: 0, projectLists: 0, projectUpdates: 0 },\n  };\n}\nexport type Database = ReturnType<typeof createDatabase>;","truncated":false,"loaded":[],"display":{"type":"file","path":"/private/tmp/handwork-fair-2tip6hsn/tenant-cache-5-opencode/repo/src/db/database.ts","text":"import type { Project, Organization, User } from '../types.ts';\nexport type Seed = { projects: Project[]; organizations: Organization[]; users: User[]; memberships: {userId:string; organizationId:string}[]; sessions: Record<string,string> };\nexport function createDatabase(seed: Seed) {\n  return {\n    projects: new Map(seed.projects.map(p => [p.id, structuredClone(p)])),\n    organizations: new Map(seed.organizations.map(o => [o.id, {...o}])),\n    users: new Map(seed.users.map(u => [u.id, {...u}])),\n    memberships: new Set(seed.memberships.map(m => JSON.stringify([m.userId,m.organizationId]))),\n    sessions: new Map(Object.entries(seed.sessions)),\n    counters: { projectReads: 0, projectLists: 0, projectUpdates: 0 },\n  };\n}\nexport type Database = ReturnType<typeof createDatabase>;","lineStart":1,"lineEnd":13,"totalLines":13,"truncated":false}},"title":"src/db/database.ts","time":{"start":1789782880881,"end":1789782880883}},"metadata":{"openai":{"itemId":"fc_0f6998b621cfbd00016aadeb608e6887d1a37212a8fbb49dbd"}},"id":"prt_0b75f7247001dKKNIK21PquXtC","sessionID":"ses_f48a1272cffeVhdrtRhR69ox9F","messageID":"msg_0b75f458c001axoxTTs775P54l"}}
