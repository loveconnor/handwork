{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfhQVgGdiLGn7Kge6Hu18","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NM2Bn3AB4HDYgKTwsg6iQ1","name":"Write","input":{"file_path":"/private/tmp/handwork-claude-7lla1sj1/bullmq-3-claude/repo/tests/stale_lock_ownership.test.ts","content":"import {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\n\nimport { Job, Queue, Worker } from '../src/classes';\nimport { IRedisClient } from '../src/interfaces';\nimport { randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { cleanupQueue } from './utils/cleanup-queue';\n\ndescribe('stale lock ownership', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n  const staleToken = 'stale-token';\n  const ownerToken = 'owner-token';\n\n  let queue: Queue;\n  let queueName: string;\n  let staleWorker: Worker;\n  let ownerWorker: Worker;\n  let connection: IRedisClient;\n\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n    staleWorker = new Worker(queueName, null, {\n      connection,\n      prefix,\n      lockDuration: 30000,\n    });\n    ownerWorker = new Worker(queueName, null, {\n      connection,\n      prefix,\n      lockDuration: 30000,\n    });\n    await staleWorker.waitUntilReady();\n    await ownerWorker.waitUntilReady();\n  });\n\n  afterEach(async () => {\n    await staleWorker.close();\n    await ownerWorker.close();\n    await queue.close();\n    await cleanupQueue(queueName, prefix);\n  });\n\n  afterAll(async function () {\n    await connection.quit();\n  });\n\n  const lockKey = (jobId: string) => `${prefix}:${queueName}:${jobId}:lock`;\n\n  const getEvents = async () => {\n    const client = await queue.client;\n    return client.xrange(`${prefix}:${queueName}:events`, '-', '+');\n  };\n\n  // The stale worker takes the job, loses its lock, and the job is then\n  // recovered by the stalled checker and claimed by the owner worker.\n  const loseAndRecover = async (opts = {}) => {\n    await queue.add('test', { foo: 'bar' }, opts);\n\n    const staleJob = (await staleWorker.getNextJob(staleToken)) as Job;\n    expect(staleJob).toBeDefined();\n\n    const client = await queue.client;\n    await client.del(lockKey(staleJob.id!));\n\n    // First pass marks the active job, second pass moves it back to wait.\n    await (ownerWorker as any).moveStalledJobsToWait();\n    await (ownerWorker as any).moveStalledJobsToWait();\n\n    const ownerJob = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    expect(ownerJob).toBeDefined();\n    expect(ownerJob.id).toBe(staleJob.id);\n    expect(await client.get(lockKey(ownerJob.id!))).toBe(ownerToken);\n\n    return { staleJob, ownerJob };\n  };\n\n  const snapshot = async (jobId: string) => {\n    const client = await queue.client;\n    const job = (await queue.getJob(jobId))!;\n    return {\n      state: await job.getState(),\n      json: job.asJSON(),\n      lock: await client.get(lockKey(jobId)),\n      events: await getEvents(),\n      counts: await queue.getJobCounts(),\n    };\n  };\n\n  const expectRejected = async (\n    jobId: string,\n    operation: () => Promise<unknown>,\n  ) => {\n    const before = await snapshot(jobId);\n    expect(before.state).toBe('active');\n\n    await expect(operation()).rejects.toMatchObject({ code: -6 });\n\n    expect(await snapshot(jobId)).toEqual(before);\n  };\n\n  it('should not let a stale worker complete a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover();\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToCompleted('stale', staleToken, false),\n    );\n\n    await ownerJob.moveToCompleted('owner', ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('completed');\n    expect(job.returnvalue).toBe('owner');\n  });\n\n  it('should not let a stale worker fail a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover();\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('failed');\n    expect(job.failedReason).toBe('owner');\n  });\n\n  it('should not let a stale worker immediately retry a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover({ attempts: 3 });\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('waiting');\n    expect(job.attemptsMade).toBe(1);\n  });\n\n  it('should not let a stale worker schedule a delayed retry of a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover({\n      attempts: 3,\n      backoff: { type: 'fixed', delay: 5000 },\n    });\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('delayed');\n    expect(job.attemptsMade).toBe(1);\n    expect(job.delay).toBe(5000);\n  });\n\n  it('should not let a stale worker move a recovered job to delayed or wait', async () => {\n    const { staleJob } = await loseAndRecover();\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToDelayed(Date.now() + 5000, staleToken),\n    );\n    await expectRejected(staleJob.id!, () => staleJob.moveToWait(staleToken));\n  });\n\n  it('should not let a stale worker renew the lock of a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover();\n    const client = await queue.client;\n    const stalledKey = `${prefix}:${queueName}:stalled`;\n    await client.sadd(stalledKey, staleJob.id!);\n\n    expect(await staleJob.extendLock(staleToken, 60000)).toBe(0);\n    expect(await client.get(lockKey(staleJob.id!))).toBe(ownerToken);\n    expect(await client.pttl(lockKey(staleJob.id!))).toBeLessThanOrEqual(30000);\n    expect(await client.sismember(stalledKey, staleJob.id!)).toBe(1);\n\n    expect(await ownerJob.extendLock(ownerToken, 60000)).toBe(1);\n    expect(await client.get(lockKey(ownerJob.id!))).toBe(ownerToken);\n    expect(await client.pttl(lockKey(ownerJob.id!))).toBeGreaterThan(30000);\n    expect(await client.sismember(stalledKey, staleJob.id!)).toBe(0);\n  });\n\n  it('should not let a stale worker renew recovered jobs in batch', async () => {\n    const { staleJob } = await loseAndRecover();\n    const client = await queue.client;\n    const stalledKey = `${prefix}:${queueName}:stalled`;\n\n    // A second job still legitimately owned by the stale worker.\n    await queue.add('test', { foo: 'baz' });\n    const ownedJob = (await staleWorker.getNextJob(staleToken)) as Job;\n    await client.sadd(stalledKey, staleJob.id!, ownedJob.id!);\n\n    const failed = await staleWorker.extendJobLocks(\n      [staleJob.id!, ownedJob.id!, 'missing'],\n      [staleToken, staleToken, staleToken],\n      60000,\n    );\n\n    expect(failed).toEqual([staleJob.id, 'missing']);\n    expect(await client.get(lockKey(staleJob.id!))).toBe(ownerToken);\n    expect(await client.pttl(lockKey(staleJob.id!))).toBeLessThanOrEqual(30000);\n    expect(await client.sismember(stalledKey, staleJob.id!)).toBe(1);\n    expect(await client.pttl(lockKey(ownedJob.id!))).toBeGreaterThan(30000);\n    expect(await client.sismember(stalledKey, ownedJob.id!)).toBe(0);\n\n    expect(\n      await ownerWorker.extendJobLocks([staleJob.id!], [ownerToken], 60000),\n    ).toEqual([]);\n    expect(await client.pttl(lockKey(staleJob.id!))).toBeGreaterThan(30000);\n  });\n\n  it('should still report a missing lock as an error', async () => {\n    await queue.add('test', { foo: 'bar' });\n    const job = (await staleWorker.getNextJob(staleToken)) as Job;\n    const client = await queue.client;\n    await client.del(lockKey(job.id!));\n\n    await expect(\n      job.moveToCompleted('done', staleToken, false),\n    ).rejects.toMatchObject({ code: -2 });\n    expect(await job.extendLock(staleToken, 60000)).toBe(0);\n    expect(await job.getState()).toBe('active');\n  });\n});\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1357,"cache_read_input_tokens":48869,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1357},"output_tokens":76,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"43ca26b3-baa3-428a-8353-3ab78a1aaa81","uuid":"d1a53f21-9621-44fb-b705-c06168310fe4","timestamp":"2026-10-04T15:07:45.834Z","request_id":"req_011CfhQVfyWxDkSXTppVPCK3","wire_tool_inputs":{"toolu_01NM2Bn3AB4HDYgKTwsg6iQ1":{"file_path":"/private/tmp/handwork-claude-7lla1sj1/bullmq-3-claude/repo/tests/stale_lock_ownership.test.ts","content":"import {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\n\nimport { Job, Queue, Worker } from '../src/classes';\nimport { IRedisClient } from '../src/interfaces';\nimport { randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { cleanupQueue } from './utils/cleanup-queue';\n\ndescribe('stale lock ownership', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n  const staleToken = 'stale-token';\n  const ownerToken = 'owner-token';\n\n  let queue: Queue;\n  let queueName: string;\n  let staleWorker: Worker;\n  let ownerWorker: Worker;\n  let connection: IRedisClient;\n\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n    staleWorker = new Worker(queueName, null, {\n      connection,\n      prefix,\n      lockDuration: 30000,\n    });\n    ownerWorker = new Worker(queueName, null, {\n      connection,\n      prefix,\n      lockDuration: 30000,\n    });\n    await staleWorker.waitUntilReady();\n    await ownerWorker.waitUntilReady();\n  });\n\n  afterEach(async () => {\n    await staleWorker.close();\n    await ownerWorker.close();\n    await queue.close();\n    await cleanupQueue(queueName, prefix);\n  });\n\n  afterAll(async function () {\n    await connection.quit();\n  });\n\n  const lockKey = (jobId: string) => `${prefix}:${queueName}:${jobId}:lock`;\n\n  const getEvents = async () => {\n    const client = await queue.client;\n    return client.xrange(`${prefix}:${queueName}:events`, '-', '+');\n  };\n\n  // The stale worker takes the job, loses its lock, and the job is then\n  // recovered by the stalled checker and claimed by the owner worker.\n  const loseAndRecover = async (opts = {}) => {\n    await queue.add('test', { foo: 'bar' }, opts);\n\n    const staleJob = (await staleWorker.getNextJob(staleToken)) as Job;\n    expect(staleJob).toBeDefined();\n\n    const client = await queue.client;\n    await client.del(lockKey(staleJob.id!));\n\n    // First pass marks the active job, second pass moves it back to wait.\n    await (ownerWorker as any).moveStalledJobsToWait();\n    await (ownerWorker as any).moveStalledJobsToWait();\n\n    const ownerJob = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    expect(ownerJob).toBeDefined();\n    expect(ownerJob.id).toBe(staleJob.id);\n    expect(await client.get(lockKey(ownerJob.id!))).toBe(ownerToken);\n\n    return { staleJob, ownerJob };\n  };\n\n  const snapshot = async (jobId: string) => {\n    const client = await queue.client;\n    const job = (await queue.getJob(jobId))!;\n    return {\n      state: await job.getState(),\n      json: job.asJSON(),\n      lock: await client.get(lockKey(jobId)),\n      events: await getEvents(),\n      counts: await queue.getJobCounts(),\n    };\n  };\n\n  const expectRejected = async (\n    jobId: string,\n    operation: () => Promise<unknown>,\n  ) => {\n    const before = await snapshot(jobId);\n    expect(before.state).toBe('active');\n\n    await expect(operation()).rejects.toMatchObject({ code: -6 });\n\n    expect(await snapshot(jobId)).toEqual(before);\n  };\n\n  it('should not let a stale worker complete a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover();\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToCompleted('stale', staleToken, false),\n    );\n\n    await ownerJob.moveToCompleted('owner', ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('completed');\n    expect(job.returnvalue).toBe('owner');\n  });\n\n  it('should not let a stale worker fail a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover();\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('failed');\n    expect(job.failedReason).toBe('owner');\n  });\n\n  it('should not let a stale worker immediately retry a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover({ attempts: 3 });\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('waiting');\n    expect(job.attemptsMade).toBe(1);\n  });\n\n  it('should not let a stale worker schedule a delayed retry of a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover({\n      attempts: 3,\n      backoff: { type: 'fixed', delay: 5000 },\n    });\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('delayed');\n    expect(job.attemptsMade).toBe(1);\n    expect(job.delay).toBe(5000);\n  });\n\n  it('should not let a stale worker move a recovered job to delayed or wait', async () => {\n    const { staleJob } = await loseAndRecover();\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToDelayed(Date.now() + 5000, staleToken),\n    );\n    await expectRejected(staleJob.id!, () => staleJob.moveToWait(staleToken));\n  });\n\n  it('should not let a stale worker renew the lock of a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover();\n    const client = await queue.client;\n    const stalledKey = `${prefix}:${queueName}:stalled`;\n    await client.sadd(stalledKey, staleJob.id!);\n\n    expect(await staleJob.extendLock(staleToken, 60000)).toBe(0);\n    expect(await client.get(lockKey(staleJob.id!))).toBe(ownerToken);\n    expect(await client.pttl(lockKey(staleJob.id!))).toBeLessThanOrEqual(30000);\n    expect(await client.sismember(stalledKey, staleJob.id!)).toBe(1);\n\n    expect(await ownerJob.extendLock(ownerToken, 60000)).toBe(1);\n    expect(await client.get(lockKey(ownerJob.id!))).toBe(ownerToken);\n    expect(await client.pttl(lockKey(ownerJob.id!))).toBeGreaterThan(30000);\n    expect(await client.sismember(stalledKey, staleJob.id!)).toBe(0);\n  });\n\n  it('should not let a stale worker renew recovered jobs in batch', async () => {\n    const { staleJob } = await loseAndRecover();\n    const client = await queue.client;\n    const stalledKey = `${prefix}:${queueName}:stalled`;\n\n    // A second job still legitimately owned by the stale worker.\n    await queue.add('test', { foo: 'baz' });\n    const ownedJob = (await staleWorker.getNextJob(staleToken)) as Job;\n    await client.sadd(stalledKey, staleJob.id!, ownedJob.id!);\n\n    const failed = await staleWorker.extendJobLocks(\n      [staleJob.id!, ownedJob.id!, 'missing'],\n      [staleToken, staleToken, staleToken],\n      60000,\n    );\n\n    expect(failed).toEqual([staleJob.id, 'missing']);\n    expect(await client.get(lockKey(staleJob.id!))).toBe(ownerToken);\n    expect(await client.pttl(lockKey(staleJob.id!))).toBeLessThanOrEqual(30000);\n    expect(await client.sismember(stalledKey, staleJob.id!)).toBe(1);\n    expect(await client.pttl(lockKey(ownedJob.id!))).toBeGreaterThan(30000);\n    expect(await client.sismember(stalledKey, ownedJob.id!)).toBe(0);\n\n    expect(\n      await ownerWorker.extendJobLocks([staleJob.id!], [ownerToken], 60000),\n    ).toEqual([]);\n    expect(await client.pttl(lockKey(staleJob.id!))).toBeGreaterThan(30000);\n  });\n\n  it('should still report a missing lock as an error', async () => {\n    await queue.add('test', { foo: 'bar' });\n    const job = (await staleWorker.getNextJob(staleToken)) as Job;\n    const client = await queue.client;\n    await client.del(lockKey(job.id!));\n\n    await expect(\n      job.moveToCompleted('done', staleToken, false),\n    ).rejects.toMatchObject({ code: -2 });\n    expect(await job.extendLock(staleToken, 60000)).toBe(0);\n    expect(await job.getState()).toBe('active');\n  });\n});\n"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NM2Bn3AB4HDYgKTwsg6iQ1","type":"tool_result","content":"File created successfully at: /private/tmp/handwork-claude-7lla1sj1/bullmq-3-claude/repo/tests/stale_lock_ownership.test.ts (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"43ca26b3-baa3-428a-8353-3ab78a1aaa81","uuid":"e8073098-d791-4fe5-80c6-04c958378db4","timestamp":"2026-10-04T15:07:45.842Z","tool_use_result":{"type":"create","filePath":"/private/tmp/handwork-claude-7lla1sj1/bullmq-3-claude/repo/tests/stale_lock_ownership.test.ts","content":"import {\n  describe,\n  beforeEach,\n  afterEach,\n  beforeAll,\n  afterAll,\n  it,\n  expect,\n} from 'vitest';\n\nimport { Job, Queue, Worker } from '../src/classes';\nimport { IRedisClient } from '../src/interfaces';\nimport { randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { cleanupQueue } from './utils/cleanup-queue';\n\ndescribe('stale lock ownership', () => {\n  const prefix = process.env.BULLMQ_TEST_PREFIX || 'bull';\n  const staleToken = 'stale-token';\n  const ownerToken = 'owner-token';\n\n  let queue: Queue;\n  let queueName: string;\n  let staleWorker: Worker;\n  let ownerWorker: Worker;\n  let connection: IRedisClient;\n\n  beforeAll(async () => {\n    connection = createTestConnection();\n  });\n\n  beforeEach(async () => {\n    queueName = `test-${randomUUID()}`;\n    queue = new Queue(queueName, { connection, prefix });\n    staleWorker = new Worker(queueName, null, {\n      connection,\n      prefix,\n      lockDuration: 30000,\n    });\n    ownerWorker = new Worker(queueName, null, {\n      connection,\n      prefix,\n      lockDuration: 30000,\n    });\n    await staleWorker.waitUntilReady();\n    await ownerWorker.waitUntilReady();\n  });\n\n  afterEach(async () => {\n    await staleWorker.close();\n    await ownerWorker.close();\n    await queue.close();\n    await cleanupQueue(queueName, prefix);\n  });\n\n  afterAll(async function () {\n    await connection.quit();\n  });\n\n  const lockKey = (jobId: string) => `${prefix}:${queueName}:${jobId}:lock`;\n\n  const getEvents = async () => {\n    const client = await queue.client;\n    return client.xrange(`${prefix}:${queueName}:events`, '-', '+');\n  };\n\n  // The stale worker takes the job, loses its lock, and the job is then\n  // recovered by the stalled checker and claimed by the owner worker.\n  const loseAndRecover = async (opts = {}) => {\n    await queue.add('test', { foo: 'bar' }, opts);\n\n    const staleJob = (await staleWorker.getNextJob(staleToken)) as Job;\n    expect(staleJob).toBeDefined();\n\n    const client = await queue.client;\n    await client.del(lockKey(staleJob.id!));\n\n    // First pass marks the active job, second pass moves it back to wait.\n    await (ownerWorker as any).moveStalledJobsToWait();\n    await (ownerWorker as any).moveStalledJobsToWait();\n\n    const ownerJob = (await ownerWorker.getNextJob(ownerToken)) as Job;\n    expect(ownerJob).toBeDefined();\n    expect(ownerJob.id).toBe(staleJob.id);\n    expect(await client.get(lockKey(ownerJob.id!))).toBe(ownerToken);\n\n    return { staleJob, ownerJob };\n  };\n\n  const snapshot = async (jobId: string) => {\n    const client = await queue.client;\n    const job = (await queue.getJob(jobId))!;\n    return {\n      state: await job.getState(),\n      json: job.asJSON(),\n      lock: await client.get(lockKey(jobId)),\n      events: await getEvents(),\n      counts: await queue.getJobCounts(),\n    };\n  };\n\n  const expectRejected = async (\n    jobId: string,\n    operation: () => Promise<unknown>,\n  ) => {\n    const before = await snapshot(jobId);\n    expect(before.state).toBe('active');\n\n    await expect(operation()).rejects.toMatchObject({ code: -6 });\n\n    expect(await snapshot(jobId)).toEqual(before);\n  };\n\n  it('should not let a stale worker complete a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover();\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToCompleted('stale', staleToken, false),\n    );\n\n    await ownerJob.moveToCompleted('owner', ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('completed');\n    expect(job.returnvalue).toBe('owner');\n  });\n\n  it('should not let a stale worker fail a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover();\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('failed');\n    expect(job.failedReason).toBe('owner');\n  });\n\n  it('should not let a stale worker immediately retry a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover({ attempts: 3 });\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('waiting');\n    expect(job.attemptsMade).toBe(1);\n  });\n\n  it('should not let a stale worker schedule a delayed retry of a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover({\n      attempts: 3,\n      backoff: { type: 'fixed', delay: 5000 },\n    });\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(await job.getState()).toBe('delayed');\n    expect(job.attemptsMade).toBe(1);\n    expect(job.delay).toBe(5000);\n  });\n\n  it('should not let a stale worker move a recovered job to delayed or wait', async () => {\n    const { staleJob } = await loseAndRecover();\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToDelayed(Date.now() + 5000, staleToken),\n    );\n    await expectRejected(staleJob.id!, () => staleJob.moveToWait(staleToken));\n  });\n\n  it('should not let a stale worker renew the lock of a recovered job', async () => {\n    const { staleJob, ownerJob } = await loseAndRecover();\n    const client = await queue.client;\n    const stalledKey = `${prefix}:${queueName}:stalled`;\n    await client.sadd(stalledKey, staleJob.id!);\n\n    expect(await staleJob.extendLock(staleToken, 60000)).toBe(0);\n    expect(await client.get(lockKey(staleJob.id!))).toBe(ownerToken);\n    expect(await client.pttl(lockKey(staleJob.id!))).toBeLessThanOrEqual(30000);\n    expect(await client.sismember(stalledKey, staleJob.id!)).toBe(1);\n\n    expect(await ownerJob.extendLock(ownerToken, 60000)).toBe(1);\n    expect(await client.get(lockKey(ownerJob.id!))).toBe(ownerToken);\n    expect(await client.pttl(lockKey(ownerJob.id!))).toBeGreaterThan(30000);\n    expect(await client.sismember(stalledKey, staleJob.id!)).toBe(0);\n  });\n\n  it('should not let a stale worker renew recovered jobs in batch', async () => {\n    const { staleJob } = await loseAndRecover();\n    const client = await queue.client;\n    const stalledKey = `${prefix}:${queueName}:stalled`;\n\n    // A second job still legitimately owned by the stale worker.\n    await queue.add('test', { foo: 'baz' });\n    const ownedJob = (await staleWorker.getNextJob(staleToken)) as Job;\n    await client.sadd(stalledKey, staleJob.id!, ownedJob.id!);\n\n    const failed = await staleWorker.extendJobLocks(\n      [staleJob.id!, ownedJob.id!, 'missing'],\n      [staleToken, staleToken, staleToken],\n      60000,\n    );\n\n    expect(failed).toEqual([staleJob.id, 'missing']);\n    expect(await client.get(lockKey(staleJob.id!))).toBe(ownerToken);\n    expect(await client.pttl(lockKey(staleJob.id!))).toBeLessThanOrEqual(30000);\n    expect(await client.sismember(stalledKey, staleJob.id!)).toBe(1);\n    expect(await client.pttl(lockKey(ownedJob.id!))).toBeGreaterThan(30000);\n    expect(await client.sismember(stalledKey, ownedJob.id!)).toBe(0);\n\n    expect(\n      await ownerWorker.extendJobLocks([staleJob.id!], [ownerToken], 60000),\n    ).toEqual([]);\n    expect(await client.pttl(lockKey(staleJob.id!))).toBeGreaterThan(30000);\n  });\n\n  it('should still report a missing lock as an error', async () => {\n    await queue.add('test', { foo: 'bar' });\n    const job = (await staleWorker.getNextJob(staleToken)) as Job;\n    const client = await queue.client;\n    await client.del(lockKey(job.id!));\n\n    await expect(\n      job.moveToCompleted('done', staleToken, false),\n    ).rejects.toMatchObject({ code: -2 });\n    expect(await job.extendLock(staleToken, 60000)).toBe(0);\n    expect(await job.getState()).toBe('active');\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
