 /**\n   * Public accessor method for LockManager to extend locks.\n   * This delegates to the protected scripts object.\n   */\n  async extendJobLocks(","truncated":true,"loaded":[],"display":{"type":"file","path":"/private/tmp/handwork-bullmq-G7VJT5/3-opencode/repo/src/classes/worker.ts","text":"  /**\n   * Creates and configures the sandbox for processing jobs.\n   * This method can be overridden in subclasses to customize sandbox behavior.\n   *\n   * @param processor - The processor file path, URL, or function to be sandboxed\n   */\n  protected createSandbox(\n    processor: string | URL | null | Processor<DataType, ResultType, NameType>,\n  ) {\n    this.processFn = sandbox<DataType, ResultType, NameType>(\n      processor,\n      this.childPool,\n    ).bind(this);\n  }\n\n  /**\n   * Public accessor method for LockManager to extend locks.\n   * This delegates to the protected scripts object.\n   */\n  async extendJobLocks(\n    jobIds: string[],\n    tokens: string[],\n    duration: number,\n  ): Promise<string[]> {\n    return this.backend.extendLocks(jobIds, tokens, duration);\n  }\n\n  emit<","lineStart":395,"lineEnd":422,"totalLines":1484,"truncated":true}},"title":"src/classes/worker.ts","time":{"start":1789791056266,"end":1789791056270}},"metadata":{"openai":{"itemId":"fc_0368d318509e3784016aae0b4edcf487d18d3f381de8666aa8"}},"id":"prt_0b7dc2c55001L15MBWGIqnqyY8","sessionID":"ses_f4824f550ffeaBmxcEcK2h5aW9","messageID":"msg_0b7dc259a001G34ezn4K6OYVRX"}}
