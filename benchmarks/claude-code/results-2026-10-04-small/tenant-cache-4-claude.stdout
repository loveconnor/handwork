db,req.token).id,p.organizationId)));\n    10\t}\n=== src/routes/projects.ts\n     1\timport type { Router } from '../http/router.ts';\n     2\timport type { Database } from '../db/database.ts';\n     3\timport type { Cache } from '../cache/project-cache.ts';\n     4\timport { requireSession } from '../auth/session.ts';\n     5\timport { projectService } from '../services/project-service.ts';\n     6\timport { listOptions } from '../http/list-options.ts';\n     7\timport { ok } from '../http/response.ts';\n     8\texport function registerProjects(router:Router,db:Database,cache:Cache) {\n     9\t  const service=projectService(db,cache);\n    10\t  router.add('GET','/projects/:projectId',(req,p)=>ok(service.detail(requireSession(db,req.token).id,p.projectId)));\n    11\t  router.add('PATCH','/projects/:projectId',(req,p)=>ok(service.update(requireSession(db,req.token).id,p.projectId,req.body)));\n    12\t  router.add('GET','/organizations/:organizationId/projects',(req,p)=>ok(service.list(requireSession(db,req.token).id,p.organizationId,listOptions(req.query))));\n    13\t}\n=== src/services/organization-service.ts\n     1\timport type { Database } from '../db/database.ts';\n     2\timport { membershipRepository } from '../db/membership-repository.ts';\n     3\timport { requireMembership } from '../auth/membership.ts';\n     4\timport { HttpError } from '../http/response.ts';\n     5\texport function organizationService(db:Database){return {\n     6\t  list(userId:string){return {items:membershipRepository(db).organizationsFor(userId)};},\n     7\t  detail(userId:string,id:string){requireMembership(db,userId,id);const org=db.organizations.get(id);if(!org)throw new HttpError(404,'not_found');return {...org};},\n     8\t};}\n=== src/services/project-service.ts\n     1\timport type { Database } from '../db/database.ts';\n     2\timport type { Cache } from '../cache/project-cache.ts';\n     3\timport type { ListOptions } from '../types.ts';\n     4\timport { projectRepository } from '../db/project-repository.ts';\n     5\timport { requireMembership } from '../auth/membership.ts';\n     6\timport { projectListKey, projectDetailKey } from '../cache/keys.ts';\n     7\timport { HttpError } from '../http/response.ts';\n     8\texport function projectService(db:Database,cache:Cache) {\n     9\t  const projects=projectRepository(db);\n    10\t  function detail(userId:string,projectId:string) {\n    11\t    const project=projects.find(projectId);\n    12\t    if(!project)throw new HttpError(404,'not_found');\n    13\t    return project;\n    14\t  }\n    15\t  return {\n    16\t    detail,\n    17\t    list(userId:string,organizationId:string,options:ListOptions) {\n    18\t      requireMembership(db,userId,organizationId);\n    19\t      const key=projectListKey(organizationId,options);\n    20\t      const cached=cache.get(key);\n    21\t      if(cached!==undefined)return cached;\n    22\t      const result=projects.list(organizationId,options);cache.set(key,result);return result;\n    23\t    },\n    24\t    update(userId:string,projectId:string,body:unknown) {\n    25\t      detail(userId,projectId);\n    26\t      if(!body||typeof body!=='object'||typeof (body as any).name!=='string'||!(body as any).name.trim())throw new HttpError(400,'invalid_body');\n    27\t      const updated=projects.update(projectId,(body as any).name.trim())!;\n    28\t      cache.delete(projectDetailKey(projectId));\n    29\t      return updated;\n    30\t    },\n    31\t  };\n    32\t}\n=== src/types.ts\n     1\texport type Project = { id: string; organizationId: string; name: string; updatedAt: number };\n     2\texport type Organization = { id: string; name: string };\n     3\texport type User = { id: string; name: string };\n     4\texport type ListOptions = { page: number; pageSize: number; sort: 'name' | 'updatedAt'; direction: 'asc' | 'desc' };\n     5\texport type Request = { method: string; path: string; token?: string; query?: Record<string,string>; 