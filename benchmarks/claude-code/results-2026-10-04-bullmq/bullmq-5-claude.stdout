eToDelayed(this.id, now, finalDelay, token, {\n      skipAttempt: true,\n    });\n    this.delay = finalDelay;\n\n    this.recordJobMetrics('delayed');\n  }\n\n  /**\n   * Moves the job to the waiting-children set.\n   *\n   * @param token - Token to check job is locked by current worker\n   * @param opts - The options bag for moving a job to waiting-children.\n   * @returns true if the job was moved\n   */\n  async moveToWaitingChildren(\n    token: string,\n    opts: MoveToWaitingChildrenOpts = {},\n  ): Promise<boolean> {\n    const movedToWaitingChildren = await this.backend.moveToWaitingChildren(\n      this.id,\n      token,\n      opts,\n    );\n\n    if (movedToWaitingChildren) {\n      this.recordJobMetrics('waiting-children');\n    }\n\n    return movedToWaitingChildren;\n  }\n63:import { finishedErrors } from './finished-errors';\n64-import { UnrecoverableError } from './errors';\n65-import { KeysMap, QueueKeys } from './queue-keys';\n66-import { RedisConnection } from './redis-connection';\n67-export type JobData = [JobJson | number, string?];\n68-\n69-/**\n--\n684:      throw this.finishedErrors({\n685-        code: <number>result,\n686-        parentKey: parentKeyOpts.parentKey,\n687-        command: 'addJob',\n688-      });\n689-    }\n690-\n--\n862:   * @throws An error resolved from `finishedErrors` when the Lua script returns a negative status code.\n863-   *\n864-   * @private\n865-   */\n866-  async addJobScheduler(\n867-    jobSchedulerId: string,\n868-    nextMillis: number,\n--\n912:      throw this.finishedErrors({\n913-        code: result,\n914-        command: 'addJobScheduler',\n915-      });\n916-    }\n917-\n918-    return result;\n--\n993:      throw this.finishedErrors({\n994-        code: result,\n995-        jobId,\n996-        command: 'removeJob',\n997-      });\n998-    }\n999-\n--\n1067:      throw this.finishedErrors({\n1068-        code: result,\n1069-        jobId: job.id,\n1070-        command: 'updateData',\n1071-      });\n1072-    }\n1073-  }\n--\n1092:      throw this.finishedErrors({\n1093-        code: result,\n1094-        jobId,\n1095-        command: 'updateProgress',\n1096-      });\n1097-    }\n1098-  }\n--\n1119:      throw this.finishedErrors({\n1120-        code: result,\n1121-        jobId,\n1122-        command: 'addLog',\n1123-      });\n1124-    }\n1125-\n--\n1207:      throw this.finishedErrors({\n1208-        code: result,\n1209-        jobId,\n1210-        command: 'moveToFinished',\n1211-        state: 'active',\n1212-      });\n1213-    } else {\n--\n1275:        throw this.finishedErrors({\n1276-          code: result,\n1277-          jobId,\n1278-          parentKey,\n1279-          command: 'removeChildDependency',\n1280-        });\n1281-    }\n--\n1529:      throw this.finishedErrors({\n1530-        code: result,\n1531-        jobId,\n1532-        command: 'changeDelay',\n1533-        state: 'delayed',\n1534-      });\n1535-    }\n--\n1567:      throw this.finishedErrors({\n1568-        code: result,","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
