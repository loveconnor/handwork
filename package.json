{
  "name": "handwork",
  "version": "0.1.0",
  "description": "Fast, native coding agent for the terminal",
  "homepage": "https://connorlove.com",
  "author": {
    "name": "Connor Love",
    "url": "https://connorlove.com"
  },
  "bin": {
    "handwork": "bin/handwork.cjs"
  },
  "files": [
    "bin/handwork.cjs",
    "prebuilds",
    "zig-out/bin/handwork",
    "zig-out/bin/handwork.exe",
