 true]) { for (const oldFirst of [false, true]) { const pending = []; const c = createSearchController({ search: () => new Promise((resolve, reject) => pending.push({ resolve, reject })) }); const old = c.search(\"old\"); const current = c.search(clear ? \"  \" : \"new\"); const settleOld = async () => { const before = c.getState(); if (reject) pending[0].reject(new Error(\"stale\")); else pending[0].resolve([{ id: \"old\", title: \"Old\", url: \"/old\" }]); await old; assert.deepEqual(c.getState(), before); }; const settleCurrent = async () => { if (!clear) pending[1].resolve([{ id: \"new\", title: \"New\", url: \"/new\" }]); await current; }; if (clear) assert.deepEqual(c.getState(), { query: \"\", results: [], loading: false, error: null }); if (oldFirst) { await settleOld(); await settleCurrent(); } else { await settleCurrent(); await settleOld(); } assert.equal(c.getState().loading, false); assert.equal(c.getState().error, null); assert.equal(c.getState().results.length, clear ? 0 : 1); } } } console.log(\"Passed 8 stale-request scenarios (success/failure, completion order, query clearing).\");'","time":{"start":1789170566678,"end":1789170566681}},"metadata":{"openai":{"itemId":"fc_0103682b6092b1cb016aa4937bd55487d19da40688f76750c0"}},"id":"prt_092e01c35001CwixLVAouwc3Eo","sessionID":"ses_f6d20faf0ffeMlzoL19Zt487uW","messageID":"msg_092e012bd001k5B5bIDQrHadOm"}}
