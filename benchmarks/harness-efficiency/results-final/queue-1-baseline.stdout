tdout_file":null,"stderr_file":null}},{"name":"read_file","status":"success"},{"name":"edit_file","status":"success"},{"name":"edit_file","status":"success"},{"name":"shell","status":"success","command_result":{"kind":"command","command":"npm test && node --input-type=module <<'NODE'\nimport assert from 'node:assert/strict';\nimport {mapLimit} from './src/map.js';\nlet active = 0, peak = 0;\nconst seen = [];\nconst syncError = new Error('sync'), asyncError = new Error('async');\nconst results = await mapLimit([0,1,2,3,4], 2, (item, index) => {\n  assert.equal(item, index);\n  seen.push(index);\n  if (index === 1) throw syncError;\n  active++;\n  peak = Math.max(peak, active);\n  return new Promise((resolve, reject) => setTimeout(() => {\n    active--;\n    if (index === 2) reject(asyncError);\n    else resolve(item * 2);\n  }, index === 0 ? 30 : 1));\n});\nassert.deepEqual(results, [\n  {status:'fulfilled',value:0}, {status:'rejected',reason:syncError},\n  {status:'rejected',reason:asyncError}, {status:'fulfilled',value:6},\n  {status:'fulfilled',value:8}\n]);\nassert.equal(peak, 2);\nassert.deepEqual(seen, [0,1,2,3,4]);\nfor (const limit of [0,-1,1.5,NaN,Infinity,'2',null,undefined]) {\n  await assert.rejects(mapLimit([1], limit, () => assert.fail('work started')), RangeError);\n  await assert.rejects(mapLimit([], limit, () => assert.fail('work started')), RangeError);\n}\nconsole.log('Contract probe passed');\nNODE\n git diff --check; git diff --stat; git diff; git status --short","cwd":"/private/tmp/handwork-efficiency-apul1kbx/queue-1-baseline/repo","exit_code":0,"signal":null,"timed_out":false,"duration_ms":358,"stdout_bytes":1568,"stderr_bytes":0,"truncated":false,"output_file":"handwork-command-replay-0e14012a2cc0883a580a617d74b6a400.bin","stdout_file":null,"stderr_file":null}}],"usage":{"input_tokens":58442,"output_tokens":1070},"usage_details":{"cached_input_tokens":25472,"cache_write_tokens":0,"reasoning_tokens":6}}
