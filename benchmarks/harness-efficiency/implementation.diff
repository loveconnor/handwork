+    defer arena.deinit();
+    var messages: std.ArrayList(ChatMessage) = .empty;
+    try appendTransient(.{ .workspace_root = root, .host_workspace = .{ .root = root, .cwd = root, .home = root }, .interactive = false, .permission_mode = .yolo }, arena.allocator(), &messages);
+    for (messages.items) |m| try std.testing.expect(std.mem.find(u8, m.content orelse "", "<workspace-path-snapshot>") == null);
+}
