uarantees that the worker owns the job during the lock\nsrc/commands/moveToActive-11.lua:6:  expiration time. The worker is responsible of keeping the lock fresh\nsrc/commands/moveToActive-11.lua:33:    opts - token - lock token\nsrc/commands/moveToActive-11.lua:34:    opts - lockDuration\nsrc/commands/obliterate-2.lua:31:    rcall(\"DEL\", baseKey .. key .. ':lock')\nsrc/commands/retryJob-11.lua:30:     -2 - Missing lock\nsrc/commands/moveJobFromActiveToWait-9.lua:16:    ARGV[2] lock token\nsrc/commands/moveToFinished-14.lua:4:  The job must be locked before it can be moved to a finished status,\nsrc/commands/moveToFinished-14.lua:5:  and the lock must be released in this script.\nsrc/commands/moveToFinished-14.lua:37:      opts - token - lock token\nsrc/commands/moveToFinished-14.lua:39:      opts - lockDuration - lock duration in milliseconds\nsrc/commands/moveToFinished-14.lua:51:      -2 Missing lock.\n    Events:\n      'stalled' with stalled job id.\n]]\nlocal rcall = redis.call\n\n-- Includes\n--- @include \"includes/batches\"\n--- @include \"includes/moveJobToWait\"\n--- @include \"includes/trimEvents\"\n\nlocal stalledKey = KEYS[1]\nlocal waitKey = KEYS[2]\nlocal activeKey = KEYS[3]\nlocal stalledCheckKey = KEYS[4]\nlocal metaKey = KEYS[5]\nlocal pausedKey = KEYS[6]\nlocal markerKey = KEYS[7]\nlocal eventStreamKey = KEYS[8]\nlocal repeatKey = KEYS[9]\nlocal maxStalledJobCount = tonumber(ARGV[1])\nlocal queueKeyPrefix = ARGV[2]\nlocal timestamp = ARGV[3]\nlocal maxCheckTime = ARGV[4]\n\nif rcall(\"EXISTS\", stalledCheckKey) == 1 then\n    return {}\nend\n\nrcall(\"SET\", stalledCheckKey, timestamp, \"PX\", maxCheckTime)\n\n-- Trim events before emitting them to avoid trimming events emitted in this script\ntrimEvents(metaKey, eventStreamKey)\n\n-- Move all stalled jobs to wait\nlocal stalling = rcall('SMEMBERS', stalledKey)\nlocal stalled = {}\nif (#stalling > 0) then\n    rcall('DEL', stalledKey)\n\n    -- Remove from active list\n    for i, jobId in ipairs(stalling) do\n        -- Markers in waitlist DEPRECATED in v5: Remove in v6.\n        if string.sub(jobId, 1, 2) == \"0:\" then\n            -- If the jobId is a delay marker ID we just remove it.\n            rcall(\"LREM\", activeKey, 1, jobId)\n        else\n            local jobKey = queueKeyPrefix .. jobId\n\n            -- Check that the lock is also missing, then we can handle this job as really stalled.\n            if (rcall(\"EXISTS\", jobKey .. \":lock\") == 0) then\n                --  Remove from the active queue.\n                local removed = rcall(\"LREM\", activeKey, 1, jobId)\n\n                if (removed > 0) then\n                    -- If this job has been stalled too many times, such as if it crashes the worker, then fail it.\n                    local stalledCount = rcall(\"HINCRBY\", jobKey, \"stc\", 1)\n                    \n                    -- Check if this is a repeatable job by looking at job options\n                    local jobSchedulerId = rcall(\"HGET\", jobKey, \"rjk\")\n                    local isRepeatableJob = false\n                    if jobSchedulerId then\n                        local schedulerKey = repeatKey .. \":\" .. jobSchedulerId\n\n                        if rcall(\"EXISTS\", schedulerKey) == 1 then\n                            isRepeatableJob = true\n                        else\n                            -- TODO: remove this check in v6, as it is only needed for legacy repeatable jobs\n                            -- that stored the scheduler id in the job key but did not create the scheduler hash key\n                            local prevMillis = rcall(\"ZSCORE\", repeatKey, jobSchedulerId)\n                            if prevMillis then\n                                isRepeatableJob = true\n                            end\n                        end\n                    end\n                    \n                    -- Only fail job if it exceeds stall limit AND is not a repeatable job\n                    if stalledCount > maxStalledJobCount and not isRepeatableJob then\n                        local failedReason = \"job stalled more than allowable limit\"\n                        rcall(\"HSET\", jobKey, \"defa\", failedReason)\n                    end\n                    \n                    moveJobToWait(metaKey, activeKey, waitKey, pausedKey, markerKey, eventStreamKey, jobId,\n                        \"RPUSH\")\n\n                    -- Emit the stalled event\n                    rcall(\"XADD\", eventStreamKey, \"*\", \"event\", \"stalled\", \"jobId\", jobId)\n                    table.insert(stalled, jobId)\n                end\n            end\n        end\n    end\nend\n\n-- Mark potentially stalled jobs\nlocal active = rcall('LRANGE', activeKey, 0, -1)\n\nif (#active > 0) then\n    for from, to in batches(#active, 7000) do\n        rcall('SADD', stalledKey, unpack(active, from, to))\n    end\nend\n-- Refresh an active job's lock; returns 1 on success, 0 if the lock was lost.\n-- Params: $1 queue, $2 id, $3 token, $4 lock_ms, $5 now_ms.\nSELECT extend_lock($1, $2, $3, $4, $5) AS n;\n188:-- token when a job is claimed. Otherwise identical to the v23 definition.\n191:  p_token            text,\n260:    -- worker's limiter check and its token consumption can never interleave with\n263:    -- counter < max, each claim a (distinct) job, and each consume a token —\n266:    -- effective check below then runs on a fresh snapshot that sees the token a\n287:  -- Consume a token now that a job is actually being claimed. Duration: the\n300:         lock_token = p_token,\n331:  p_token        text,\n364:  SELECT state, lock_token, parent_queue, parent_id, dedup_id\n373:  IF p_token <> '0' AND v_lock IS DISTINCT FROM p_token THEN\n399:         lock_token = NULL,\n476:  p_token         text,\n504:  SELECT state, lock_token, dedup_id INTO v_state, v_lock, v_dedup_id\n512:  IF p_token <> '0' AND v_lock IS DISTINCT FROM p_token THEN\n521:         lock_token = NULL,\n576:-- extend_lock: refresh an active job's lock if the token still holds it.\n582:  p_token    text,\n597:     AND lock_token = p_token;\n607:  p_token         text,\n621:  SELECT state, lock_token INTO v_state, v_lock\n629:  IF p_token <> '0' AND v_lock IS DISTINCT FROM p_token THEN\n639:         lock_token = NULL,\n661:  p_token         text,\n674:  SELECT state, lock_token INTO v_state, v_lock\n682:  IF p_token <> '0' AND v_lock IS DISTINCT FROM p_token THEN\n697:         lock_token = NULL,\n1059:      WHERE j.lock_token IS NOT NULL AND j.locked_until_ms > v_now\n1062:    SELECT lock_token IS NOT NULL AND locked_until_ms > v_now INTO v_locked\n1148:         lock_token = NULL,\n1619:  p_queue text, p_id text, p_token text, p_now bigint\n1631:  SELECT state, lock_token, priority INTO v_state, v_lock, v_priority\n1638:     AND (p_token = '0' OR v_lock IS NOT DISTINCT FROM p_token) THEN\n1648:           lock_token = NULL,\n1748:  p_queue text, p_id text, p_token text\n1758:  SELECT state, lock_token, pending_deps INTO v_state, v_lock, v_pending\n1774:  -- missing lock is -2, a mismatched one is -6; token '0' skips the check.\n1775:  IF p_token <> '0' THEN\n1779:    ELSIF v_lock <> p_token THEN\n1790:       SET state = 'waiting-children', lock_token = NULL, locked_until_ms = NULL\n2105:    lock_token = NULL,\n2323:           lock_token = NULL,\n2362:-- counter key with a PTTL: a token is consumed (INCR + PEXPIRE-on-first) each\n2451:-- Consume one token (INCR + PEXPIRE-on-first-of-window).\n3092:         AND j.lock_token IS NULL\n3100:         AND j.lock_token IS NULL\n3290:-- locked with the same worker token the finish used, exactly as the standalone\n3302:  p_token            text,\n3319:    p_queue, p_id, p_token, p_return_value,\n3323:    p_queue, p_token, p_lock_ms, p_now, p_name, p_limiter_max, p_limiter_duration);\n3333:  p_token            text,\n3351:    p_queue, p_id, p_token, p_failed_reason, p_stacktrace,\n3355:    p_queue, p_token, p_lock_ms, p_now, p_name