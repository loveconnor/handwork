{"type":"tool_use","timestamp":1789788902903,"sessionID":"ses_f48467e2bffejC2lfVdrXfzZn1","part":{"type":"tool","tool":"apply_patch","callID":"call_LR4TTAwou6IzTvqLZUXWn7c7","state":{"status":"completed","input":{"patchText":"*** Begin Patch\n*** Add File: /private/tmp/handwork-bullmq-G7VJT5/2-opencode/repo/tests/ownership.redis.test.ts\n+import { afterEach, beforeEach, describe, expect, it } from 'vitest';\n+import { Job, Queue, Worker } from '../src/classes';\n+import { randomUUID } from '../src/utils';\n+import { createTestConnection } from './utils/connection-factory';\n+import { getRedisClient } from './utils/get-redis-client';\n+\n+describe('recovered job ownership (redis-only)', () => {\n+  let connection: ReturnType<typeof createTestConnection>;\n+  let queue: Queue;\n+  let original: Worker;\n+  let replacement: Worker;\n+\n+  beforeEach(() => {\n+    connection = createTestConnection();\n+    const name = `ownership-${randomUUID()}`;\n+    const opts = { connection, prefix: process.env.BULLMQ_TEST_PREFIX || 'bull' };\n+    queue = new Queue(name, opts);\n+    original = new Worker(name, null, { ...opts, autorun: false });\n+    replacement = new Worker(name, null, { ...opts, autorun: false });\n+  });\n+\n+  afterEach(async () => {\n+    await original.close();\n+    await replacement.close();\n+    await queue.obliterate({ force: true });\n+    await queue.close();\n+    await connection.quit();\n+  });\n+\n+  it.each(['complete', 'fail', 'retry', 'delayed retry'])(\n+    'rejects stale %s without changing the recovered job or events',\n+    async operation => {\n+      await queue.add('job', {}, {\n+        attempts: operation.includes('retry') ? 3 : 1,\n+        backoff: operation === 'delayed retry' ? { type: 'fixed', delay: 1000 } : undefined,\n+      });\n+      const stale = (await original.getNextJob('original')) as Job;\n+      const client = await getRedisClient(queue);\n+      const jobKey = queue.toKey(stale.id!);\n+      const lockKey = `${jobKey}:lock`;\n+      // Simulate a crashed worker losing its lock, then use normal stalled recovery.\n+      await client.del(lockKey);\n+      await (replacement as any).moveStalledJobsToWait();\n+      await client.del(queue.toKey('stalled-check'));\n+      await (replacement as any).moveStalledJobsToWait();\n+      const current = (await replacement.getNextJob('replacement')) as Job;\n+      expect(current.id).toBe(stale.id);\n+\n+      // A due delayed job must not be promoted by an unauthorized immediate retry.\n+      const delayed = await queue.add('delayed', {}, { delay: 60000 });\n+      await client.zadd(queue.toKey('delayed'), 0, delayed.id!);\n+      const fields = await client.hgetall(jobKey);\n+      const events = await client.xrange(queue.toKey('events'), '-', '+');\n+      const action = operation === 'complete'\n+        ? stale.moveToCompleted('stale result', 'original', false)\n+        : stale.moveToFailed(new Error('stale failure'), 'original', false);\n+      await expect(action).rejects.toThrow('Lock mismatch');\n+      expect(await client.hgetall(jobKey)).toEqual(fields);\n+      expect(await client.get(lockKey)).toBe('replacement');\n+      expect(await current.getState()).toBe('active');\n+      expect(await delayed.getState()).toBe('delayed');\n+      expect(await client.xrange(queue.toKey('events'), '-', '+')).toEqual(events);\n+\n+      await client.sadd(queue.toKey('stalled'), current.id!);\n+      await client.pexpire(lockKey, 10000);\n+      expect(await stale.extendLock('original', 60000)).toBe(0);\n+      expect(await original.extendJobLocks([stale.id!], ['original'], 60000)).toEqual([stale.id]);\n+      expect(await client.get(lockKey)).toBe('replacement');\n+      expect(await client.pttl(lockKey)).toBeLessThanOrEqual(10000);\n+      expect(await client.sismember(queue.toKey('stalled'), current.id!)).toBe(1);\n+      expect(await current.extendLock('replacement', 60000)).toBe(1);\n+      expect(await replacement.extendJobLocks([current.id!], ['replacement'], 60000)).toEqual([]);\n+      expect(await client.sismember(queue.toKey('stalled'), current.id!)).toBe(0);\n+      await current.moveToCompleted('current result', 'replacement', false);\n+      expect(await current.getState()).toBe('completed');\n+      expect((await queue.getJob(current.id!))?.returnvalue).toBe('current result');\n+    },\n+  );\n+});\n*** End Patch"},"output":"Success. Updated the following files:\nA tests/ownership.redis.test.ts","metadata":{"diff":"Index: /private/tmp/handwork-bullmq-G7VJT5/2-opencode/repo/tests/ownership.redis.test.ts\n===================================================================\n--- /private/tmp/handwork-bullmq-G7VJT5/2-opencode/repo/tests/ownership.redis.test.ts\n+++ /private/tmp/handwork-bullmq-G7VJT5/2-opencode/repo/tests/ownership.redis.test.ts\n@@ -0,0 +1,79 @@\n+import { afterEach, beforeEach, describe, expect, it } from 'vitest';\n+import { Job, Queue, Worker } from '../src/classes';\n+import { randomUUID } from '../src/utils';\n+import { createTestConnection } from './utils/connection-factory';\n+import { getRedisClient } from './utils/get-redis-client';\n+\n+describe('recovered job ownership (redis-only)', () => {\n+  let connection: ReturnType<typeof createTestConnection>;\n+  let queue: Queue;\n+  let original: Worker;\n+  let replacement: Worker;\n+\n+  beforeEach(() => {\n+    connection = createTestConnection();\n+    const name = `ownership-${randomUUID()}`;\n+    const opts = { connection, prefix: process.env.BULLMQ_TEST_PREFIX || 'bull' };\n+    queue = new Queue(name, opts);\n+    original = new Worker(name, null, { ...opts, autorun: false });\n+    replacement = new Worker(name, null, { ...opts, autorun: false });\n+  });\n+\n+  afterEach(async () => {\n+    await original.close();\n+    await replacement.close();\n+    await queue.obliterate({ force: true });\n+    await queue.close();\n+    await connection.quit();\n+  });\n+\n+  it.each(['complete', 'fail', 'retry', 'delayed retry'])(\n+    'rejects stale %s without changing the recovered job or events',\n+    async operation => {\n+      await queue.add('job', {}, {\n+        attempts: operation.includes('retry') ? 3 : 1,\n+        backoff: operation === 'delayed retry' ? { type: 'fixed', delay: 1000 } : undefined,\n+      });\n+      const stale = (await original.getNextJob('original')) as Job;\n+      const client = await getRedisClient(queue);\n+      const jobKey = queue.toKey(stale.id!);\n+      const lockKey = `${jobKey}:lock`;\n+      // Simulate a crashed worker losing its lock, then use normal stalled recovery.\n+      await client.del(lockKey);\n+      await (replacement as any).moveStalledJobsToWait();\n+      await client.del(queue.toKey('stalled-check'));\n+      await (replacement as any).moveStalledJobsToWait();\n+      const current = (await replacement.getNextJob('replacement')) as Job;\n+      expect(current.id).toBe(stale.id);\n+\n+      // A due delayed job must not be promoted by an unauthorized immediate retry.\n+      const delayed = await queue.add('delayed', {}, { delay: 60000 });\n+      await client.zadd(queue.toKey('delayed'), 0, delayed.id!);\n+      const fields = await client.hgetall(jobKey);\n+      const events = await client.xrange(queue.toKey('events'), '-', '+');\n+      const action = operation === 'complete'\n+        ? stale.moveToCompleted('stale result', 'original', false)\n+        : stale.moveToFailed(new Error('stale failure'), 'original', false);\n+      await expect(action).rejects.toThrow('Lock mismatch');\n+      expect(await client.hgetall(jobKey)).toEqual(fields);\n+      expect(await client.get(lockKey)).toBe('replacement');\n+      expect(await current.getState()).toBe('active');\n+      expect(await delayed.getState()).toBe('delayed');\n+      expect(await client.xrange(queue.toKey('events'), '-', '+')).toEqual(events);\n+\n+      await client.sadd(queue.toKey('stalled'), current.id!);\n+      await client.pexpire(lockKey, 10000);\n+      expect(await stale.extendLock('original', 60000)).toBe(0);\n+      expect(await original.extendJobLocks([stale.id!], ['original'], 60000)).toEqual([stale.id]);\n+      expect(await client.get(lockKey)).toBe('replacement');\n+      expect(await client.pttl(lockKey)).toBeLessThanOrEqual(10000);\n+      expect(await client.sismember(queue.toKey('stalled'), current.id!)).toBe(1);\n+      expect(await current.extendLock('replacement', 60000)).toBe(1);\n+      expect(await replacement.extendJobLocks([current.id!], ['replacement'], 60000)).toEqual([]);\n+      expect(await client.sismember(queue.toKey('stalled'), current.id!)).toBe(0);\n+      await current.moveToCompleted('current result', 'replacement', false);\n+      expect(await current.getState()).toBe('completed');\n+      expect((await queue.getJob(current.id!))?.returnvalue).toBe('current result');\n+    },\n+  );\n+});\n\n","files":[{"filePath":"/private/tmp/handwork-bullmq-G7VJT5/2-opencode/repo/tests/ownership.redis.test.ts","relativePath":"tests/ownership.redis.test.ts","type":"add","patch":"Index: /private/tmp/handwork-bullmq-G7VJT5/2-opencode/repo/tests/ownership.redis.test.ts\n===================================================================\n--- /private/tmp/handwork-bullmq-G7VJT5/2-opencode/repo/tests/ownership.redis.test.ts\n+++ /private/tmp/handwork-bullmq-G7VJT5/2-opencode/repo/tests/ownership.redis.test.ts\n@@ -0,0 +1,79 @@\n+import { afterEach, beforeEach, describe, expect, it } from 'vitest';\n+import { Job, Queue, Worker } from '../src/classes';\n+import { randomUUID } from '../src/utils';\n+import { createTestConnection } from './utils/connection-factory';\n+import { getRedisClient } from './utils/get-redis-client';\n+\n+describe('recovered job ownership (redis-only)', () => {\n+  let connection: ReturnType<typeof createTestConnection>;\n+  let queue: Queue;\n+  let original: Worker;\n+  let replacement: Worker;\n+\n+  beforeEach(() => {\n+    connection = createTestConnection();\n+    const name = `ownership-${randomUUID()}`;\n+    const opts = { connection, prefix: process.env.BULLMQ_TEST_PREFIX || 'bull' };\n+    queue = new Queue(name, opts);\n+    original = new Worker(name, null, { ...opts, autorun: false });\n+    replacement = new Worker(name, null, { ...opts, autorun: false });\n+  });\n+\n+  afterEach(async () => {\n+    await original.close();\n+    await replacement.close();\n+    await queue.obliterate({ force: true });\n+    await queue.close();\n+    await connection.quit();\n+  });\n+\n+  it.each(['complete', 'fail', 'retry', 'delayed retry'])(\n+    'rejects stale %s without changing the recovered job or events',\n+    async operation => {\n+      await queue.add('job', {}, {\n+        attempts: operation.includes('retry') ? 3 : 1,\n+        backoff: operation === 'delayed retry' ? { type: 'fixed', delay: 1000 } : undefined,\n+      });\n+      const stale = (await original.getNextJob('original')) as Job;\n+      const client = await getRedisClient(queue);\n+      const jobKey = queue.toKey(stale.id!);\n+      const lockKey = `${jobKey}:lock`;\n+      // Simulate a crashed worker losing its lock, then use normal stalled recovery.\n+      await client.del(lockKey);\n+      await (replacement as any).moveStalledJobsToWait();\n+      await client.del(queue.toKey('stalled-check'));\n+      await (replacement as any).moveStalledJobsToWait();\n+      const current = (await replacement.getNextJob('replacement')) as Job;\n+      expect(current.id).toBe(stale.id);\n+\n+      // A due delayed job must not be promoted by an unauthorized immediate retry.\n+      const delayed = await queue.add('delayed', {}, { delay: 60000 });\n+      await client.zadd(queue.toKey('delayed'), 0, delayed.id!);\n+      const fields = await client.hgetall(jobKey);\n+      const events = await client.xrange(queue.toKey('events'), '-', '+');\n+      const action = operation === 'complete'\n+        ? stale.moveToCompleted('stale result', 'original', false)\n+        : stale.moveToFailed(new Error('stale failure'), 'original', false);\n+      await expect(action).rejects.toThrow('Lock mismatch');\n+      expect(await client.hgetall(jobKey)).toEqual(fields);\n+      expect(await client.get(lockKey)).toBe('replacement');\n+      expect(await current.getState()).toBe('active');\n+      expect(await delayed.getState()).toBe('delayed');\n+      expect(await client.xrange(queue.toKey('events'), '-', '+')).toEqual(events);\n+\n+      await client.sadd(queue.toKey('stalled'), current.id!);\n+      await client.pexpire(lockKey, 10000);\n+      expect(await stale.extendLock('original', 60000)).toBe(0);\n+      expect(await original.extendJobLocks([stale.id!], ['original'], 60000)).toEqual([stale.id]);\n+      expect(await client.get(lockKey)).toBe('replacement');\n+      expect(await client.pttl(lockKey)).toBeLessThanOrEqual(10000);\n+      expect(await client.sismember(queue.toKey('stalled'), current.id!)).toBe(1);\n+      expect(await current.extendLock('replacement', 60000)).toBe(1);\n+      expect(await replacement.extendJobLocks([current.id!], ['replacement'], 60000)).toEqual([]);\n+      expect(await client.sismember(queue.toKey('stalled'), current.id!)).toBe(0);\n+      await current.moveToCompleted('current result', 'replacement', false);\n+      expect(await current.getState()).toBe('completed');\n+      expect((await queue.getJob(current.id!))?.returnvalue).toBe('current result');\n+    },\n+  );\n+});\n","additions":79,"deletions":0}],"diagnostics":{},"truncated":false},"title":"Success. Updated the following files:\nA tests/ownership.redis.test.ts","time":{"start":1789788902898,"end":1789788902902}},"metadata":{"openai":{"itemId":"fc_0e0d20defa0c321b016aae02c3869887d1962e54db2ef4c211"}},"id":"prt_0b7bacc64001hgewv571ZaTYU0","sessionID":"ses_f48467e2bffejC2lfVdrXfzZn1","messageID":"msg_0b7bac2a1001fdQqkWv81v0Enh"}}
