{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"rg -n 'extendLocks|extendLock|moveStalledJobsToWait' src/backends -g '*.ts' | head -35; sed -n '1,100p' src/commands/moveStalledJobsToWait-*.lua; sed -n '390,425p' src/classes/worker.ts; rg -n 'backend' src/classes/queue-base.ts | head; cat src/commands/includes/isLocked.lua\"","aggregated_output":"rg: src/backends: IO error for operation on src/backends: No such file or directory (os error 2)\n--[[\n  Move stalled jobs to wait.\n\n    Input:\n      KEYS[1] 'stalled' (SET)\n      KEYS[2] 'wait',   (LIST)\n      KEYS[3] 'active', (LIST)\n      KEYS[4] 'stalled-check', (KEY)\n      KEYS[5] 'meta', (KEY)\n      KEYS[6] 'paused', (LIST)\n      KEYS[7] 'marker'\n      KEYS[8] 'event stream' (STREAM)\n      KEYS[9] 'repeat' key\n\n      ARGV[1]  Max stalled job count\n      ARGV[2]  queue.toKey('')\n      ARGV[3]  timestamp\n      ARGV[4]  max check time\n\n    Events:\n      'stalled' with stalled job id.\n]]\nlocal rcall = redis.call\n\n-- Includes\n--- @include \"includes/batches\"\n--- @include \"includes/moveJobToWait\"\n--- @include \"includes/trimEvents\"\n\nlocal stalledKey = KEYS[1]\nlocal waitKey = KEYS[2]\nlocal activeKey = KEYS[3]\nlocal stalledCheckKey = KEYS[4]\nlocal metaKey = KEYS[5]\nlocal pausedKey = KEYS[6]\nlocal markerKey = KEYS[7]\nlocal eventStreamKey = KEYS[8]\nlocal repeatKey = KEYS[9]\nlocal maxStalledJobCount = tonumber(ARGV[1])\nlocal queueKeyPrefix = ARGV[2]\nlocal timestamp = ARGV[3]\nlocal maxCheckTime = ARGV[4]\n\nif rcall(\"EXISTS\", stalledCheckKey) == 1 then\n    return {}\nend\n\nrcall(\"SET\", stalledCheckKey, timestamp, \"PX\", maxCheckTime)\n\n-- Trim events before emitting them to avoid trimming events emitted in this script\ntrimEvents(metaKey, eventStreamKey)\n\n-- Move all stalled jobs to wait\nlocal stalling = rcall('SMEMBERS', stalledKey)\nlocal stalled = {}\nif (#stalling > 0) then\n    rcall('DEL', stalledKey)\n\n    -- Remove from active list\n    for i, jobId in ipairs(stalling) do\n        -- Markers in waitlist DEPRECATED in v5: Remove in v6.\n        if string.sub(jobId, 1, 2) == \"0:\" then\n            -- If the jobId is a delay marker ID we just remove it.\n            rcall(\"LREM\", activeKey, 1, jobId)\n        else\n            local jobKey = queueKeyPrefix .. jobId\n\n            -- Check that the lock is also missing, then we can handle this job as really stalled.\n            if (rcall(\"EXISTS\", jobKey .. \":lock\") == 0) then\n                --  Remove from the active queue.\n                local removed = rcall(\"LREM\", activeKey, 1, jobId)\n\n                if (removed > 0) then\n                    -- If this job has been stalled too many times, such as if it crashes the worker, then fail it.\n                    local stalledCount = rcall(\"HINCRBY\", jobKey, \"stc\", 1)\n                    \n                    -- Check if this is a repeatable job by looking at job options\n                    local jobSchedulerId = rcall(\"HGET\", jobKey, \"rjk\")\n                    local isRepeatableJob = false\n                    if jobSchedulerId then\n                        local schedulerKey = repeatKey .. \":\" .. jobSchedulerId\n\n                        if rcall(\"EXISTS\", schedulerKey) == 1 then\n                            isRepeatableJob = true\n                        else\n                            -- TODO: remove this check in v6, as it is only needed for legacy repeatable jobs\n                            -- that stored the scheduler id in the job key but did not create the scheduler hash key\n                            local prevMillis = rcall(\"ZSCORE\", repeatKey, jobSchedulerId)\n                            if prevMillis then\n                                isRepeatableJob = true\n                            end\n                        end\n                    end\n                    \n                    -- Only fail job if it exceeds stall limit AND is not a repeatable job\n                    if stalledCount > maxStalledJobCount and not isRepeatableJob then\n                        local failedReason = \"job stalled more than allowable limit\"\n                        rcall(\"HSET\", jobKey, \"defa\", failedReason)\n                    end\n                    \n      workerId: this.id,\n      workerName: this.opts.name,\n    });\n  }\n\n  /**\n   * Creates and configures the sandbox for processing jobs.\n   * This method can be overridden in subclasses to customize sandbox behavior.\n   *\n   * @param processor - The processor file path, URL, or function to be sandboxed\n   */\n  protected createSandbox(\n    processor: string | URL | null | Processor<DataType, ResultType, NameType>,\n  ) {\n    this.processFn = sandbox<DataType, ResultType, NameType>(\n      processor,\n      this.childPool,\n    ).bind(this);\n  }\n\n  /**\n   * Public accessor method for LockManager to extend locks.\n   * This delegates to the protected scripts object.\n   */\n  async extendJobLocks(\n    jobIds: string[],\n    tokens: string[],\n    duration: number,\n  ): Promise<string[]> {\n    return this.backend.extendLocks(jobIds, tokens, duration);\n  }\n\n  emit<\n    U extends keyof WorkerListener<\n      DataType,\n      ResultType,\n11:import { getDefaultBackendFactory } from '../utils/create-backend';\n31:  backend: B;\n32:  protected readonly backendFactory: BackendFactory<B>;\n39:   * @param backendFactory - Factory used to build the {@link IQueueBackend}.\n40:   * Defaults to the Redis backend; inject a different factory to use another\n46:    backendFactory: BackendFactory<B> = getDefaultBackendFactory<B>(),\n51:    this.backendFactory = backendFactory;\n66:    // Queue identity and key building are owned by the backend (a datastore\n67:    // concern). The Redis backend encodes the key `prefix`\n68:    // (`\"<prefix>:<queue>\"`); other backends format their own identity.\n--[[\n  Function to recursively check if there are no locks\n  on the jobs to be removed.\n\n  returns:\n    boolean\n]]\n--- @include \"destructureJobKey\"\n\nlocal function isLocked( prefix, jobId, removeChildren)\n  local jobKey = prefix .. jobId;\n\n  -- Check if this job is locked\n  local lockKey = jobKey .. ':lock'\n  local lock = rcall(\"GET\", lockKey)\n  if not lock then\n    if removeChildren == \"1\" then\n      local dependencies = rcall(\"SMEMBERS\", jobKey .. \":dependencies\")\n      if (#dependencies > 0) then\n        for i, childJobKey in ipairs(dependencies) do\n          -- We need to get the jobId for this job.\n          local childJobId = getJobIdFromKey(childJobKey)\n          local childJobPrefix = getJobKeyPrefix(childJobKey, childJobId)\n          local result = isLocked( childJobPrefix, childJobId, removeChildren )\n          if result then\n            return true\n          end\n        end\n      end\n    end\n    return false\n  end\n  return true\nend\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/worker_ownership.redis.test.ts <<'EOF'\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest';\nimport { Job, Queue, Worker } from '../src/classes';\nimport { IRedisClient } from '../src/interfaces';\nimport { randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\n\ndescribe('worker ownership after recovery', () => {\n  let connection: IRedisClient;\n  let queue: Queue;\n  let original: Worker;\n  let replacement: Worker;\n\n  beforeEach(() => {\n    connection = createTestConnection();\n    const name = \"'`ownership-${randomUUID()}`;\n    queue = new Queue(name, { connection });\n    original = new Worker(name, undefined, { connection });\n    replacement = new Worker(name, undefined, { connection });\n  });\n\n  afterEach(async () => {\n    await original.close();\n    await replacement.close();\n    await queue.obliterate({ force: true });\n    await queue.close();\n    await connection.quit();\n  });\n\n  async function recover(opts = {}) {\n    await queue.add('\"'job', {}, opts);\n    const stale = (await original.getNextJob('old-token')) as Job;\n    await connection.del(queue.toKey(\"'`${stale.id}:lock`));\n    await connection.sadd(queue.keys.stalled, stale.id!);\n    await replacement.backend.moveStalledJobsToWait();\n    const owner = (await replacement.getNextJob('\"'new-token')) as Job;\n    expect(owner.id).toBe(stale.id);\n    return { stale, owner };\n  }\n\n  async function snapshot(id: string) {\n    return {\n      job: await connection.hgetall(queue.toKey(id)),\n      active: await connection.lrange(queue.keys.active, 0, -1),\n      wait: await connection.lrange(queue.keys.wait, 0, -1),\n      delayed: await connection.zrange(queue.keys.delayed, 0, -1),\n      events: await connection.xrange(queue.keys.events, '-', '+'),\n      lock: await connection.get(queue.toKey(\"'`${id}:lock`)),\n      stalled: await connection.smembers(queue.keys.stalled),\n    };\n  }\n\n  it.each(['\"'complete', 'fail', 'retry', 'backoff'])(\n    'rejects stale %s without changing persisted state or events',\n    async operation => {\n      const { stale, owner } = await recover({\n        attempts: operation === 'retry' || operation === 'backoff' ? 3 : 1,\n        backoff: operation === 'backoff' ? { type: 'fixed', delay: 1000 } : undefined,\n      });\n      // A due delayed job must not be promoted by a rejected immediate retry.\n      const delayed = await queue.add('delayed', {}, { delay: 60000 });\n      await connection.zadd(queue.keys.delayed, 0, delayed.id\"'!);\n      const before = await snapshot(owner.id!);\n      const action = operation === '\"'complete'\n        ? stale.moveToCompleted('stale result', 'old-token', false)\n        : stale.moveToFailed(new Error('stale failure'), 'old-token', false);\n      await expect(action).rejects.toThrow('Lock mismatch');\n      expect(await snapshot(owner.id\"'!)).toEqual(before);\n      expect(await owner.getState()).toBe('\"'active');\n      expect(await owner.extendLock('new-token', 30000)).toBe(1);\n      await owner.moveToCompleted('owner result', 'new-token', false);\n      const finished = await queue.getJob(owner.id\"'!);\n      expect(await finished!.getState()).toBe('\"'completed');\n      expect(finished\"'!.returnvalue).toBe('\"'owner result');\n      expect(finished\"'!.attemptsMade).toBe(1);\n    },\n  );\n\n  it('\"'rejects stale and missing renewals while renewing matching batch entries', async () => {\n    const { stale, owner } = await recover();\n    await queue.add('other', {});\n    const other = (await replacement.getNextJob('other-token')) as Job;\n    await connection.sadd(queue.keys.stalled, owner.id\"'!, other.id!);\n    const before = await snapshot(owner.id!);\n    expect(await stale.extendLock('\"'old-token', 60000)).toBe(0);\n    expect(await snapshot(owner.id\"'!)).toEqual(before);\n    expect(await replacement.extendJobLocks(\n      [owner.id!, other.id!, '\"'missing'],\n      ['old-token', 'other-token', 'missing-token'],\n      60000,\n    )).toEqual([owner.id\"'!, '\"'missing']);\n    expect(await connection.get(queue.toKey(\"'`${owner.id}:lock`))).toBe('\"'new-token');\n    expect(await connection.smembers(queue.keys.stalled)).toEqual([owner.id]);\n    expect(await connection.pttl(queue.toKey(\"'`${other.id}:lock`))).toBeGreaterThan(30000);\n    await connection.del(queue.toKey(`${owner.id}:lock`));\n    expect(await owner.extendLock('\"'new-token', 60000)).toBe(0);\n    await expect(owner.moveToCompleted('result', 'new-token', false)).rejects.toThrow('Missing lock');\n    await other.moveToCompleted('result', 'other-token', false);\n  });\n});\nEOF\nnode node_modules/vitest/vitest.mjs run --no-file-parallelism tests/worker_ownership.redis.test.ts > /tmp/bullmq-ownership.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
