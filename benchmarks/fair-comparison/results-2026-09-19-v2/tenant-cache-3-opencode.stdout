ojects`,token:'both',query:{page,pageSize,sort,direction}};\n+    const result=a.request(request);\n+    assert.deepEqual(result,expected.request(request));\n+    assert.equal(result.status,200);\n+    assert.ok((result.body as any).items.every((p:any)=>p.organizationId===organizationId));\n+    const lists=a.db.counters.projectLists;\n+    assert.deepEqual(a.request(request),result);\n+    assert.equal(a.db.counters.projectLists,lists);\n+  }\n+  assert.equal(a.db.counters.projectLists,32);\n+  assert.equal(a.cache.keys().length,32);\n+});\n+\n+test('updates invalidate every owning-organization variant and preserve other cached lists',()=>{\n+  const seed=sampleSeed();\n+  // A delimiter-bearing organization ID must not be mistaken for its prefix.\n+  seed.organizations.push({id:'org-a:child',name:'Child'});\n+  seed.memberships.push({userId:'both',organizationId:'org-a:child'});\n+  seed.projects.push({id:'child',organizationId:'org-a:child',name:'Child',updatedAt:1});\n+  const a=createApp(seed),requests=[];\n+  for(const organizationId of ['org-a','org-b','org-a:child'])for(const page of ['1','2'])for(const pageSize of ['1','2'])for(const sort of ['name','updatedAt'])for(const direction of ['asc','desc']) {\n+    const request={method:'GET',path:`/organizations/${organizationId}/projects`,token:'both',query:{page,pageSize,sort,direction}};\n+    requests.push({request,result:a.request(request),organizationId});\n+  }\n+  assert.equal(a.request({method:'PATCH',path:'/projects/a1',token:'both',body:{name:'Zulu'}}).status,200);\n+  assert.equal(a.cache.keys().length,32);\n+  const expected=createApp(seed);\n+  expected.request({method:'PATCH',path:'/projects/a1',token:'both',body:{name:'Zulu'}});\n+  for(const {request,result,organizationId} of requests) {\n+    const lists=a.db.counters.projectLists;\n+    assert.deepEqual(a.request(request),organizationId==='org-a'?expected.request(request):result);\n+    assert.equal(a.db.counters.projectLists,lists+(organizatio