+test "workspace snapshot admission respects permission mode and host workspace" {
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try writeTestFile(tmp.dir, "workspace/visible.ts", "");
+    const alloc = std.testing.allocator;
+    const root = try io_mod.dirRealpathAlloc(alloc, tmp.dir, "workspace");
+    defer alloc.free(root);
+    for ([_]types.PermissionMode{ .ask, .auto, .yolo }) |mode| {
+        var arena = std.heap.ArenaAllocator.init(alloc);
+        defer arena.deinit();
+        var messages: std.ArrayList(ChatMessage) = .empty;
+        try appendTransient(.{ .workspace_root = root, .interactive = false, .permission_mode = mode }, arena.allocator(), &messages);
