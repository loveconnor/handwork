{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/project-isolation.test.ts <<'EOF'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { createApp } from '../src/app.ts';\nimport { sampleSeed } from '../src/seed.ts';\nimport { createCache } from '../src/cache/project-cache.ts';\nimport { membershipRepository } from '../src/db/membership-repository.ts';\n\nconst forbidden={status:403,body:{error:'forbidden'}};\nconst variants=Array.from([1,2],page=>\n  [1,2].flatMap(pageSize=>['name','updatedAt'].flatMap(sort=>\n    ['asc','desc'].map(direction=>({page:String(page),pageSize:String(pageSize),sort,direction}))))).flat();\n\nfunction list(app:ReturnType<typeof createApp>,organizationId:string,query:Record<string,string>={},token='both') {\n  return app.request({method:'GET',path:\"'`/organizations/${organizationId}/projects`,token,query});\n}\n\ntest('\"'nonmembers cannot read or update projects, spoof ownership, or alter cached lists',()=>{\n  const cache=createCache(),app=createApp(sampleSeed(),cache);\n  list(app,'org-b');\n  const stored=structuredClone([...app.db.projects]);\n  const cached=cache.keys().map(key=>[key,cache.get(key)]);\n  const metrics={...cache.metrics};\n  assert.deepEqual(app.request({method:'GET',path:'/projects/b1',token:'alice',query:{organizationId:'org-a'}}),forbidden);\n  assert.deepEqual(app.request({method:'PATCH',path:'/projects/b1',token:'alice',body:{name:'Stolen',organizationId:'org-a'}}),forbidden);\n  assert.deepEqual(list(app,'org-b',{},'alice'),forbidden);\n  assert.deepEqual([...app.db.projects],stored);\n  assert.equal(app.db.counters.projectUpdates,0);\n  assert.deepEqual(cache.metrics,metrics);\n  assert.deepEqual(cache.keys().map(key=>[key,cache.get(key)]),cached);\n  for(const method of ['GET','PATCH'])assert.deepEqual(app.request({method,path:'/projects/missing',token:'alice',body:{name:'Name'}}),{status:404,body:{error:'not_found'}});\n});\n\ntest('organization switching and every pagination/sorting variant remain isolated and cached',()=>{\n  const app=createApp(sampleSeed());\n  for(const organizationId of ['org-a','org-b'])for(const query of variants){\n    const expected=list(createApp(sampleSeed()),organizationId,query);\n    assert.equal(expected.status,200);\n    assert.deepEqual(list(app,organizationId,query),expected);\n  }\n  assert.equal(app.db.counters.projectLists,variants.length*2);\n  for(const organizationId of ['org-b','org-a'])for(const query of variants){\n    assert.deepEqual(list(app,organizationId,query),list(createApp(sampleSeed()),organizationId,query));\n  }\n  assert.equal(app.db.counters.projectLists,variants.length*2);\n});\n\ntest('updates invalidate every owning organization variant and retain unrelated cache hits',()=>{\n  const seed=sampleSeed();\n  // These IDs catch both naive prefix grouping and delimiter collisions.\n  const ids=['org-a','org-a:child','org-a\\\"','org-a\\\\\\\\'];\n  for(const id of ids.slice(1)){\n    seed.organizations.push({id,name:id});\n    seed.memberships.push({userId:'both',organizationId:id});\n    seed.projects.push({id:\"'`project-${id}`,organizationId:id,name:'\"'Other',updatedAt:1});\n  }\n  const app=createApp(seed);\n  for(const id of ids)for(const query of variants)list(app,id,query);\n  const before=app.db.counters.projectLists;\n  assert.equal(app.request({method:'PATCH',path:'/projects/a1',token:'alice',body:{name:'Zulu',organizationId:'org-b'}}).status,200);\n  assert.equal(app.db.projects.get('a1')\"'!.organizationId,'\"'org-a');\n  for(const id of ids.slice(1))for(const query of variants)list(app,id,query);\n  assert.equal(app.db.counters.projectLists,before);\n  const fresh=createApp({...seed,projects:[...app.db.projects.values()]});\n  for(const query of variants)assert.deepEqual(list(app,'org-a',query),list(fresh,'org-a',query));\n  assert.equal(app.db.counters.projectLists,before+variants.length);\n  for(const query of variants)list(app,'org-a',query);\n  assert.equal(app.db.counters.projectLists,before+variants.length);\n});\n\ntest('membership revocation takes effect on cached lists, reads, and updates',()=>{\n  const cache=createCache(),app=createApp(sampleSeed(),cache);\n  list(app,'org-a',{},'alice');\n  membershipRepository(app.db).revoke('alice','org-a');\n  const metrics={...cache.metrics};\n  assert.deepEqual(list(app,'org-a',{},'alice'),forbidden);\n  assert.deepEqual(app.request({method:'GET',path:'/projects/a1',token:'alice'}),forbidden);\n  assert.deepEqual(app.request({method:'PATCH',path:'/projects/a1',token:'alice',body:{name:'Changed'}}),forbidden);\n  assert.equal(app.db.counters.projectUpdates,0);\n  assert.deepEqual(cache.metrics,metrics);\n  assert.equal(list(app,'org-a').status,200);\n  assert.equal(app.db.counters.projectLists,1);\n  assert.equal(cache.metrics.hits,metrics.hits+1);\n});\nEOF\nnpm test\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/project-isolation.test.ts <<'EOF'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { createApp } from '../src/app.ts';\nimport { sampleSeed } from '../src/seed.ts';\nimport { createCache } from '../src/cache/project-cache.ts';\nimport { membershipRepository } from '../src/db/membership-repository.ts';\n\nconst forbidden={status:403,body:{error:'forbidden'}};\nconst variants=Array.from([1,2],page=>\n  [1,2].flatMap(pageSize=>['name','updatedAt'].flatMap(sort=>\n    ['asc','desc'].map(direction=>({page:String(page),pageSize:String(pageSize),sort,direction}))))).flat();\n\nfunction list(app:ReturnType<typeof createApp>,organizationId:string,query:Record<string,string>={},token='both') {\n  return app.request({method:'GET',path:\"'`/organizations/${organizationId}/projects`,token,query});\n}\n\ntest('\"'nonmembers cannot read or update projects, spoof ownership, or alter cached lists',()=>{\n  const cache=createCache(),app=createApp(sampleSeed(),cache);\n  list(app,'org-b');\n  const stored=structuredClone([...app.db.projects]);\n  const cached=cache.keys().map(key=>[key,cache.get(key)]);\n  const metrics={...cache.metrics};\n  assert.deepEqual(app.request({method:'GET',path:'/projects/b1',token:'alice',query:{organizationId:'org-a'}}),forbidden);\n  assert.deepEqual(app.request({method:'PATCH',path:'/projects/b1',token:'alice',body:{name:'Stolen',organizationId:'org-a'}}),forbidden);\n  assert.deepEqual(list(app,'org-b',{},'alice'),forbidden);\n  assert.deepEqual([...app.db.projects],stored);\n  assert.equal(app.db.counters.projectUpdates,0);\n  assert.deepEqual(cache.metrics,metrics);\n  assert.deepEqual(cache.keys().map(key=>[key,cache.get(key)]),cached);\n  for(const method of ['GET','PATCH'])assert.deepEqual(app.request({method,path:'/projects/missing',token:'alice',body:{name:'Name'}}),{status:404,body:{error:'not_found'}});\n});\n\ntest('organization switching and every pagination/sorting variant remain isolated and cached',()=>{\n  const app=createApp(sampleSeed());\n  for(const organizationId of ['org-a','org-b'])for(const query of variants){\n    const expected=list(createApp(sampleSeed()),organizationId,query);\n    assert.equal(expected.status,200);\n    assert.deepEqual(list(app,organizationId,query),expected);\n  }\n  assert.equal(app.db.counters.projectLists,variants.length*2);\n  for(const organizationId of ['org-b','org-a'])for(const query of variants){\n    assert.deepEqual(list(app,organizationId,query),list(createApp(sampleSeed()),organizationId,query));\n  }\n  assert.equal(app.db.counters.projectLists,variants.length*2);\n});\n\ntest('updates invalidate every owning organization variant and retain unrelated cache hits',()=>{\n  const seed=sampleSeed();\n  // These IDs catch both naive prefix grouping and delimiter collisions.\n  const ids=['org-a','org-a:child','org-a\\\"','org-a\\\\\\\\'];\n  for(const id of ids.slice(1)){\n    seed.organizations.push({id,name:id});\n    seed.memberships.push({userId:'both',organizationId:id});\n    seed.projects.push({id:\"'`project-${id}`,organizationId:id,name:'\"'Other',updatedAt:1});\n  }\n  const app=createApp(seed);\n  for(const id of ids)for(const query of variants)list(app,id,query);\n  const before=app.db.counters.projectLists;\n  assert.equal(app.request({method:'PATCH',path:'/projects/a1',token:'alice',body:{name:'Zulu',organizationId:'org-b'}}).status,200);\n  assert.equal(app.db.projects.get('a1')\"'!.organizationId,'\"'org-a');\n  for(const id of ids.slice(1))for(const query of variants)list(app,id,query);\n  assert.equal(app.db.counters.projectLists,before);\n  const fresh=createApp({...seed,projects:[...app.db.projects.values()]});\n  for(const query of variants)assert.deepEqual(list(app,'org-a',query),list(fresh,'org-a',query));\n  assert.equal(app.db.counters.projectLists,before+variants.length);\n  for(const query of variants)list(app,'org-a',query);\n  assert.equal(app.db.counters.projectLists,before+variants.length);\n});\n\ntest('membership revocation takes effect on cached lists, reads, and updates',()=>{\n  const cache=createCache(),app=createApp(sampleSeed(),cache);\n  list(app,'org-a',{},'alice');\n  membershipRepository(app.db).revoke('alice','org-a');\n  const metrics={...cache.metrics};\n  assert.deepEqual(list(app,'org-a',{},'alice'),forbidden);\n  assert.deepEqual(app.request({method:'GET',path:'/projects/a1',token:'alice'}),forbidden);\n  assert.deepEqual(app.request({method:'PATCH',path:'/projects/a1',token:'alice',body:{name:'Changed'}}),forbidden);\n  assert.equal(app.db.counters.projectUpdates,0);\n  assert.deepEqual(cache.metrics,metrics);\n  assert.equal(list(app,'org-a').status,200);\n  assert.equal(app.db.counters.projectLists,1);\n  assert.equal(cache.metrics.hits,metrics.hits+1);\n});\nEOF\nnpm test\"","aggregated_output":"✔ health and profile (0.847667ms)\n✔ organizations scoped to user (0.14575ms)\n✔ logout revokes session (0.117541ms)\n✔ nonmembers cannot read or update projects, spoof ownership, or alter cached lists (6.21525ms)\n✔ organization switching and every pagination/sorting variant remain isolated and cached (1.607666ms)\n✔ updates invalidate every owning organization variant and retain unrelated cache hits (0.893875ms)\n✔ membership revocation takes effect on cached lists, reads, and updates (0.146458ms)\n✔ authenticated detail (0.633125ms)\n✔ authenticated list (5.538791ms)\n✔ update then read (0.199417ms)\n✔ anonymous request rejected (0.3635ms)\n✔ invalid update rejected (0.135208ms)\nℹ tests 12\nℹ suites 0\nℹ pass 12\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 89.972958\n","exit_code":0,"status":"completed"}}
