 await expectRejected(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    expect(await queue.getJobState(ownerJob.id!)).toBe('failed');\n    expect((await queue.getJob(ownerJob.id!))!.failedReason).toBe('owner');\n  });\n\n  it('should not immediately retry a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob({ attempts: 3 });\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    expect(await queue.getJobState(ownerJob.id!)).toBe('waiting');\n    expect((await queue.getJob(ownerJob.id!))!.attemptsMade).toBe(1);\n  });\n\n  it('should not schedule a delayed retry for a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob({\n      attempts: 3,\n      backoff: { type: 'fixed', delay: 5000 },\n    });\n\n    await expectRejected(staleJob.id!, () =>\n      staleJob.moveToFailed(new Error('stale'), staleToken, false),\n    );\n\n    await ownerJob.moveToFailed(new Error('owner'), ownerToken, false);\n    expect(await queue.getJobState(ownerJob.id!)).toBe('delayed');\n    const job = (await queue.getJob(ownerJob.id!))!;\n    expect(job.attemptsMade).toBe(1);\n    expect(job.delay).toBe(5000);\n  });\n\n  it('should not renew the lock of a recovered job', async () => {\n    const { staleJob, ownerJob } = await recoverJob();\n    const client = await queue.client;\n    const lockKey = queue.toKey(`${staleJob.id}:lock`);\n    await client.sadd(queue.keys.stalled, staleJob.id!);\n\n    expect(await staleJob.extendLock(staleToken, 600000)).toBe(0);\n    expect(\n      await staleWorker.extendJobLocks([staleJob.id!], [staleToken], 600000),\n    ).toEqual([staleJob.id]);\n\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await client.pttl(lockKey)).toBeLessThanOrEqual(30000);\n    expect(await client.sismember(queue.keys.stalled, staleJob.id!)).toBe(1);\n\n    expect(await ownerJob.extendLock(ownerToken, 600000)).toBe(1);\n    expect(await client.pttl(lockKey)).toBeGreaterThan(30000);\n    expect(await client.sismember(queue.keys.stalled, staleJob.id!)).toBe(0);\n\n    await client.sadd(queue.keys.stalled, staleJob.id!);\n    expect(\n      await ownerWorker.extendJobLocks([ownerJob.id!], [ownerToken], 900000),\n    ).toEqual([]);\n    expect(await client.get(lockKey)).toBe(ownerToken);\n    expect(await client.pttl(lockKey)).toBeGreaterThan(600000);\n    expect(await client.sismember(queue.keys.stalled, staleJob.id!)).toBe(0);\n  });\n\n  it('should only renew the owned locks in a batch', async () => {\n    await queue.add('other', { foo: 'baz' });\n    const otherJob = (await staleWorker.getNextJob(staleToken)) as Job;\n    const { staleJob } = await recoverJob();\n    const client = await queue.client;\n\n    expect(\n      await staleWorker.extendJobLocks(\n        [otherJob.id!, staleJob.id!],\n        [staleToken, staleToken],\n        600000,\n      ),\n    ).toEqual([staleJob.id]);\n\n    expect(await client.get(queue.toKey(`${staleJob.id}:lock`))).toBe(\n      ownerToken,\n    );\n    expect(\n      await client.pttl(queue.toKey(`${otherJob.id}:lock`)),\n    ).toBeGreaterThan(30000);\n  });\n\n  it('should keep failing when the lock is missing', async () => {\n    await queue.add('test', { foo: 'bar' });\n    const job = (await staleWorker.getNextJob(staleToken)) as Job;\n    const client = await queue.client;\n    await client.del(queue.toKey(`${job.id}:lock`));\n\n    await expect(\n      job.moveToCompleted('stale', staleToken, false),\n    ).rejects.toThrow(`Missing lock for job ${job.id}`);\n    expect(await job.extendLock(staleToken, 600000)).toBe(0);\n    expect(\n      await staleWorker.extendJobLocks([job.id!], [staleToken], 600000),\n    ).toEqual([job.id]);\n    expect(await client.exists(queue.toKey(`${job.id}:lock`))).toBe(0);\n    expect(await queue.getJobState(job.id!)).toBe('active');\n  });\n});\n","structuredPatch":[],"originalFile":null,"userModified":false}}
