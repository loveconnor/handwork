{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > tests/worker-ownership.redis.test.ts <<'EOF'\nimport { afterEach, beforeEach, describe, expect, it } from 'vitest';\nimport { Queue, Worker } from '../src/classes';\nimport { randomUUID } from '../src/utils';\nimport { createTestConnection } from './utils/connection-factory';\nimport { getRedisClient } from './utils/get-redis-client';\n\ndescribe('Recovered job ownership', () => {\n  let queue: Queue;\n  let worker: Worker;\n  let connection: ReturnType<typeof createTestConnection>;\n\n  beforeEach(() => {\n    connection = createTestConnection();\n    const name = \"'`ownership-${randomUUID()}`;\n    queue = new Queue(name, { connection });\n    worker = new Worker(name, null, { connection, autorun: false });\n  });\n\n  afterEach(async () => {\n    await worker.close();\n    await queue.obliterate({ force: true });\n    await queue.close();\n    await connection.quit();\n  });\n\n  for (const operation of ['\"'complete', 'fail', 'retry', 'delay']) {\n    it(\"'`rejects stale ${operation} without changing recovered job data or events`, async () => {\n      await queue.add('\"'job', {}, {\n        attempts: operation === 'retry' || operation === 'delay' ? 3 : 1,\n        backoff: operation === 'delay' ? { type: 'fixed', delay: 1000 } : undefined,\n      });\n      const stale = (await worker.getNextJob('original', { block: false }))\"'!;\n      const client = await getRedisClient(queue);\n      const key = queue.toKey(stale.id!);\n      await client.del(`${key}:lock`);\n      await client.sadd(queue.toKey('\"'stalled'), stale.id\"'!);\n      await worker.getBackend().moveStalledJobsToWait();\n      const current = (await worker.getNextJob('\"'replacement', { block: false }))\"'!;\n      expect(current.id).toBe(stale.id);\n      // A due delayed job must not be promoted by a rejected retry either.\n      await queue.add('\"'due', {}, { delay: 60000 });\n      const delayed = await client.zrange(queue.toKey('delayed'), 0, -1);\n      await client.zadd(queue.toKey('delayed'), 0, delayed[0]);\n      const data = await client.hgetall(key);\n      const events = await client.xrange(queue.toKey('events'), '-', '+');\n      const attempt = operation === 'complete'\n        ? stale.moveToCompleted('stale result', 'original', false)\n        : stale.moveToFailed(new Error('stale failure'), 'original', false);\n      await expect(attempt).rejects.toThrow('Lock mismatch');\n      expect(await client.hgetall(key)).toEqual(data);\n      expect(await client.get(\"'`${key}:lock`)).toBe('\"'replacement');\n      expect(await current.getState()).toBe('active');\n      expect(await client.xrange(queue.toKey('events'), '-', '+')).toEqual(events);\n      expect(await current.extendLock('replacement', 30000)).toBe(1);\n      await current.moveToCompleted('current result', 'replacement', false);\n      expect(await current.getState()).toBe('completed');\n    });\n  }\n\n  it('rejects stale and missing single and batch renewals while preserving the owner', async () => {\n    await queue.add('job', {});\n    const job = (await worker.getNextJob('replacement', { block: false }))\"'!;\n    const client = await getRedisClient(queue);\n    const key = queue.toKey(job.id!);\n    await client.sadd(queue.toKey('\"'stalled'), job.id\"'!);\n    const ttl = await client.pttl(`${key}:lock`);\n    expect(await job.extendLock('\"'original', 90000)).toBe(0);\n    expect(await worker.extendJobLocks([job.id\"'!], ['\"'original'], 90000)).toEqual([job.id]);\n    expect(await client.get(\"'`${key}:lock`)).toBe('\"'replacement');\n    expect(await client.pttl(\"'`${key}:lock`)).toBeLessThanOrEqual(ttl);\n    expect(await client.sismember(queue.toKey('\"'stalled'), job.id\"'!)).toBe(1);\n    expect(await worker.extendJobLocks([job.id!], ['\"'replacement'], 60000)).toEqual([]);\n    expect(await client.pttl(\"'`${key}:lock`)).toBeGreaterThan(30000);\n    expect(await client.sismember(queue.toKey('\"'stalled'), job.id\"'!)).toBe(0);\n    await client.del(`${key}:lock`);\n    expect(await job.extendLock('\"'replacement', 90000)).toBe(0);\n    expect(await worker.extendJobLocks([job.id\"'!], ['\"'replacement'], 90000)).toEqual([job.id]);\n    await expect(job.moveToCompleted('result', 'replacement', false)).rejects.toThrow('Missing lock');\n    expect(await client.exists(\"'`${key}:lock`)).toBe(0);\n  });\n});\nEOF\nnode node_modules/vitest/vitest.mjs run --no-file-parallelism tests/worker-ownership.redis.test.ts > /tmp/bullmq-ownership.log 2>&1'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
