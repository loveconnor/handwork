+fn batchDecodeAllocationProbe(alloc: Allocator) !void {
+    const result = try decode(.{ .allocator = alloc }, "{\"files\":[{\"path\":\"a\"},{\"path\":\"b\",\"start_line\":2}]}");
+    switch (result) {
+        .input => |input| input.deinit(alloc),
+        .failure => |body| {
+            alloc.free(body);
+            return error.TestUnexpectedResult;
+        },
+    }
+}
