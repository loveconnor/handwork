/b1',token:'alice',body:{name:''}}),forbidden);\n  assert.equal(a.db.counters.projectUpdates,0);assert.deepEqual(a.db.projects.get('b1'),sampleSeed().projects[3]);assert.deepEqual(a.cache.keys(),keys);\n});\ntest('missing project is 404 and nonmember list is 403',()=>{\n  const a=createApp(sampleSeed());\n  assert.equal(a.request({method:'GET',path:'/projects/nope',token:'alice'}).status,404);\n  assert.equal(a.request({method:'PATCH',path:'/projects/nope',token:'alice',body:{name:'x'}}).status,404);\n  assert.deepEqual(list(a,'alice','org-b'),forbidden);assert.equal(a.db.counters.projectLists,0);assert.deepEqual(a.cache.keys(),[]);\n});\ntest('lists are cached per organization',()=>{\n  const a=createApp(sampleSeed());\n  assert.deepEqual(names(list(a,'both','org-a')),['Alpha','Delta','Gamma']);\n  assert.deepEqual(names(list(a,'both','org-b')),['Beta','Echo','Foxtrot']);\n  assert.deepEqual(names(list(a,'both','org-a')),['Alpha','Delta','Gamma']);\n  assert.equal(a.db.counters.projectLists,2);\n});\ntest('list variants stay distinct',()=>{\n  const a=createApp(sampleSeed());\n  assert.deepEqual(names(list(a,'alice','org-a',{pageSize:'2'})),['Alpha','Delta']);\n  assert.deepEqual(names(list(a,'alice','org-a',{pageSize:'2',page:'2'})),['Gamma']);\n  assert.deepEqual(names(list(a,'alice','org-a',{direction:'desc'})),['Gamma','Delta','Alpha']);\n  assert.deepEqual(names(list(a,'alice','org-a',{sort:'updatedAt'})),['Delta','Gamma','Alpha']);\n  assert.equal(a.db.counters.projectLists,4);\n});\ntest('cache hits still check membership',()=>{\n  const a=createApp(sampleSeed());list(a,'bob','org-b');\n  assert.deepEqual(list(a,'alice','org-b'),forbidden);\n  membershipRepository(a.db).revoke('bob','org-b');\n  assert.deepEqual(list(a,'bob','org-b'),forbidden);assert.equal(a.db.counters.projectLists,1);\n});\ntest('update invalidates every variant for only the owning organization',()=>{\n  const a=createApp(sampleSeed());\n  const variants=[undefined,{direction:'desc'},{sor