r = new Worker(queueName, null, {\n5050:             autorun: false,\n5051:             connection,\n5052:             prefix,\n5053:             lockDuration: 1000,\n5054:             stalledInterval: 100,\n5055:             maxStalledCount: 0,\n5056:           });\n5057: \n\n(Showing lines 5010-5057 of 5218. Use offset=5058 to continue.)\n</content>","metadata":{"preview":"\n        const activated = new Promise<Job>(resolve => {\n          worker.on('active', resolve);\n        });\n\n        const job = (await worker.getNextJob(token)) as Job;\n\n        const activatedJob = await activated;\n\n        expect(activatedJob.id).toBe(job.id);\n\n        const isActive = await job.isActive();\n        expect(isActive).toBe(true);\n\n        await job.moveToCompleted('done', token);\n        await worker.close();\n      });\n    });\n\n    describe('when a stalled job has exhausted its max stalled attempts', () => {","truncated":true,"loaded":[],"display":{"type":"file","path":"/private/tmp/handwork-bullmq-G7VJT5/2-opencode/repo/tests/worker.test.ts","text":"\n        const activated = new Promise<Job>(resolve => {\n          worker.on('active', resolve);\n        });\n\n        const job = (await worker.getNextJob(token)) as Job;\n\n        const activatedJob = await activated;\n\n        expect(activatedJob.id).toBe(job.id);\n\n        const isActive = await job.isActive();\n        expect(isActive).toBe(true);\n\n        await job.moveToCompleted('done', token);\n        await worker.close();\n      });\n    });\n\n    describe('when a stalled job has exhausted its max stalled attempts', () => {\n      const markJobForDeferredFailure = async (worker: Worker, job: Job) => {\n        const client = await getRedisClient(worker);\n        await client.del(`${prefix}:${queueName}:${job.id}:lock`);\n\n        const stalled = new Promise<string>(resolve => {\n          worker.on('stalled', resolve);\n        });\n\n        await (worker as any).moveStalledJobsToWait();\n        await client.del(`${prefix}:${queueName}:stalled-check`);\n        await (worker as any).moveStalledJobsToWait();\n\n        expect(await stalled).toBe(job.id);\n      };\n\n      it(\n        'should move the job to failed automatically on the next getNextJob ' +\n          'call and return undefined when no other jobs are waiting',\n        async () => {\n          const worker = new Worker(queueName, null, {\n            autorun: false,\n            connection,\n            prefix,\n            lockDuration: 1000,\n            stalledInterval: 100,\n            maxStalledCount: 0,\n          });\n","lineStart":5010,"lineEnd":5057,"totalLines":5218,"truncated":true}},"title":"tests/worker.test.ts","time":{"start":1789788853655,"end":1789788853661}},"metadata":{"openai":{"itemId":"fc_0597fda48c6969a9016aae02b37d3c87d18e10bab0f894de60"}},"id":"prt_0b7ba8d13001akJjgScuk263Hj","sessionID":"ses_f48467e2bffejC2lfVdrXfzZn1","messageID":"msg_0b7ba84a8001oVHqBuWyH6Ca21"}}
