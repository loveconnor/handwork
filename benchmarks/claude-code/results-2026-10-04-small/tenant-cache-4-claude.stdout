'../src/seed.ts';\nimport { membershipRepository } from '../src/db/membership-repository.ts';\nconst forbidden={status:403,body:{error:'forbidden'}};\nconst list=(a:any,org:string,token:string,query?:Record<string,string>)=>a.request({method:'GET',path:`/organizations/${encodeURIComponent(org)}/projects`,token,query});\ntest('nonmember cannot read a project',()=>{const a=createApp(sampleSeed());assert.deepEqual(a.request({method:'GET',path:'/projects/b1',token:'alice'}),forbidden);});\ntest('nonmember cannot update a project',()=>{\n  const a=createApp(sampleSeed());list(a,'org-b','bob');const keys=a.cache.keys();\n  assert.deepEqual(a.request({method:'PATCH',path:'/projects/b1',token:'alice',body:{name:'Hacked',organizationId:'org-a'}}),forbidden);\n  assert.deepEqual(a.request({method:'PATCH',path:'/projects/b1',token:'alice',body:{name:''}}),forbidden);\n  assert.deepEqual(a.db.projects.get('b1'),{id:'b1',organizationId:'org-b',name:'Beta',updatedAt:7});\n  assert.equal(a.db.counters.projectUpdates,0);assert.deepEqual(a.cache.keys(),keys);\n});\ntest('missing project is 404, ownership cannot be reassigned',()=>{\n  const a=createApp(sampleSeed());\n  assert.equal(a.request({method:'GET',path:'/projects/nope',token:'alice'}).status,404);\n  assert.equal(a.request({method:'PATCH',path:'/projects/nope',token:'alice',body:{name:'x'}}).status,404);\n  assert.deepEqual(a.request({method:'PATCH',path:'/projects/a1',token:'alice',body:{name:' New ',organizationId:'org-b'}}).body,{id:'a1',organizationId:'org-a',name:'New',updatedAt:4});\n});\ntest('nonmember cannot list, even on cache hit',()=>{\n  const a=createApp(sampleSeed());\n  assert.deepEqual(list(a,'org-b','alice'),forbidden);assert.deepEqual(a.cache.keys(),[]);\n  assert.equal(list(a,'org-b','bob').status,200);\n  assert.deepEqual(list(a,'org-b','alice'),forbidden);\n});\ntest('revoked membership takes effect immediately',()=>{\n  const a=createApp(sampleSeed());assert.equal(list(a,'org-a','alice').status,200);\n  membershipRepository(a.db).revoke('alice','org-a');\n  assert.deepEqual(list(a,'org-a','alice'),forbidden);\n  assert.deepEqual(a.request({method:'GET',path:'/projects/a1',token:'alice'}),forbidden);\n});\ntest('lists are cached per organization',()=>{\n  const a=createApp(sampleSeed());\n  assert.deepEqual((list(a,'org-a','both').body as any).items.map((p:any)=>p.id),['a1','a2','a3']);\n  assert.deepEqual((list(a,'org-b','both').body as any).items.map((p:any)=>p.id),['b1','b2','b3']);\n  assert.equal(a.db.counters.projectLists,2);\n  const again=list(a,'org-a','both');assert.deepEqual((again.body as any).items.map((p:any)=>p.id),['a1','a2','a3']);\n  assert.equal(a.db.counters.projectLists,2);\n});\ntest('list variants stay distinct',()=>{\n  const a=createApp(sampleSeed());const ids=(q:Record<string,string>)=>(list(a,'org-a','alice',q).body as any).items.map((p:any)=>p.id);\n  for(let i=0;i<2;i++){\n    assert.deepEqual(ids({}),['a1','a2','a3']);\n    assert.deepEqual(ids({direction:'desc'}),['a3','a2','a1']);\n    assert.deepEqual(ids({sort:'updatedAt'}),['a2','a3','a1']);\n    assert.deepEqual(ids({pageSize:'2'}),['a1','a2']);\n    assert.deepEqual(ids({pageSize:'2',page:'2'}),['a3']);\n  }\n  assert.equal(a.db.counters.projectLists,5);\n  assert.equal(list(a,'org-a','alice',{pageSize:'0'}).status,400);\n});\ntest('update invalidates every list variant of the owning organization only',()=>{\n  const a=createApp(sampleSeed());const variants=[{},{direction:'desc'},{sort:'updatedAt'},{pageSize:'2',page:'2'}];\n  for(const q of variants){list(a,'org-a','both',q);list(a,'org-b','both',q);}\n  assert.equal(a.db.counters.projectLists,8);\n  assert.equal(a.request({method:'PATCH',path:'/projects/a1',token:'both',body:{name:'Zulu'}}).status,200);\n  for(const q of variants)list(a,'org-b','both',q);\n  assert.equal(a.db.counters.projectLists,8);\n  assert.deepEqual((list(a,'org-a','both').body as any).items.map((p:any)=>p.name),['Delta','Gamma','Zulu']);\n  assert.deepEqual((list(a,'org-a','both',{sort:'updatedAt',direction:'desc'}).body as any).items[0],{id:'a1',organizationId:'org-a',name:'Zulu',updatedAt:4});\n  for(const q of variants)list(a,'org-a','both',q);\n  assert.equal(a.db.counters.projectLists,13);\n});\ntest('rejected updates leave cached lists alone',()=>{\n  const a=createApp(sampleSeed());list(a,'org-a','alice');\n  assert.equal(a.request({method:'PATCH',path:'/projects/a1',token:'alice',body:{name:' '}}).status,400);\n  list(a,'org-a','alice');assert.equal(a.db.counters.projectLists,1);\n});\ntest('organization ids sharing prefixes or punctuation do not collide',()=>{\n  const seed=sampleSeed(),orgs=['org','org:1','org:1:10','org%3A1','org/x'];\n  seed.organizations=orgs.map(id=>({id,name:id}));seed.memberships=orgs.map(id=>({userId:'alice',organizationId:id}));\n  seed.projects=orgs.map((id,i)=>({id:`p${i}`,organizationId:id,name:`P${i}`,updatedAt:1}));\n  const a=createApp(seed);\n  const check=()=>orgs.forEach((id,i)=>assert.deepEqual((list(a,id,'alice').body as any).items.map((p:any)=>p.id),[`p${i}`]));\n  check();check();assert.equal(a.db.counters.projectLists,5);\n  assert.equal(a.request({method:'PATCH',path:'/projects/p1',token:'alice',body:{name:'Renamed'}}).status,200);\n  check();assert.equal(a.db.counters.projectLists,6);\n  assert.equal((list(a,'org:1','alice').body as any).items[0].name,'Renamed');\n});\nEOF\nnpm test 2>&1 | tail -40; git status --short","description":"Apply fix, add isolation tests, run test suite"}},"wire_ingest_context":{"toolu_01RmhfwYvqJTMgaYkDah1At9":{"cwd":"/private/tmp/handwork-claude-vucg11_s/tenant-cache-4-claude/repo"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RmhfwYvqJTMgaYkDah1At9","type":"tool_result","content":"> test\n> node --test tests/*.test.ts\n\n✔ health and profile (0.820375ms)\n✔ organizations scoped to user (0.142625ms)\n✔ logout revokes session (0.11425ms)\n✔ nonmember cannot read a project (0.932458ms)\n✔ nonmember cannot update a project (5.646666ms)\n✔ missing project is 404, ownership cannot be reassigned (0.145833ms)\n✔ nonmember cannot list, even on cache hit (0.112208ms)\n✔ revoked membership takes effect immediately (0.130958ms)\n✔ lists are cached per organization (0.116042ms)\n✔ list variants stay distinct (0.195166ms)\n✔ update invalidates every list variant of the owning organization only (0.173833ms)\n✔ rejected updates leave cached lists alone (0.104792ms)\n✔ organization ids sharing prefixes or punctuation do not collide (0.367833ms)\n✔ authenticated detail (0.587292ms)\n✔ authenticated list (5.475ms)\n✔ update then read (0.189667ms)\n✔ anonymous request rejected (0.391125ms)\n✔ invalid update rejected (0.087542ms)\nℹ tests 18\nℹ suites 0\nℹ pass 18\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 89.992042\n M src/cache/keys.ts\n M src/services/project-service.ts\n?? tests/isolation.test.ts","is_error":false}]},"parent_tool_use_id":null,"session_id":"da5fde59-e9bb-42b9-9dda-e82d9d4b2b0b","uuid":"0488487d-acdc-4954-a374-c65fb25c67ed","timestamp":"2026-10-04T14:46:55.273Z","tool_use_result":{"stdout":"> test\n> node --test tests/*.test.ts\n\n✔ health and profile (0.820375ms)\n✔ organizations scoped to user (0.142625ms)\n✔ logout revokes session (0.11425ms)\n✔ nonmember cannot read a project (0.932458ms)\n✔ nonmember cannot update a project (5.646666ms)\n✔ missing project is 404, ownership cannot be reassigned (0.145833ms)\n✔ nonmember cannot list, even on cache hit (0.112208ms)\n✔ revoked membership takes effect immediately (0.130958ms)\n✔ lists are cached per organization (0.116042ms)\n✔ list variants stay distinct (0.195166ms)\n✔ update invalidates every list variant of the owning organization only (0.173833ms)\n✔ rejected updates leave cached lists alone (0.104792ms)\n✔ organization ids sharing prefixes or punctuation do not collide (0.367833ms)\n✔ authenticated detail (0.587292ms)\n✔ authenticated list (5.475ms)\n✔ update then read (0.189667ms)\n✔ anonymous request rejected (0.391125ms)\n✔ invalid update rejected (0.087542ms)\nℹ tests 18\nℹ suites 0\nℹ pass 18\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 89.992042\n M src/cache/keys.ts\n M src/services/project-service.ts\n?? tests/isolation.test.ts","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CfhNwcwx7UuUhSicb9jvd","type":"message","role":"assistant","content":[{"type":"text","text":"All three reported bugs are fixed, and the full suite passes (18 tests: the 8 existing ones, unmodified, plus 10 new ones). Nothing is committed.\n\n## Root causes and fixes\n\n**1. Cross-organization read/update** — `src/services/project-service.ts`\n`detail()` looked up the project but never checked membership, and `update()` relied on `detail()`. It now calls `requireMembership` against the project's stored `organizationId`, so both GET and PATCH return 403 `{error:\"forbidden\"}` for nonmembers. The check runs before body validation and before any write, so an unauthorized request touches neither storage nor the cache. Missing projects still return 404.\n\n**2. Previous organization's projects after switching** — `src/cache/keys.ts`\n`projectListKey` ignored its `organizationId` argument, so every organization shared one cache entry per page/sort combination. The key now includes the organization ID alongside page, page size, sort and direction. The ID is URI-encoded, so IDs that share a prefix or contain punctuation (`org`, `org:1`, `org:1:10`) can't collide.\n\n**3. Stale list after update** — `src/services/project-service.ts`\n`update()` only deleted a detail key and never touched list entries. After a successful update it now deletes every cached key under the owning organization's list prefix (new `projectListPrefix` helper). Other organizations' entries are left alone.\n\nThe list route already checked membership before consulting the cache, so cache hits were already authorized; I left that as is and added a test for it. No signatures, response shapes or status codes changed, and caching stays on.\n\n## Verification\n\n`npm test` ran the existing tests plus the new `tests/isolation.test.ts`, which covers:\n- **Nonmember read and update:** both return 403, with storage, the update counter and cache keys unchanged, even when the body carries a spoofed `organizationId` or an invalid name.\n- **Nonmember list:** returns 403 on both a cold cache and a cache hit, and a revoked membership takes effect immediately.\n- **Per-organization caching:** a user in both organizations sees the right list for each, and repeated requests don't trigger another repository query.\n- **List variants:** page, page size, sort and direction are cached separately and return correct results.\n- **Invalidation:** an update refreshes every variant for the owning organization, while the other organization's cached variants are still served without a query.\n- **Rejected updates:** a 400 leaves cached lists in place.\n- **Awkward organization IDs:** IDs with shared prefixes, `:`, `%` and `/` stay isolated for both caching and invalidation."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4483,"cache_read_input_tokens":15995,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4483},"output_tokens":671,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"da5fde59-e9bb-42b9-9dda-e82d9d4b2b0b","uuid":"e652864a-eaa0-480d-8704-864688a189b2","timestamp":"2026-10-04T14:47:04.932Z","request_id":"req_011CfhNwcbrqZX5BavLtB3cZ"}
